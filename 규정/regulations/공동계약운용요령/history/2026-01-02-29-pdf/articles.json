[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_1","display_id":"공동계약운용요령-제1조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_1_P0","display_id":"공동계약운용요령-제1조","paragraph_number":"","paragraph_index":null,"content":"이 예규는 「국가를 당사자로 하는 계약에 관한 법률 시행령」(이하 \"시행령\"이라 한다) 제72조에 의한 공동계약의 체결방법과 기타 필요한 사항을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"1","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_72"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2","display_id":"공동계약운용요령-제2조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_P0","display_id":"공동계약운용요령-제2조","paragraph_number":"","paragraph_index":null,"content":"이 예규에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_P0_I1","display_id":"공동계약운용요령-제2조-제1호","item_number":"1","content":"\"공동계약\"이라 함은 공사ㆍ제조ㆍ기타의 계약에 있어서 발주기관과 공동수급체가 체결하는 계약을 말한다.","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_P0_I2","display_id":"공동계약운용요령-제2조-제2호","item_number":"2","content":"\"공동수급체\"라 함은 구성원을 2인 이상으로 하여 수급인이 해당계약을 공동으로 수행하기 위하여 잠정적으로 결성한 실체를 말한다.","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_P0_I3","display_id":"공동계약운용요령-제2조-제3호","item_number":"3","content":"\"공동수급체 대표자\"라 함은 공동수급체의 구성원 중에서 대표자로 선정된 자를 말한다.","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_P0_I4","display_id":"공동계약운용요령-제2조-제4호","item_number":"4","content":"\"공동수급협정서\"라 함은 공동계약에 있어서 공동수급체구성원 상호간의 권리ㆍ의무 등 공동계약의 수행에 관한 중요사항을 규정한 계약서를 말한다.","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_P0_I5","display_id":"공동계약운용요령-제2조-제5호","item_number":"5","content":"\"주계약자\"라 함은 주계약자관리방식의 공동계약에서 공동수급체 구성원 중 전체 건설공사의 이행에 관하여 종합적인 계획ㆍ관리ㆍ조정을 하는 자를 말한다.<신설 2009. 4. 8.>","subitems":[]}]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"1","amendments":["<신설 2009. 4. 8.>"],"last_amended":"2009-04-08","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_2","display_id":"공동계약운용요령-제2조의2","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"2의2","article_label":"제2조의2","article_title":"공동계약의 유형","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_2_P0","display_id":"공동계약운용요령-제2조의2","paragraph_number":"","paragraph_index":null,"content":"공동계약은 공동수급체가 도급받아 이행하는 방식에 따라 다음 각 호와 같이 구분한다.","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_2_P0_I1","display_id":"공동계약운용요령-제2조의2-제1호","item_number":"1","content":"\"공동이행방식\"이라 함은 공동수급체 구성원이 일정 출자비율에 따라 연대하여 공동으로 계약을 이행하는 공동계약을 말한다.","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_2_P0_I2","display_id":"공동계약운용요령-제2조의2-제2호","item_number":"2","content":"\"분담이행방식\"이라 함은 공동수급체 구성원이 일정 분담내용에 따라 나누어 공동으로 계약을 이행하는 공동계약을 말한다.","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_2_P0_I3","display_id":"공동계약운용요령-제2조의2-제3호","item_number":"3","content":"\"주계약자관리방식\"이라 함은 「건설산업기본법」에 따른 건설공사를 시행하기 위한 공동수급체의 구성원중 주계약자를 선정하고, 주계약자가 전체 건설공사 계약의 수행에 관하여 종합적인 계획ㆍ관리 및 조정을 하는 공동계약을 말한다.<개정 2020. 12. 28.>","subitems":[]}]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"1","amendments":["<개정 2020. 12. 28.>"],"last_amended":"2020-12-28","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_3","display_id":"공동계약운용요령-제2조의3","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"2의3","article_label":"제2조의3","article_title":"주계약자관리방식에 의한 공동계약","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_2_3_P0","display_id":"공동계약운용요령-제2조의3","paragraph_number":"","paragraph_index":null,"content":"<삭제 2020. 12. 28.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"1","amendments":["<삭제 2020. 12. 28.>"],"last_amended":"2020-12-28","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_3","display_id":"공동계약운용요령-제3조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"권리행사 및 의무의 이행","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_3_P0","display_id":"공동계약운용요령-제3조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원(각 중앙관서의 장이 계약에 관한 사무를 그 소속공무원에게 위임하지 아니하고 직접 처리하는 경우에는 이를 계약담당공무원으로 본다. 이하 같다)은 공동수급체의 구성원으로 하여금 이 예규 및 공동수급협정서에서 정하는 바에 따라 신의와 성실의 원칙에 입각하여 이를 이행하게 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"1","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체","중앙관서의 장"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_4","display_id":"공동계약운용요령-제4조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"공동수급체 대표자의 선임","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_4_P1","display_id":"공동계약운용요령-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공동수급체의 구성원으로 하여금 상호 협의하여 공동수급체 대표자를 선임하게 하되, 시행령 제36조에 의한 입찰공고 등에서 요구한 자격을 갖춘 업체를 우선적으로 선임하게 하여야 한다. 다만, 주계약자관리방식에 의한 공동계약의 경우에는 주계약자가 공동수급체의 대표자가 된다.<개정 2009. 4. 8.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_4_P2","display_id":"공동계약운용요령-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의하여 선임된 공동수급체 대표자는 발주기관 및 제3자에 대하여 공동수급체를 대표한다.","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_4_P3","display_id":"공동계약운용요령-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 주계약자관리방식에서 대표자로 하여금 공사시방서ㆍ설계도면ㆍ계약서ㆍ예정공정표ㆍ품질보증계획 또는 품질시험계획ㆍ안전 및 환경관리계획ㆍ산출내역서 등에 의하여 품질 및 시공을 확인하게 하고 적정하지 못하다고 인정되는 경우에는 재시공지시 등 필요한 조치를 하게 하여야 한다.<신설 2009. 4. 8.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_4_P4","display_id":"공동계약운용요령-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약담당공무원은 주계약자관리방식에서 대표자로 하여금 공사 진행의 경제성 및 효율성 등을 감안하여 공동수급체 구성원과의 협의를 거쳐 자재 및 장비 등의 조달을 일원화하여 관리하게 하여야 한다.<신설 2009. 4. 8.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_4_P5","display_id":"공동계약운용요령-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약담당공무원은 시행령 제42조제4항에 의한 종합심사 낙찰제 대상공사 입찰의 경우에 공동수급체 대표자의 출자비율 또는 분담내용이 100분의 50이상이 되도록 하여야 한다. 다만, 주계약자관리방식에 의한 공동계약의 경우에는 공사의 내용 및 특성에 따라 분담내용을 정한다.<개정 2009. 4. 8., 2016. 1. 1.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"1-2","amendments":["<개정 2009. 4. 8.>","<신설 2009. 4. 8.>","<개정 2009. 4. 8., 2016. 1. 1.>"],"last_amended":"2016-01-01","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_36","STATE_CONTRACT_ENFORCEMENT_ART_42"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["공동계약","공동수급체","종합심사낙찰제"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_5","display_id":"공동계약운용요령-제5조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"공동수급협정서의 작성 및 제출","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_5_P1","display_id":"공동계약운용요령-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공동수급체 구성원으로 하여금 제8조에 의하여 입찰공고 내용에 명시된 공동계약의 이행방식에 따라 별첨 1(공동이행방식) 또는 별첨 2(분담이행방식) 또는 별첨\n3(주계약자관리방식)의 공동수급표준협정서를 참고하여 공동수급협정서를 작성하게 하여야 한다.<개정 2009. 4. 8.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_5_P2","display_id":"공동계약운용요령-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 공동수급체 대표자로 하여금 제1항에 의하여 작성한 공동수급협정서를 「국가를 당사자로 하는 계약에 관한 법률 시행규칙」 제40조에 의한 입찰참가 신청서류 제출시 함께 제출토록 하여 이를 보관하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"2","amendments":["<개정 2009. 4. 8.>"],"last_amended":"2009-04-08","related_articles":["JOINT_CONTRACT_OPERATION_RULE_ART_8","STATE_CONTRACT_RULE_ART_40"],"related_regulations":["STATE_CONTRACT_RULE"],"external_references":[],"keywords":["공동계약","공동수급체"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_6","display_id":"공동계약운용요령-제6조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"계약의 체결","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_6_P0","display_id":"공동계약운용요령-제6조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 공동계약 체결시 공동수급체구성원 전원이 계약서에 연명으로 기명날인 또는 서명토록 하여야 한다.<개정 2009. 9. 21.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"2","amendments":["<개정 2009. 9. 21.>"],"last_amended":"2009-09-21","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약서 작성","공동계약"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_7","display_id":"공동계약운용요령-제7조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"책임","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_7_P1","display_id":"공동계약운용요령-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공동수급체 구성원으로 하여금 발주자에 대한 계약상의 시공, 제조, 용역의무이행에 대하여 다음 각호에 따라 책임을 지도록 하여야 한다.<개정 2009. 4. 8., 2014. 1. 10.>","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_7_P1_I1","display_id":"공동계약운용요령-제7조-제1항-제1호","item_number":"1","content":"공동이행방식에 의한 경우에 구성원은 연대하여 책임을 지도록 하여야 한다. 다만, 공사이행보증서가 제출된 공사로서 계약이행요건을 충족하지 못하는 업체는 출자비율에 따라 책임을 지도록 하여야 한다.<신설 2014. 1. 10.>","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_7_P1_I2","display_id":"공동계약운용요령-제7조-제1항-제2호","item_number":"2","content":"분담이행방식에 의한 경우에 구성원은 분담내용에 따라 각자 책임을 지도록 하여야 한다.<신설 2014. 1. 10.>","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_7_P1_I3","display_id":"공동계약운용요령-제7조-제1항-제3호","item_number":"3","content":"주계약자관리방식에 의한 경우에 구성원은 각자 자신이 분담한 부분에 대해서만 책임을 지되, 불이행시 그 구성원의 보증기관이 책임을 지며, 주계약자는 최종적으로 전체계약에 대하여 책임을 지되, 불이행시 주계약자의 보증기관이 책임을 진다. 다만, 주계약자가 탈퇴한 후에 주계약자의 계약이행의무 대행이 이루어지지 않은 경우에는 주계약자 이외의 구성원은 자신의 분담부분에 대하여 계약이행이 이루어지지 아니한 것으로 본다.<신설 2009. 4. 8.>","subitems":[]}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_7_P2","display_id":"공동계약운용요령-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"시행령 제76조제2항은 입찰참가자격의 제한사유를 발생시킨 자에 대하여 적용하며, 출자비율 또는 분담내용과 다르게 시공한 경우에는 해당 구성원에 대하여 적용한다.<개정 2025. 12. 31.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"2","amendments":["<개정 2009. 4. 8., 2014. 1. 10.>","<신설 2014. 1. 10.>","<신설 2009. 4. 8.>","<개정 2025. 12. 31.>"],"last_amended":"2025-12-31","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_76"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["공동계약","계약의 이행","입찰참가자격"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8","display_id":"공동계약운용요령-제8조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"입찰공고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P1","display_id":"공동계약운용요령-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 입찰공고시 시행령 제72조제2항에 의하여 동일현장에 2인이상의 수급인을 투입하기 곤란하거나 긴급한 이행이 필요한 경우등 계약의 목적ㆍ성질상 공동계약에 의함이 곤란하다고 인정되는 경우를 제외하고는 가능한 한 공동계약이 가능하다는 뜻을 명시하여야 한다.","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P2","display_id":"공동계약운용요령-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 시행령 제72조제1항 또는 제3항에 따라 공동계약으로 발주하려는 경우에는 다음 각 호의 사항을 입찰공고에 명시하여야 한다.<개정 2020. 12. 28.>","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P2_I1","display_id":"공동계약운용요령-제8조-제2항-제1호","item_number":"1","content":"공동계약의 이행방식: 다음 각 방식 중 어느 하나로 한다.<신설 2020. 12. 28.>","subitems":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P2_I1_S1","display_id":"공동계약운용요령-제8조-제2항-제1호-가목","subitem_number":"가","content":"공동이행방식"},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P2_I1_S2","display_id":"공동계약운용요령-제8조-제2항-제1호-나목","subitem_number":"나","content":"분담이행방식"},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P2_I1_S3","display_id":"공동계약운용요령-제8조-제2항-제1호-다목","subitem_number":"다","content":"공동이행방식과 분담이행방식이 혼합된 방식"}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P2_I2","display_id":"공동계약운용요령-제8조-제2항-제2호","item_number":"2","content":"공동수급체 구성원의 자격제한 사항<신설 2020. 12. 28.>","subitems":[]}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_P3","display_id":"공동계약운용요령-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"입찰참가자는 제2항제1호 가목 또는 다목의 공동이행방식을 대신하여 주계약자관리방식으로 공동수급체를 구성하여 입찰에 참여할 수 있다.<신설 2020. 12. 28.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"3","amendments":["<개정 2020. 12. 28.>","<신설 2020. 12. 28.>"],"last_amended":"2020-12-28","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_72"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["입찰공고","공동계약","공동수급체"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_2","display_id":"공동계약운용요령-제8조의2","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"8의2","article_label":"제8조의2","article_title":"설비공사의 공동계약","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_2_P1","display_id":"공동계약운용요령-제8조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 「건설산업기본법시행령」 제7조에 의한 설비공사를 발주할 경우에는 설비제조업체와 시공업체간 분담이행방식에 의한 공동계약방법으로 입찰에 참가하게 할 수 있다. 다만, 단일 설비제조업체의 설비부분이 전체 추정가격의 50%이상일 경우에 한한다.","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_8_2_P2","display_id":"공동계약운용요령-제8조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항의 공사를 시행령 제78조에 의하여 일괄입찰방식으로 발주할 경우에 설비제조업체, 시공업체 및 기술용역등록업체간 분담이행방식에 의한 공동계약방법으로 입찰에 참가하게 할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"3","amendments":[],"last_amended":"","related_articles":["CONSTRUCTION_INDUSTRY_BASIC_ENFORCEMENT_ART_7","STATE_CONTRACT_ENFORCEMENT_ART_78"],"related_regulations":["CONSTRUCTION_INDUSTRY_BASIC_ENFORCEMENT","STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["공동계약","계약방법","추정가격"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9","display_id":"공동계약운용요령-제9조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"공동수급체의 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P1","display_id":"공동계약운용요령-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공동수급체 구성원으로 하여금 해당계약을 이행하는데 필요한 면 허ㆍ허가ㆍ등록 등의 자격요건을 갖추게 하여야 하며, 계약이행에 필요한 자격요건은 다음 각 호에 따라 구비되어야 한다.<개정 2009. 4. 8.>","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P1_I1","display_id":"공동계약운용요령-제9조-제1항-제1호","item_number":"1","content":"분담이행방식의 경우 : 구성원 공동","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P1_I2","display_id":"공동계약운용요령-제9조-제1항-제2호","item_number":"2","content":"공동이행방식의 경우 : 구성원 각각","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P1_I3","display_id":"공동계약운용요령-제9조-제1항-제3호","item_number":"3","content":"주계약자관리방식의 경우","subitems":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P1_I3_S1","display_id":"공동계약운용요령-제9조-제1항-제3호-가목","subitem_number":"가","content":"주계약자 : 전체공사를 이행하는데 필요한 자격요건"},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P1_I3_S2","display_id":"공동계약운용요령-제9조-제1항-제3호-나목","subitem_number":"나","content":"구성원 : 분담공사를 이행하는데 필요한 자격요건"}]}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P2","display_id":"공동계약운용요령-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 시행령 제21조제1항에 의한 시공능력, 공사실적, 기술보유상황 등은 「건설산업기본법」 등 관련법령에서 규정하고 있는 면허와 동일한 경우에는 공동수급체 구성원 모두의 것을 합산하여 적용한다.<개정 2016. 12. 30.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3","display_id":"공동계약운용요령-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"공동계약에 의하여 이행된 실적의 인정범위는 다음 각 호에 따라 배분한다.","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3_I1","display_id":"공동계약운용요령-제9조-제3항-제1호","item_number":"1","content":"분담이행방식에 의한 경우 : 공동수급체의 구성원별 분담부분","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3_I2","display_id":"공동계약운용요령-제9조-제3항-제2호","item_number":"2","content":"공동이행방식에 의한 경우","subitems":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3_I2_S1","display_id":"공동계약운용요령-제9조-제3항-제2호-가목","subitem_number":"가","content":"금액 : 공동수급체의 구성원별 출자비율에 해당되는 금액"},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3_I2_S2","display_id":"공동계약운용요령-제9조-제3항-제2호-나목","subitem_number":"나","content":"규모 또는 양 : 실적증명 발급기관에서 공사의 성질상 공동수급체의 구성원별 실제 시공부분을 분리하여 구분할 수 있는 경우에는 실제 시공한 부분. 다만, 분리ㆍ구분할 수 없는 경우에는 출자비율에 따라 배분"}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3_I3","display_id":"공동계약운용요령-제9조-제3항-제3호","item_number":"3","content":"주계약자관리방식에 의한 경우<신설 2009. 4. 8.>","subitems":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3_I3_S1","display_id":"공동계약운용요령-제9조-제3항-제3호-가목","subitem_number":"가","content":"구성원 : 분담부분"},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P3_I3_S2","display_id":"공동계약운용요령-제9조-제3항-제3호-나목","subitem_number":"나","content":"주계약자 : 건설산업기본법 시행규칙 제23조 제6항에 의함(제10항)"}]}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P4","display_id":"공동계약운용요령-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약담당공무원은 공동수급체구성원이 동일 입찰건에 대하여 공동수급체를 중복적으로 결성하여 입찰에 참가하게 하거나, 시행령 제72조제3항에 의한 공동계약의 경우와 주계약자관리방식에 의한 공동계약의 경우 「독점규제 및 공정거래에 관한 법률」에 의한 상호출자제한기업집단소속 계열회사간에 공동수급체를 구성하게 하여서는 아니된다.<개정 2009. 4. 8., 2014. 1. 10.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P5","display_id":"공동계약운용요령-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약담당공무원은 공동계약의 유형별 구성원 수와 구성원별 계약참여 최소지분율을 다음 각 호에 따라 처리한다. 다만, 해당 계약의 특성 및 규모를 고려하여 계약담당공무원이 필요하다고 인정할 경우에는 공동계약의 유형별 구성원 수와 구성원별 계약참여 최소지분율을 각각 20% 범위내에서 가감할 수 있다.  <단서신설 2014. 1. 10., 개정 2024. 9. 13.><개정 2008. 11. 1., 2009. 4. 8.>\n가. 분담이행방식에 의한 경우 : 5인 이하\n나. 공동이행방식에 의한 경우 : 5인 이하, 10% 이상(단, 시행령 제6장 및 제8장에 따른 공사중 추정가격이 1,000억원 이상인 공사의 경우에는 10인 이하, 5% 이상)<개정 2009. 4. 8., 2012. 10. 26.>\n다. 주계약자관리방식에 의한 경우 : 10인 이하, 5% 이상","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P6","display_id":"공동계약운용요령-제9조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"제5항에도 불구하고 계약담당공무원은 시행령 제72조제3항에 따른 공동계약의 경우에 공사의 특성 등을 고려하여 지역업체의 최소지분율을 다음 각 호에 따라 정할 수 있으며, 이를 입찰공고에 명시하여야 한다.","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P6_I1","display_id":"공동계약운용요령-제9조-제6항-제1호","item_number":"1","content":"시행령 제72조제3항제1호에 따른 공동계약 : 30% 이상","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P6_I2","display_id":"공동계약운용요령-제9조-제6항-제2호","item_number":"2","content":"시행령 제72조제3항제2호에 따른 공동계약<개정 2020. 4. 7.>","subitems":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P6_I2_S1","display_id":"공동계약운용요령-제9조-제6항-제2호-가목","subitem_number":"가","content":"재정경제부 고시「국가를 당사자로 하는 계약에 관한 법률 시행령 제72조제3항제2호에 따른 공동계약 대상 사업」(이하  이 예규에서 \"고시\"라 한다) 제1호에 따른 사업: 40% 이상(단, 시행령 제6장 및 제8장에 따른 공사의 경우에는 20% 이상)"},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P6_I2_S2","display_id":"공동계약운용요령-제9조-제6항-제2호-나목","subitem_number":"나","content":"고시 제2호에 따른 사업: 20% 이상"}]}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_9_P7","display_id":"공동계약운용요령-제9조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"제6항제2호에 따른 공동수급체의 구성원이 되는 지역업체는 입찰공고일 현재 90일 이상 해당 공사현장을 관할하는 특별시ㆍ광역시 및 도에 법인등기부상 본점소재지가 소재한 업체이어야 한다.<개정 2018. 12. 31.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"3-4","amendments":["<개정 2009. 4. 8.>","<개정 2016. 12. 30.>","<신설 2009. 4. 8.>","<개정 2009. 4. 8., 2014. 1. 10.>","<단서신설 2014. 1. 10., 개정 2024. 9. 13.>","<개정 2008. 11. 1., 2009. 4. 8.>","<개정 2009. 4. 8., 2012. 10. 26.>","<개정 2020. 4. 7.>","<개정 2018. 12. 31.>"],"last_amended":"2024-09-13","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_21","CONSTRUCTION_INDUSTRY_BASIC_RULE_ART_23","STATE_CONTRACT_ENFORCEMENT_ART_72"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT","CONSTRUCTION_INDUSTRY_BASIC_RULE"],"external_references":[],"keywords":["공동계약","공동수급체","건설산업기본법","추정가격","입찰공고"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_10","display_id":"공동계약운용요령-제10조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"보증금의 납부","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_10_P0","display_id":"공동계약운용요령-제10조","paragraph_number":"","paragraph_index":null,"content":"공동수급체 구성원은 각종 보증금 납부시 공동수급협정서에서 정한 구성원의 출자비율 또는 분담내용에 따라 분할 납부하여야 한다. 다만, 공동이행방식 또는 주계약자관리방식에 의한 공동계약일 경우에는 공동수급체대표자 또는 공동수급체구성원중 1인으로 하여금 일괄 납부하게 할 수 있다.<개정 2009. 4. 8.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"4","amendments":["<개정 2009. 4. 8.>"],"last_amended":"2009-04-08","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_11","display_id":"공동계약운용요령-제11조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"대가지급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_11_P1","display_id":"공동계약운용요령-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 선금ㆍ대가 등을 지급함에 있어서는 공동수급체 구성원별로 구분 기재된 신청서를 공동수급체 대표자가 제출하도록 하여야 한다. 다만, 공동수급체 대표자가 부도, 파산 등의 부득이한 사유로 신청서를 제출할 수 없는 경우에는 공동수급체의 다른 모든 구성원의 연명으로 이를 제출하게 할 수 있다.","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_11_P2","display_id":"공동계약운용요령-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항에 의한 신청이 있을 경우에 신청된 금액을 공동수급체구성원 각자에게 지급하여야 한다. 다만, 선금은 주계약자관리방식에 의한 공동계약일 경우에는 제1항 단서의 경우를 제외하고는 공동수급체 대표자에게 지급하여야 한다.<개정 2009. 4. 8., 2010. 1. 4.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_11_P3","display_id":"공동계약운용요령-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기성대가는 공동수급체의 대표자 및 각 구성원의 이행내용에 따라 지급하여야 한다. 이 경우에 준공대가 지급시에는 구성원별 총 지급금액이 준공당시 공동수급체구성원의 출자비율 또는 분담내용과 일치하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"4-5","amendments":["<개정 2009. 4. 8., 2010. 1. 4.>"],"last_amended":"2010-01-04","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["대가지급","공동계약","공동수급체","선금"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_12","display_id":"공동계약운용요령-제12조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"공동도급내용의 변경","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_12_P1","display_id":"공동계약운용요령-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공동계약을 체결한 후 공동수급체구성원의 출자비율 또는 분담내용을 변경하게 할 수 없다. 다만, 시행령 제64조내지 제66조에 의한 계약내용의 변경이나 파산, 해산, 부도, 법정관리, 워크아웃(기업구조조정촉진법에 따라 채권단이 구조조정 대상으로 결정하여 구조조정중인 업체), 중도탈퇴의 사유로 인하여 당초 협정서의 내용대로 계약이행이 곤란한 구성원이 발생하여 공동수급체구성원 연명으로 출자비율 또는 분담내용의 변경을 요청한 경우와 제12조제4항의 경우에는 그러하지 아니하다.<개정 2014. 1.\n10.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_12_P2","display_id":"공동계약운용요령-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항 단서에 의하여 공동수급체 구성원의 출자비율 또는 분담내용의 변경을 승인함에 있어 구성원 각각의 출자지분 또는 분담내용 전부를 다른 구성원에게 이전하게 하여서는 아니된다. 다만, 주계약자 관리방식에서 공동수급체 구성원중 일부가 파산, 해산, 부도 등으로 계약을 이행할 수 없는 사유 등으로 공동수급체 구성원의 출자비율 또는 분담내용의 변경을 승인하는 경우에는 그러하지 아니하다. <단서신설 2014. 4. 1.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_12_P3","display_id":"공동계약운용요령-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 공동수급체 구성원을 추가하게 할 수 없다. 다만, 계약내용의 변경이나 공동수급체 구성원의 파산, 해산, 부도, 법정관리, 워크아웃(기업구조조정촉진법에 따라 채권단이 구조조정 대상으로 결정하여 구조조정중인  업체), 중도탈퇴의 사유로 인하여 잔존구성원만으로는 면허, 시공능력 및 실적 등 계약이행에 필요한 요건을 갖추지 못할 경우로서 공동수급체구성원 연명으로 구성원의 추가를 요청한 경우에는 그러하지 아니한다.<개정 2010. 9. 8., 2014. 1. 10., 2015. 1. 1.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_12_P4","display_id":"공동계약운용요령-제12조-제4항","paragraph_number":"④","paragraph_index":4,"content":"주계약자관리방식에서 주계약자는 구성원이 정당한 사유없이 계약을 이행하지 아니하거나 지체하여 이행하는 경우 또는 주계약자의 계획ㆍ관리 및 조정 등에 협조하지 않아 계약이행이 곤란하다고 판단되는 경우에는 구성원의 출자비율 또는 분담내용, 해당 구성원을 변경할 수 있다. 이 경우에 주계약자는 변경사유와 변경내용 등을 계약담당공무원에게 통보하여야 하며, 계약담당공무원은 주계약자의 변경내용이 계약의 원활한 이행을 저해하지 않는 한 승인해야 한다.<신설 2009. 4. 8.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"5","amendments":["<개정 2014. 1.\n10.>","<단서신설 2014. 4. 1.>","<개정 2010. 9. 8., 2014. 1. 10., 2015. 1. 1.>","<신설 2009. 4. 8.>"],"last_amended":"2015-01-01","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_64"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["공동수급체","공동계약","계약변경","계약의 이행"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13","display_id":"공동계약운용요령-제13조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"공동수급체 구성원의 제재","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P1","display_id":"공동계약운용요령-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공사 착공시까지 공동수급체 구성원별 출자비율 또는 분담내용에 따른 다음 각 호의 내용이 포함된 공동계약이행계획서(이하 \"계약이행계획서\"라 한다)를 제출하게 하여 승인을 받도록 하여야 한다.","items":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P1_I1","display_id":"공동계약운용요령-제13조-제1항-제1호","item_number":"1","content":"구성원별 이행부분 및 내역서(이행부분을 구분하지 아니하는 경우에는 제외)","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P1_I2","display_id":"공동계약운용요령-제13조-제1항-제2호","item_number":"2","content":"구성원별 투입 인원ㆍ장비 등 목록 및 투입시기","subitems":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P1_I3","display_id":"공동계약운용요령-제13조-제1항-제3호","item_number":"3","content":"그 밖의 발주기관이 요구하는 사항","subitems":[]}]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P2","display_id":"공동계약운용요령-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 공동수급체구성원이 연명으로 출자비율 또는 분담내용을 준수하는 범위내에서 제1항에 의한 계약이행계획서의 변경에 대한 승인을 요청하는 때에는 공사의 적정한 이행을 위하여 필요하다고 인정되는 경우에 한하여 이를 승인할 수 있다.","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P3","display_id":"공동계약운용요령-제13조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 주계약자관리방식에 의한 공동계약의 경우에 주계약자 이외의 공동수급체의 구성원 자신이 분담한 부분을 직접 시공하게 하여야 한다. 다만, 공동수급체 구성원이 종합건설업자인 경우에는 다른 법령이나 시공품질의 향상 및 현장사정 등 불가피한 사유가 있는 경우에는 주계약자와 합의하여 하도급을 승인할 수 있다.<신설 2009. 4. 8.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P4","display_id":"공동계약운용요령-제13조-제4항","paragraph_number":"④","paragraph_index":4,"content":"주계약자관리방식에 의한 경우로서 주계약자는 직접시공에는 참여하지 않더라도 시공관리, 품질관리, 하자관리, 공정관리, 안전관리, 환경관리 등 시공의 종합적인 계획ㆍ관리 및 조정에만 참여하는 경우에도 이를 계약이행 으로 본다.<신설 2009. 4. 8.>","items":[]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_13_P5","display_id":"공동계약운용요령-제13조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"각 중앙관서의 장은 공동수급체 구성원 중 정당한 이유없이 계약이행계획서에 따라 실제 계약이행에 참여하지 아니하는 구성원(단순히 자본참여만을 한 경우 등을 포함) 또는 출자비율 또는 분담내용과 다르게 시공하는 구성원 또는 주계약자관리방식에서 주계약자이외의 구성원이 발주기관의 사전서면 승인없이 직접 시공하지 않고 하도급한 경우에 법률 제27조제1항제3호 또는 시행령 제76조제2항제2호 가목에 의한 입찰참가자격제한조치를 하여야 한다.<개정 2009. 4. 8., 2018. 12. 31., 2025. 12. 31.>","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2026-01-02","source_file":"(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_path":"원문/규정/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","pdf_path":"pdf/(계약예규) 공동계약운용요령/(계약예규) 공동계약운용요령(재정경제부계약예규)(제29호)(20260102).pdf","source_page":"5-6","amendments":["<신설 2009. 4. 8.>","<개정 2009. 4. 8., 2018. 12. 31., 2025. 12. 31.>"],"last_amended":"2025-12-31","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_76"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["공동계약","공동수급체","계약의 이행","입찰참가자격","입찰참가자격 제한","하도급"]},{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_14","display_id":"공동계약운용요령-제14조","regulation_id":"JOINT_CONTRACT_OPERATION_RULE","regulation_name":"(계약예규) 공동계약운용요령","short_name":"공동계약운용요령","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"JOINT_CONTRACT_OPERATION_RULE_ART_14_P0","display_id":"공동계약운용요령-제14조","paragraph_number":"","paragraph_index":null,"content":"「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 이 예규에 대하여 2016년 1월 1일 기준으로 매3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.<개정 2015. 9. 21.>","i