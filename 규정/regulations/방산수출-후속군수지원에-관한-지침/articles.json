[{"id":"DAPA_A_2100000274622_ART_1","display_id":"방산수출-후속군수지원에-관한-지침-제1조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_1_P0","display_id":"방산수출-후속군수지원에-관한-지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「방위산업 발전 및 지원에 관한 법률」(이하 \"법\"이라 한다) 제15조제3항제1호, 동법시행령(이하 \"시행령\"이라 한다) 제20조 제3항, 「방산물자등의 정부간 판매에 관한 규정」 제7조의 방산물자등의 수출에 따른 후속군수지원 업무를 효율적으로 추진하기 위하여 필요한 절차 등을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_15"],"related_regulations":["DAPA_L_287981"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_2","display_id":"방산수출-후속군수지원에-관한-지침-제2조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_2_P0","display_id":"방산수출-후속군수지원에-관한-지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업청과 그 소속기관 및 출연기관에 적용한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_3","display_id":"방산수출-후속군수지원에-관한-지침-제3조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_3_P0","display_id":"방산수출-후속군수지원에-관한-지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용되는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000274622_ART_3_P0_I1","display_id":"방산수출-후속군수지원에-관한-지침-제3조-제1호","item_number":"1","content":"\"방산수출 후속군수지원\" 이라 함은 구매국 또는 수출업체의 요청에 따라 수출한 방위산업물자등(법 제2조제1항제1호에 따른 방위산업물자등을 말한다. 이하 \"방산물자등\"이라 한다)에 대한 운영유지를 위하여 정부차원에서 군수물자(관련 지원장비, 수리부속 포함), 군수시설, 군수인력, 운영제원 및 기술자료 등 군수지원요소를 지원하는 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274622_ART_3_P0_I2","display_id":"방산수출-후속군수지원에-관한-지침-제3조-제2호","item_number":"2","content":"\"수출업체\"라 함은 방산물자등을 수출(이하 \"방산수출\"이라 한다)하는 국내업체를 말한다.","subitems":[]},{"id":"DAPA_A_2100000274622_ART_3_P0_I3","display_id":"방산수출-후속군수지원에-관한-지침-제3조-제3호","item_number":"3","content":"\"수행기관\"이라 함은 시행령 제20조제3항에 따라 후속군수지원에 관한 조치요청을 받고 방산수출 후속군수지원 업무를 직접 수행하는 기관을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_2"],"related_regulations":["DAPA_L_287981"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_4","display_id":"방산수출-후속군수지원에-관한-지침-제4조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"목표 및 방침","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_4_P0","display_id":"방산수출-후속군수지원에-관한-지침-제4조","paragraph_number":"","paragraph_index":null,"content":"방산수출 후속군수지원의 목표 및 방침은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000274622_ART_4_P0_I1","display_id":"방산수출-후속군수지원에-관한-지침-제4조-제1호","item_number":"1","content":"목 표수출한 방산물자등이 방산수출 후속군수지원을 통하여 구매국에서 안정적으로 운용유지 되도록 함으로써 해외 방산시장에서의 신뢰제고 및 방산수출 증대를 목표로 한다","subitems":[]},{"id":"DAPA_A_2100000274622_ART_4_P0_I2","display_id":"방산수출-후속군수지원에-관한-지침-제4조-제2호","item_number":"2","content":"방 침가. 방위사업청(국제협력관)은 구매국 또는 수출업체가 방산수출 후속군수지원을 요청하는 경우에는 관계 행정기관과 후속군수지원 범위와 지원가능 여부를 협의하고, 그 결과에 따라 후속군수지원을 요청한다.나. 국제협력관은 방산수출후속군수지원에 대한 전반적인 업무를 관장하며, 방산수출에 따른 후속군수지원에 장애가 발생할 우려가 있는 경우(종합관리계획서의 미제출 또는 내용부실 등)에는 방위사업법 시행령 제68조에 따라 수출 제한 조치를 할 수 있다.","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_68"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_5","display_id":"방산수출-후속군수지원에-관한-지침-제5조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"업무분장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_5_P0","display_id":"방산수출-후속군수지원에-관한-지침-제5조","paragraph_number":"","paragraph_index":null,"content":"방위사업청 및 관련 기관 간 업무분장은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000274622_ART_5_P0_I1","display_id":"방산수출-후속군수지원에-관한-지침-제5조-제1호","item_number":"1","content":"국제협력관가. 방산수출 후속군수지원에 관한 정책 수립 및 시행 업무주관나. 구매국의 방산수출 후속군수지원 요구사항 식별, 수출 협상 및 계약 간 지원다. 방산수출 후속군수지원에 대하여 관계 행정기관에 지원요청 및 지원범위 협의라. 종합관리계획서를 관계 행정기관 및 업체와 협의하여 확정마. 수출업체 및 수행기관의 후속군수지원계획 이행활동 확인다. 방산수출 후속군수지원 업무에 대한 창구업무 및 사업관리 지원","subitems":[]},{"id":"DAPA_A_2100000274622_ART_5_P0_I2","display_id":"방산수출-후속군수지원에-관한-지침-제5조-제2호","item_number":"2","content":"사업관리본부(전력화지원관리팀, 통합사업관리팀, 표준자원관리팀)","subitems":[{"id":"DAPA_A_2100000274622_ART_5_P0_I2_S1","display_id":"방산수출-후속군수지원에-관한-지침-제5조-제2호-가목","subitem_number":"가","content":"방산수출 후속군수지원에 관련된 기술적인 사항 검토 및 지원나. 방산수출 후속군수지원 요소에 대한 형상변경시 기술지원다. 종합관리계획서의 실효성 검토라. 방산수출 후속군수지원에 관련된 계약 관련 사항 검토 및 지원마. 방산수출 후속군수지원 요소에 대한 형상변경시 표준화 업무지원"}]},{"id":"DAPA_A_2100000274622_ART_5_P0_I3","display_id":"방산수출-후속군수지원에-관한-지침-제5조-제3호","item_number":"3","content":"국과연 및 기품원가. 방산수출 후속군수지원에 관련된 기술지원나. 방산수출 후속군수지원 요소에 대한 형상변경시 기술지원","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_6","display_id":"방산수출-후속군수지원에-관한-지침-제6조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"방산수출 후속군수지원 요청 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_6_P1","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"수출협상간 구매국 정부로부터 정부차원의 후속군수지원을 요청받은 수출업체는 별표 1의 방산수출 후속군수지원 요청서 및 종합관리계획서(안)을 작성하여 방위사업청장(국제협력관)에게 제출한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_6_P2","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 구매국이 직접 방위사업청에 방산수출 후속군수지원을 요청한 때에는 해당 수출업체에 통보 하고 관련 절차에 따라 지원할 수 있도록 조치한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_6_P3","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"종합관리계획서(안)은 정당한 사유가 없는한 방산수출 계약 전에 제출하여야 하며, 다음 각 호의 사항을 포함하여야 한다.","items":[{"id":"DAPA_A_2100000274622_ART_6_P3_I1","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제3항-제1호","item_number":"1","content":"수출 개요 및 범위","subitems":[]},{"id":"DAPA_A_2100000274622_ART_6_P3_I2","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제3항-제2호","item_number":"2","content":"방산수출에 따른 후속군수지원 범위","subitems":[]},{"id":"DAPA_A_2100000274622_ART_6_P3_I3","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제3항-제3호","item_number":"3","content":"수출하는 방산물자등에 대한 수출업체의 후속군수지원계획(부품 단종대비계획 등을 포함한다)","subitems":[]},{"id":"DAPA_A_2100000274622_ART_6_P3_I4","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제3항-제4호","item_number":"4","content":"방위사업청 및 관계 행정기관에서 지원할 후속군수지원요소 및 개략적인 지원 시기","subitems":[]},{"id":"DAPA_A_2100000274622_ART_6_P3_I5","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제3항-제5호","item_number":"5","content":"방위사업청 및 관계 행정기관에서 지원할 후속군수지원요소의 유ㆍ무상 양도 또는 대여 등에 대한 구분 및 개략적인 상환방법","subitems":[]},{"id":"DAPA_A_2100000274622_ART_6_P3_I6","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제3항-제6호","item_number":"6","content":"기타 방산수출 후속군수지원을 위하여 필요한 사항","subitems":[]}]},{"id":"DAPA_A_2100000274622_ART_6_P4","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장(국제협력관)은 수출업체가 요청한 방산수출 후속군수지원 사항을 검토한 후 정부차원에서 지원해야할 후속군수지원요소에 대한 다음 각호의 사항에 대하여 관계 행정기관의 장에게 검토를 요청한다.","items":[{"id":"DAPA_A_2100000274622_ART_6_P4_I1","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제4항-제1호","item_number":"1","content":"지원가능 여부","subitems":[]},{"id":"DAPA_A_2100000274622_ART_6_P4_I2","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제4항-제2호","item_number":"2","content":"지원범위 및 기간","subitems":[]},{"id":"DAPA_A_2100000274622_ART_6_P4_I3","display_id":"방산수출-후속군수지원에-관한-지침-제6조-제4항-제3호","item_number":"3","content":"지원요소의 유ㆍ무상 대여 또는 양도 가능성 및 조건","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_7","display_id":"방산수출-후속군수지원에-관한-지침-제7조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"방산수출 후속군수지원 여부 결정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_7_P1","display_id":"방산수출-후속군수지원에-관한-지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"국제협력관(각 지역담당관)은 관계 행정기관이 검토하여 통보한 방산수출 후속군수지원 관련 사항을 종합적으로 검토한 후 수출업체로 하여금 종합관리계획서(안)을 수정 보완하도록 조치한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_7_P2","display_id":"방산수출-후속군수지원에-관한-지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"국제협력관(각 지역담당관)은 제1항에 의해 수정ㆍ보완된 종합관리계획서(안)을 수행기관의 관련 부서장 및 수출업체 대표와 함께 서명 날인하여 이를 확정하고 관계 행정기관 및 수출업체에 통보한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_7_P3","display_id":"방산수출-후속군수지원에-관한-지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"국제협력관(각 지역담당관)은 종합관리계획서 변경이 필요시 관계 행정기관 및 수출업체와 협의하여 종합관리계획서를 수정하도록 조치할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_8","display_id":"방산수출-후속군수지원에-관한-지침-제8조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"방산수출 후속군수지원 대한 수출협상 및 수출계약 지원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_8_P1","display_id":"방산수출-후속군수지원에-관한-지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장(국제협력관)은 구매국 또는 수출업체의 요청이 있을시 종합관리계획서에 근거하여 방산수출 후속군수지원의 방법 및 절차를 설명하는 등 협상 및 계약을 지원할 수 있다.","items":[]},{"id":"DAPA_A_2100000274622_ART_8_P2","display_id":"방산수출-후속군수지원에-관한-지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"수출업체는 종합관리계획서에 근거한 후속군수지원 사항을 구매국과의 계약서에 반영하며, 상호 협의하에 그 내용이 변경될 수도 있음을 명시한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_9","display_id":"방산수출-후속군수지원에-관한-지침-제9조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"수출계약 이후 방산수출 후속군수지원 이행 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_9_P1","display_id":"방산수출-후속군수지원에-관한-지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"수출업체가 수출계약 이후 종합관리계획서에 근거하여 수행기관으로부터 방산수출 후속군수지원을 받기 위해서는 별표2 양식에 따라 방산수출 후속군수지원요소 지원요청서를 작성하여 국제협력관(각 지역담당관)에게 제출한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_9_P2","display_id":"방산수출-후속군수지원에-관한-지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"국제협력관(각 지역담당관)은 1항에 따라 수출업체가 작성한 후속군수지원요소지원요청서를 검토하여 수행기관의 장에게 필요한 조치를 하여 줄 것을 요청한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_9_P3","display_id":"방산수출-후속군수지원에-관한-지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"수출업체는 수행기관과 후속군수지원 사안별로 방산수출 후속군수지원요소 지원에 대한 계약을 체결하고, 이에 근거하여 지원을 받는다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_10","display_id":"방산수출-후속군수지원에-관한-지침-제10조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"방산수출 후속군수지원에 투입된 지원요소 상환 및 비용정산","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_10_P1","display_id":"방산수출-후속군수지원에-관한-지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방산수출 후속군수지원 업무와 관련해 발생한 제비용은 법 제15조 제3항에 따라 요청자가 부담한다. 단, 관련 법령에 위배되지 않는 범위에서 방산수출 후속군수지원 계약에 의해 따로 정할 수 있다.","items":[]},{"id":"DAPA_A_2100000274622_ART_10_P2","display_id":"방산수출-후속군수지원에-관한-지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방산수출 후속군수지원 조치를 위하여 군수품이나 국유재산의 대여ㆍ양도ㆍ교환 등이 이루어질 경우 군수품관리법 및 동법 시행령ㆍ시행규칙, 방위사업법 및 동법시행령ㆍ시행규칙 등 관련 법령의 절차에 의한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_10_P3","display_id":"방산수출-후속군수지원에-관한-지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방산수출 후속군수지원요소별 상환 및 비용 정산은 관련 법령에 따라 체결된 방산수출 후속군수지원 계약서에 근거하여 수행한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_15"],"related_regulations":["DAPA_L_287981"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_11","display_id":"방산수출-후속군수지원에-관한-지침-제11조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"관리 및 시정 요청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_11_P1","display_id":"방산수출-후속군수지원에-관한-지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"국제협력관(각 지역담당관)은 제9조에 의거 방산수출에 따른 후속군수지원 업무의 전반적인 진행상황을 수시로 확인ㆍ점검한다.","items":[]},{"id":"DAPA_A_2100000274622_ART_11_P2","display_id":"방산수출-후속군수지원에-관한-지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"국제협력관(각 지역담당관)은 이행상황 확인 결과 방산수출에 따른 후속군수지원업무가 계획된 일정에 비해 지연되거나 차질이 발생하는 경우 청장의 승인을 얻어 수출업체 및 수행기관에 시정을 요청한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274622_ART_9"],"related_regulations":[],"external_references":[],"key