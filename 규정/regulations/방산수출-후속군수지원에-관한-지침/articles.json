d_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274622_ART_14","display_id":"방산수출-후속군수지원에-관한-지침-제14조","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_ART_14_P0","display_id":"방산수출-후속군수지원에-관한-지침-제14조","paragraph_number":"","paragraph_index":null,"content":"이 예규는 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2026년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방산수출 후속군수지원에 관한 지침.json","source_path":"원문/법제처API/방산수출 후속군수지원에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000274622_SUPP1_PRE","display_id":"방산수출-후속군수지원에-관한-지침-부칙1","regulation_id":"DAPA_A_2100000274622","regulation_name":"방산수출 후속군수지원에 관한 지침","short_name":"방산수출 후속군수지원에 관한 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274622_SUPP1_PRE_P1","display_id":"방산수출-후속군수지원에-관한-지침-부칙1-제1항","paragraph_number":"①","paragraph_index":1,"content":"(시행일)이 지침은 발령한 날부터 시행한다.② (적용특례) 구매국 및 수출업체가 이 지침에 의한 방법 및 절차 외에 별도의 방산수출 후속군수지원을 요청하는 경우 방위사업청 및 관계 행정기관은 관련 법령 및 정책과 상반되지 않는 범위내에서 이에 응해 방산수출 후속군수지원을 할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-0