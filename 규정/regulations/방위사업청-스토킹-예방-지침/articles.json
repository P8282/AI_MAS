","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_3","display_id":"방위사업청-스토킹-예방-지침-제3조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_3_P0","display_id":"방위사업청-스토킹-예방-지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 뜻은 다음과 같다.","items":[{"id":"DAPA_A_2100000240014_ART_3_P0_I1","display_id":"방위사업청-스토킹-예방-지침-제3조-제1호","item_number":"1","content":"\"스토킹\"이란 「스토킹방지 및 피해자보호 등에 관한 법률」 제2조제1호의 규정에 따라 「스토킹범죄의 처벌 등에 관한 법률」 제2조제1호에 따른 스토킹행위 및 같은 조 제2호에 따른 스토킹범죄를 말한다.","subitems":[]},{"id":"DAPA_A_2100000240014_ART_3_P0_I2","display_id":"방위사업청-스토킹-예방-지침-제3조-제2호","item_number":"2","content":"\"스토킹행위자\"란 스토킹을 한 사람을 말한다.","subitems":[]},{"id":"DAPA_A_2100000240014_ART_3_P0_I3","display_id":"방위사업청-스토킹-예방-지침-제3조-제3호","item_number":"3","content":"\"피해자\"란 스토킹으로 직접적인 피해를 입은 사람을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["스토킹방지 및 피해자보호 등에 관한 법률","스토킹범죄의 처벌 등에 관한 법률"],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_4","display_id":"방위사업청-스토킹-예방-지침-제4조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"스토킹 예방교육","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_4_P1","display_id":"방위사업청-스토킹-예방-지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 스토킹의 예방과 방지를 위하여 필요한 교육을 실시할 수 있고, 이를 위해 스토킹 예방교육의 시기ㆍ내용ㆍ방법 등에 관한 세부 실시계획을 수립할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_4_P2","display_id":"방위사업청-스토킹-예방-지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 스토킹 예방교육을 실시하는 경우 「가정폭력방지 및 피해자보호 등에 관한 법률」제4조의3에 따른 가정폭력 예방교육, 「성매매방지 및 피해자보호 등에 관한 법률」제5조에 따른 성매매 예방교육, 「성폭력방지 및 피해자보호 등에 관한 법률」 제5조에 따른 성교육 및 성폭력 예방교육, 「양성평등기본법」 제31조에 따른 성희롱 예방교육 등을 성평등 관점에서 통합하여 실시할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_4_P3","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"스토킹 예방교육은 다음 각 호의 내용을 포함해야 한다.","items":[{"id":"DAPA_A_2100000240014_ART_4_P3_I1","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항-제1호","item_number":"1","content":"스토킹 관련 법령 및 지침","subitems":[]},{"id":"DAPA_A_2100000240014_ART_4_P3_I2","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항-제2호","item_number":"2","content":"스토킹의 특성 및 징후, 사례","subitems":[]},{"id":"DAPA_A_2100000240014_ART_4_P3_I3","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항-제3호","item_number":"3","content":"스토킹 발생 시의 처리 절차 및 조치 기준","subitems":[]},{"id":"DAPA_A_2100000240014_ART_4_P3_I4","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항-제4호","item_number":"4","content":"스토킹 피해자에 대한 고충상담, 구제절차 및 보호조치","subitems":[]},{"id":"DAPA_A_2100000240014_ART_4_P3_I5","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항-제5호","item_number":"5","content":"스토킹행위자에 대한 징계 등 제재조치","subitems":[]},{"id":"DAPA_A_2100000240014_ART_4_P3_I6","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항-제6호","item_number":"6","content":"민원인, 고객 등 업무관련성 있는 제3자에 의한 스토킹 예방과 발생 시 대처 방안","subitems":[]},{"id":"DAPA_A_2100000240014_ART_4_P3_I7","display_id":"방위사업청-스토킹-예방-지침-제4조-제3항-제7호","item_number":"7","content":"기타 스토킹 예방에 관한 사항 등","subitems":[]}]},{"id":"DAPA_A_2100000240014_ART_4_P4","display_id":"방위사업청-스토킹-예방-지침-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 스토킹 예방교육의 내용을 구성원이 자유롭게 열람할 수 있는 장소나 인터넷 사이트에 항상 게시하거나 갖추어 두어 구성원에게 널리 알려야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["가정폭력방지 및 피해자보호 등에 관한 법률","성매매방지 및 피해자보호 등에 관한 법률","성폭력방지 및 피해자보호 등에 관한 법률","양성평등기본법"],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_5","display_id":"방위사업청-스토킹-예방-지침-제5조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"고충상담창구 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_5_P1","display_id":"방위사업청-스토킹-예방-지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"스토킹 예방을 위한 업무 처리를 위하여 기존의 성희롱ㆍ성폭력 고충상담창구(조직인사담당관)에 스토킹 고충상담창구(이하 \"고충상담창구\"라 한다) 및 고충처리업무담당자를 두고 조직 내외에 적극 알려 이를 인지할 수 있도록 한다. 이때 고충상담창구는 기존 성희롱ㆍ성폭력 고충상담창구와 통합 운영할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_5_P2","display_id":"방위사업청-스토킹-예방-지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 고충상담의 업무를 처리하기 위하여 스토킹 고충상담원(이하 \"고충상담원\"이라 한다)을 지정하여야 하며, 성희롱ㆍ성폭력 고충상담원 또는 직장 내 괴롭힘 상담원이 이를 겸할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_5_P3","display_id":"방위사업청-스토킹-예방-지침-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"고충상담창구의 업무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000240014_ART_5_P3_I1","display_id":"방위사업청-스토킹-예방-지침-제5조-제3항-제1호","item_number":"1","content":"스토킹 피해(2차 피해 포함)에 대한 상담","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P3_I2","display_id":"방위사업청-스토킹-예방-지침-제5조-제3항-제2호","item_number":"2","content":"스토킹 사건에 대한 고충의 접수 및 처리","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P3_I3","display_id":"방위사업청-스토킹-예방-지침-제5조-제3항-제3호","item_number":"3","content":"스토킹 피해자 보호조치의 검토 및 이를 시행하기 위한 부서 간 협조ㆍ조정에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P3_I4","display_id":"방위사업청-스토킹-예방-지침-제5조-제3항-제4호","item_number":"4","content":"스토킹 재발 방지 대책의 수립과 이행에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P3_I5","display_id":"방위사업청-스토킹-예방-지침-제5조-제3항-제5호","item_number":"5","content":"스토킹 고충 처리 절차 및 매뉴얼 마련에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P3_I6","display_id":"방위사업청-스토킹-예방-지침-제5조-제3항-제6호","item_number":"6","content":"스토킹 예방을 위한 교육ㆍ홍보 등 기타 스토킹 예방 업무","subitems":[]}]},{"id":"DAPA_A_2100000240014_ART_5_P4","display_id":"방위사업청-스토킹-예방-지침-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"고충상담원은 고충상담창구 내에 별지 제1호 서식의 고충접수 및 처리대장, 스토킹 고충처리절차 및 매뉴얼을 작성ㆍ비치하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_5_P5","display_id":"방위사업청-스토킹-예방-지침-제5조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"고충상담원은 피해자에게 기관의 스토킹 고충처리절차를 구체적으로 설명하여 피해자가 기관 내 고충처리절차를 충분히 이해하고 활용할 수 있도록 지원하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_5_P6","display_id":"방위사업청-스토킹-예방-지침-제5조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"고충상담원은 피해자가 요청한 제8조의 보호조치 이행을 점검하고 피해자 상담 후 결과를 방위사업청장에게 보고하는 등 피해를 최소화하기 위한 조치를 지원하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_5_P7","display_id":"방위사업청-스토킹-예방-지침-제5조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"고충상담원은 상담 과정에서 피해자에게 다음 각 호의 2차 피해를 주는 행위를 하여서는 아니 된다.","items":[{"id":"DAPA_A_2100000240014_ART_5_P7_I1","display_id":"방위사업청-스토킹-예방-지침-제5조-제7항-제1호","item_number":"1","content":"피해자를 비난하거나 위축시키는 등의 행위","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P7_I2","display_id":"방위사업청-스토킹-예방-지침-제5조-제7항-제2호","item_number":"2","content":"정당한 이유 없이 다음 각 목의 어느 하나에 해당하는 행위가. 피해자의 책임을 언급하는 등의 행위나. 피해자의 고충 접수의 의도를 의심하는 행위다. 피해자의 피해 사실을 인정하지 않으려는 예단을 가지거나 사소한 것으로 취급하는 행위라. 피해자의 과거 언행을 부적절하게 질문하는 행위마. 스토킹행위자를 옹호하거나 두둔하는 행위바. 비공식적으로 사건에 대해 언급하는 행위","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P7_I3","display_id":"방위사업청-스토킹-예방-지침-제5조-제7항-제3호","item_number":"3","content":"스토킹행위자를 동석시키는 행위","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P7_I4","display_id":"방위사업청-스토킹-예방-지침-제5조-제7항-제4호","item_number":"4","content":"목격자 회유 및 피해자 입장에서의 진술을 방해하는 행위","subitems":[]},{"id":"DAPA_A_2100000240014_ART_5_P7_I5","display_id":"방위사업청-스토킹-예방-지침-제5조-제7항-제5호","item_number":"5","content":"그 밖에 이에 준하는 2차 피해를 주는 행위","subitems":[]}]},{"id":"DAPA_A_2100000240014_ART_5_P8","display_id":"방위사업청-스토킹-예방-지침-제5조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"방위사업청장은 스토킹 피해 신고의 편의성을 위하여 사이버신고센터를 설치ㆍ운영할 수 있고, 이를 조직 구성원들에게 적극 알려 인지할 수 있도록 한다. 또한 사이버신고센터에 신고 된 사실이나 내용은 고충상담창구를 설치한 부서의 장(이하 \"고충상담부서장\"이라 한다), 고충처리업무담당자만 열람할 수 있도록 운영하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_5_P9","display_id":"방위사업청-스토킹-예방-지침-제5조-제9항","paragraph_number":"⑨","paragraph_index":9,"content":"스토킹 피해 사실을 인지하거나 피해자로부터 고충 상담을 받은 상급자(피해자의 업무 및 근로조건에 영향을 줄 수 있는 자)는 피해자에게 스토킹 고충처리절차를 충실하게 안내하여야 하고, 피해자의 의사에 반하지 않는 한 고충상담원에게 이를 알려야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000240014_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_6","display_id":"방위사업청-스토킹-예방-지침-제6조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"고충처리 업무의 지원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_6_P1","display_id":"방위사업청-스토킹-예방-지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 고충상담원의 스토킹 관련 상담 및 고충처리 업무 역량강화를 위해 외부 전문기관 교육수강을 적극 지원하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_6_P2","display_id":"방위사업청-스토킹-예방-지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 고충상담원이 고충처리 업무를 행할 때 공정하고 독립적으로 임할 수 있도록 보호하고 지원하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_6_P3","display_id":"방위사업청-스토킹-예방-지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 제5조 제3항의 고충상담창구의 업무를 지원하기 위해 외부 전문가를 선임할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_6_P4","display_id":"방위사업청-스토킹-예방-지침-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 스토킹 상담의 공신력과 전문성을 제고하기 위하여 제5조에 따른 고충상담창구 및 사이버신고센터의 업무를 외부전문기관에 위탁할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000240014_ART_5"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_7","display_id":"방위사업청-스토킹-예방-지침-제7조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"고충 상담 및 처리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_7_P1","display_id":"방위사업청-스토킹-예방-지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"스토킹과 관련하여 상담을 원하는 소속 구성원은 서면, 전화, 온라인 및 방문 등의 방법으로 고충상담원에게 상담을 신청할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_7_P2","display_id":"방위사업청-스토킹-예방-지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"상담을 접수받은 경우 고충상담원은 지체 없이 상담에 응하여야 하며, 조사신청 등 처리절차를 안내하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_7_P3","display_id":"방위사업청-스토킹-예방-지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"고충상담원은 상담을 진행하여 스토킹 피해 및 위험의 정황을 파악하고 피해자의 명시적인 의사에 반하지 않는 한 이를 방위사업청장에게 보고하여 제8조의 보호조치가 이루어지도록 해야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000240014_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_8","display_id":"방위사업청-스토킹-예방-지침-제8조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"피해자 보호조치 시행","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_8_P1","display_id":"방위사업청-스토킹-예방-지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 피해자의 안전한 업무환경을 위하여 근무 시간 및 장소의 변경, 배치전환 등의 적절한 보호조치를 시행할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_8_P2","display_id":"방위사업청-스토킹-예방-지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 직장 내에서 스토킹이 발생한 경우 스토킹행위자에게 피해자에 대한 접근금지, 피해자의 근무 장소 및 일정 파악 금지 등 준수할 사항을 고지하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_8_P3","display_id":"방위사업청-스토킹-예방-지침-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 제1항 및 제2항에 따른 보호조치의 원활한 시행을 위해 외부전문가의 자문을 구할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_8_P4","display_id":"방위사업청-스토킹-예방-지침-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항 및 제2항에 따른 보호조치는 스토킹행위자에 대한 징계 의결이 있기 전에도 피해자보호 필요성을 고려하여 실시할 수 있고, 이러한 경우에도 피해자의 의사를 고려하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_8_P5","display_id":"방위사업청-스토킹-예방-지침-제8조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제1항 및 제2항에 따른 보호조치는 스토킹이 사실이 아닌 것으로 판단된 경우에 종료할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_8_P6","display_id":"방위사업청-스토킹-예방-지침-제8조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"방위사업청장은 제1항 및 제2항에 따른 보호조치를 시행함에 있어 피해자의 신원, 피해 내용 등이 다른 사람에게 누설되지 않도록 해야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_8_P7","display_id":"방위사업청-스토킹-예방-지침-제8조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"방위사업청장은 기관 또는 단체 내에서 스토킹 사건이 발생한 사실을 직무상 알게 된 때에는 피해자의 명시적인 반대의견이 없으면 수사기관에 협조를 요청할 수 있다","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_9","display_id":"방위사업청-스토킹-예방-지침-제9조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"조사 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_9_P1","display_id":"방위사업청-스토킹-예방-지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"스토킹 고충에 대한 조사를 원하는 피해자(피해자의 대리인을 포함한다)는 서면 또는 정보통신 등의 방법으로 별지 제2호 서식의 스토킹 조사 신청서를 제출하여야 하며, 고충상담원은 지체 없이 조사 신청을 접수하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_9_P2","display_id":"방위사업청-스토킹-예방-지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"고충상담원은 제1항에 따른 신청서를 접수한 날로부터 신속하게 조사를 실시하여야 하며, 20일 이내에 조사를 완료하여야 한다. 다만, 특별한 사정이 있는 경우 10일의 범위 안에서 조사 기간을 연장할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_9_P3","display_id":"방위사업청-스토킹-예방-지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 제2항에 따른 조사 과정에서 피해자의 인격이나 명예가 손상되거나 사적인 비밀이 침해되지 아니하도록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_9_P4","display_id":"방위사업청-스토킹-예방-지침-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"공정하고 전문적인 조사를 위하여 조사 과정에 외부전문가 등을 참여시키거나 외부전문가의 자문을 얻을 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_9_P5","display_id":"방위사업청-스토킹-예방-지침-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"피해자가 조사받을 경우 피해자가 신청하면 조사에 지장을 줄 우려가 있는 등 부득이한 경우를 제외하고 신뢰관계인이 동석할 수 있도록 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_9_P6","display_id":"방위사업청-스토킹-예방-지침-제9조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"제1항의 규정에 따라 조사가 진행 중인 사안에 대해 피해자가 법령에 따라 다른 기관에서 조사 또는 처리를 원하거나, 명시적으로 사건조사에 반대하는 경우 조사를 중지할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_9_P7","display_id":"방위사업청-스토킹-예방-지침-제9조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"스토킹사건 조사 진행상황을 피해자에게 서면, 온라인, 전화 등 방법을 통해 알려주어야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_9_P8","display_id":"방위사업청-스토킹-예방-지침-제9조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"고충상담원은 해당 사안이 성희롱ㆍ성폭력이나 그 외 직장 내 괴롭힘 등과 복합된 사건의 경우에는 관련 사안 처리 담당 부서(조직인사담당관, 공직감사담당관)에 협조를 요청할 수 있고, 협조 요청을 받은 관련 부서는 정당한 이유 없이 이를 거절할 수 없다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_10","display_id":"방위사업청-스토킹-예방-지침-제10조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"조사결과의 보고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_10_P0","display_id":"방위사업청-스토킹-예방-지침-제10조","paragraph_number":"","paragraph_index":null,"content":"고충상담원은 스토킹 사안에 대한 조사를 완료한 즉시 그 결과를 방위사업청장에게 보고하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_11","display_id":"방위사업청-스토킹-예방-지침-제11조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"불리한 처우 금지 및 비밀유지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_11_P1","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 피해자, 신고자, 조력자, 대리인에 대하여 고충의 상담, 신고, 협력, 제8조에서 규정한 보호조치를 요구ㆍ신청했다는 것 등을 이유로 다음 각 호의 어느 하나에 해당하는 불리한 처우를 하여서는 아니 된다.","items":[{"id":"DAPA_A_2100000240014_ART_11_P1_I1","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제1호","item_number":"1","content":"파면, 해임, 해고, 그 밖에 신분상실에 해당하는 신분상 불이익 조치","subitems":[]},{"id":"DAPA_A_2100000240014_ART_11_P1_I2","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제2호","item_number":"2","content":"징계, 정직, 감봉, 강등, 승진 제한 등 부당한 인사조치","subitems":[]},{"id":"DAPA_A_2100000240014_ART_11_P1_I3","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제3호","item_number":"3","content":"전보, 전근, 직무 미부여, 직무 재배치, 그 밖에 본인의 의사에 반하는 인사조치","subitems":[]},{"id":"DAPA_A_2100000240014_ART_11_P1_I4","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제4호","item_number":"4","content":"성과평가 또는 동료평가 등에서 차별이나 그에 따른 임금 또는 상여금 등의 차별 지급","subitems":[]},{"id":"DAPA_A_2100000240014_ART_11_P1_I5","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제5호","item_number":"5","content":"직업능력 개발 및 향상을 위한 교육훈련 기회의 제한, 예산 또는 인력 등 가용자원의 제한 또는 제거, 보안정보 또는 비밀정보 사용의 정지 또는 취급자격의 취소, 그 밖에 근무조건 등에 부정적 영향을 미치는 차별 또는 조치","subitems":[]},{"id":"DAPA_A_2100000240014_ART_11_P1_I6","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제6호","item_number":"6","content":"주의 대상자 명단 작성 또는 그 명단의 공개, 집단 따돌림, 폭행 또는 폭언 등 정신적ㆍ신체적 손상을 가져오는 행위 또는 그 행위의 발생을 방치하는 행위","subitems":[]},{"id":"DAPA_A_2100000240014_ART_11_P1_I7","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제7호","item_number":"7","content":"직무에 대한 부당한 감사 또는 조사나 그 결과의 공개","subitems":[]},{"id":"DAPA_A_2100000240014_ART_11_P1_I8","display_id":"방위사업청-스토킹-예방-지침-제11조-제1항-제8호","item_number":"8","content":"그 밖에 피해자, 신고자, 조력자, 대리인의 의사에 반하는 불이익 조치","subitems":[]}]},{"id":"DAPA_A_2100000240014_ART_11_P2","display_id":"방위사업청-스토킹-예방-지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 소속 구성원들이 피해자에 대하여 스토킹 피해사실을 이유로 또는 제8조에서 규정한 보호조치를 요구ㆍ신청했다는 것 등을 이유로 집단 따돌림, 폭행 또는 폭언, 그 밖에 정신적ㆍ신체적 손상을 가져오는 행위로 인한 2차 피해(정보통신망을 이용한 행위로 인한 피해를 포함한다)를 주지 않도록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_11_P3","display_id":"방위사업청-스토킹-예방-지침-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장, 고충상담원 등 스토킹 고충과 관계된 사안을 직무상 알게 된 자는 사실관계 확인 및 사안처리, 피해자의 보호를 위해 필요한 경우를 제외하고는 동 사안 관계자의 신원은 물론 그 내용 등에 대하여 이를 다른 사람에게 누설하여서는 아니 된다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000240014_ART_8"],"related_regulations":[],"external_references":[],"keywords":["대리"]},{"id":"DAPA_A_2100000240014_ART_12","display_id":"방위사업청-스토킹-예방-지침-제12조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"고충심의위원회의 설치 및 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_12_P1","display_id":"방위사업청-스토킹-예방-지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"스토킹 사건을 심의하기 위하여 스토킹 고충심의위원회(이하 \"스토킹위원회\"라 한다)를 구성하되, 기존에 설치된 고충심의위원회(성희롱ㆍ성폭력 고충심의위원회, 직장 내 괴롭힘 고충심의위원회 등)와 통합 운영할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_12_P2","display_id":"방위사업청-스토킹-예방-지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"스토킹위원회 위원 구성은 위원장을 포함하여 최소 6인의 위원으로 구성하며, 제1항에 따라 기존 고충심의위원회와 통합 운영하는 경우에도 위원장을 포함하여 최소 6인의 위원으로 구성한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_12_P3","display_id":"방위사업청-스토킹-예방-지침-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장은 방위사업청장이 지명하는 자로 한다. 다만 제1항에 따라 스토킹위원회를 기존에 설치된 고충심의위원회와 통합 운영하는 경우에는 기존 고충심의위원회 규정에 따른다.","items":[]},{"id":"DAPA_A_2100000240014_ART_12_P4","display_id":"방위사업청-스토킹-예방-지침-제12조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제2항의 규정에 의하여 위원회를 구성함에 있어 위원은 남성 또는 여성의 비율이 전체 위원의 10분의 6을 초과하여서는 아니되며, 위원 중 2명 이상을 외부의 스토킹 관련 전문가(이하 \"외부위원\"이라 한다)로 위촉한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_12_P5","display_id":"방위사업청-스토킹-예방-지침-제12조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"위원회의 개최 등 위원회의 사무를 처리하기 위하여 간사 1인을 두되, 간사는 고충상담원으로 한다. 다만 제1항에 따라 스토킹위원회를 기존에 설치된 고충심의위원회와 통합 운영하는 경우에는 기존 고충심의위원회 규정에 따른다.","items":[]},{"id":"DAPA_A_2100000240014_ART_12_P6","display_id":"방위사업청-스토킹-예방-지침-제12조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"제4항 후단에도 불구하고 방위사업청장이 스토킹행위자로 지목된 경우에는 내부위원과 외부위원을 각각 동수로 구성하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_13","display_id":"방위사업청-스토킹-예방-지침-제13조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"고충심의위원회의 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_13_P1","display_id":"방위사업청-스토킹-예방-지침-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원회의 회의는 위원장이 소집한다. 다만, 방위사업청장이 스토킹행위자로 지목된 경우에는 사건 발생 사실을 안 날로부터 7일 이내에 회의를 개최하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_13_P2","display_id":"방위사업청-스토킹-예방-지침-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"사건의 당사자 또는 사건과 특수한 관계를 가진 자는 해당 심의ㆍ의결에서 제척된다. 사건 당사자는 특정 위원이 심의ㆍ의결의 공정성을 기대하기 어려운 사정이 있는 경우 위원회에 위원의 기피를 신청할 수 있고, 위원 본인도 직ㆍ간접적으로 이해관계가 있는 안건의 심의에 대해 회피할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_13_P3","display_id":"방위사업청-스토킹-예방-지침-제13조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장은 기피 신청을 받으면 기피 여부에 대한 결정을 한다. 이 경우 기피 신청의 대상이 된 위원에게서 그에 대한 의견을 받을 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_13_P4","display_id":"방위사업청-스토킹-예방-지침-제13조-제4항","paragraph_number":"④","paragraph_index":4,"content":"위원회는 다음 각 호에 관하여 심의한다. 다만, 방위사업청장이 스토킹행위자로 지목되었을 경우 제1호에 대해서는 심의하지 아니한다.","items":[{"id":"DAPA_A_2100000240014_ART_13_P4_I1","display_id":"방위사업청-스토킹-예방-지침-제13조-제4항-제1호","item_number":"1","content":"스토킹의 판단(2차 피해 포함)","subitems":[]},{"id":"DAPA_A_2100000240014_ART_13_P4_I2","display_id":"방위사업청-스토킹-예방-지침-제13조-제4항-제2호","item_number":"2","content":"가해행위 비위 정도 및 과실의 경중 판단","subitems":[]},{"id":"DAPA_A_2100000240014_ART_13_P4_I3","display_id":"방위사업청-스토킹-예방-지침-제13조-제4항-제3호","item_number":"3","content":"스토킹행위자 제재 조치(직위해제 등) 또는 필요 조치 요구","subitems":[]},{"id":"DAPA_A_2100000240014_ART_13_P4_I4","display_id":"방위사업청-스토킹-예방-지침-제13조-제4항-제4호","item_number":"4","content":"피해자 보호조치 및 지원 권고(2차 피해 방지를 위한 조치 포함)","subitems":[]},{"id":"DAPA_A_2100000240014_ART_13_P4_I5","display_id":"방위사업청-스토킹-예방-지침-제13조-제4항-제5호","item_number":"5","content":"그 밖에 스토킹의 재발 방지에 관한 사항","subitems":[]}]},{"id":"DAPA_A_2100000240014_ART_13_P5","display_id":"방위사업청-스토킹-예방-지침-제13조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"위원회의 심의는 재적위원 과반수 찬성으로 의결한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_13_P6","display_id":"방위사업청-스토킹-예방-지침-제13조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"위원회는 심의결과를 방위사업청장에게 보고하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_14","display_id":"방위사업청-스토킹-예방-지침-제14조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"조사 등 결과 통지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_14_P0","display_id":"방위사업청-스토킹-예방-지침-제14조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 당사자에게 별지 제3호의 서식에 따라 서면으로 사건 조사결과 및 위원회의 심의결과 등을 지체 없이 통지하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_15","display_id":"방위사업청-스토킹-예방-지침-제15조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"징계","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_15_P1","display_id":"방위사업청-스토킹-예방-지침-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 제13조에 따른 스토킹 고충심의위원회 결과에 따라 스토킹에 해당한다고 인정될 경우 스토킹행위자에 대하여 징계 등 제재절차가 이루어지도록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_15_P2","display_id":"방위사업청-스토킹-예방-지침-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 제1항에 따른 징계 등 제재 절차에서 피해자에게 의견진술 기회를 부여하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_15_P3","display_id":"방위사업청-스토킹-예방-지침-제15조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 스토킹 사건을 은폐하거나 피해자에게 2차 피해를 준 경우 관련자에 대하여 징계 등 조치를 하여야 한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_15_P4","display_id":"방위사업청-스토킹-예방-지침-제15조-제4항","paragraph_number":"④","paragraph_index":4,"content":"수사기관에서 수사 중인 사건의 경우 수사결과가 통보되기 전까지 징계 의결 요구나 그 밖의 징계 절차를 진행하지 아니할 수 있다. 다만 이 경우 스토킹 고충심의위원회 결과를 고려하여 스토킹행위자 직위해제 등 인사적인 제재 조치를 수행하거나, 피해자가 명시적으로 수사기관의 수사결과가 나오기 전 스토킹행위자에 대한 징계 절차 진행을 요구할 경우 징계 절차 진행 및 징계조치를 할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000240014_ART_13"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240014_ART_16","display_id":"방위사업청-스토킹-예방-지침-제16조","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"재발방지조치 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_ART_16_P1","display_id":"방위사업청-스토킹-예방-지침-제16조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 제9조에 따른 조사 및 제13조에 따른 스토킹 고충심의위원회 결과에 따라 스토킹 사건으로 인정된 경우, 스토킹의 재발 방지를 위하여 재발방지대책(2차 피해 방지를 포함한다.)을 수립ㆍ시행한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_16_P2","display_id":"방위사업청-스토킹-예방-지침-제16조-제2항","paragraph_number":"②","paragraph_index":2,"content":"재발방지대책에는 사건 처리경과 및 조치결과에 관한 사항, 스토킹 방지 조치 및 예방교육의 실시 등에 관한 사항, 피해자 또는 스토킹 사실을 신고한 사람에 대한 불이익조치 금지 및 보호조치 마련 등 2차 피해 방지에 관한 사항, 그 밖에 기관 내 스토킹 사건의 재발방지를 위하여 필요한 사항을 포함한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_16_P3","display_id":"방위사업청-스토킹-예방-지침-제16조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 제1항의 재발방지대책을 수립ㆍ시행하는 경우 스토킹이 성희롱ㆍ성폭력과 결합된 사건인 경우에는 「성폭력방지 및 피해자보호 등에 관한 법률」 제5조 또는 「양성평등기본법」 제31조에 따른 재발방지대책과 통합하여 수립ㆍ시행할 수 있다.③ 방위사업청장은 스토킹 방지를 위하여 필요하다고 인정되는 경우 특별 스토킹 예방교육, 스토킹의 실태 또는 인식에 대한 조사 등을 실시할 수 있다.","items":[]},{"id":"DAPA_A_2100000240014_ART_16_P4","display_id":"방위사업청-스토킹-예방-지침-제16조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 스토킹행위자에 대한 재발방지 교육을 실시한다.","items":[]},{"id":"DAPA_A_2100000240014_ART_16_P5","display_id":"방위사업청-스토킹-예방-지침-제16조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"방위사업청장 피해자에게 치료 및 상담 등 피해 복구를 위해 가능한 지원을 한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000240014_ART_9","DAPA_A_2100000240014_ART_13"],"related_regulations":[],"external_references":["성폭력방지 및 피해자보호 등에 관한 법률","양성평등기본법"],"keywords":[]},{"id":"DAPA_A_2100000240014_SUPP_PRE","display_id":"방위사업청-스토킹-예방-지침-부칙","regulation_id":"DAPA_A_2100000240014","regulation_name":"방위사업청 스토킹 예방 지침","short_name":"방위사업청 스토킹 예방 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240014_SUPP_PRE_P0","display_id":"방위사업청-스토킹-예방-지침-부칙","paragraph_number":"","paragraph_index":null,"content":"이 지침은 발령한 날부터 시행한다.","items":[]}],"notes":[],"effective_date":"2024-04-29","revision_date":"2024-04-29","source_file":"방위사업청 스토킹 예방 지침.json","source_path":"원문/법제처API/방위사업청 스토킹 예방 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제911호, 2024. 4. 29.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]}]
