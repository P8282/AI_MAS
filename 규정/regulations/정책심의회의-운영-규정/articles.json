egulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"심의안건","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_3_P0","display_id":"정책심의회의-운영-규정-제3조","paragraph_number":"","paragraph_index":null,"content":"정책심의회의는 다음 각 호의 사항을 심의한다.","items":[{"id":"DAPA_A_2100000240228_ART_3_P0_I1","display_id":"정책심의회의-운영-규정-제3조-제1호","item_number":"1","content":"방위사업 관련 정책, 법령 및 방위사업청 행정규칙의 수립ㆍ변경사항 중 대외적으로 파급효과를 미치는 주요사항","subitems":[]},{"id":"DAPA_A_2100000240228_ART_3_P0_I2","display_id":"정책심의회의-운영-규정-제3조-제2호","item_number":"2","content":"관계법령 및 방위사업청 행정규칙의 일반적인 제ㆍ개정사항 중 관련기관ㆍ부서 사이에 이견 조정이 필요한 사항","subitems":[]},{"id":"DAPA_A_2100000240228_ART_3_P0_I3","display_id":"정책심의회의-운영-규정-제3조-제3호","item_number":"3","content":"청장 또는 차장이 지시한 사항, 기타 회의에서 정책심의회의에 회부하도록 결정된 사항","subitems":[]}]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_4","display_id":"정책심의회의-운영-규정-제4조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_4_P1","display_id":"정책심의회의-운영-규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"의장은 차장이 된다.","items":[]},{"id":"DAPA_A_2100000240228_ART_4_P2","display_id":"정책심의회의-운영-규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원은 의장을 포함한 감사관, 기획조정관, 국제협력관, 방위사업정책국장, 방위산업진흥국장, 국방기술보호국장, 기반전력사업지원부장, 미래전력사업지원부장이 된다. 다만, 의장이 필요하다고 판단 시 위원을 추가할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_5","display_id":"정책심의회의-운영-규정-제5조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"배석","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_5_P1","display_id":"정책심의회의-운영-규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"의장은 안건과 관련된 국ㆍ부장 및 관련 팀(과)장을 배석시킬 수 있으며, 출연기관과 관련된 안건에 대해서는 국방과학연구소, 국방기술품질원의 관계관을 배석시킬 수 있다.","items":[]},{"id":"DAPA_A_2100000240228_ART_5_P2","display_id":"정책심의회의-운영-규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"의장은 안건의 법률적 자문을 위해 감독지원담당관 소속직원을 배석시킬 수 있고, 배석한 소속지원은 법률적 견해를 제시할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_6","display_id":"정책심의회의-운영-규정-제6조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"의장의 직무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_6_P0","display_id":"정책심의회의-운영-규정-제6조","paragraph_number":"","paragraph_index":null,"content":"의장은 회의를 주재하며, 그 사무를 총괄한다. 다만, 의장이 공무상 출장 또는 부득이한 사유로 직무를 수행할 수 없을 때에는 의장이 지명한 위원이 그 직무를 대행한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_7","display_id":"정책심의회의-운영-규정-제7조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"회의소집","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_7_P0","display_id":"정책심의회의-운영-규정-제7조","paragraph_number":"","paragraph_index":null,"content":"청장 또는 의장이 필요하다고 인정하는 때에 소집한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_8","display_id":"정책심의회의-운영-규정-제8조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"의사 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_8_P1","display_id":"정책심의회의-운영-규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"회의는 위원 과반수의 출석으로 개회하고, 출석위원 3분의 2이상의 찬성으로 의결한다.","items":[]},{"id":"DAPA_A_2100000240228_ART_8_P2","display_id":"정책심의회의-운영-규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원이 공무상 출장 또는 부득이한 사유로 회의에 참석할 수 없을 때에는 위원의 하위직급자인 대리자가 위원을 대리하여 출석 및 의결할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["대리"]},{"id":"DAPA_A_2100000240228_ART_9","display_id":"정책심의회의-운영-규정-제9조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"발언","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_9_P0","display_id":"정책심의회의-운영-규정-제9조","paragraph_number":"","paragraph_index":null,"content":"배석자와 간사는 의장의 지시가 있거나 승인을 얻어 발언할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_10","display_id":"정책심의회의-운영-규정-제10조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"보고자","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_10_P0","display_id":"정책심의회의-운영-규정-제10조","paragraph_number":"","paragraph_index":null,"content":"회의의제에 대한 제안 설명은 안건을 제기한 팀(과)장이 한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_11","display_id":"정책심의회의-운영-규정-제11조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"간사와 서기","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_11_P1","display_id":"정책심의회의-운영-규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"회의에 관한 사무를 처리하기 위하여 간사와 서기 각 1인을 둔다.","items":[]},{"id":"DAPA_A_2100000240228_ART_11_P2","display_id":"정책심의회의-운영-규정-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 정책조정담당관이 되며, 간사는 의장의 명을 받아 회의 시 제기된 의견을 [별지 제2호] 서식의 의사록에 기록하여 관리하는 등 회의의 사무를 처리한다.","items":[]},{"id":"DAPA_A_2100000240228_ART_11_P3","display_id":"정책심의회의-운영-규정-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"서기는 간사가 실무담당자 중에서 정하며, 서기는 간사를 보좌한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_12","display_id":"정책심의회의-운영-규정-제12조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"회의준비","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_12_P0","display_id":"정책심의회의-운영-규정-제12조","paragraph_number":"","paragraph_index":null,"content":"회의준비는 다음 각 호와 같이 한다.","items":[{"id":"DAPA_A_2100000240228_ART_12_P0_I1","display_id":"정책심의회의-운영-규정-제12조-제1호","item_number":"1","content":"안건 제기부서는 <삭제> 안건을 회의개최 10일전까지 간사에게 제출한다.","subitems":[]},{"id":"DAPA_A_2100000240228_ART_12_P0_I2","display_id":"정책심의회의-운영-규정-제12조-제2호","item_number":"2","content":"간사는 회의개최계획을 의장에게 보고하여 승인을 얻은 다음, 회의개최일 3일전까지 회의개최 계획을 위원 및 배석자에게 통보한다.","subitems":[]},{"id":"DAPA_A_2100000240228_ART_12_P0_I3","display_id":"정책심의회의-운영-규정-제12조-제3호","item_number":"3","content":"안건 제기부서는 의장에게 안건 선행 보고 후, 사전 배부가 곤란하거나 부적절하다고 의장이 승인하는 경우를 제외하고는 위원 및 배석자에게 안건을 사전 배부한다.","subitems":[]},{"id":"DAPA_A_2100000240228_ART_12_P0_I4","display_id":"정책심의회의-운영-규정-제12조-제4호","item_number":"4","content":"안건에 비밀관련 사항이 포함된 경우 안건제기부서는 안건을 비문으로 생산하여 회의 개최 이전에 의장에게 선행보고하고, 필요시 위원에게는 회의개최 3일 이전에 대면 보고 후 회수하여 회의시 재배부한다. 이 경우 회의안건은 회의 종료 후 회수한다.","subitems":[]}]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_13","display_id":"정책심의회의-운영-규정-제13조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"의결서","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_13_P0","display_id":"정책심의회의-운영-규정-제13조","paragraph_number":"","paragraph_index":null,"content":"위원은 [별지 제3호] 서식의 의결서에 찬반 여부(동의 또는 부동의)와 의견을 자필로 기록한 후 서명하여야 한다. 다만 영상회의에 의할 경우에는 자필서명을 영상회의에서 말로 한 동의로 대체할 수 있으며, 간사는 이를 [별지 제2호] 서식의 의사록에 기록한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_14","display_id":"정책심의회의-운영-규정-제14조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"의사록","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_14_P0","display_id":"정책심의회의-운영-규정-제14조","paragraph_number":"","paragraph_index":null,"content":"간사는 회의시 제시된 의견을 [별지 제2호] 서식의 의사록에 기록하여 비치한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_15","display_id":"정책심의회의-운영-규정-제15조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"후속조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_15_P0","display_id":"정책심의회의-운영-규정-제15조","paragraph_number":"","paragraph_index":null,"content":"간사는 의결서 사본 등 회의결과를 첨부하여 청장의 결재를 받아야 하며, 결재를 받은 문서를 안건제기부서의 장에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_16","display_id":"정책심의회의-운영-규정-제16조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"자료의 보존","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_16_P0","display_id":"정책심의회의-운영-규정-제16조","paragraph_number":"","paragraph_index":null,"content":"안건 제기부서는 공공기관의 기록물관리에 관한 법률 등 관련법령에 따라 심의안건, 심의결과, 의결서, 의사록 등 회의관련 자료를 보존하여야 하며, 기획조정관은 의사록을 연도별, 회의 횟수별로 보존한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_17","display_id":"정책심의회의-운영-규정-제17조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"정책실무회의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_17_P1","display_id":"정책심의회의-운영-규정-제17조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기획조정관은 정책심의회의 안건에 대해 부서간 이견이 있는 경우 등 사전 실무적인 토의가 필요하다고 인정하는 경우 관련부서ㆍ기관이 참여하는 정책실무회의를 구성ㆍ운영할 수 있다.","items":[]},{"id":"DAPA_A_2100000240228_ART_17_P2","display_id":"정책심의회의-운영-규정-제17조-제2항","paragraph_number":"②","paragraph_index":2,"content":"정책실무회의 의장은 안건을 관장하는 당해 기획조정관으로 하고, 위원 및 배석인원 등 정책실무회의 운영과 관련된 사항은 기획조정관이 정한다.","items":[]}],"notes":[],"effective_date":"2024-04-30","revision_date":"2024-04-30","source_file":"정책심의회의 운영 규정.json","source_path":"원문/법제처API/정책심의회의 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000240228_ART_18","display_id":"정책심의회의-운영-규정-제18조","regulation_id":"DAPA_A_2100000240228","regulation_name":"정책심의회의 운영 규정","short_name":"정책심의회의 운영 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000240228_ART_18_P0","display_id":"정책심의회의-운영-규정-제18조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 훈령에 대하여「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2024년 4월 30일 기준으로 매 3년이 되는 시점(매 3년째의 4월 29일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 