[{"id":"DAPA_A_2100000274634_ART_1","display_id":"원가회계심의위원회-운영-지침-제1조","regulation_id":"DAPA_A_2100000274634","regulation_name":"원가회계심의위원회 운영 지침","short_name":"원가회계심의위원회 운영 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274634_ART_1_P0","display_id":"원가회계심의위원회-운영-지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「군수품조달관리규정」 제159조에 따라 원가회계심의위원회의 설치 및 운영에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"원가회계심의위원회 운영 지침.json","source_path":"원문/법제처API/원가회계심의위원회 운영 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE_ART_159"],"related_regulations":["DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274634_ART_2","display_id":"원가회계심의위원회-운영-지침-제2조","regulation_id":"DAPA_A_2100000274634","regulation_name":"원가회계심의위원회 운영 지침","short_name":"원가회계심의위원회 운영 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274634_ART_2_P1","display_id":"원가회계심의위원회-운영-지침-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"원가회계심의위원회(이하 \"심의위원회\"라 한다)는 위원장을 포함하여 9명(위원장 1명, 상임위원 4명, 비상임위원 4명)의 위원과 1명의 간사로 구성한다.","items":[]},{"id":"DAPA_A_2100000274634_ART_2_P2","display_id":"원가회계심의위원회-운영-지침-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심의위원회 구성원은 아래 각호와 같다.","items":[{"id":"DAPA_A_2100000274634_ART_2_P2_I1","display_id":"원가회계심의위원회-운영-지침-제2조-제2항-제1호","item_number":"1","content":"위원장 : 방위산업진흥국장","subitems":[]},{"id":"DAPA_A_2100000274634_ART_2_P2_I2","display_id":"원가회계심의위원회-운영-지침-제2조-제2항-제2호","item_number":"2","content":"상임위원 : 감독지원담당관, 계약제도발전과장, 운영지원과장(재무팀장), 원가관리과장(안건제기부서인 경우 방위산업진흥국 직제순에 따라 참석)","subitems":[]},{"id":"DAPA_A_2100000274634_ART_2_P2_I3","display_id":"원가회계심의위원회-운영-지침-제2조-제2항-제3호","item_number":"3","content":"비상임 내부위원 : 안건관련 계약팀장","subitems":[]},{"id":"DAPA_A_2100000274634_ART_2_P2_I4","display_id":"원가회계심의위원회-운영-지침-제2조-제2항-제4호","item_number":"4","content":"비상임 외부위원 : 원가관리자문단의 자문위원 및「계약심의위원회 운영규정」에 따른 계약심의회 외부위원 중에서 위원장이 위촉한 자로 하며, 임기는 2년으로 하되 1회 연임할 수 있다.","subitems":[]},{"id":"DAPA_A_2100000274634_ART_2_P2_I5","display_id":"원가회계심의위원회-운영-지침-제2조-제2항-제5호","item_number":"5","content":"간사 : 원가관리과 소속직원 중에서 위원장이 지명한 자","subitems":[]}]},{"id":"DAPA_A_2100000274634_ART_2_P3","display_id":"원가회계심의위원회-운영-지침-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장은 심의위원회 소집일 3일전까지 비상임 내부위원 1명과 비상임 외부위원 3명을 선정하되, 비상임 외부위원은 회계분야와 법률분야 위원이 각 1명 이상 포함되도록 한다. 다만, 비상임 내부위원 중 안건제기부서 팀ㆍ과장을, 비상임 외부위원 중 본인 또는 본인이 소속한 회계법인이나 법무법인 등이 심의안건과 관련된 업체의 용역ㆍ자문 또는 그 밖의 방법으로 직접 관여하거나 심의안건과 직접적인 이해관계가 있다고 인정되는 위원은 제외한다.","items":[]},{"id":"DAPA_A_2100000274634_ART_2_P4","display_id":"원가회계심의위원회-운영-지침-제2조-제4항","paragraph_number":"④","paragraph_index":4,"content":"비상임 외부위원의 심사사안에 대한 제척 및 회피는 「방위사업청 내 위원회의 투명한 운영에 관한 규정」제 6조(위원의 제척ㆍ회피)를 따른다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"원가회계심의위원회 운영 지침.json","source_path":"원문/법제처API/원가회계심의위원회 운영 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000216972_ART_6"],"related_regulations":["DAPA_A_2100000216972"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274634_ART_3","display_id":"원가회계심의위원회-운영-지침-제3조","regulation_id":"DAPA_A_2100000274634","regulation_name":"원가회계심의위원회 운영 지침","short_name":"원가회계심의위원회 운영 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"기능","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274634_ART_3_P0","display_id":"원가회계심의위원회-운영-지침-제3조","paragraph_number":"","paragraph_index":null,"content":"심의위원회는 「군수품조달관리규정」 제159조 제2항에 따라 다음 각 호의 사항을 심의ㆍ조정한다.","items":[{"id":"DAPA_A_2100000274634_ART_3_P0_I1","display_id":"원가회계심의위원회-운영-지침-제3조-제1호","item_number":"1","content":"부당이득금 및 가산금(업체에서 환수 금액에 동의한 경우에는 제외한다)","subitems":[]},{"id":"DAPA_A_2100000274634_ART_3_P0_I2","display_id":"원가회계심의위원회-운영-지침-제3조-제2호","item_number":"2","content":"주계약업체 및 협력업체에 대한 원가부정행위 해당 여부. 이 경우 협력업체의 행위가 원가부정행위에 해당하는 경우에는 주계약업체가 이를 알았거나 중대한 과실로 알지 못했는지 여부를 추가로 심의ㆍ조정하며, 주계약업체가 협력업체의 원가부정행위를 알았거나 중대한 과실로 알지 못했다고 심의ㆍ조정하면 협력업체 원가부정에 대해 계약상대자의 직접책임이 있는 것으로 보며, 중대한 과실이 아닌 사유로 알지 못하였다면 계약상대자의 직접책임이 없는 것으로 본다.","subitems":[]},{"id":"DAPA_A_2100000274634_ART_3_P0_I3","display_id":"원가회계심의위원회-운영-지침-제3조-제3호","item_number":"3","content":"기타 원가회계업무 관련하여 원가회계심의위원회 위원장이 심의가 필요하다고 인정한 사항","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"원가회계심의위원회 운영 지침.json","source_path":"원문/법제처API/원가회계심의위원회 운영 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE_ART_159"],"related_regulations":["DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE"],"external_references":[],"keywords":["계약상대자"]},{"id":"DAPA_A_2100000274634_ART_4","display_id":"원가회계심의위원회-운영-지침-제4조","regulation_id":"DAPA_A_2100000274634","regulation_name":"원가회계심의위원회 운영 지침","short_name":"원가회계심의위원회 운영 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"직무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274634_ART_4_P1","display_id":"원가회계심의위원회-운영-지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원장은 심의위원회를 대표하며, 그 사무를 총괄한다.","items":[]},{"id":"DAPA_A_2100000274634_ART_4_P2","display_id":"원가회계심의위원회-운영-지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원장이 부득이한 사유로 직무를 수행할 수 없을 경우에는 방위산업진흥국장 직무대리가 그 직무를 대행한다.","items":[]},{"id":"DAPA_A_2100000274634_ART_4_P3","display_id":"원가회계심의위원회-운영-지침-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원은 심의위원회의 상정된 안건에 대한 의결권을 가진다.","items":[]},{"id":"DAPA_A_2100000274634_ART_4_P4","display_id":"원가회계심의위원회-운영-지침-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"위원에게 사고가 발생하여 직무대리규정에 따른 직무대리자가 위원의 직무를 대리하고자 할 때에는, 심의위원회 소집일 1일전까지 원가관리과장에게 통보하여 위원장의 승인을 받아야 한다.","items":[]},{"id":"DAPA_A_2100000274634_ART_4_P5","display_id":"원가회계심의위원회-운영-지침-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"간사는 안건을 종합하여 이를 심의위원회에 상정하고 심의결과 통보 등 필요한 조치를 취한다.","items":[]},{"id":"DAPA_A_2100000274634_ART_4_P6","display_id":"원가회계심의위원회-운영-지침-제4조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"제3조 각 호에서 규정한 심의ㆍ조정할 사항을 제기한 부서(이하 ‘안건제기부서’라 한다.)는 상정할 안건을 작성하고, 필요시 위원에게 사전설명하며, 심의위원회에서 당일 안건을 보고한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"원가회계심의위원회 운영 지침.json","source_path":"원문/법제처API/원가회계심의위원회 운영 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274634_ART_3"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274634_ART_5","display_id":"원가회계심의위원회-운영-지침-제5조","regulation_id":"DAPA_A_2100000274634","regulation_name":"원가회계심의위원회 운영 지침","short_name":"원가회계심의위원회 운영 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274634_ART_5_P1","display_id":"원가회계심의위원회-운영-지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"안건제기부서는 심의위원회 소집 희망일 1주 전까지 심의안건에 대한 다음 각 호의 내용을 작성하여 간사에게 심의위원회 소집을 요청하면, 간사는 위원장에게 심의위원회 소집을 건의한다.","items":[{"id":"DAPA_A_2100000274634_ART_5_P1_I1","display_id":"원가회계심의위원회-운영-지침-제5조-제1항-제1호","item_number":"1","content":"심의안건 상정 사유","subitems":[]},{"id":"DAPA_A_2100000274634_ART_5_P1_I2","display_id":"원가회계심의위원회-운영-지침-제5조-제1항-제2호","item_number":"2","content":"주요 내용","subitems":[]},{"id":"DAPA_A_2100000274634_ART_5_P1_I3","display_id":"원가회계심의위원회-운영-지침-제5조-제1항-제3호","item_number":"3","content":"심의ㆍ조정사항","subitems":[]},{"id":"DAPA_A_2100000274634_ART_5_P1_I4","display_id":"원가회계심의위원회-운영-지침-제5조-제1항-제4호","item_number":"4","content":"심의위원회 소집 희망일","subitems":[]},{"id":"DAPA_A_2100000274634_ART_5_P1_I5","display_id":"원가회계심의위원회-운영-지침-제5조-제1항-제5호","item_number":"5","content":"심의위원 및 배석자 선정 건의","subitems":[]},{"id":"DAPA_A_2100000274634_ART_5_P1_I6","display_id":"원가회계심의위원회-운영-지침-제5조-제1항-제6호","item_number":"6","content":"심의안건의 공개/비공개 여부","subitems":[]},{"id":"DAPA_A_2100000274634_ART_5_P1_I7","display_id":"원가회계심의위원회-운영-지침-제5조-제1항-제7호","item_number":"7","content":"기타 필요한 사항","subitems":[]}]},{"id":"DAPA_A_2100000274634_ART_5_P2","display_id":"원가회계심의위원회-운영-지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 위원장의 명을 받아 각 위원에게 소집을 통보하며, 심의안건은 소집일 당일 배포를 원칙으로 한다. 단, 위원장이 필요하다고 판단하는 경우 심의위원회 소집일 3일전까지 심의안건을 배포할 수 있다.","items":[]},{"id":"DAPA_A_2100000274634_ART_5_P3","display_id":"원가회계심의위원회-운영-지침-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항 단서의 경우 안건제기부서는 외부위원을 방문하여 심의안건에 관해 직접 설명할 수 있다.","items":[]},{"id":"DAPA_A_2100000274634_ART_5_P4","display_id":"원가회계심의위원회-운영-지침-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"심의위원회는 상정된 안건에 대하여 위원 과반수 이상의 출석과 출석위원 과반수 이상의 찬성으로 의결한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"원가회계심의위원회 운영 지침.json","source_path":"원문/법제처API/원가회계심의위원회 운영 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274634_ART_6","display_id":"원가회계심의위원회-운영-지침-제6조","regulation_id":"DAPA_A_2100000274634","regulation_name":"원가회계심의위원회 운영 지침","short_name":"원가회계심의위원회 운영 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"의견청취","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274634_ART_6_P1","display_id":"원가회계심의위원회-운영-지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심의위원회는 안건을 심의하는 경우 해당 업체에게 서면으로 의견을 제출하거나 심의위원회에 출석하여 진술하게 할 수 있다.","items":[]},{"id":"DAPA_A_2100000274634_ART_6_P2","display_id":"원가회계심의위원회-운영-지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전항에 따라 해당 업체가 심의위원회에 출석하여 진술하게 되는 경우에는, 위원장이 그 참석 및 진술 시기를 결정한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"원가회계심의위원회 운영 지침.json","source_path":"원문/법제처API/원가회계심의위원회 운영 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274634_ART_7","display_id":"원가회계심의위원회-운영-지침-제7조","regulation_id":"DAPA_A_2100000274634","regulation_name":"원가회계심의위원회 운영 지침","short_name":"원가회계심의위원회 운영 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"회의록 유지ㆍ관리 및 회의결과 조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_n