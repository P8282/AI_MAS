:[]},{"id":"DAPA_A_2100000216969_ART_3","display_id":"민군규격-표준화-업무지침-제3조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_3_P0","display_id":"민군규격-표준화-업무지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000216969_ART_3_P0_I1","display_id":"민군규격-표준화-업무지침-제3조-제1호","item_number":"1","content":"\"민ㆍ군규격표준화사업\"이라 함은 민수규격과 국방규격을 통일화 및 표준화 하는 사업을 말한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_3_P0_I2","display_id":"민군규격-표준화-업무지침-제3조-제2호","item_number":"2","content":"\"관계중앙행정기관\"이라 함은 방위사업청, 국방부, 산업통상자원부 및 대통령이 정하는 중앙행정기관을 말한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_3_P0_I3","display_id":"민군규격-표준화-업무지침-제3조-제3호","item_number":"3","content":"\"연구과제\"라 함은 민ㆍ군규격표준화사업을 위해 민ㆍ군기술협력사업 예산으로 추진하는 연구 과제를 말한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_3_P0_I4","display_id":"민군규격-표준화-업무지침-제3조-제4호","item_number":"4","content":"\"민ㆍ군규격실무위원회\"라 함은 민ㆍ군규격표준화사업의 중요한 사항을 심의, 조정하기 위한 위원회를 말한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_3_P0_I5","display_id":"민군규격-표준화-업무지침-제3조-제5호","item_number":"5","content":"\"전문위원회\"라 함은 연구과제 수행과 관련한 중요한 사항을 심의 결정하기 위한 실무위원회를 말한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_3_P0_I6","display_id":"민군규격-표준화-업무지침-제3조-제6호","item_number":"6","content":"\"표준규격\"이라 함은 민ㆍ군규격 표준화 사업에서 도출된 규격 또는 국방표준서를 의미한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_4","display_id":"민군규격-표준화-업무지침-제4조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"업무분장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_4_P0","display_id":"민군규격-표준화-업무지침-제4조","paragraph_number":"","paragraph_index":null,"content":"민ㆍ군규격표준화사업을 추진하기 위한 업무분장은 다음과 같다.","items":[{"id":"DAPA_A_2100000216969_ART_4_P0_I1","display_id":"민군규격-표준화-업무지침-제4조-제1호","item_number":"1","content":"방위사업청(방위사업정책국 표준기획과)","subitems":[{"id":"DAPA_A_2100000216969_ART_4_P0_I1_S1","display_id":"민군규격-표준화-업무지침-제4조-제1호-가목","subitem_number":"가","content":"민ㆍ군규격표준화사업 주관나. 민ㆍ군규격표준화사업 관련 제도 발전다. 민ㆍ군규격표준화 기본계획 및 시행계획 종합ㆍ수립라. 민ㆍ군규격표준화사업 관련 기관간 업무 조정ㆍ통제마. 민ㆍ군규격표준화사업 추진실적 종합ㆍ평가바. 민ㆍ군규격실무위원회 운영"}]},{"id":"DAPA_A_2100000216969_ART_4_P0_I2","display_id":"민군규격-표준화-업무지침-제4조-제2호","item_number":"2","content":"방위사업청(기반전력사업본부 및 미래전력사업본부 내 표준자원관리팀ㆍ통합사업관리팀), 각 군 및 국과연가. 관리대상 규격에 대한 민ㆍ군규격표준화사업 수행 및 연구결과 후속조치나. 민ㆍ군규격표준화 기본계획 및 시행계획 작성(기반전력사업본부 및 미래전력사업본부 제외)다. 민ㆍ군규격표준화 대상규격 발굴, 민수규격 전환라. 민ㆍ군규격표준화 추진실적 작성 통보마. 민ㆍ군규격표준화와 관련된 기술적 사항의 협조(국과연)","subitems":[]},{"id":"DAPA_A_2100000216969_ART_4_P0_I3","display_id":"민군규격-표준화-업무지침-제4조-제3호","item_number":"3","content":"국방기술품질원(민ㆍ군규격표준화사업 전문기관)","subitems":[{"id":"DAPA_A_2100000216969_ART_4_P0_I3_S1","display_id":"민군규격-표준화-업무지침-제4조-제3호-가목","subitem_number":"가","content":"관리대상 규격에 대한 민ㆍ군규격표준화사업 수행 및 연구결과 후속조치나. 민ㆍ군규격표준화 기본계획 및 시행계획 작성다. 민ㆍ군규격표준화 대상규격 발굴, 민수규격 전환라. 민ㆍ군규격표준화 추진실적 작성 통보마. 민ㆍ군규격표준화 연구과제 수행 및 관련된 평가, 심의 활동, 연구결과 후속조치 지원 등바. 민ㆍ군규격표준화와 관련된 기술적 사항의 협조사. 전문위원회 운영"}]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_5","display_id":"민군규격-표준화-업무지침-제5조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"기본방침","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_5_P0","display_id":"민군규격-표준화-업무지침-제5조","paragraph_number":"","paragraph_index":null,"content":"민ㆍ군규격표준화 사업추진 기본방침은 다음과 같다.","items":[{"id":"DAPA_A_2100000216969_ART_5_P0_I1","display_id":"민군규격-표준화-업무지침-제5조-제1호","item_number":"1","content":"방위사업청 기반전력사업본부 및 미래전력사업본부 (표준자원관리팀), 방위사업청 기반전력사업본부 및 미래전력사업본부(각 통합사업관리팀), 각 군, 국과연, 기품원은(이하 \"사업수행기관\"이라 한다) 관리 대상규격에 대한 민ㆍ군규격표준화 업무를 수행한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_5_P0_I2","display_id":"민군규격-표준화-업무지침-제5조-제2호","item_number":"2","content":"민ㆍ군규격표준화를 위하여 다음 각 목의 원칙을 준수한다.","subitems":[{"id":"DAPA_A_2100000216969_ART_5_P0_I2_S1","display_id":"민군규격-표준화-업무지침-제5조-제2호-가목","subitem_number":"가","content":"민ㆍ군 겸용성 품목은 국방규격의 제정을 지양한다."},{"id":"DAPA_A_2100000216969_ART_5_P0_I2_S2","display_id":"민군규격-표준화-업무지침-제5조-제2호-나목","subitem_number":"나","content":"국방규격 중 민ㆍ군 겸용성 품목은 민수규격으로 전환한다."},{"id":"DAPA_A_2100000216969_ART_5_P0_I2_S3","display_id":"민군규격-표준화-업무지침-제5조-제2호-다목","subitem_number":"다","content":"불합리하거나 과도한 군 요구는 현실화하고, 가치를 상승시키지 않는 군 고유의 요구사항은 배제한다."},{"id":"DAPA_A_2100000216969_ART_5_P0_I2_S4","display_id":"민군규격-표준화-업무지침-제5조-제2호-라목","subitem_number":"라","content":"규격 작성 시는 가능한 성능형 규격으로 하는 것을 원칙으로 하며, 제작 도면은 최소화하여 상용품으로 전환을 촉진시키도록 한다.마.연구과제 결과에 따른 민ㆍ군규격 표준화(안)이 기준, 방법, 절차에 해당하는 경우 국방표준서로 제정한다."}]},{"id":"DAPA_A_2100000216969_ART_5_P0_I3","display_id":"민군규격-표준화-업무지침-제5조-제3호","item_number":"3","content":"민ㆍ군규격표준화 업무구분은 다음 각 목과 같다.","subitems":[{"id":"DAPA_A_2100000216969_ART_5_P0_I3_S1","display_id":"민군규격-표준화-업무지침-제5조-제3호-가목","subitem_number":"가","content":"국방규격을 민수규격으로 전환하는 업무(이하 \"국방규격 정비\"라 한다.)"},{"id":"DAPA_A_2100000216969_ART_5_P0_I3_S2","display_id":"민군규격-표준화-업무지침-제5조-제3호-나목","subitem_number":"나","content":"민ㆍ군규격표준화 연구과제 수행 업무(이하 \"연구과제\"라 한다.)"}]},{"id":"DAPA_A_2100000216969_ART_5_P0_I4","display_id":"민군규격-표준화-업무지침-제5조-제4호","item_number":"4","content":"민ㆍ군규격표준화사업의 추진내용은 다음 각 목과 같다.","subitems":[{"id":"DAPA_A_2100000216969_ART_5_P0_I4_S1","display_id":"민군규격-표준화-업무지침-제5조-제4호-가목","subitem_number":"가","content":"국내ㆍ외 규격의 조사 및 분석나. 규격표준화 대상의 분류 선정 및 검증다. 표준규격의 도출, 제ㆍ개정라. 기타 규격표준에 필요한 사항"}]},{"id":"DAPA_A_2100000216969_ART_5_P0_I5","display_id":"민군규격-표준화-업무지침-제5조-제5호","item_number":"5","content":"민ㆍ군규격표준화사업을 체계적이고 효율적으로 수행하기 위하여 기본계획과 시행계획을 수립한다.","subitems":[{"id":"DAPA_A_2100000216969_ART_5_P0_I5_S1","display_id":"민군규격-표준화-업무지침-제5조-제5호-가목","subitem_number":"가","content":"민ㆍ군규격표준화사업 추진목표와 기본방향을 제시하기 위하여 5년 단위로 기본계획을 수립하며 국방규격정비는 규격적합성 검토계획을 고려하여 계획을 수립한다.(단, 필요에 따라 수행기간을 조정할 수 있다.)"},{"id":"DAPA_A_2100000216969_ART_5_P0_I5_S2","display_id":"민군규격-표준화-업무지침-제5조-제5호-나목","subitem_number":"나","content":"기본계획에서 제시한 목표달성을 위하여 당해 연도 시행계획을 수립한다."}]},{"id":"DAPA_A_2100000216969_ART_5_P0_I6","display_id":"민군규격-표준화-업무지침-제5조-제6호","item_number":"6","content":"민수규격 제정 또는 개정이 필요한 경우는 관계중앙행정기관의 장에게 해당 규격의 제정 또는 개정을 요청하며 이때, 규격분야별로 다음 각 목의 기관에서 종합 하여 요청한다.","subitems":[{"id":"DAPA_A_2100000216969_ART_5_P0_I6_S1","display_id":"민군규격-표준화-업무지침-제5조-제6호-가목","subitem_number":"가","content":"기품원 관리대상 규격분야 및 연구과제 규격분야 : 기품원나. 기타 사업수행기관 관리대상 규격분야 : 방위사업청(기반전력사업지원부 및 미래전력사업지원부, 방위사업정책국), 각 군"}]},{"id":"DAPA_A_2100000216969_ART_5_P0_I7","display_id":"민군규격-표준화-업무지침-제5조-제7호","item_number":"7","content":"기품원은 민ㆍ군규격표준화 추진실적을 파악하여 방위사업청(방위사업정책국)에 제출하며 세부절차는 제10조를 따른다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_5_P0_I8","display_id":"민군규격-표준화-업무지침-제5조-제8호","item_number":"8","content":"민ㆍ군규격표준화사업과 관련하여 중요한 사항을 심의ㆍ조정하기 위한 민ㆍ군규격실무위원회를 방위사업청에 설치하며 연구과제 수행과 관련한 평가 및 심의활동을 위해 기품원에 전문위원회를 설치한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000216969_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_6","display_id":"민군규격-표준화-업무지침-제6조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"기본계획 및 시행계획 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_6_P1","display_id":"민군규격-표준화-업무지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기본계획 수립에 관한 세부사항은 다음과 같다.","items":[{"id":"DAPA_A_2100000216969_ART_6_P1_I1","display_id":"민군규격-표준화-업무지침-제6조-제1항-제1호","item_number":"1","content":"방위사업청(방위사업정책국)은 민ㆍ군규격표준화사업 기본계획 수립에 필요한 지침을 작성하여 F-2년(국방규격 정비는 F-1년) 9월 30일까지 사업수행기관에 통보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_6_P1_I2","display_id":"민군규격-표준화-업무지침-제6조-제1항-제2호","item_number":"2","content":"사업수행기관은 F-2년(국방규격정비는 F-1년) 11월 30일까지 향후 5개년(국방규격 정비는 향후 3개년) 동안의 민ㆍ군규격표준화 추진 기본계획에 필요한 관련자료를 작성하여 방위사업청 (방위사업정책국)에 통보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_6_P1_I3","display_id":"민군규격-표준화-업무지침-제6조-제1항-제3호","item_number":"3","content":"방위사업청(방위사업정책국)은 사업수행기관으로부터 접수한 기관별 기본계획 관련자료를 종합 검토하여 기본계획을 수립하고 민ㆍ군규격실무위원회에 회부, 심의 및 확정한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_6_P1_I4","display_id":"민군규격-표준화-업무지침-제6조-제1항-제4호","item_number":"4","content":"연구과제분야 기본계획에 포함되어야 할 사항은 다음과 같다.","subitems":[{"id":"DAPA_A_2100000216969_ART_6_P1_I4_S1","display_id":"민군규격-표준화-업무지침-제6조-제1항-제4호-가목","subitem_number":"가","content":"민ㆍ군규격표준화와 관련된 국내ㆍ외 규격의 동향나. 민ㆍ군규격표준화사업 방향다. 대상기간 연구과제 및 수행계획라. 연도별 추진계획 및 소요예산마. 기대효과(예산절감 효과 등)"}]},{"id":"DAPA_A_2100000216969_ART_6_P1_I5","display_id":"민군규격-표준화-업무지침-제6조-제1항-제5호","item_number":"5","content":"국방규격 정비분야 기본계획에 포함되어야 할 사항은 다음과 같다.","subitems":[{"id":"DAPA_A_2100000216969_ART_6_P1_I5_S1","display_id":"민군규격-표준화-업무지침-제6조-제1항-제5호-가목","subitem_number":"가","content":"개요(추진 목표/중점/방침 등)"},{"id":"DAPA_A_2100000216969_ART_6_P1_I5_S2","display_id":"민군규격-표준화-업무지침-제6조-제1항-제5호-나목","subitem_number":"나","content":"대상기간 추진계획(표준화 대상)"},{"id":"DAPA_A_2100000216969_ART_6_P1_I5_S3","display_id":"민군규격-표준화-업무지침-제6조-제1항-제5호-다목","subitem_number":"다","content":"연도별 추진 목표 및 계획"}]}]},{"id":"DAPA_A_2100000216969_ART_6_P2","display_id":"민군규격-표준화-업무지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"시행계획 수립에 관한 세부사항은 다음과 같다.","items":[{"id":"DAPA_A_2100000216969_ART_6_P2_I1","display_id":"민군규격-표준화-업무지침-제6조-제2항-제1호","item_number":"1","content":"방위사업청(방위사업정책국)은 시행계획 작성지침을 작성하여 F-1년 10월 31일까지 사업수행기관에 통보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_6_P2_I2","display_id":"민군규격-표준화-업무지침-제6조-제2항-제2호","item_number":"2","content":"사업수행기관은 방위사업청 지침에 의거 시행계획을 수립하여 F-1년 12월 31일 까지 방위사업청(방위사업정책국)에 통보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_6_P2_I3","display_id":"민군규격-표준화-업무지침-제6조-제2항-제3호","item_number":"3","content":"방위사업청(방위사업정책국)은 사업수행기관으로부터 접수한 기관별 시행계획을 검토 종합하여 민ㆍ군규격실무위원회에 회부, 심의 및 확정한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_6_P2_I4","display_id":"민군규격-표준화-업무지침-제6조-제2항-제4호","item_number":"4","content":"연구과제분야 시행계획에 포함되어야 할 사항은 다음과 같다가. 사업개요(추진 목표/중점/방침 등)나. 사업추진 및 투자계획다. 당해연도 연구수행계획라. 사업추진 일정마. 과제별 세부 시행계획바. 기존 연구결과 후속조치 현황(민수규격 전환 실적 및 향후 추진계획)","subitems":[]},{"id":"DAPA_A_2100000216969_ART_6_P2_I5","display_id":"민군규격-표준화-업무지침-제6조-제2항-제5호","item_number":"5","content":"국방규격 정비분야 시행계획에 포함되어야 할 사항은 다음과 같다.","subitems":[{"id":"DAPA_A_2100000216969_ART_6_P2_I5_S1","display_id":"민군규격-표준화-업무지침-제6조-제2항-제5호-가목","subitem_number":"가","content":"개요(추진 목표/중점/방침 등)"},{"id":"DAPA_A_2100000216969_ART_6_P2_I5_S2","display_id":"민군규격-표준화-업무지침-제6조-제2항-제5호-나목","subitem_number":"나","content":"당해연도 추진계획(표준화 대상 규격현황)"},{"id":"DAPA_A_2100000216969_ART_6_P2_I5_S3","display_id":"민군규격-표준화-업무지침-제6조-제2항-제5호-다목","subitem_number":"다","content":"추진일정(반기별 민수전환 추진계획)"}]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_7","display_id":"민군규격-표준화-업무지침-제7조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"민ㆍ군규격표준화 업무수행 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_7_P0","display_id":"민군규격-표준화-업무지침-제7조","paragraph_number":"","paragraph_index":null,"content":"민ㆍ군규격 표준화 업무수행 절차는 다음과 같다.","items":[{"id":"DAPA_A_2100000216969_ART_7_P0_I1","display_id":"민군규격-표준화-업무지침-제7조-제1호","item_number":"1","content":"사업수행기관은 자체 작성관리 국방규격 중 민ㆍ군 겸용성 품목을 조사하여 규격 표준화가 가능한 규격을 도출하여야 하며, 이를 위해 규격서 작성기관에 대한 필요한 확인 활동을 하여야 한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_7_P0_I2","display_id":"민군규격-표준화-업무지침-제7조-제2호","item_number":"2","content":"사업수행기관은 규격 표준화가 가능한 규격 중 별도의 연구가 필요하나 예산, 시험 시설, 전문 인력 부족 및 기타 사유로 자체적으로 수행하기 어려운 표준화 대상 규격에 대해서는 자체조사 내용, 수행불가 사유 및 기대효과를 명시하여 기품원에 통보하고 자체적으로 수행가능한 표준화 대상규격은 기본계획 및 시행계획 수립 시 반영하여 추진한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_7_P0_I3","display_id":"민군규격-표준화-업무지침-제7조-제3호","item_number":"3","content":"기품원은 사업수행기관으로부터 접수한 규격 표준화 검토대상을 자체 표준화 수요조사 결과와 함께 연구과제 선정 평가 시 포함한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_7_P0_I4","display_id":"민군규격-표준화-업무지침-제7조-제4호","item_number":"4","content":"동일한 민수규격이 있는 경우에는 국방규격을 폐지하고 민수규격을 적용한다. 이때 민수규격을 관련 국내ㆍ외 규격과 비교한 결과 개정 필요 시 제5조(기본방침) 제6항에 따라 해당 민수규격 제정기관의 장에게 개정을 요구한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_7_P0_I5","display_id":"민군규격-표준화-업무지침-제7조-제5호","item_number":"5","content":"군 요구조건과 일치하지는 않으나 유사한 민수규격이 있는 경우에는 다음의 절차를 따른다.","subitems":[{"id":"DAPA_A_2100000216969_ART_7_P0_I5_S1","display_id":"민군규격-표준화-업무지침-제7조-제5호-가목","subitem_number":"가","content":"국방규격과 민수규격의 품질수준을 비교한다."},{"id":"DAPA_A_2100000216969_ART_7_P0_I5_S2","display_id":"민군규격-표준화-업무지침-제7조-제5호-나목","subitem_number":"나","content":"국방규격의 품질수준이 높을 때에는 군 요구사항과 국내 기술수준 등을 종합 검토하여 군 요구사항이 과도할 경우에는 해당 군과 협의하여 군사 요구도를 현실화한다."},{"id":"DAPA_A_2100000216969_ART_7_P0_I5_S3","display_id":"민군규격-표준화-업무지침-제7조-제5호-다목","subitem_number":"다","content":"국방규격이 민수규격의 수준보다 높지만 민수규격을 대체할 보다 우수한 민수기술이 존재할 경우에는 민수기술을 수용하는 표준규격(안)을 작성 한다."},{"id":"DAPA_A_2100000216969_ART_7_P0_I5_S4","display_id":"민군규격-표준화-업무지침-제7조-제5호-라목","subitem_number":"라","content":"민수규격의 품질수준이 높은 경우에는 군 요구사항과의 차이에 대하여 민수규격 개정 필요성을 검토한다."}]},{"id":"DAPA_A_2100000216969_ART_7_P0_I6","display_id":"민군규격-표준화-업무지침-제7조-제6호","item_number":"6","content":"민수규격이 없는 경우에는 다음 절차에 따른다.","subitems":[{"id":"DAPA_A_2100000216969_ART_7_P0_I6_S1","display_id":"민군규격-표준화-업무지침-제7조-제6호-가목","subitem_number":"가","content":"민수규격이 없는 경우에는 시장조사를 통하여 민간의 수요를 판단한다."},{"id":"DAPA_A_2100000216969_ART_7_P0_I6_S2","display_id":"민군규격-표준화-업무지침-제7조-제6호-나목","subitem_number":"나","content":"민수 수요가 군 수요보다 많은 경우에는 유사 국제규격 유무를 조사하여 국제규격이 있는 경우에는 국제규격을 채택하고, 국제규격이 없는 경우에는 표준규격(안)을 작성한다."},{"id":"DAPA_A_2100000216969_ART_7_P0_I6_S3","display_id":"민군규격-표준화-업무지침-제7조-제6호-다목","subitem_number":"다","content":"민수 수요가 군 수요보다 적은 경우에는 국방규격의 제ㆍ개정 여부를 검토하여 필요시 국방규격을 제정 또는 개정한다."}]},{"id":"DAPA_A_2100000216969_ART_7_P0_I7","display_id":"민군규격-표준화-업무지침-제7조-제7호","item_number":"7","content":"국제규격과의 비교 및 국내 기술수준을 고려하여 신규로 작성된 표준규격 (안)은 국방 관련기관들의 의견을 수렴하여 제5조제6항 절차에 따라 해당 민수규격 제정기관의 장에게 제정 또는 개정을 요청한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_7_P0_I8","display_id":"민군규격-표준화-업무지침-제7조-제8호","item_number":"8","content":"방위사업청 방위사업정책국 또는 기품원은 민수규격 제정기관의 장으로부터 민수 규격이 확정 통보되면, 해당 사업수행기관에 이를 전파하여 관련 국방규격을 폐지하도록 해야 한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000216969_ART_5"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_8","display_id":"민군규격-표준화-업무지침-제8조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"연구과제 수행","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_8_P0","display_id":"민군규격-표준화-업무지침-제8조","paragraph_number":"","paragraph_index":null,"content":"민ㆍ군규격표준화를 위한 연구과제는 다음과 같은 절차에 따라 수행한다.","items":[{"id":"DAPA_A_2100000216969_ART_8_P0_I1","display_id":"민군규격-표준화-업무지침-제8조-제1호","item_number":"1","content":"연구과제 수행은 기품원에서 주관하며, 과제성격에 따라 자체수행 혹은 외부 전문연구기관을 선정하여 수행할 수 있다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_8_P0_I2","display_id":"민군규격-표준화-업무지침-제8조-제2호","item_number":"2","content":"연구과제 선정을 위해 기품원은 사업수행기관으로부터 접수한 표준화 검토 대상 규격과 자체 표준화 수요조사를 통한 소요를 종합하여 전문위원회의 선정평가를 거쳐 연구 대상과제를 도출한다. 다만 민ㆍ군규격실무위원회 심의에서 표준화 정책 수행을 위해 필요하다고 인정된 과제는 제외한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_8_P0_I3","display_id":"민군규격-표준화-업무지침-제8조-제3호","item_number":"3","content":"도출된 연구 대상과제는 민ㆍ군규격실무위원회의 최종 심의를 거쳐 연구과제로 확정되며, 기본 및 시행계획에 반영하여 추진한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_8_P0_I4","display_id":"민군규격-표준화-업무지침-제8조-제4호","item_number":"4","content":"연구과제 결과에 따라 제시된 민ㆍ군규격 표준화(안) 및 기타사항의 적용 여부는 전문위원회를 통해 관계기관 검토를 거친 후 최종 민ㆍ군규격실무위원회에서 심의 의결하여 관련분야에 적용 및 후속 조치한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_8_P0_I5","display_id":"민군규격-표준화-업무지침-제8조-제5호","item_number":"5","content":"기품원은 연구과제 결과에 따라 최종 적용 및 추진토록 의결된 사항에 관한 진행상황을 유지하고 사업수행기관별 연구과제 결과 적용 및 필요시 민ㆍ군규격 표준화사업으로 추진할 수 있도록 필요한 제반 후속조치 활동을 취해야 하며, 이를 위해 사업수행 기관은 제10조(추진실적보고)에 따라 추진실적을 방위사업청(방위사업정책국)과 기품원에 통보하고 기품원은 연구결과에 따른 민수규격 제ㆍ개정 사항을 관련 사업수행기관에 통보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_8_P0_I6","display_id":"민군규격-표준화-업무지침-제8조-제6호","item_number":"6","content":"기품원은 연구과제 실효성 향상과 연구개발과정 확인을 위해 필요 시 모니터링 요원을 선정, 운용할 수 있으며 모니터링 활동에 따른 수당을 지급할 수 있다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_8_P0_I7","display_id":"민군규격-표준화-업무지침-제8조-제7호","item_number":"7","content":"기타 연구과제 수행을 위해 필요한 세부절차는 기품원에서 별도로 정한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000216969_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_9","display_id":"민군규격-표준화-업무지침-제9조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"예산확보","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_9_P0","display_id":"민군규격-표준화-업무지침-제9조","paragraph_number":"","paragraph_index":null,"content":"","items":[{"id":"DAPA_A_2100000216969_ART_9_P0_I1","display_id":"민군규격-표준화-업무지침-제9조-제1호","item_number":"1","content":"각 사업수행기관은 민ㆍ군규격표준화 사업추진에 필요한 소요예산을 사업수행 기관별 규격관리 예산으로 확보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_9_P0_I2","display_id":"민군규격-표준화-업무지침-제9조-제2호","item_number":"2","content":"연구과제 수행에 필요한 소요예산은 기품원에서 민ㆍ군기술협력사업 예산으로 확보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_9_P0_I3","display_id":"민군규격-표준화-업무지침-제9조-제3호","item_number":"3","content":"각 사업수행기관은 소요예산이 확보되도록 적극적으로 노력해야 한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_10","display_id":"민군규격-표준화-업무지침-제10조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"추진실적보고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_10_P0","display_id":"민군규격-표준화-업무지침-제10조","paragraph_number":"","paragraph_index":null,"content":"","items":[{"id":"DAPA_A_2100000216969_ART_10_P0_I1","display_id":"민군규격-표준화-업무지침-제10조-제1호","item_number":"1","content":"사업수행기관은 매 반기 다음 달 15일까지 민ㆍ군규격표준화 추진실적을 방위사업청(방위사업정책국), 기품원에 각각 통보한다.","subitems":[]},{"id":"DAPA_A_2100000216969_ART_10_P0_I2","display_id":"민군규격-표준화-업무지침-제10조-제2호","item_number":"2","content":"추진실적에는 다음 각 목의 사항이 포함되어야 한다.","subitems":[{"id":"DAPA_A_2100000216969_ART_10_P0_I2_S1","display_id":"민군규격-표준화-업무지침-제10조-제2호-가목","subitem_number":"가","content":"당해반기 민수규격 전환 추진 진도나. 기타 연구결과 적용 및 후속조치 추진 진도다. 연구과제 반기별 추진 진도 및 평가결과(기품원)라. 부진사업 원인 분석 및 대책"}]}]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_11","display_id":"민군규격-표준화-업무지침-제11조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"민ㆍ군규격실무위원회 구성 및 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_11_P1","display_id":"민군규격-표준화-업무지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"민ㆍ군규격표준화사업을 전담ㆍ검토하기 위하여 방위사업청에 민ㆍ군규격실무위원회(이하 \"규격위\"라 한다.)를 둘 수 있다.","items":[]},{"id":"DAPA_A_2100000216969_ART_11_P2","display_id":"민군규격-표준화-업무지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"규격위는 다음 각 호의 업무를 처리한다.","items":[{"id":"DAPA_A_2100000216969_ART_11_P2_I1","display_id":"민군규격-표준화-업무지침-제11조-제2항-제1호","item_number":"1","content":"민ㆍ군규격표준화사업의 기본계획 및 시행계획의 수립과 변경에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000216969_ART_11_P2_I2","display_id":"민군규격-표준화-업무지침-제11조-제2항-제2호","item_number":"2","content":"국방규격의 민수규격으로의 전환 대상 심의","subitems":[]},{"id":"DAPA_A_2100000216969_ART_11_P2_I3","display_id":"민군규격-표준화-업무지침-제11조-제2항-제3호","item_number":"3","content":"민ㆍ군규격표준화와 관련된 표준제도 및 지침의 개선에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000216969_ART_11_P2_I4","display_id":"민군규격-표준화-업무지침-제11조-제2항-제4호","item_number":"4","content":"민ㆍ군 규격 표준화 연구과제 최종선정 및 연구결과 적용 심의","subitems":[]},{"id":"DAPA_A_2100000216969_ART_11_P2_I5","display_id":"민군규격-표준화-업무지침-제11조-제2항-제5호","item_number":"5","content":"표준화 정책 수행을 위해 위원장이 필요하다고 판단하여 심의에 부치는 사항","subitems":[]}]},{"id":"DAPA_A_2100000216969_ART_11_P3","display_id":"민군규격-표준화-업무지침-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"규격위는 위원장과 15인 내외의 위원으로 구성하며, 위원장은 방위사업청 표준기획과장으로 하며, 위원은 다음 각 호에 해당하는 자로 한다.","items":[{"id":"DAPA_A_2100000216969_ART_11_P3_I1","display_id":"민군규격-표준화-업무지침-제11조-제3항-제1호","item_number":"1","content":"민군기술협력사업 촉진법 제2조제2호 내지 제3호에 따른 규격 또는 표준 관련 사업에 직접 관련되는 업무 담당자로서 위원장이 요청하여 해당 소속기관의 장이 지명한 자","subitems":[]},{"id":"DAPA_A_2100000216969_ART_11_P3_I2","display_id":"민군규격-표준화-업무지침-제11조-제3항-제2호","item_number":"2","content":"규격 또는 표준관련 전문기관의 직원 중 규격위 위원장이 위촉한 자","subitems":[]},{"id":"DAPA_A_2100000216969_ART_11_P3_I3","display_id":"민군규격-표준화-업무지침-제11조-제3항-제3호","item_number":"3","content":"규격 또는 표준에 관하여 학식과 경험이 풍부한 자 중 규격위 위원장이 위촉한 자","subitems":[]}]},{"id":"DAPA_A_2100000216969_ART_11_P4","display_id":"민군규격-표준화-업무지침-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"간사는 방위사업청 표준기획과 실무자로 하며, 서기 1인을 둘 수 있다.","items":[]},{"id":"DAPA_A_2100000216969_ART_11_P5","display_id":"민군규격-표준화-업무지침-제11조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"위촉위원의 임기는 2년으로 한다. 단 필요시 연임할 수 있다.","items":[]},{"id":"DAPA_A_2100000216969_ART_11_P6","display_id":"민군규격-표준화-업무지침-제11조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"규격위는 재적위원 과반수 출석으로 개의하고, 출석위원 과반수 찬성으로 의결한다.","items":[]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["촉진법"],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_12","display_id":"민군규격-표준화-업무지침-제12조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표준화 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"전문위원회 구성 및 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000216969_ART_12_P1","display_id":"민군규격-표준화-업무지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"민ㆍ군규격표준화사업의 효율적 추진을 위하여 전문위원회를 기품원에 설치ㆍ운영한다.","items":[]},{"id":"DAPA_A_2100000216969_ART_12_P2","display_id":"민군규격-표준화-업무지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전문위원회는 다음 각 호의 사항을 심의ㆍ조정한다.","items":[{"id":"DAPA_A_2100000216969_ART_12_P2_I1","display_id":"민군규격-표준화-업무지침-제12조-제2항-제1호","item_number":"1","content":"연구과제 소요 선정평가 및 연구대상 과제 도출","subitems":[]},{"id":"DAPA_A_2100000216969_ART_12_P2_I2","display_id":"민군규격-표준화-업무지침-제12조-제2항-제2호","item_number":"2","content":"주관연구기관 선정평가 및 최종평가","subitems":[]},{"id":"DAPA_A_2100000216969_ART_12_P2_I3","display_id":"민군규격-표준화-업무지침-제12조-제2항-제3호","item_number":"3","content":"연구과제 결과 적용여부 검토 등","subitems":[]},{"id":"DAPA_A_2100000216969_ART_12_P2_I4","display_id":"민군규격-표준화-업무지침-제12조-제2항-제4호","item_number":"4","content":"기타 위원장이 부의하는 사항","subitems":[]}]},{"id":"DAPA_A_2100000216969_ART_12_P3","display_id":"민군규격-표준화-업무지침-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"전문위원회는 위원장과 간사를 포함하여 9인 내외로 하되, 위원 구성 시 과제별 사업수행 기관 대표위원, 기술 분야별로 산ㆍ학ㆍ연 관련 전문가 등을 포함되도록 하고 연구과제 수행책임자는 위원이 될 수 없다.","items":[]},{"id":"DAPA_A_2100000216969_ART_12_P4","display_id":"민군규격-표준화-업무지침-제12조-제4항","paragraph_number":"④","paragraph_index":4,"content":"위원장, 간사 및 위원구성 등 기타 세부운영 절차는 기품원에서 별도로 정한다.","items":[]}],"notes":[],"effective_date":"2022-12-19","revision_date":"2022-12-19","source_file":"민·군규격 표준화 업무지침.json","source_path":"원문/법제처API/민·군규격 표준화 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000216969_ART_13","display_id":"민군규격-표준화-업무지침-제13조","regulation_id":"DAPA_A_2100000216969","regulation_name":"민·군규격 표준화 업무지침","short_name":"민·군규격 표