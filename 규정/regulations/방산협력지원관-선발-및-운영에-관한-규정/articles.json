[{"id":"DAPA_A_2100000235076_ART_1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제1조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_1_P0","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위산업 발전 및 지원에 관한 법률」 제15조제4항에 따른 수출사업 지원 또는 「방위사업법 시행령」 제24조의 제3항 제1호에 따른 국제공동연구개발의 이행관리 및 감독을 위해 국외에서 근무하는 방위사업청 소속 공무원(이하 \"방산협력지원관\"이라 한다)의 선발 및 운영에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_15","DEFENSE_ACQ_ENFORCEMENT_ART_24"],"related_regulations":["DAPA_L_287981","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000235076_ART_2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제2조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_2_P0","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방산협력지원관의 업무를 조정ㆍ감독ㆍ지원하는 방위사업청의 관계 부서에 적용한다.","items":[]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000235076_ART_3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제3조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"방산협력지원단장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_3_P1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청장은 각 해외 주재국(이하 \"주재국\"이라 한다)에 대하여 직급, 계급 및 근무 잔여기간 등을 고려하여 방산협력지원관 중 1인을 방산협력지원단장으로 임명한다. 단, 방산협력지원관이 1명인 경우 그 1인을 방산협력지원단장으로 본다.","items":[]},{"id":"DAPA_A_2100000235076_ART_3_P2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방산협력지원단장에 대한 지휘ㆍ감독권자(제4조, 제6조, 제14조, 제21조부터 제23조까지의 규정에 따른 업무의 수행 및 제15조부터 제18조까지의 규정에 따른 복무 관리에 대한 지휘 및 감독을 말하며, 이하 \"지휘권자\"라 한다)는 유럽아시아협력담당관으로 한다.","items":[]},{"id":"DAPA_A_2100000235076_ART_3_P3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방산협력지원단장은 본인을 제외한 주재국 방산협력지원관의 지휘권자가 된다.","items":[]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000235076_ART_4","DAPA_A_2100000235076_ART_6","DAPA_A_2100000235076_ART_14","DAPA_A_2100000235076_ART_21","DAPA_A_2100000235076_ART_23","DAPA_A_2100000235076_ART_15","DAPA_A_2100000235076_ART_18"],"related_regulations":[],"external_references":[],"keywords":["감독"]},{"id":"DAPA_A_2100000235076_ART_4","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"임무 및 업무보고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_4_P1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방산협력지원관의 임무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000235076_ART_4_P1_I1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항-제1호","item_number":"1","content":"해외 진출 방산업체 및 방산물자 등 생산업체의 애로사항 조사와 그 해결을 위한 지원","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P1_I2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항-제2호","item_number":"2","content":"근무하는 국가의 정부, 군 및 방산업체 등 요구사항 대응","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P1_I3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항-제3호","item_number":"3","content":"획득사업관리에 준하는 현장 상시 감독 및 통제(기술유출 방지 및 보호)","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P1_I4","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항-제4호","item_number":"4","content":"각종 회의(현지 정부-수출업체간 회의를 포함한다) 참석, 모니터링, 회의 결과 공유 등","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P1_I5","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항-제5호","item_number":"5","content":"민간통상협력, 산업협력, 교육 훈련 및 홍보 등 지원","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P1_I6","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항-제6호","item_number":"6","content":"근무하는 국가의 주변국으로의 시장 판로 개척 활동 지원","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P1_I7","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제1항-제7호","item_number":"7","content":"그 밖에 방산수출 지원, 국제 공동연구개발 사업의 관리 및 감독에 관하여 청장이 지시하는 사항","subitems":[]}]},{"id":"DAPA_A_2100000235076_ART_4_P2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방산협력지원단장은 업무 전반에 관한 사항을 유럽아시아협력담당관에게 보고한다. 업무보고의 종류 및 시기는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000235076_ART_4_P2_I1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제2항-제1호","item_number":"1","content":"월간업무보고 : 매월 첫 번째 수요일","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P2_I2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제2항-제2호","item_number":"2","content":"분기업무보고 : 분기익월 첫 번째 수요일","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P2_I3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제2항-제3호","item_number":"3","content":"전년도 업무실적 종합분석 및 신년도 업무계획보고 : 매년 1월 10일 이전(개인 업무실적 및 계획은 담당별 별도 제출)","subitems":[]},{"id":"DAPA_A_2100000235076_ART_4_P2_I4","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제2항-제4호","item_number":"4","content":"주간보고 : 매주 수요일","subitems":[]}]},{"id":"DAPA_A_2100000235076_ART_4_P3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방산협력지원단장은 주재국의 국방정책, 방위산업, 획득ㆍ계약관련 정보 등을 수집하여 월 1회 유럽아시아협력담당관에게 보고한다. 단, 긴급한 사항이거나 적시성을 요구하는 정보보고일 경우 지체없이 보고하여야 한다.","items":[]},{"id":"DAPA_A_2100000235076_ART_4_P4","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"「국제계약지원단 운영규정」(방위사업청 훈령 제728호) 제9조 제2항에 따른 유럽지역 국제계약지원관은 서유럽(「외교부와 그 소속기관 직제 시행규칙」(외교부령 제125호)제19조제6항제3호에 따른 지역을 말한다) 방산협력지원관을 겸임한다.","items":[]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000235076_ART_9","DAPA_A_2100000235076_ART_19"],"related_regulations":[],"external_references":[],"keywords":["감독"]},{"id":"DAPA_A_2100000235076_ART_5","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제5조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"근무기간","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_5_P1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방산협력지원관의 근무 기간은 3년으로 한다. 단, 청장이 필요하다고 인정하는 경우에는 그 근무 기간을 연장하거나 단축할 수 있다.","items":[]},{"id":"DAPA_A_2100000235076_ART_5_P2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"유럽아시아협력담당관은 방산협력지원관에게 다음 각 호의 사유가 있는 경우, 청장에게 근무 기간의 단축을 건의할 수 있다.","items":[{"id":"DAPA_A_2100000235076_ART_5_P2_I1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제5조-제2항-제1호","item_number":"1","content":"「공무원 행동강령」 또는 「군인의 지위 및 복무에 관한 기본법」, 그 시행령을 위반하는 경우","subitems":[]},{"id":"DAPA_A_2100000235076_ART_5_P2_I2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제5조-제2항-제2호","item_number":"2","content":"방산협력지원관으로서의 품위를 손상하는 경우","subitems":[]},{"id":"DAPA_A_2100000235076_ART_5_P2_I3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제5조-제2항-제3호","item_number":"3","content":"근무평가 최하위 등급을 2년 연속 받은 경우","subitems":[]},{"id":"DAPA_A_2100000235076_ART_5_P2_I4","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제5조-제2항-제4호","item_number":"4","content":"기타 방산협력지원관으로서 업무를 수행하는 것이 부적절하다고 판단되는 경우","subitems":[]}]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000235076_ART_6","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제6조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"사무실 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_6_P1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방산협력지원관은 업무 수행을 위해 주재국 공관과 별도의 독립사무실을 운영한다. 다만, 주재국 여건 상 필요한 경우 주재국 공관과 협조하여 공관 내 사무실을 지원 받을 수 있다.","items":[]},{"id":"DAPA_A_2100000235076_ART_6_P2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방산협력지원관 사무실은 필요한 경우 군, 출연기관 등 관련기관 통합하여 운영할 수 있다. 이 경우, 운영에 필요한 비용을 공동으로 부담할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000235076_ART_7","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제7조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"통신수단","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_7_P0","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제7조","paragraph_number":"","paragraph_index":null,"content":"방산협력지원관은 긴급 보고사항이나 연락사항이 있을 경우, 전화 및 인터넷 PMO 업무관리 정보체계 등 가용 통신수단을 활용한다.","items":[]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000235076_ART_8","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제8조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제2장 선발 및 운영","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"선발 원칙","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_8_P0","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제8조","paragraph_number":"","paragraph_index":null,"content":"방산협력지원관의 선발은 공개경쟁을 원칙으로 한다. 다만, 다음 각 호의 어느 하나에 해당하는 경우에는 청장이 지명하여 임명할 수 있다.","items":[{"id":"DAPA_A_2100000235076_ART_8_P0_I1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제8조-제1호","item_number":"1","content":"방산협력지원관 유고 시","subitems":[]},{"id":"DAPA_A_2100000235076_ART_8_P0_I2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제8조-제2호","item_number":"2","content":"긴급히 주재국으로 방산협력지원관을 파견하여야 하나 선발을 위한 최소 행정기간이 부족할 경우","subitems":[]}]}],"notes":[],"effective_date":"2024-01-12","revision_date":"2024-01-12","source_file":"방산협력지원관 선발 및 운영에 관한 규정.json","source_path":"원문/법제처API/방산협력지원관 선발 및 운영에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000235076_ART_9","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조","regulation_id":"DAPA_A_2100000235076","regulation_name":"방산협력지원관 선발 및 운영에 관한 규정","short_name":"방산협력지원관 선발 및 운영에 관한 규정","document_type":"훈령","part":"","chapter":"제2장 선발 및 운영","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"지원 자격","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000235076_ART_9_P1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방산협력지원관 지원 자격요건은 다음 각 호와 같다.(서류접수 마감일 기준)","items":[{"id":"DAPA_A_2100000235076_ART_9_P1_I1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제1항-제1호","item_number":"1","content":"어학 능력에 있어서 제11조제2호에 따른 기준에 적합한 자","subitems":[]},{"id":"DAPA_A_2100000235076_ART_9_P1_I2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제1항-제2호","item_number":"2","content":"근무 경력에 있어서 제11조제3호에 따른 기준에 적합한 자","subitems":[]},{"id":"DAPA_A_2100000235076_ART_9_P1_I3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제1항-제3호","item_number":"3","content":"공무원의 경우「공무원임용령」제32조 승진임용 제한사유에 해당하지 않는 자","subitems":[]},{"id":"DAPA_A_2100000235076_ART_9_P1_I4","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제1항-제4호","item_number":"4","content":"선발제한기간(국제계약지원관, 국외사업 현장감독관 등 국외파견근무와 국외 장기교육 수료 시 해당기간의 1.5배 기간(귀국일로부터 기산)을 선발 제한기간으로 한다.)에 포함되지 않는 자.","subitems":[]}]},{"id":"DAPA_A_2100000235076_ART_9_P2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"다음 각 호 어느 하나에 해당하는 경우에는 제1항에 따른 자격요건을 갖추지 못한 것으로 본다.","items":[{"id":"DAPA_A_2100000235076_ART_9_P2_I1","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제2항-제1호","item_number":"1","content":"징계 처분을 받고 징계기록이 말소되지 않은 자","subitems":[]},{"id":"DAPA_A_2100000235076_ART_9_P2_I2","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제2항-제2호","item_number":"2","content":"금품 및 향응 수수, 공금의 횡령 및 유용, 성폭력, 성희롱 및 성매매, 보안 사고로 징계를 받은 이력이 있는 자(징계기록 말소 여부를 불문한다)","subitems":[]},{"id":"DAPA_A_2100000235076_ART_9_P2_I3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제2항-제3호","item_number":"3","content":"방산협력지원관 임명일 기준 잔여 정년 기간이 4년 미만인 자(계약직의 경우 별도로 정하는 기간에 따른다)","subitems":[]}]},{"id":"DAPA_A_2100000235076_ART_9_P3","display_id":"방산협력지원관-선발-및-운영에-관한-규정-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"국제협력관은 제1항부터 제2항까지에서 규정한 사항 외에 방산협력지원관의 지원 자격 요건에 대한 세부사항을 조직인사