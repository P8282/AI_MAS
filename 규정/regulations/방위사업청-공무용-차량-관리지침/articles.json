[{"id":"DAPA_A_2100000275514_ART_1","display_id":"방위사업청-공무용-차량-관리지침-제1조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_1_P0","display_id":"방위사업청-공무용-차량-관리지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업청(이하\"청\"이라 한다)이 보유한 차량의 효율적인 관리 및 운영에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_2","display_id":"방위사업청-공무용-차량-관리지침-제2조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_2_P0","display_id":"방위사업청-공무용-차량-관리지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 정의는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000275514_ART_2_P0_I1","display_id":"방위사업청-공무용-차량-관리지침-제2조-제1호","item_number":"1","content":"\"차량\"이라 함은 청에서 관리하는 모든 자동차를 말하며, 배정대상자에게 전용으로 배정하는 전용차량과 일반업무 차량(일반/군)으로 구분한다.","subitems":[]},{"id":"DAPA_A_2100000275514_ART_2_P0_I2","display_id":"방위사업청-공무용-차량-관리지침-제2조-제2호","item_number":"2","content":"\"차량의 운영 및 관리\"라 함은 차량의 구입 또는 임차시기부터 운행 및 정비, 폐차 등에 관한 사항 등 차량의 모든 사항을 총칭한다.","subitems":[]},{"id":"DAPA_A_2100000275514_ART_2_P0_I3","display_id":"방위사업청-공무용-차량-관리지침-제2조-제3호","item_number":"3","content":"\"차량의 공용운행\"이라 함은 청 본연의 업무 목적을 달성하기 위하여 사용되는 경우를 말하며, \"차량의 관리부서\"(이하 \"관리부서\"라 한다.)라 함은 차량의 관리 운용을 담당하는 부서를 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_3","display_id":"방위사업청-공무용-차량-관리지침-제3조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_3_P0","display_id":"방위사업청-공무용-차량-관리지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 \"청\"이 보유 및 임차한 차량에 적용한다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_4","display_id":"방위사업청-공무용-차량-관리지침-제4조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"구입 및 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_4_P1","display_id":"방위사업청-공무용-차량-관리지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"\"관리부서\"는 운영지원과로하며, 다음 각 호의 업무를 한다.","items":[{"id":"DAPA_A_2100000275514_ART_4_P1_I1","display_id":"방위사업청-공무용-차량-관리지침-제4조-제1항-제1호","item_number":"1","content":"차량의 배차","subitems":[]},{"id":"DAPA_A_2100000275514_ART_4_P1_I2","display_id":"방위사업청-공무용-차량-관리지침-제4조-제1항-제2호","item_number":"2","content":"차량의 구입, 임차, 전환, 폐차, 정비, 수리 그 밖의 참고사항 작성 기록 보존","subitems":[]}]},{"id":"DAPA_A_2100000275514_ART_4_P2","display_id":"방위사업청-공무용-차량-관리지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"\"관리부서\"는 경형 차량 및 「환경친화적 자동차의 개발 및 보급 촉진에 관한 법률」에 따른 환경친화적 자동차를 구매하도록 노력하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_5","display_id":"방위사업청-공무용-차량-관리지침-제5조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"기본방침","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_5_P1","display_id":"방위사업청-공무용-차량-관리지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"차량 운행은 청 본연의 업무 목적을 달성하기 위하여 이용함을 원칙으로 한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_5_P2","display_id":"방위사업청-공무용-차량-관리지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"일반업무 차량은 사적인 용도로 사용ㆍ수익을 할 수 없다.","items":[]},{"id":"DAPA_A_2100000275514_ART_5_P3","display_id":"방위사업청-공무용-차량-관리지침-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"차량은 일과시간 내 사용함을 원칙으로 한다. 다만, 업무의 목적과 연속성에 따라 야간 및 2일 이상의 운행이 필요한 경우 \"관리부서\"의 사전 승인 조치 후 운행한다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_6","display_id":"방위사업청-공무용-차량-관리지침-제6조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"차량 관리 및 배차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_6_P1","display_id":"방위사업청-공무용-차량-관리지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"모든 차량은 \"관리부서\"의 장이 관리 및 배차한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_6_P2","display_id":"방위사업청-공무용-차량-관리지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"\"관리부서\"의 장은 차량담당을 지정하여 차량 관리 및 배차 업무를 총괄 위임할 수 있다.","items":[]},{"id":"DAPA_A_2100000275514_ART_6_P3","display_id":"방위사업청-공무용-차량-관리지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"\"관리부서\"는 차량을 중요도, 긴급성, 대중교통 불편 등을 고려하여 배차한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_6_P4","display_id":"방위사업청-공무용-차량-관리지침-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"\"관리부서\"는 일반업무 차량을 다음 각 호에 해당하는 경우에 배차한다.","items":[{"id":"DAPA_A_2100000275514_ART_6_P4_I1","display_id":"방위사업청-공무용-차량-관리지침-제6조-제4항-제1호","item_number":"1","content":"출장","subitems":[]},{"id":"DAPA_A_2100000275514_ART_6_P4_I2","display_id":"방위사업청-공무용-차량-관리지침-제6조-제4항-제2호","item_number":"2","content":"\"청\" 행사","subitems":[]},{"id":"DAPA_A_2100000275514_ART_6_P4_I3","display_id":"방위사업청-공무용-차량-관리지침-제6조-제4항-제3호","item_number":"3","content":"그 밖의 업무수행 상 필요하다고 판단될 경우","subitems":[]}]},{"id":"DAPA_A_2100000275514_ART_6_P5","display_id":"방위사업청-공무용-차량-관리지침-제6조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"\"관리부서\"는 대외협력이 필요한 부서인 경우 청장의 승인 후 고정으로 배정할 수 있다.","items":[]},{"id":"DAPA_A_2100000275514_ART_6_P6","display_id":"방위사업청-공무용-차량-관리지침-제6조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"지방사무소 지원 차량의 경우 해당 사무소 부서장이 관리 및 배차 통제한다. 다만, 원칙적으로 \"관리부서\"의 통제에 따른다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_7","display_id":"방위사업청-공무용-차량-관리지침-제7조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"배차신청 및 승인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_7_P1","display_id":"방위사업청-공무용-차량-관리지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"차량을 이용하고자 하는 자는 운행 전일 15시까지 청 통합정보시스템(이하 \"행정업무지원체계\")을 이용하여 배차를 신청하여야 한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_7_P2","display_id":"방위사업청-공무용-차량-관리지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"\"관리부서\"는 제1항의 신청에 대하여 특별한 사유가 없는 한 이를 승인하여야 한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_7_P3","display_id":"방위사업청-공무용-차량-관리지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"차량담당은 공무용 차량의 효율적 운영을 위하여 사용자가 신청한 차종과 달리 배차 할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_8","display_id":"방위사업청-공무용-차량-관리지침-제8조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"배차 제한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_8_P0","display_id":"방위사업청-공무용-차량-관리지침-제8조","paragraph_number":"","paragraph_index":null,"content":"다음 각 호의 경우 \"관리부서\"는 차량 사용을 제한할 수 있다.","items":[{"id":"DAPA_A_2100000275514_ART_8_P0_I1","display_id":"방위사업청-공무용-차량-관리지침-제8조-제1호","item_number":"1","content":"제7조의 배차신청 절차를 거치지 아니하고 배차를 요구하는 경우","subitems":[]},{"id":"DAPA_A_2100000275514_ART_8_P0_I2","display_id":"방위사업청-공무용-차량-관리지침-제8조-제2호","item_number":"2","content":"정당한 사유 없이 사적인 용도나 업무와 밀접한 관련이 없는 업무에 사용하기 위해 신청하는 경우","subitems":[]},{"id":"DAPA_A_2100000275514_ART_8_P0_I3","display_id":"방위사업청-공무용-차량-관리지침-제8조-제3호","item_number":"3","content":"대중교통을 이용하는 것이 효율적이라고 판단되는 경우","subitems":[]},{"id":"DAPA_A_2100000275514_ART_8_P0_I4","display_id":"방위사업청-공무용-차량-관리지침-제8조-제4호","item_number":"4","content":"타 기관으로부터 강사료, 수당, 교통비 등을 받는 출장","subitems":[]},{"id":"DAPA_A_2100000275514_ART_8_P0_I5","display_id":"방위사업청-공무용-차량-관리지침-제8조-제5호","item_number":"5","content":"관련 법령에 따라 차량 운행 제한인 경우","subitems":[]}]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000275514_ART_7"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_9","display_id":"방위사업청-공무용-차량-관리지침-제9조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"직접운전","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_9_P0","display_id":"방위사업청-공무용-차량-관리지침-제9조","paragraph_number":"","paragraph_index":null,"content":"\"관리부서\"는 업무 능률의 향상과 차량운행의 효율성을 위하여 필요한 때에는 운전직 직원이 아닌 청 소속 일반직원(공무직 및 기간제 직원 포함)이 차량을 직접 운전하며 업무를 수행할 수 있도록 할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_10","display_id":"방위사업청-공무용-차량-관리지침-제10조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"유류보충 및 충전","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_10_P1","display_id":"방위사업청-공무용-차량-관리지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"운전자는 차량운행 전 연료 또는 충전상태를 확인하고 운행하여야하며, 일반차량의 경우 원칙적으로 공공기관 유류구매카드를 활용하여 조달청에 협약 등록된 공공기관 지정주유소에서 주유하고, 불가피한 사유로 공공기관 지정주유소 미 이용 시 소명사유를 작성 후 \"관리부서\"에 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_10_P2","display_id":"방위사업청-공무용-차량-관리지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전기차량의 경우 충전카드를 활용하여 충전하며, 「환경친화적 자동차의 개발 및 보급 촉진에 관한 법률 시행령」 제18조의8 제6호 및 제7호에 따른 충전시간을 준수하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["환경친화적 자동차의 개발 및 보급 촉진에 관한 법률 시행령"],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_11","display_id":"방위사업청-공무용-차량-관리지침-제11조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"차량의 입ㆍ출고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_11_P1","display_id":"방위사업청-공무용-차량-관리지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"차량은 출장 당일 관리부서가 지정하는 청사 내 주차장(이하 \"지정주차장\")에서 출고하며, 출장이 끝나거나 운행시간이 아닌 경우에는 지체없이 지정주차장에 입고하여야 한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_11_P2","display_id":"방위사업청-공무용-차량-관리지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에도 불구하고 지방사무소의 경우에는 해당 사무소 내 차고지에 입고하여야 한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_11_P3","display_id":"방위사업청-공무용-차량-관리지침-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항에도 불구하고, 배정대상자에게 전용으로 배정하는 전용차량 및 지정활용 대상자(차장, 고위공무원 ‘가’등급의 소속기관장)가 통상적인 근무시간 이전ㆍ이후에 업무현장 방문 및 회의 참석 등 업무와 긴밀하게 연계된 경우에 사용하는 차량에 한하여 예외로 할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_12","display_id":"방위사업청-공무용-차량-관리지침-제12조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"차량의 반납 및 운행일지 작성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_12_P1","display_id":"방위사업청-공무용-차량-관리지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"차량 운전자는 차량 사용 후 차량은 청사 내 지정주차장에, 열쇠는 \"관리부서\"에 반납한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_12_P2","display_id":"방위사업청-공무용-차량-관리지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"차량운전자는 차량을 근무시간 내에 본 지침 제11조의 지정 장소로 반납함을 원칙으로 하되, 부득이한 사정으로 근무시간 외 반납 할 때에는 예정시간을 \"관리부서\"에 사전 통보하고, 차량 열쇠를「방위사업청 당직근무 지침」제9조 제5호에 따라 반납한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_12_P3","display_id":"방위사업청-공무용-차량-관리지침-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"차량 운전자는 배차된 차량을 사용 및 반납 후 반드시 익일까지 차량 운행사항을 행정업무지원체계(공무용차량관리)에 등록하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000275514_ART_11","DAPA_A_2100000271364_ART_9"],"related_regulations":["DAPA_A_2100000271364"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_13","display_id":"방위사업청-공무용-차량-관리지침-제13조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"차량 반납 확인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_13_P0","display_id":"방위사업청-공무용-차량-관리지침-제13조","paragraph_number":"","paragraph_index":null,"content":"차량의 반납 확인은 다음의 각호와 같다.","items":[{"id":"DAPA_A_2100000275514_ART_13_P0_I1","display_id":"방위사업청-공무용-차량-관리지침-제13조-제1호","item_number":"1","content":"차량담당자는 행정업무지원체계(공무용차량관리)에 등록된 차량 운행기록이 정상적으로 작성되었는지 여부 및 출발지부터 도착지까지의 주행거리를 확인하여야 한다.","subitems":[]},{"id":"DAPA_A_2100000275514_ART_13_P0_I2","display_id":"방위사업청-공무용-차량-관리지침-제13조-제2호","item_number":"2","content":"차량담당자는 일과시간 개시 전 본 지침 제12조의 제2항에 따라 차량열쇠 및 주유카드를 회수하여야 한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000275514_ART_12"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_14","display_id":"방위사업청-공무용-차량-관리지침-제14조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"운행 중 고장 및 사고보고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_14_P0","display_id":"방위사업청-공무용-차량-관리지침-제14조","paragraph_number":"","paragraph_index":null,"content":"차량운행 중 고장 및 사고발생 시 안전 조치를 한 후 \"관리부서\"에 다음 각 호의 내용을 포함하여 통보한다.","items":[{"id":"DAPA_A_2100000275514_ART_14_P0_I1","display_id":"방위사업청-공무용-차량-관리지침-제14조-제1호","item_number":"1","content":"고장 또는 사고 내용 일시 및 장소","subitems":[]},{"id":"DAPA_A_2100000275514_ART_14_P0_I2","display_id":"방위사업청-공무용-차량-관리지침-제14조-제2호","item_number":"2","content":"안전조치 내용 및 견인차 출동 여부","subitems":[]},{"id":"DAPA_A_2100000275514_ART_14_P0_I3","display_id":"방위사업청-공무용-차량-관리지침-제14조-제3호","item_number":"3","content":"고장 및 사고 피해 사항 등","subitems":[]}]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000275514_ART_15","display_id":"방위사업청-공무용-차량-관리지침-제15조","regulation_id":"DAPA_A_2100000275514","regulation_name":"방위사업청 공무용 차량 관리지침","short_name":"방위사업청 공무용 차량 관리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"운전자 책임","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000275514_ART_15_P1","display_id":"방위사업청-공무용-차량-관리지침-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"공무 외 사적인 용도로 차량을 운행하여 사고를 낸 때에는 운전자가 모든 책임을 진다.","items":[]},{"id":"DAPA_A_2100000275514_ART_15_P2","display_id":"방위사업청-공무용-차량-관리지침-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"차량을 운행하는 중에 불법 주ㆍ정차위반, 제한속도위반 또는 전용차선위반 등 「도로교통법」 위반에 따라 처분된 과태료ㆍ범칙금ㆍ벌금 등은 운전자의 책임으로 한다.","items":[]},{"id":"DAPA_A_2100000275514_ART_15_P3","display_id":"방위사업청-공무용-차량-관리지침-제15조-제3항","paragraph_number":"③","paragraph_index":3,"content":"운전자가 고의 또는 중대한 과실(음주운전 등)로 인하여 인적, 물적 손해가 발생하였을 때에는 이를 변상할 책임을 진다.","items":[]}],"notes":[],"effective_date":"2026-03-05","revision_date":"2026-03-05","source_file":"방위사업청 공무용 차량 관리지침.json","source_path":"원문/법제처API/방위사업청 공무용 차량 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amend