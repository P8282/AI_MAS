ernal_references":[],"keywords":[]},{"id":"DAPA_A_2100000171533_ART_4","display_id":"방위산업기술-보호-유공자-포상규정-제4조","regulation_id":"DAPA_A_2100000171533","regulation_name":"방위산업기술 보호 유공자 포상규정","short_name":"방위산업기술 보호 유공자 포상규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"방위산업기술보호 유공자 선정심사위원회 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171533_ART_4_P1","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 신청 받은 자 또는 추천받은 자 중 포상·포상금 지급 대상자 및 지급액을 결정하기 위하여 \"방위산업기술 보호 유공자 선정심사위원회\"(이하 \"심사위원회\"라 한다.)를 구성하여 운영한다.","items":[]},{"id":"DAPA_A_2100000171533_ART_4_P2","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원장은 국방기술보호국장이 되고, 위원은 다음 각 호의 자 중 6인 이상 9인 이하로 구성한다.","items":[{"id":"DAPA_A_2100000171533_ART_4_P2_I1","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제2항-제1호","item_number":"1","content":"기술정책과장, 기술혁신과장, 기술보호과장, 기술심사과장","subitems":[]},{"id":"DAPA_A_2100000171533_ART_4_P2_I2","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제2항-제2호","item_number":"2","content":"기술관리 및 사업관리 관련 방위사업청 과·팀장","subitems":[]},{"id":"DAPA_A_2100000171533_ART_4_P2_I3","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제2항-제3호","item_number":"3","content":"방위산업기술 보호법 시행령 제5조제2항의 정보수사기관 담당과장","subitems":[]},{"id":"DAPA_A_2100000171533_ART_4_P2_I4","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제2항-제4호","item_number":"4","content":"산업기술보호협회, 전략물자관리원 해당분야 전문가","subitems":[]},{"id":"DAPA_A_2100000171533_ART_4_P2_I5","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제2항-제5호","item_number":"5","content":"방위산업기술 보호 자문단 중 관련분야 전문가","subitems":[]}]},{"id":"DAPA_A_2100000171533_ART_4_P3","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항제1호 내지 제3호 위원의 대리참석은 대리명령자 또는 위원회 개최 2일전까지 위원장의 승인을 득한 인원으로 한다.","items":[]},{"id":"DAPA_A_2100000171533_ART_4_P4","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"위원장과 위원은 별지 5호 서식의 청렴서약서를 작성한다","items":[]},{"id":"DAPA_A_2100000171533_ART_4_P5","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"위원의 임기는 그 직에 있는 동안 재임하는 것으로 한다. 단, 제2항제4호 및 제5호 각 위원의 임기는 2년으로 하며, 1회 연임이 가능하다.","items":[]},{"id":"DAPA_A_2100000171533_ART_4_P6","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"방위사업청장은 위원으로 임명·위촉된 자가 다음 각 호에 해당하는 경우, 임기만료 전이라도 해촉 할 수 있다.","items":[{"id":"DAPA_A_2100000171533_ART_4_P6_I1","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제6항-제1호","item_number":"1","content":"별지 제5호의 청렴서약서의 내용에 위반되는 행위를 한 경우","subitems":[]},{"id":"DAPA_A_2100000171533_ART_4_P6_I2","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제6항-제2호","item_number":"2","content":"위원 스스로 직무를 수행하는 것이 곤란하다고 의사를 밝히는 경우","subitems":[]}]},{"id":"DAPA_A_2100000171533_ART_4_P7","display_id":"방위산업기술-보호-유공자-포상규정-제4조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"심사위원회는 간사 1명을 둔다. 간사는 방위사업청 기술보호과 실무담당자 중에서 위원장이 정한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"방위산업기술 보호 유공자 포상규정.json","source_path":"원문/법제처API/방위산업기술 보호 유공자 포상규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_290401_ART_5"],"related_regulations":["DAPA_L_290401"],"external_references":[],"keywords":["청렴계약","대리"]},{"id":"DAPA_A_2100000171533_ART_5","display_id":"방위산업기술-보호-유공자-포상규정-제5조","regulation_id":"DAPA_A_2100000171533","regulation_name":"방위산업기술 보호 유공자 포상규정","short_name":"방위산업기술 보호 유공자 포상규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"심사위원회 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171533_ART_5_P1","display_id":"방위산업기술-보호-유공자-포상규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심사위원회의 회의는 재적위원 과반수의 출석으로 개의하고, 출석위원 과반수의 찬성으로 의결한다.","items":[]},{"id":"DAPA_A_2100000171533_ART_5_P2","display_id":"방위산업기술-보호-유공자-포상규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"회의는 비공개를 원칙으로 한다, 단, 공정한 심사 등을 위해 심사위원회 구성인원 외 참여 인원이 필요하거나 참여를 요청하는 경우 간사는 위원장의 승인을 얻어 참여 인원을 확정한다.","items":[]},{"id":"DAPA_A_2100000171533_ART_5_P3","display_id":"방위산업기술-보호-유공자-포상규정-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장과 위원은 별지 제6호 서식의 의결서에 찬반여부와 의견을 자필로 기록한 후 서명하여야한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"방위산업기술 보호 유공자 포상규정.json","source_path":"원문/법제처API/방위산업기술 보호 유공자 포상규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171533_ART_6","display_id":"방위산업기술-보호-유공자-포상규정-제6조","regulation_id":"DAPA_A_2100000171533","regulation_name":"방위산업기술 보호 유공자 포상규정","short_name":"방위산업기술 보호 유공자 포상규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"심사위원회 심사기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171533_ART_6_P1","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심사위원회는 다음 각 호의 사항을 고려하여 유공자를 선정한다","items":[{"id":"DAPA_A_2100000171533_ART_6_P1_I1","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제1항-제1호","item_number":"1","content":"방위산업기술보호를 위한 정책개발·제도개선의 적절성 및 효과성","subitems":[]},{"id":"DAPA_A_2100000171533_ART_6_P1_I2","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제1항-제2호","item_number":"2","content":"방위산업기술의 유출 및 침해 신고로 인한 공익 기여도 다만, 이때 신고는「방위산업기술 보호법」제21조부터 제24조의 행위를 대상으로 한다.","subitems":[]},{"id":"DAPA_A_2100000171533_ART_6_P1_I3","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제1항-제3호","item_number":"3","content":"방위산업기술 보호 분야 강연·논문·기고·아이디어 발굴 및 홍보활동 실적","subitems":[]},{"id":"DAPA_A_2100000171533_ART_6_P1_I4","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제1항-제4호","item_number":"4","content":"방위산업기술 보호 관련 기술개발에 따른 국가 안보 및 경제 발전 기여도","subitems":[]},{"id":"DAPA_A_2100000171533_ART_6_P1_I5","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제1항-제5호","item_number":"5","content":"그 외 방위산업기술 보호에 기여한 공이 큰 경우","subitems":[]}]},{"id":"DAPA_A_2100000171533_ART_6_P2","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"포상금은 제①항의 기준을 통해 선정된 유공자 중에 당해 회계연도 예산의 범위 내에서 방위산업기술 보호법 시행규칙 제5조 별표 기준액에 따라 지급액을 결정한다.","items":[]},{"id":"DAPA_A_2100000171533_ART_6_P3","display_id":"방위산업기술-보호-유공자-포상규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"정부기관 등에 의해 신청내용과 동일한 내용으로 금전적 보상을 받은 자는 포상금 지급대상에서 제외한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"방위산업기술 보호 유공자 포상규정.json","source_path":"원문/법제처API/방위산업기술 보호 유공자 포상규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_283945_ART_21","DAPA_L_283945_ART_24","DAPA_L_289785_ART_5"],"related_regulations":["DAPA_L_283945","DAPA_L_289785"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171533_ART_7","display_id":"방위산업기술-보호-유공자-포상규정-제7조","regulation_id":"DAPA_A_2100000171533","regulation_name":"방위산업기술 보호 유공자 포상규정","short_name":"방위산업기술 보호 유공자 포상규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"포상금 환수","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171533_ART_7_P0","display_id":"방위산업기술-보호-유공자-포상규정-제7조","paragraph_number":"","paragraph_index"