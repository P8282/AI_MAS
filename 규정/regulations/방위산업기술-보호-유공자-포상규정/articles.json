[{"id":"DAPA_A_2100000171533_ART_1","display_id":"방위산업기술-보호-유공자-포상규정-제1조","regulation_id":"DAPA_A_2100000171533","regulation_name":"방위산업기술 보호 유공자 포상규정","short_name":"방위산업기술 보호 유공자 포상규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171533_ART_1_P0","display_id":"방위산업기술-보호-유공자-포상규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위산업기술 보호법」제17조, 동법 시행령 제22조, 동법 시행규칙 제5조에 따른 방위산업기술 보호 유공자에 대한 포상 및 포상금 지급 기준과 방법 등에 관한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"방위산업기술 보호 유공자 포상규정.json","source_path":"원문/법제처API/방위산업기술 보호 유공자 포상규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_283945_ART_17","DAPA_A_2100000171533_ART_5"],"related_regulations":["DAPA_L_283945"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171533_ART_2","display_id":"방위산업기술-보호-유공자-포상규정-제2조","regulation_id":"DAPA_A_2100000171533","regulation_name":"방위산업기술 보호 유공자 포상규정","short_name":"방위산업기술 보호 유공자 포상규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"추천절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171533_ART_2_P1","display_id":"방위산업기술-보호-유공자-포상규정-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은「방위산업기술 보호법」시행령 제22조제1항에 따라 포상 및 포상금 지급대상자 추천을 위하여 다음 각 호의 사항을 명시하여 공고한다.","items":[{"id":"DAPA_A_2100000171533_ART_2_P1_I1","display_id":"방위산업기술-보호-유공자-포상규정-제2조-제1항-제1호","item_number":"1","content":"접수기간 및 접수처","subitems":[]},{"id":"DAPA_A_2