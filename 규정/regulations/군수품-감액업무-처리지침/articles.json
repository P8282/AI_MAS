:[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_3","display_id":"군수품-감액업무-처리지침-제3조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제1장 총칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_3_P0","display_id":"군수품-감액업무-처리지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000257964_ART_3_P0_I1","display_id":"군수품-감액업무-처리지침-제3조-제1호","item_number":"1","content":"\"감액\"이란 계약물품이 규격과 부합하지 않으나 사용목적 또는 효용가치에 비추어 사용상 지장이 없다고 인정될 경우 계약금액에 대한 지급금액의 삭감을 말한다.","subitems":[]},{"id":"DAPA_A_2100000257964_ART_3_P0_I2","display_id":"군수품-감액업무-처리지침-제3조-제2호","item_number":"2","content":"\"감액대상금액\"이란 계약 기술요구조건에 불일치하는 특정의 품목(완제품, 부품)에 대한 계약가를 말한다. 단, 물자류의 경우에는 원ㆍ부자재를 포함한다.","subitems":[]},{"id":"DAPA_A_2100000257964_ART_3_P0_I3","display_id":"군수품-감액업무-처리지침-제3조-제3호","item_number":"3","content":"\"감액산정 허용기준\"이란 감액대상 품목에 대하여 검사항목별로 허용된 미달(또는 초과) 정도를 말한다.","subitems":[]},{"id":"DAPA_A_2100000257964_ART_3_P0_I4","display_id":"군수품-감액업무-처리지침-제3조-제4호","item_number":"4","content":"\"기준감액률\"이란 검사항목별로 지정된 중요도등급에 부여된 비율로써 감액률 산정시 기준이 되는 비율을 말한다.","subitems":[]},{"id":"DAPA_A_2100000257964_ART_3_P0_I5","display_id":"군수품-감액업무-처리지침-제3조-제5호","item_number":"5","content":"\"적용비율\"이란 감액률 산정시 적용되는 비율로써 미달율(또는 초과율)을 감액산정 허용기준으로 나눈 값을 구간별로 구분하여 정한 비율을 말한다.","subitems":[]},{"id":"DAPA_A_2100000257964_ART_3_P0_I6","display_id":"군수품-감액업무-처리지침-제3조-제6호","item_number":"6","content":"\"미달율(또는 초과율)\"이란 검사 또는 시험 결과 품질특성이 계약서에 포함된 품질 요구조건(규격치)에 비해 미달(또는 초과)되는 비율을 말한다.","subitems":[]},{"id":"DAPA_A_2100000257964_ART_3_P0_I7","display_id":"군수품-감액업무-처리지침-제3조-제7호","item_number":"7","content":"\"중요도등급\"이란 규격과 불일치한 검사항목이 건강, 성능, 호환성, 신뢰성, 사용편의성 등에 미치는 영향의 정도에 따라 기준감액률을 정하기 위하여 부여된 등급을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["검사"]},{"id":"DAPA_A_2100000257964_ART_4","display_id":"군수품-감액업무-처리지침-제4조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제1장 총칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"업무분장 및 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_4_P0","display_id":"군수품-감액업무-처리지침-제4조","paragraph_number":"","paragraph_index":null,"content":"감액업무를 수행하는 기관ㆍ부서별 업무분장은 다음 각 호와 같으며, 감액업무 처리절차는 별표 4 감액처리 절차도(물자류) 및 별표 5 감액처리 절차도(장비류)에 따른다.","items":[{"id":"DAPA_A_2100000257964_ART_4_P0_I1","display_id":"군수품-감액업무-처리지침-제4조-제1호","item_number":"1","content":"형상관리책임기관가. 중면제 승인품목에 대한 감액산정 및 감액승인나. 경면제 승인품목에 대한 감액승인","subitems":[]},{"id":"DAPA_A_2100000257964_ART_4_P0_I2","display_id":"군수품-감액업무-처리지침-제4조-제2호","item_number":"2","content":"계약팀 : 계약물품 대가 지출시 감액조치 의뢰","subitems":[]},{"id":"DAPA_A_2100000257964_ART_4_P0_I3","display_id":"군수품-감액업무-처리지침-제4조-제3호","item_number":"3","content":"원가팀 : 형상관리책임기관 또는 국방기술품질원이 감액대상 원ㆍ부자재 및 부품에 대한 금액의 자료요청 시 해당자료 제공","subitems":[]},{"id":"DAPA_A_2100000257964_ART_4_P0_I4","display_id":"군수품-감액업무-처리지침-제4조-제4호","item_number":"4","content":"국방기술품질원가. 경면제 승인품목에 대한 감액산정나. 감액승인품목에 대한 검사조서 발행","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_5","display_id":"군수품-감액업무-처리지침-제5조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제1장 총칙","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"감액 적용 제외대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_5_P0","display_id":"군수품-감액업무-처리지침-제5조","paragraph_number":"","paragraph_index":null,"content":"다음 각 호의 경우에는 감액 적용을 제외한다.","items":[{"id":"DAPA_A_2100000257964_ART_5_P0_I1","display_id":"군수품-감액업무-처리지침-제5조-제1호","item_number":"1","content":"요구된 규격 및 품질조건에는 불일치하나, 요구수준 이상의 재질사용으로 성능향상, 원가 절감 등 소요군이 동의하여 납품을 수락하는 경우(예 : 동일 용도의 우수 재질 사용 시 등)","subitems":[]},{"id":"DAPA_A_2100000257964_ART_5_P0_I2","display_id":"군수품-감액업무-처리지침-제5조-제2호","item_number":"2","content":"부적절한 기술요구조건, 미비한 규격 등 명백하게 계약업체의 잘못이 아닌 사유로 발생한 규격불일치품목에 대해 형상관리책임기관, 국방기술품질원에서 면제 승인하여 납품을 수락하는 경우","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_6","display_id":"군수품-감액업무-처리지침-제6조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제2장 물자류 감액처리","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"기본방침","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_6_P1","display_id":"군수품-감액업무-처리지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"\"물자류\"의 적용범위는「국방전력발전업무훈령」별표2-2(전력지원체계 세부분류)의2. 전투지원물자에서 정한 군수품을 말하며, 이를 구성하는 부품(구성품, 결합체, 부분품) 또는 원ㆍ부자재를 포함한다.","items":[]},{"id":"DAPA_A_2100000257964_ART_6_P2","display_id":"군수품-감액업무-처리지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"감액처리는 품질보증활동 중 규격불일치 정도가 별표 3에서 정하고 있는 감액산정 허용기준 내에 속할 경우에 한하여 할 수 있다. 다만, 감액산정 허용기준을 초과하는 경우라도 그 자체로 사용함에 있어 목적수행이 가능하고 경제성, 긴급성 등을 고려 소요군의 동의 하에 수납하는 것이 바람직하다고 판단되는 경우에는 예외로 할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_7","display_id":"군수품-감액업무-처리지침-제7조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제2장 물자류 감액처리","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"감액 산정절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_7_P1","display_id":"군수품-감액업무-처리지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"감액은 별표 3의 주기 9에 따라 별표 1의 적용비율과 별표 2의 기준감액률을 선택한 후 다음의 산정식에 대입하여 산정한다.","items":[{"id":"DAPA_A_2100000257964_ART_7_P1_I1","display_id":"군수품-감액업무-처리지침-제7조-제1항-제1호","item_number":"1","content":"감액률 = 적용비율 × 기준감액률","subitems":[]},{"id":"DAPA_A_2100000257964_ART_7_P1_I2","display_id":"군수품-감액업무-처리지침-제7조-제1항-제2호","item_number":"2","content":"감액 = 감액대상금액 × 감액률","subitems":[]}]},{"id":"DAPA_A_2100000257964_ART_7_P2","display_id":"군수품-감액업무-처리지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"감액대상금액은 다음과 같은 기준으로 적용한다.","items":[{"id":"DAPA_A_2100000257964_ART_7_P2_I1","display_id":"군수품-감액업무-처리지침-제7조-제2항-제1호","item_number":"1","content":"감액대상이 되는 특정 완제품의 가격은 계약서상의 계약단가를 적용할 것","subitems":[]},{"id":"DAPA_A_2100000257964_ART_7_P2_I2","display_id":"군수품-감액업무-처리지침-제7조-제2항-제2호","item_number":"2","content":"감액대상이 되는 원ㆍ부자재, 부품 등은 부가가치세율(10%)과 원가 대비 계약가율을 감안한 가격으로 원가팀장이 산정한 금액을 적용할 것","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_8","display_id":"군수품-감액업무-처리지침-제8조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제2장 물자류 감액처리","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"복수 항목의 규격불일치 사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_8_P1","display_id":"군수품-감액업무-처리지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"특정검사대상에서 2개 이상 검사항목의 규격불일치 사항이 발생되어 감액을 적용할 경우는 각 각의 항목별로 감액을 산정 후 합산한다.","items":[]},{"id":"DAPA_A_2100000257964_ART_8_P2","display_id":"군수품-감액업무-처리지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"다음 각 호에 해당하는 경우 감액을 적용할 수 없으며, 이때 규격 불일치된 원자재는 재 확보하여야 한다.","items":[{"id":"DAPA_A_2100000257964_ART_8_P2_I1","display_id":"군수품-감액업무-처리지침-제8조-제2항-제1호","item_number":"1","content":"1개 품목에 대하여 원자재 3종 이상 규격불일치 시","subitems":[]},{"id":"DAPA_A_2100000257964_ART_8_P2_I2","display_id":"군수품-감액업무-처리지침-제8조-제2항-제2호","item_number":"2","content":"1개 원자재에 대하여 3개 항목 이상 규격불일치 시","subitems":[]},{"id":"DAPA_A_2100000257964_ART_8_P2_I3","display_id":"군수품-감액업무-처리지침-제8조-제2항-제3호","item_number":"3","content":"1개 원자재에 중요도 등급 \"A\"가 2개 항목 이상 규격불일치 시","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_9","display_id":"군수품-감액업무-처리지침-제9조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제2장 물자류 감액처리","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"가중감액률 적용 대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_9_P0","display_id":"군수품-감액업무-처리지침-제9조","paragraph_number":"","paragraph_index":null,"content":"다음 각 호에 해당하는 경우에는 적용 감액률의 2배를 적용한다.","items":[{"id":"DAPA_A_2100000257964_ART_9_P0_I1","display_id":"군수품-감액업무-처리지침-제9조-제1호","item_number":"1","content":"제6조제2항에 따라 미달율(또는 초과율)이 감액산정 허용기준을 초과한 경우의 감액률 적용 시","subitems":[]},{"id":"DAPA_A_2100000257964_ART_9_P0_I2","display_id":"군수품-감액업무-처리지침-제9조-제2호","item_number":"2","content":"동일 계약 여부와 상관없이 동일업체가 생산한 동일 품목에서 동일한 항목의 규격불일치가 발생되어 반복 면제 승인으로 인한 감액률 적용 시","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000257964_ART_6"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_10","display_id":"군수품-감액업무-처리지침-제10조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제3장 장비류 감액처리","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"기본방침","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_10_P1","display_id":"군수품-감액업무-처리지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"\"장비류\"의 적용범위는「국방전력발전업무훈령」별표2(무기체계 세부분류) 및 별표2-2(전력지원체계 세부분류)의1.전투지원장비(부품)에서 정한 군수품을 말하며, 이를 구성하는 부품(구성품, 결합체, 부분품)을 포함한다.","items":[]},{"id":"DAPA_A_2100000257964_ART_10_P2","display_id":"군수품-감액업무-처리지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"감액처리는 「방위사업 품질관리 규정」제40조제1항에 따라 중ㆍ경면제 승인품목에 한하여 할 수 있다. 다만, 중면제 승인품목의 감액처리를 할 경우에는 별표 6의 장비류 감액산정방식(경면제 승인품목)과 소요군의 의견 등을 고려하여 방위사업기획ㆍ관리분과위원회 또는 방위사업기획ㆍ관리실무위원회의 심의를 거쳐 결정할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000285644_ART_40"],"related_regulations":["DAPA_A_2100000285644"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_11","display_id":"군수품-감액업무-처리지침-제11조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제3장 장비류 감액처리","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"경면제 승인품목의 감액 산정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_11_P1","display_id":"군수품-감액업무-처리지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"경면제 승인품목의 감액은 별표 6에 따라 품질특성, 장비형태, 결함부위를 고려하여 중요도를 산출한 후 다음의 감액산정식에 대입하여 산정한다.","items":[{"id":"DAPA_A_2100000257964_ART_11_P1_I1","display_id":"군수품-감액업무-처리지침-제11조-제1항-제1호","item_number":"1","content":"감액률 = 중요도 × 기준감액률","subitems":[]},{"id":"DAPA_A_2100000257964_ART_11_P1_I2","display_id":"군수품-감액업무-처리지침-제11조-제1항-제2호","item_number":"2","content":"감액 = 감액대상금액 × 감액률","subitems":[]}]},{"id":"DAPA_A_2100000257964_ART_11_P2","display_id":"군수품-감액업무-처리지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"감액대상금액은 결함이 포함된 부분을 기준으로 다음과 같이 적용한다. 다만 계약명세서 상의 납품 품목단위가 아닌 경우에는 원가팀장이 산정한 금액을 적용할 수 있다.","items":[{"id":"DAPA_A_2100000257964_ART_11_P2_I1","display_id":"군수품-감액업무-처리지침-제11조-제2항-제1호","item_number":"1","content":"결함부분이 분리되는 경우는 해당부분에 해당하는 가격을 적용할 것","subitems":[]},{"id":"DAPA_A_2100000257964_ART_11_P2_I2","display_id":"군수품-감액업무-처리지침-제11조-제2항-제2호","item_number":"2","content":"결함부분이 분리되지 않는 경우는 결함부분이 포함된 상위 조립체 가격을 적용할 것","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_12","display_id":"군수품-감액업무-처리지침-제12조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제3장 장비류 감액처리","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"복수 항목 및 가중감액의 처리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_12_P1","display_id":"군수품-감액업무-처리지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"별표 6의 중요도 산출방식에서 결함요소 중 품질특성의 구성인자인 \"외형\"과 \"일솜씨\"가 동시에 포함된 경우에는 구성인자의 비중을 \"1\"로 적용하여 중요도를 산정한다.","items":[]},{"id":"DAPA_A_2100000257964_ART_12_P2","display_id":"군수품-감액업무-처리지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"동일 계약 여부와 상관없이 동일업체가 생산한 동일 품목에서 동일한 항목의 규격불일치가 발생되어 반복 면제 승인할 경우에는 산정액의 2배를 적용한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_13","display_id":"군수품-감액업무-처리지침-제13조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제3장 장비류 감액처리","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"감액의 제한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257964_ART_13_P0","display_id":"군수품-감액업무-처리지침-제13조","paragraph_number":"","paragraph_index":null,"content":"감액은 계약금액의 최대 30% 이하의 범위에서 산정하는 것을 원칙으로 한다. 다만, 장비류 중면제 승인품목 감액의 경우 또는 가중감액의 경우에는 이를 적용하지 않는다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"군수품 감액업무 처리지침.json","source_path":"원문/법제처API/군수품 감액업무 처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257964_ART_14","display_id":"군수품-감액업무-처리지침-제14조","regulation_id":"DAPA_A_2100000257964","regulation_name":"군수품 감액업무 처리지침","short_name":"군수품 감액업무 처리지침","document_type":"예규","part":"","chapter":"제4장 보칙","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"수치의 맺음","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAP