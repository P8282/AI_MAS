[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_1","display_id":"방위사업청-물품-적격심사-기준-제1조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_1_P0","display_id":"방위사업청-물품-적격심사-기준-제1조","paragraph_number":"","paragraph_index":null,"content":"이 기준은 「국가를 당사자로 하는 계약에 관한 법률 시행령」(이하 \"국가계약법 시행령\"이라 한다) 제42조제5항 단서에 따라 방위사업청에서 경쟁입찰을 통해 조달하는 물품 제조ㆍ구매계약의 낙찰자 결정에 적용할 계약이행능력의 심사기준을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"1","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_42"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["낙찰자"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_2","display_id":"방위사업청-물품-적격심사-기준-제2조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"심사대상 및 심사기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_2_P1","display_id":"방위사업청-물품-적격심사-기준-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 기준에 따른 심사는 국가계약법 시행령 제42조제1항과 「중소기업제품 구매촉진 및 판로지원에 관한 법률」 제4조제2항에 해당하는 물품 제조ㆍ구매계약 중 계약이행능력을 심사하여 낙찰자를 결정하는 입찰을 대상으로 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_2_P2","display_id":"방위사업청-물품-적격심사-기준-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심사의 적용기준은 다음 각 호에 의한다.","items":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_2_P2_I1","display_id":"방위사업청-물품-적격심사-기준-제2조-제2항-제1호","item_number":"1","content":"심사기준일\n심사기준일은 다른 법령 등에서 정한 것을 제외하고는 입찰참가 등록마감일 전일로 한다. 다만, 당해물품 납품이행능력 결격여부 사항에 대하여는 적격심사낙찰자 통보일 현재로 한다.","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_2_P2_I2","display_id":"방위사업청-물품-적격심사-기준-제2조-제2항-제2호","item_number":"2","content":"외화표시금액\n납품(판매)실적 등의 외화표시 금액은 원화로 환산하여 표시하며, 적용환율은 입찰참가 등록마감일 전일의 외국환거래법에 의한 기준환율 또는 재정환율(매매기준율)을 적용한다. 다만, 외화와 원화가 동시에 표시된 경우에는 원화를 적용한다.","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_2_P2_I3","display_id":"방위사업청-물품-적격심사-기준-제2조-제2항-제3호","item_number":"3","content":"계산결과 소수점 이하 숫자 처리\n비율, 평점(입찰가격 포함) 등을 계산한 결과 소수점 이하의 숫자가 있는 경우에는 별도로 정하지 않으면 소수점 다섯째 자리에서 반올림한다. 이때 비율은 백분율(%)단위로 전환 이전단계의 수치를 의미한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"1","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_42","SME_PRODUCT_PROCUREMENT_ACT_ART_4"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT","SME_PRODUCT_PROCUREMENT_ACT"],"external_references":[],"keywords":["입찰참가자격"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_3","display_id":"방위사업청-물품-적격심사-기준-제3조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"심사항목 및 배점한도","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_3_P1","display_id":"방위사업청-물품-적격심사-기준-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사의 심사항목 및 배점한도는 다음 각 호에 의한다.","items":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_3_P1_I1","display_id":"방위사업청-물품-적격심사-기준-제3조-제1항-제1호","item_number":"1","content":"추정가격이 고시금액(국가계약법 시행령 제2조제3호의 재정경제부장관이 고시한 금액을 말한다. 이하 같다.) 이상인 물품 제조 또는 구매입찰 : [별표 1]","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_3_P1_I2","display_id":"방위사업청-물품-적격심사-기준-제3조-제1항-제2호","item_number":"2","content":"추정가격이 고시금액 미만인 물품 제조 또는 구매입찰 : [별표 1의2]","subitems":[]}]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_3_P2","display_id":"방위사업청-물품-적격심사-기준-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 계약의 특성ㆍ목적 및 내용 등을 종합 고려하여 심사분야별 배점한도(입찰가격은 제외)를 20% 범위 내에서 가ㆍ감 조정할 수 있으며, 항목별(신인도 제외) 세부사항을 추가하거나 제외할 수 있다. 이 경우 입찰공고 또는 입찰설명서에 조정내용을 명시하여야 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_3_P3","display_id":"방위사업청-물품-적격심사-기준-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"신인도를 평가함에 있어서는 당해물품납품이행능력 취득점수가 당해물품납품이행능력 배점한도에 미달한 경우에만 배점한도 내에서 신인도총평점을 더하고, 신인도 총평점이 음인 경우에는 신인도 평가 이외에서 취득한 총점에서 뺀다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"1","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_2"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["배점한도","신인도","추정가격","물품"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4","display_id":"방위사업청-물품-적격심사-기준-제4조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"제출서류","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 적격심사 대상자에게 입찰일 또는 통보일로부터 7일 이내에 다음 각 호의 서류를 제출하도록 하여야 한다.","items":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I1","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제1호","item_number":"1","content":"적격심사신청서 1부(별지 제1호 서식)","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I2","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제2호","item_number":"2","content":"적격심사 자기평가 및 심사표 1부(별지 제2호 서식) 및 항목별 평점 세부내역 1부(별지 제2-1호 서식)","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I3","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제3호","item_number":"3","content":"물품납품실적증명원 1부(별지 제3호 서식)","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I4","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제4호","item_number":"4","content":"「신용정보의 이용 및 보호에 관한 법률」 제4조제2항  또는 「자본시장과 금융투자업에 관한 법률」제335조의3에 따라 업무를 영위하는 신용정보회사 또는 신용평가회사가 발급한 신용평가등급확인서(공공기관제출용) 1부","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I4_2","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제4호의2","item_number":"4의2","content":"추정가격 10억 이상 제조계약인 경우「신용정보의 이용 및 보호에 관한 법률」제4조제2항에 따라 업무를 영위하는 신용정보회사가 발급한 기술평가등급확인서(공공기관제출용) 1부","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I5","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제5호","item_number":"5","content":"입찰참가등록 마감일 전일부터 과거 2년 이내에 지체상금을 부과받은 사실이 있는 자로서 위 지체상금에 대한 면제원이 해당 계약에서 제출된 경우(입찰참가등록 마감일 전일 이후부터 위 7일 이내에 제출된 경우도 포함), 지체상금 면제원 제출 현황(계약번호, 계약건명, 납품일자 및 지체상금면제원 제출일자) 및 위 지체상금 면제원이 결정된 경우 지체상금 면제원 결정 현황(결정일, 결정금액)","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I6","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제6호","item_number":"6","content":"제5호의 지체상금 면제원이 취소 요청된 경우 취소 요청 서류","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P1_I7","display_id":"방위사업청-물품-적격심사-기준-제4조-제1항-제7호","item_number":"7","content":"기타 제출서류 각 1부(별지 제4호 서식 참조)","subitems":[]}]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에도 불구하고 계약담당공무원은 통합사업관리정보체계 또는 중소기업제품 공공구매종합정보망을 통해 확인이 가능한 다음 각 호의 서류는 적격심사 대상자로부터 제출받지 않고 직접 확인하여 적용할 수 있다.","items":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I1","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제1호","item_number":"1","content":"신용평가등급확인서","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I2","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제2호","item_number":"2","content":"직접생산확인서","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I3","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제3호","item_number":"3","content":"여성기업확인서","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I4","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제4호","item_number":"4","content":"장애인기업확인서","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I5","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제5호","item_number":"5","content":"기술혁신형중소기업확인서","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I6","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제6호","item_number":"6","content":"경영혁신형중소기확인서","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I7","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제7호","item_number":"7","content":"수출유망중소기업확인서","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P2_I8","display_id":"방위사업청-물품-적격심사-기준-제4조-제2항-제8호","item_number":"8","content":"벤처기업확인서","subitems":[]}]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P3","display_id":"방위사업청-물품-적격심사-기준-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 제1항에 의하여 제출된 적격심사서류상 첨부목록에 있는 서류가 누락되어 있거나 제출된 서류가 불명확하여 인지할 수 없는 경우에는 3일 이상의 기한을 정하여 보완을 요구할 수 있다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P4","display_id":"방위사업청-물품-적격심사-기준-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항에 의한 기한까지 보완 요구된 서류가 제출되지 아니한 경우에는 당초 제출된 서류만으로 심사하되, 당초 제출된 서류가 불명확하여 심사하기가 곤란한 경우에는 심사에서 제외한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P5","display_id":"방위사업청-물품-적격심사-기준-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"해당 평가항목의 제출실적이 없는 경우에는 해당 평가항목의 최저점을 부여한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_4_P6","display_id":"방위사업청-물품-적격심사-기준-제4조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"제1항 내지 제3항에 따라 제출 또는 확인할 서류로서 입찰참가 등록마감일 전일 이후에 발생 또는 신고하였거나 수정된 자료는 평가에서 제외한다. 다만 제1항에 의한 기한(제3항이 적용되는 경우에는 제3항에 의한 기한 )까지 해당 계약에서 지체상금 면제원이 제출된 경우에는 위 면제원 서류를 포함하여 [별표 1]에서 정한 바에 따라 평가한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"2","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["신용정보의 이용 및 보호에 관한 법률","자본시장과 금융투자업에 관한 법률"],"keywords":["지체상금","신용평가","경영상태","적격심사","직접생산","입찰참가자격"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_5","display_id":"방위사업청-물품-적격심사-기준-제5조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"평가방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_5_P1","display_id":"방위사업청-물품-적격심사-기준-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 예정가격 이하로서 최저가로 입찰한 자 순으로 심사한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_5_P2","display_id":"방위사업청-물품-적격심사-기준-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 [별표 1]과 [별표 1의2]의 항목별 배점한도 내에서 평가한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_5_P3","display_id":"방위사업청-물품-적격심사-기준-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 당해물품 납품이행능력 평가를 위한 납품실적 평가기준(계약목적물과 동등 이상과 유사물품 범위)을 입찰공고에 명시하여야 한다. 이때 납품실적은 계약일자와 관계없이 최근 3년 이내에 납품 완료된 실적을 말한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_5_P4","display_id":"방위사업청-물품-적격심사-기준-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"합병의 경우 존속되거나 신설된 업체의 실적은 소멸된 자의 실적을 승계한 것으로 합산하여 평가하며, 분할되는 회사의 실적은 분할로 인하여 해당영업이 속하게 되는 회사(분할로 인해 신설되는 회사 또는 분할되는 일부 영업과 합병하는 회사)의 해당 영업 실적으로 본다. 다만, 해당 영업의 인적ㆍ물적 조직은 물론 관련 권리의무가 포괄적으로 양도 양수되는 포괄 영업양도의 경우 예외적으로 양도업체의 해당 영업실적은 양수업체의 실적으로 본다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_5_P5","display_id":"방위사업청-물품-적격심사-기준-제5조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제4항에 따른 실적 평가 시 합병ㆍ분할과 관련한 업체의 실적증빙서류를 제출받아 평가하여야 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_5_P6","display_id":"방위사업청-물품-적격심사-기준-제5조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"신인도 평가 중 계약이행성실도의 납품지연 심사항목은 해당 계약에서 지체상금 면제원이 제출된 경우 [별표 1]에서 정한 바에 따라 평가한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"3","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["신인도","수행실적","예정가격"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_6","display_id":"방위사업청-물품-적격심사-기준-제6조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"공동수급체 등에 대한 평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_6_P1","display_id":"방위사업청-물품-적격심사-기준-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"공동수급체로 참여하는 경우에는 구성원별 출자비율 또는 분담부분을 입찰참가 등록 시까지 확정하여 제출하여야 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_6_P2","display_id":"방위사업청-물품-적격심사-기준-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심사대상자가 공동수급체인 경우에는 구성원별 평가결과에 각자의 출자비율 또는 분담부분을 반영하여 평가한다. 이때 납품실적은 구성원별 출자비율 또는 분담부분을 기준으로 개별 평가한 후 각자의 분담률을 반영하여 적용한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_6_P3","display_id":"방위사업청-물품-적격심사-기준-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"「중소기업협동조합법」에 의한 중소기업협동조합이 적격조합으로 물품의 제조 또는 구매에 관한 경쟁 입찰에 참가하는 경우 배정 받을 조합원은 당해 입찰참가자격조건을 구비하여야 한다. 적격조합이 확정한 계약이행 업체는 부도, 파산 등 특별한 사유로 당해업체의 계약이행이 불가능한 경우 외에는 계약 이행완료시까지 다른 조합원으로 변경할 수 없다. 적격조합의 심사는 당해계약을 이행할 출자 또는 분담업체에 대하여 심사하며 제1항 및 제2항의 평가방법에 의해 평가한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"3","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체","입찰참가자격","계약의 이행"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_7","display_id":"방위사업청-물품-적격심사-기준-제7조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"결격사유의 심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_7_P1","display_id":"방위사업청-물품-적격심사-기준-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심사대상자가 부도ㆍ파산상태인 경우에는 결격사유로 평가하며, 부도ㆍ파산의 우려가 있어 계약이행이 어렵다고 판단되는 경우에는 적격심사위원회의 심사결과에 따라 결격여부를 결정한다. 이 경우 심사대상자에게 자료의 제출을 요구하거나 관계자 또는 전문가의 의견을 청취 또는 자문을 받을 수 있다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_7_P2","display_id":"방위사업청-물품-적격심사-기준-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"공동수급체의 대표자가 부도ㆍ파산상태인 경우에는 해당 공동수급체의 결격사유로 평가하며, 대표자 이외의 구성원 중 부도ㆍ파산상태인 자가 있는 경우로서 잔여 구성원만으로 계약이행이 가능한 경우에는 적격심사를 할 수 있다. 이 경우 계약담당공무원은 공동수급협정 내용을 변경하게 할 수 있다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_7_P3","display_id":"방위사업청-물품-적격심사-기준-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"저가입찰 또는 생산능력 부족으로 배점한도 최고점(신인도점수 포함)을 적용하여도 95점이 미달될 때에는 적격심사서류 접수를 생략하고 부적격 처리할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"3","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체","적격심사","계약의 이행"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_8","display_id":"방위사업청-물품-적격심사-기준-제8조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"재심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_8_P1","display_id":"방위사업청-물품-적격심사-기준-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사결과 부적격통보를 받은 자가 통보일로부터 3일 이내에 심사결과에 대해 재심사를 요청하였을 때에는 특별한 사유가 없는 한 재심사요청서 접수일로부터 3일 이내에 재심사를 하여야 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_8_P2","display_id":"방위사업청-물품-적격심사-기준-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 재심사결과는 해당자에게 지체 없이 통보하여야 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_8_P3","display_id":"방위사업청-물품-적격심사-기준-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항의 재심사요청서를 접수할 때에는 추가서류를 접수할 수 없다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_8_P4","display_id":"방위사업청-물품-적격심사-기준-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"재심사의 적격심사위원회 구성은 최초 적격심사위원회 위원과 중복되지 않는 5인 이상의 담당관으로 구성하며, 위원장은 팀장급으로 편성한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"3-4","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["적격심사"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_9","display_id":"방위사업청-물품-적격심사-기준-제9조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"낙찰자 결정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_9_P1","display_id":"방위사업청-물품-적격심사-기준-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"예정가격 이하로서 최저가 입찰자순으로 심사를 진행하여 심사결과 종합평점이95점 이상인 입찰자를 낙찰자로 결정하고, 종합평점이 95점 미만일 경우에 차순위 입찰자 순으로 심사하여 낙찰자를 결정한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_9_P2","display_id":"방위사업청-물품-적격심사-기준-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"동일가격의 최저가 입찰자가 2인 이상일 경우, 적격심사결과 종합평점이 95점이상인 자 중에서 최고점수인 자를 낙찰자로 결정하며, 평가점수가 동일한 경우에는 추첨으로 낙찰자를 결정한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_9_P3","display_id":"방위사업청-물품-적격심사-기준-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"적격심사에 소요되는 행정소요기간을 감안하여 필요하다고 인정되는 경우에는 예정가격 이내 입찰자를 대상으로 동시에 적격심사서류를 제출받을 수 있다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_9_P4","display_id":"방위사업청-물품-적격심사-기준-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약의 특성상 평가가 곤란한 항목이 있는 경우에는 입찰공고 시 그 내용을 명시하여 그 항목을 제외한 나머지 심사항목만으로 심사하고, 심사결과 종합평점이 나머지 심사항목 배점한도의 100분의 95 이상인 자를 낙찰자로 결정할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"4","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["낙찰자","예정가격","적격심사","최저가낙찰"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_10","display_id":"방위사업청-물품-적격심사-기준-제10조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"적격심사위원회 구성 및 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_10_P1","display_id":"방위사업청-물품-적격심사-기준-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공정하고 합리적인 심사를 위해 적격심사위원회를 구성하여 심사할 수 있다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_10_P2","display_id":"방위사업청-물품-적격심사-기준-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 경우 심사위원은 관계부서의 5인 이상 담당관으로 구성하며 필요한 경우 외부전문가를 포함하여 구성 할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"4","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["적격심사"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_11","display_id":"방위사업청-물품-적격심사-기준-제11조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"생산능력의 확인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_11_P1","display_id":"방위사업청-물품-적격심사-기준-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 업체의 생산능력을 확인할 필요가 있는 물품에 대해서는 그 내용을 입찰공고 조건에 명시하여야 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_11_P2","display_id":"방위사업청-물품-적격심사-기준-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 생산능력 확인대상은 입찰결과 예정가격 이내의 입찰업체에 한하여 적용한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_11_P3","display_id":"방위사업청-물품-적격심사-기준-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항에 따른 생산능력의 확인을 위한 기준은 방위사업청장이 별도로 정한 「업체 생산 및 정비능력 확인 지침」을 적용한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"4","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["예정가격"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_12","display_id":"방위사업청-물품-적격심사-기준-제12조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"평가결과 설명 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_12_P1","display_id":"방위사업청-물품-적격심사-기준-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"입찰에 참여한 업체는 본인의 적격심사결과에 대해 설명을 원하는 경우 심사결과를 통보받은 날로부터 3근무일 이내에 서면(형식 불문)으로 요청할 수 있다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_12_P2","display_id":"방위사업청-물품-적격심사-기준-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"해당 계약팀장은 설명 요청서가 접수된 날로부터 5근무일 이내에 [별지 제5호]를 참고하여 설명을 실시한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_12_P3","display_id":"방위사업청-물품-적격심사-기준-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"적격심사결과에 이의가 있는 업체는 설명일로부터 3근무일 이내에 이의신청을 할 수 있으며, 해당 계약팀장은 신청일로부터 7근무일 이내 처리하고 그 결과를 통보하여야 한다.","items":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_12_P4","display_id":"방위사업청-물품-적격심사-기준-제12조-제4항","paragraph_number":"④","paragraph_index":4,"content":"해당 계약팀장은 제3항의 처리기한 내 처리가 불가능할 경우 그 사유와 새로운 처리기한을 정하여 이의 신청자에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_path":"원문/규정/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","pdf_path":"pdf/(방위사업청) 물품 적격심사 기준/(방위사업청) 물품 적격심사 기준(방위사업청예규)(제1080호)(20260921).pdf","source_page":"4","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["이의신청","적격심사"]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_13","display_id":"방위사업청-물품-적격심사-기준-제13조","regulation_id":"DAPA_GOODS_QUALIFICATION_GUIDE","regulation_name":"(방위사업청) 물품 적격심사 기준","short_name":"방위사업청 물품 적격심사 기준","document_type":"계약예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"부정한 방법으로 심사서류를 제출한 자의 처리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_13_P1","display_id":"방위사업청-물품-적격심사-기준-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사대상자가 이 규정에 따라 제출한 서류 중 허위로 작성된 서류가 포함된 것으로 판명된 때에는 다음 각 호와 같이 처리하여야 한다.","items":[{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_13_P1_I1","display_id":"방위사업청-물품-적격심사-기준-제13조-제1항-제1호","item_number":"1","content":"계약체결 이전인 경우에는 낙찰자 결정대상에서 제외 또는 결정통보를 취소한다.","subitems":[]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_13_P1_I2","display_id":"방위사업청-물품-적격심사-기준-제13조-제1항-제2호","item_number":"2","content":"계약체결 이후인 경우에는 당해 계약을 해제 또는 해지할 수 있다.","subitems":[]}]},{"id":"DAPA_GOODS_QUALIFICATION_GUIDE_ART_13_P2","display_id":"방위사업청-물품-적격심사-기준-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항에 해당하는 자에 대하여는 국가계약법 시행령 제76조에 의한 입찰참가자격 제한조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"(방위사업청) 물품 적격심사 기준(방위