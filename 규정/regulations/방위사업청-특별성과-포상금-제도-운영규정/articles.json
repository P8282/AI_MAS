[{"id":"DAPA_A_2100000279028_ART_1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제1조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_1_P0","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「행정업무의 운영 및 혁신에 관한 규정」(이하 \"행정업무규정\"이라 한다) 제46조의9에 따라 방위사업청 특별성과 포상금 제도의 운영에 관하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["ADMINISTRATIVE_WORK_REGULATION_ART_46_9"],"related_regulations":["ADMINISTRATIVE_WORK_REGULATION"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제2조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_2_P0","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 사용되는 용어의 정의는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000279028_ART_2_P0_I1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제2조-제1호","item_number":"1","content":"\"특별성과\"란 행정업무규정 제46조의9에 따라 공무원이 혁신적인 업무 수행으로 거둔 성과로서, 다음 각 목에 해당하는 성과를 말한다.","subitems":[{"id":"DAPA_A_2100000279028_ART_2_P0_I1_S1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제2조-제1호-가목","subitem_number":"가","content":"불합리한 규제ㆍ관행 개선, 새로운 정책ㆍ제도의 도입 등으로 국가 또는 국민의 이익 증진에 현저히 기여한 경우나. 업무절차ㆍ조직문화 개선 등으로 행정의 효율성 또는 투명성을 제고하여 행정서비스에 대한 국민의 만족도 향상에 현저히 기여한 경우다. 행정업무에 대한 선제적 대응을 통해 국민의 생명ㆍ신체 및 재산의 보호 등 공공의 안전과 질서 유지에 현저히 기여한 경우라. 그 밖에 제1호부터 제3호까지에 준하는 경우로서 행정기관의 장이 우수한 성과를 인정하는 경우"}]},{"id":"DAPA_A_2100000279028_ART_2_P0_I2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제2조-제2호","item_number":"2","content":"\"포상금\"이란 이 규정에 따라 특별성과를 창출한 공무원에게 지급하는 금전적 보상을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["ADMINISTRATIVE_WORK_REGULATION_ART_46_9"],"related_regulations":["ADMINISTRATIVE_WORK_REGULATION"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제3조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_3_P0","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제3조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업청과 그 소속기관에 소속된 군인을 포함한 모든 공무원에게 적용한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_4","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제4조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"기본원칙","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_4_P1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"특별성과에 대한 포상은 개인 포상을 원칙으로 한다. 다만, 협업을 통해 성과가 창출된 경우에는 개인별 기여도를 고려하여 차등 지급함으로써 협업 단위로 포상할 수 있다.","items":[]},{"id":"DAPA_A_2100000279028_ART_4_P2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"포상은 특별성과의 현저성에 상응하도록 합리적이고 차등적으로 이루어져야 한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_4_P3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"포상 대상의 선정은 공정성ㆍ객관성 및 엄정성을 원칙으로 한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_4_P4","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"포상 제도의 운영은 절차와 결과가 투명하게 이루어져야 한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_5","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제5조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"포상 대상자 추천","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_5_P1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"포상 대상자 추천은 수시로 할 수 있으며, 필요시 별도 기간을 정하여 공모할 수 있다.","items":[]},{"id":"DAPA_A_2100000279028_ART_5_P2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"포상 대상자는 상급자, 동료, 하급자, 본인 및 국민, 이해관계자의 추천에 따라 선정하며, 추천 시 별지 제1호 서식의 특별성과 포상 신청서 및 다음 각 호의 자료를 정책조정담당관으로 제출하여야 한다.","items":[{"id":"DAPA_A_2100000279028_ART_5_P2_I1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제5조-제2항-제1호","item_number":"1","content":"성과를 객관적으로 입증할 수 있는 자료","subitems":[]},{"id":"DAPA_A_2100000279028_ART_5_P2_I2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제5조-제2항-제2호","item_number":"2","content":"성과 달성을 위하여 추진한 주요 업무 내용 및 기여 사실을 확인할 수 있는 자료 등","subitems":[]}]},{"id":"DAPA_A_2100000279028_ART_5_P3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"본인 신청을 제외한 추천은 정책조정담당관의 요청에 따라 공적자가 별지 제1호 서식의 특별성과 포상 신청서 및 제1항 각 호에 해당하는 자료를 보완할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_6","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제6조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"사전심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_6_P1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"정책조정담당관은 신청서 접수 시 공적자의 해당 국ㆍ부로 신청서와 증빙자료를 송부하고 사전심사를 요청한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_6_P2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"각 국ㆍ부는 별표1 특별성과 포상 심사기준 및「(방위사업청) 표창규정」제10조(제10조 제1호는 제외한다)에 따라 공적자 사전심사를 실시한다. 필요한 경우 국ㆍ부 내에 특별성과 포상금 사전심사위원회를 운영할 수 있다.","items":[]},{"id":"DAPA_A_2100000279028_ART_6_P3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"각 국ㆍ부는 사전심사 실시 후 별지 제2호 서식의 특별성과 사전심사 결과서를 정책조정담당관에 제출한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_6_P4","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"사전심사에서 미흡 또는 매우 미흡을 받은 경우 포상대상에서 제외한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000250590_ART_10","DAPA_A_2100000279028_ART_10"],"related_regulations":["DAPA_A_2100000250590"],"external_references":[],"keywords":["입찰참가자격 사전심사"]},{"id":"DAPA_A_2100000279028_ART_7","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제7조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"성과검증","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_7_P1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"정책조정담당관은 유관부서와 협조하여 성과를 검증한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_7_P2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"정책조정담당관은 성과검증 과정에서 필요한 증빙서류를 공적자에게 추가로 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000279028_ART_7_P3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"성과검증 완료 후 제8조의 특별성과 포상 심사위원회 심의를 실시한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000279028_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_8","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"심사위원회의 구성 및 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_8_P1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"포상 대상자 선정 및 포상금 산정을 위하여 특별성과 포상 심사위원회(이하 \"위원회\"라 한다)를 구성하여 운영한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_8_P2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원회는 위원장 1명을 포함하여 10명 이상의 위원으로 구성하되, 민간위원은 전체 위원의 40퍼센트 이상으로 한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_8_P3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장은 방위사업청 차장이 되고 위원은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000279028_ART_8_P3_I1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제3항-제1호","item_number":"1","content":"기반전력사업본부장, 미래전력사업본부장","subitems":[]},{"id":"DAPA_A_2100000279028_ART_8_P3_I2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제3항-제2호","item_number":"2","content":"국ㆍ부장급 이상으로 방위사업청장이 지명한 자","subitems":[]},{"id":"DAPA_A_2100000279028_ART_8_P3_I3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제3항-제3호","item_number":"3","content":"청 소관업무와 관련된 전문적인 지식과 경험이 풍부한 민간전문가로 방위사업청장 위촉 또는 지명한 자","subitems":[]}]},{"id":"DAPA_A_2100000279028_ART_8_P4","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"민간위원의 임기는 1년으로 하되, 연임할 수 있다.","items":[]},{"id":"DAPA_A_2100000279028_ART_8_P5","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"위원회는 위원장을 포함한 재적위원 과반수의 출석으로 개의하고 출석위원 과반수 찬성으로 의결한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_8_P6","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"위원회는 다음 각 호의 사항을 심의하며, 각 위원은 별지 제3호 서식의 특별성과 포상 심사서를 작성한다.","items":[{"id":"DAPA_A_2100000279028_ART_8_P6_I1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제6항-제1호","item_number":"1","content":"특별성과 지급 대상자 선정","subitems":[]},{"id":"DAPA_A_2100000279028_ART_8_P6_I2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제6항-제2호","item_number":"2","content":"포상금 지급액 등","subitems":[]}]},{"id":"DAPA_A_2100000279028_ART_8_P7","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제8조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"위원장은 별지 제4호 서식의 심사위원회 의결서를 작성하고 참석한 위원 전원이 의결서에 서명 또는 날인하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_9","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"심사기준 및 제한사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_9_P1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"포상 대상자의 선정 및 포상금 산정을 위한 심사는 별표1에 따라 종합적으로 고려하여야 한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_9_P2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"다음 각 호의 어느 하나에 해당하는 경우에는 포상 대상에서 제외하거나 포상을 제한할 수 있다.","items":[{"id":"DAPA_A_2100000279028_ART_9_P2_I1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제2항-제1호","item_number":"1","content":"「(방위사업청) 표창규정」제10조 제2호부터 제9호에 해당하는 경우","subitems":[]},{"id":"DAPA_A_2100000279028_ART_9_P2_I2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제2항-제2호","item_number":"2","content":"성과의 내용 또는 공적이 사실과 다르거나 과장된 경우","subitems":[]},{"id":"DAPA_A_2100000279028_ART_9_P2_I3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제2항-제3호","item_number":"3","content":"개인별 기여도가 명확히 확인되지 않은 경우","subitems":[]},{"id":"DAPA_A_2100000279028_ART_9_P2_I4","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제2항-제4호","item_number":"4","content":"포상금의 분할 지급, 순번제 운영 등 부당한 방법으로 포상을 신청한 경우","subitems":[]},{"id":"DAPA_A_2100000279028_ART_9_P2_I5","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제2항-제5호","item_number":"5","content":"그 밖에 포상 제도의 공정한 운영을 저해한다고 인정되는 경우","subitems":[]}]},{"id":"DAPA_A_2100000279028_ART_9_P3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"동일하거나 유사한 공적으로 다른 규정에 따라 포상 또는 보상을 받은 경우에는 해당 규정의 취지, 보상 내용 및 수준 등을 고려하여 포상금 지급 여부 및 범위를 결정할 수 있다. 특히 동일한 공적으로 예산성과금, 제안 상여금 등 다른 금전적 보상을 받은 경우에는 이 제도의 취지와 보상 규모의 적정성 등을 종합적으로 고려하여 포상금 지급 여부 및 범위를 결정하여야 한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_9_P4","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"위원별 점수를 종합하여 평균점수 90점 이상은 매우우수, 80점 이상 90점 미만은 우수, 70점 이상 80점 미만은 보통으로 구분한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000250590_ART_10"],"related_regulations":["DAPA_A_2100000250590"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028_ART_10","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제10조","regulation_id":"DAPA_A_2100000279028","regulation_name":"방위사업청 특별성과 포상금 제도 운영규정","short_name":"방위사업청 특별성과 포상금 제도 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"포상금 지급 기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000279028_ART_10_P1","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"포상금은 개인별로 지급하되, 1인당 지급 한도는 3천만 원 이하로 한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_10_P2","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에도 불구하고, 협업 성과에 대한 포상금은 개인별 기여도를 고려하여 차등 지급한다.","items":[]},{"id":"DAPA_A_2100000279028_ART_10_P3","display_id":"방위사업청-특별성과-포상금-제도-운영규정-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"정책조정담당관은 매년 예산 규모에 따라 매우 우수, 우수, 보통의 포상금 규모를 결정하여 공개한다.","items":[]}],"notes":[],"effective_date":"2026-05-11","revision_date":"2026-05-11","source_file":"방위사업청 특별성과 포상금 제도 운영규정.json","source_path":"원문/법제처API/방위사업청 특별성과 포상금 제도 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000279028