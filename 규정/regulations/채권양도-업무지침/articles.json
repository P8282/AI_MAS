[{"id":"DAPA_A_2100000233830_ART_1","display_id":"채권양도-업무지침-제1조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_1_P0","display_id":"채권양도-업무지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업청이 발주한 계약에서 발생하는 채권양도에 대한 업무처리 기준 및 절차를 제공함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233830_ART_2","display_id":"채권양도-업무지침-제2조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_2_P0","display_id":"채권양도-업무지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업청에서 발주한 계약의 계약특수조건에 따라 계약상대자가 해당 계약으로 인하여 발생 또는 발생하게 될 채권을 제3자에게 양도하고자 하는 경우에 적용한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["특수조건"]},{"id":"DAPA_A_2100000233830_ART_3","display_id":"채권양도-업무지침-제3조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_3_P0","display_id":"채권양도-업무지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용되는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000233830_ART_3_P0_I1","display_id":"채권양도-업무지침-제3조-제1호","item_number":"1","content":"\"양도인\"이란 계약상대자로서 확정채권 또는 미확정채권을 보유한 개인 또는 법인 및 단체를 말한다.","subitems":[]},{"id":"DAPA_A_2100000233830_ART_3_P0_I2","display_id":"채권양도-업무지침-제3조-제2호","item_number":"2","content":"\"양수인\"이란 양도인으로부터 확정채권 또는 미확정채권을 넘겨받은 「금융기관의 업무위탁 등에 관한 규정」제2조제1항의 금융기관을 말한다.","subitems":[]},{"id":"DAPA_A_2100000233830_ART_3_P0_I3","display_id":"채권양도-업무지침-제3조-제3호","item_number":"3","content":"\"확정채권\"이란 계약상대자가 계약이행을 완료함으로써, 계약금액 전액에 대하여 방위사업청으로부터 받을 금전채권을 말한다.","subitems":[]},{"id":"DAPA_A_2100000233830_ART_3_P0_I4","display_id":"채권양도-업무지침-제3조-제4호","item_number":"4","content":"\"미확정채권\"이란 계약이행을 준비 중에 있거나, 계약이행 중에 있으므로 장차 계약이행에 의하여 계약상대자가 방위사업청에 대하여 가지게 될 것이 예상되는 금전채권을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["금융기관의 업무위탁 등에 관한 규정"],"keywords":["계약의 이행","계약상대자"]},{"id":"DAPA_A_2100000233830_ART_4","display_id":"채권양도-업무지침-제4조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"승인기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_4_P1","display_id":"채권양도-업무지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"양도인이 확정채권에 대한 양도 승인 신청을 하는 경우에는 제3항제1호에서 정한 범위 내에서 양도승인을 할 수 있다.","items":[]},{"id":"DAPA_A_2100000233830_ART_4_P2","display_id":"채권양도-업무지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"양도인이 다음 각 호의 모든 요건을 갖춘 미확정 채권에 대한 양도 승인을 신청하는 경우에는 제3항제2호에서 정한 범위 내에서 승인을 할 수 있다. 다만 조달청에 요청하여 체결한 계약의 경우에는 승인할 수 없다.","items":[{"id":"DAPA_A_2100000233830_ART_4_P2_I1","display_id":"채권양도-업무지침-제4조-제2항-제1호","item_number":"1","content":"해당 계약의 이행에 필요한 생산자금을 융자하기 위한 목적인 경우","subitems":[]},{"id":"DAPA_A_2100000233830_ART_4_P2_I2","display_id":"채권양도-업무지침-제4조-제2항-제2호","item_number":"2","content":"계약 이행기간이 30일 이상인 계약으로서 최종 납기가 도래하지 않은 경우","subitems":[]}]},{"id":"DAPA_A_2100000233830_ART_4_P3","display_id":"채권양도-업무지침-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"채권의 양도를 승인할 수 있는 한도액은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000233830_ART_4_P3_I1","display_id":"채권양도-업무지침-제4조-제3항-제1호","item_number":"1","content":"확정채권을 양도하는 경우가. 확정계약 : 납품금액의 80%나. 사후정산계약 : 납품금액의 60%","subitems":[]},{"id":"DAPA_A_2100000233830_ART_4_P3_I2","display_id":"채권양도-업무지침-제4조-제3항-제2호","item_number":"2","content":"미확정채권을 양도하는 경우가. 확정계약 : 계약금액의 50%나. 사후정산계약 : 계약금액의 30%","subitems":[]},{"id":"DAPA_A_2100000233830_ART_4_P3_I3","display_id":"채권양도-업무지침-제4조-제3항-제3호","item_number":"3","content":"제1호 및 제2호에 따른 한도액에는 채권양도를 승인할 때까지 채권(가)압류가 되어있는 금액을 포함한다.","subitems":[]}]},{"id":"DAPA_A_2100000233830_ART_4_P4","display_id":"채권양도-업무지침-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항의 ‘납품금액’과 ‘계약금액’은 계약금액(총제조부기금액)에서 납품대가로 이미 지급한 금액을 뺀 금액을 말한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약금액","계약의 이행"]},{"id":"DAPA_A_2100000233830_ART_5","display_id":"채권양도-업무지침-제5조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"사전법률검토","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_5_P0","display_id":"채권양도-업무지침-제5조","paragraph_number":"","paragraph_index":null,"content":"기반전력사업총괄팀장 또는 미래전력사업총괄팀장(이하 \"사업총괄팀장\"이라 한다.)은 채권양도를 승인하기 전에 감독지원담당관의 사전 법률검토를 받아야 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233830_ART_6","display_id":"채권양도-업무지침-제6조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"승인절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_6_P1","display_id":"채권양도-업무지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약상대자가 채권양도 승인 신청을 할 때에는 별지 제1호서식 ‘확정 채권양도 승인신청서’, 별지 제2호서식 ‘미확정 채권양도 승인신청서’ 및 별지 제3호서식 ‘채권양도승인조건’을 각 2부씩 작성하고, 양도인과 양수인이 연서하여 사업총괄팀장에게 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000233830_ART_6_P2","display_id":"채권양도-업무지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"양도인이 채권양도 승인신청서를 제출할 경우에는 다음 각 호의 서류를 함께 제출하게 하여야 한다.","items":[{"id":"DAPA_A_2100000233830_ART_6_P2_I1","display_id":"채권양도-업무지침-제6조-제2항-제1호","item_number":"1","content":"양도인가. 인감증명(「본인서명사실 확인 등에 관한 법률」제2조제3호에 따른 본인서명사실확인서 또는 같은 조제4호에 따른 전자본인서명확인서의 발급증으로 대체할 수 있다. (이하 같음)나. 국세완납증명서다. 지방세완납증명서라. 검사 및 납품조서(확정채권 양도의 경우)마. 국민건강보험법, 국민연금법, 고용산재보험료 징수법 상 보험료 완납증명서","subitems":[]},{"id":"DAPA_A_2100000233830_ART_6_P2_I2","display_id":"채권양도-업무지침-제6조-제2항-제2호","item_number":"2","content":"양수인가. 인감증명나. 사용 인감계다. 법인등기부등본라. 융자확약서(미확정채권 양도의 경우)","subitems":[]}]},{"id":"DAPA_A_2100000233830_ART_6_P3","display_id":"채권양도-업무지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"사업총괄팀장은 채권양도를 승인할 경우에 별지 제4호서식의 ‘채권양도 승인서’를 양도인에게 발급하고, 양수인 및 해당 계약팀장에게 그 사실을 알려야 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["본인서명사실 확인 등에 관한 법률"],"keywords":["채권양도"]},{"id":"DAPA_A_2100000233830_ART_7","display_id":"채권양도-업무지침-제7조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"양도승인의 보류 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_7_P0","display_id":"채권양도-업무지침-제7조","paragraph_number":"","paragraph_index":null,"content":"사업총괄팀장은 다음 각 호의 경우에는 채권양도 승인을 보류하거나 불승인하고, 승인보류 등의 취지를 양도인에게 서면으로 알려야 한다.","items":[{"id":"DAPA_A_2100000233830_ART_7_P0_I1","display_id":"채권양도-업무지침-제7조-제1호","item_number":"1","content":"단가계약으로서 납품물량과 납기가 확정되지 아니한 계약","subitems":[]},{"id":"DAPA_A_2100000233830_ART_7_P0_I2","display_id":"채권양도-업무지침-제7조-제2호","item_number":"2","content":"계약이행이 불투명할 것으로 판단되는 경우","subitems":[]},{"id":"DAPA_A_2100000233830_ART_7_P0_I3","display_id":"채권양도-업무지침-제7조-제3호","item_number":"3","content":"당해 계약의 선금 및 착수금ㆍ중도금을 지급할 수 있는 경우","subitems":[]},{"id":"DAPA_A_2100000233830_ART_7_P0_I4","display_id":"채권양도-업무지침-제7조-제4호","item_number":"4","content":"계약기간(납품기한)이 경과된 경우","subitems":[]},{"id":"DAPA_A_2100000233830_ART_7_P0_I5","display_id":"채권양도-업무지침-제7조-제5호","item_number":"5","content":"채권양도를 악용하였거나 악용의 우려가 있다고 인정되는 경우","subitems":[]}]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["채권양도","납품기한"]},{"id":"DAPA_A_2100000233830_ART_8","display_id":"채권양도-업무지침-제8조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"양도인의 이행의무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_8_P1","display_id":"채권양도-업무지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"사업총괄팀장은 양수인(금융기관)이 양도인에게 발행한 융자실행통지서를 계약상대자가 융자실행일로부터 10근무일 내에 제출하게 하여야 한다.","items":[]},{"id":"DAPA_A_2100000233830_ART_8_P2","display_id":"채권양도-업무지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 융자실행통지서에는 융자금액이 실제 양수받은 채권금액이라는 내용이 포함되고, 융자계획서 사본 등과 같은 융자사실을 확인할 수 있는 서류가 첨부되어야 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233830_ART_9","display_id":"채권양도-업무지침-제9조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"양도승인의 취소","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_9_P1","display_id":"채권양도-업무지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"사업총괄팀장은 계약상대자(양도인)가 제8조의 이행의무를 이행하지 않거나 기한까지 이행할 수 없다고 인정될 경우에는 일방적으로 양도승인을 취소할 수 있다.","items":[]},{"id":"DAPA_A_2100000233830_ART_9_P2","display_id":"채권양도-업무지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 양도승인을 취소할 경우에는 양도인 및 양수인에게 이를 즉시 알린다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000233830_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233830_ART_10","display_id":"채권양도-업무지침-제10조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"대가지급 방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_10_P1","display_id":"채권양도-업무지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"사업총괄팀장은 채권양도를 승인한 계약의 대가지급 청구가 있는 경우에는 양도인(또는 양수인은 양도인의 명의)으로 하여금 다음 각 호의 서류를 제출하게 하여야 하고, 양수인의 입금계좌 또는 변경계좌를 통합사업관리정보체계에 입력하여야 한다.","items":[{"id":"DAPA_A_2100000233830_ART_10_P1_I1","display_id":"채권양도-업무지침-제10조-제1항-제1호","item_number":"1","content":"검사 및 납품조서","subitems":[]},{"id":"DAPA_A_2100000233830_ART_10_P1_I2","display_id":"채권양도-업무지침-제10조-제1항-제2호","item_number":"2","content":"양도인의 세금계산서","subitems":[]},{"id":"DAPA_A_2100000233830_ART_10_P1_I3","display_id":"채권양도-업무지침-제10조-제1항-제3호","item_number":"3","content":"양수인의 국세, 지방세, 국민건강보험법, 국민연금법, 고용산재보험료 징수법 상 보험료 완납증명서","subitems":[]}]},{"id":"DAPA_A_2100000233830_ART_10_P2","display_id":"채권양도-업무지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"채권양도를 승인한 채권은 우선변제권 또는 대항력을 갖춘 제3자가 없는 경우에 한하여 양수인에게 지급한다.","items":[]},{"id":"DAPA_A_2100000233830_ART_10_P3","display_id":"채권양도-업무지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"2인 이상의 양수인에 대한 분할채권양도를 승인한 경우에는 「민법」 제450조제2항의 제3자에 대한 대항요건을 갖춘 순서에 따라 지급하고, 제3자에 대한 대항요건을 갖춘 양수인이 없는 경우에는 승인 순서에 따라 지급한다.","items":[]},{"id":"DAPA_A_2100000233830_ART_10_P4","display_id":"채권양도-업무지침-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"사업총괄팀장은 양도된 금액이 양수인에게 전액 지급될 때까지 양도인에 대한 대가지급을 중지하여야 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"채권양도 업무지침.json","source_path":"원문/법제처API/채권양도 업무지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["CIVIL_ACT_ART_450"],"related_regulations":["CIVIL_ACT"],"external_references":[],"keywords":["대가지급","채권양도"]},{"id":"DAPA_A_2100000233830_ART_11","display_id":"채권양도-업무지침-제11조","regulation_id":"DAPA_A_2100000233830","regulation_name":"채권양도 업무지침","short_name":"채권양도 업무지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233830_ART_11_P0","display_id":"채권양도-업무지침-제11조","paragraph_number":"","paragraph_index":null,