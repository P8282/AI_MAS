[{"id":"DAPA_L_230705_ART_1","display_id":"국방과학기술혁신-촉진법-시행규칙-제1조","regulation_id":"DAPA_L_230705","regulation_name":"국방과학기술혁신 촉진법 시행규칙","short_name":"국방과학기술혁신 촉진법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_230705_ART_1_P0","display_id":"국방과학기술혁신-촉진법-시행규칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규칙은 「국방과학기술혁신 촉진법」 및 같은 법 시행령에서 위임된 사항과 그 시행에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-03-30","source_file":"국방과학기술혁신 촉진법 시행규칙.json","source_path":"원문/법제처API/국방과학기술혁신 촉진법 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_230705_ART_2","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조","regulation_id":"DAPA_L_230705","regulation_name":"국방과학기술혁신 촉진법 시행규칙","short_name":"국방과학기술혁신 촉진법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"핵심기술 및 미래도전국방기술 연구개발사업의 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_230705_ART_2_P1","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 「국방과학기술혁신 촉진법」(이하 \"법\"이라 한다) 제2조제5호나목에 따른 핵심기술 연구개발사업 및 같은 호 다목에 따른 미래도전국방기술 연구개발사업을 수행하기 위하여 법 제6조제3항에 따른 국방과학기술혁신 시행계획에 기초하여 다음 각 호의 사항이 포함된 국방기술기획서를 매년 작성해야 한다.","items":[{"id":"DAPA_L_230705_ART_2_P1_I1","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제1항-제1호","item_number":"1","content":"중ㆍ장기 국방과학기술 확보계획","subitems":[]},{"id":"DAPA_L_230705_ART_2_P1_I2","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제1항-제2호","item_number":"2","content":"다음 연도에 착수하는 핵심기술 연구개발사업의 과제 목록","subitems":[]},{"id":"DAPA_L_230705_ART_2_P1_I3","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제1항-제3호","item_number":"3","content":"다음 연도에 착수하는 미래도전국방기술 연구개발사업의 중점 추진 분야 목록","subitems":[]}]},{"id":"DAPA_L_230705_ART_2_P2","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 제1항에 따른 국방기술기획서를 작성할 때 합동참모본부, 「국방과학연구소법」에 따른 국방과학연구소(이하 \"국방과학연구소\"라 한다), 기업, 대학, 연구기관 및 국방과학기술 관련 기관ㆍ단체 등이 제기한 과제를 반영할 수 있다. 이 경우 합동참모본부는 각군이 제출한 과제와 자체적으로 도출한 과제를 종합하여 방위사업청장에게 과제를 제기해야 한다.","items":[]},{"id":"DAPA_L_230705_ART_2_P3","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 제1항에 따른 국방기술기획서를 작성하면 「방위사업법 시행령」 제15조제1항제2호에 따른 방위사업기획ㆍ관리분과위원회의 심의를 거쳐야 한다.","items":[]},{"id":"DAPA_L_230705_ART_2_P4","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 법 제8조제6항 및 「국방과학기술혁신 촉진법 시행령」(이하 \"영\"이라 한다) 제6조제2항에 따라 다음 각 호의 구분에 따른 기관의 장에게 제1항제1호의 중ㆍ장기 국방과학기술 확보계획에 포함된 기술들에 대한 과제기획 연구를 수행하도록 할 수 있다.","items":[{"id":"DAPA_L_230705_ART_2_P4_I1","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제4항-제1호","item_number":"1","content":"핵심기술 연구개발: 「방위사업법」 제32조에 따른 국방기술품질원(이하 \"국방기술품질원\"이라 한다)","subitems":[]},{"id":"DAPA_L_230705_ART_2_P4_I2","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제4항-제2호","item_number":"2","content":"미래도전국방기술 연구개발: 국방과학연구소","subitems":[]}]},{"id":"DAPA_L_230705_ART_2_P5","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"방위사업청장은 법 제8조제6항 및 영 제6조제2항에 따라 다음 각 호의 구분에 따른 기관의 장에게 해당 국방연구개발사업의 성과를 분석하여 매년 보고하게 할 수 있다. 이 경우 다음 각 호의 기관의 장은 법 제8조제1항 각 호의 자(이하 \"연구개발기관\"이라 한다)에게 성과 분석에 필요한 자료의 제출을 요청할 수 있다.","items":[{"id":"DAPA_L_230705_ART_2_P5_I1","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제5항-제1호","item_number":"1","content":"핵심기술 연구개발: 국방기술품질원","subitems":[]},{"id":"DAPA_L_230705_ART_2_P5_I2","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제5항-제2호","item_number":"2","content":"미래도전국방기술 연구개발: 국방과학연구소","subitems":[]}]},{"id":"DAPA_L_230705_ART_2_P6","display_id":"국방과학기술혁신-촉진법-시행규칙-제2조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"방위사업청장은 제5항에 따른 성과분석 결과를 보고받은 경우 이를 국방부, 합동참모본부 및 각군에 통보해야 한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-03-30","source_file":"국방과학기술혁신 촉진법 시행규칙.json","source_path":"원문/법제처API/국방과학기술혁신 촉진법 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_283941_ART_2","DAPA_L_283941_ART_6","DEFENSE_ACQ_ENFORCEMENT_ART_15","DAPA_L_283941_ART_8","DAPA_L_287549_ART_6","DEFENSE_ACQ_ACT_ART_32"],"related_regulations":["DAPA_L_283941","DEFENSE_ACQ_ENFORCEMENT","DAPA_L_287549","DEFENSE_ACQ_ACT"],"external_references":[],"keywords":[]},{"id":"DAPA_L_230705_ART_3","display_id":"국방과학기술혁신-촉진법-시행규칙-제3조","regulation_id":"DAPA_L_230705","regulation_name":"국방과학기술혁신 촉진법 시행규칙","short_name":"국방과학기술혁신 촉진법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"신기술을 활용한 연구개발사업의 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_230705_ART_3_P0","display_id":"국방과학기술혁신-촉진법-시행규칙-제3조","paragraph_number":"","paragraph_index":null,"content":"법 제2조제5호라목에 따른 신기술을 활용한 연구개발사업의 절차 등은 방위사업청장이 정한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-03-30","source_file":"국방과학기술혁신 촉진법 시행규칙.json","source_path":"원문/법제처API/국방과학기술혁신 촉진법 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_283941_ART_2"],"related_regulations":["DAPA_L_283941"],"external_references":[],"keywords":[]},{"id":"DAPA_L_230705_ART_4","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조","regulation_id":"DAPA_L_230705","regulation_name":"국방과학기술혁신 촉진법 시행규칙","short_name":"국방과학기술혁신 촉진법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"연구개발기관의 선정절차 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_230705_ART_4_P1","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 법 제2조제5호가목에 따른 무기체계 연구개발사업을 추진하기 위하여 법 제8조제1항에 따라 연구개발기관을 선정하려는 경우에는 영 제3조제1항 각 호의 단계별로 각각 선정한다. 다만, 효율적인 연구개발이나 전력화 시기 충족을 위하여 필요한 경우에는 「방위사업법」 제9조에 따른 방위사업추진위원회의 심의를 거쳐 이미 선정된 연구개발기관이 다음 단계의 연구개발사업을 계속하여 추진하게 할 수 있다.","items":[]},{"id":"DAPA_L_230705_ART_4_P2","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 법 제8조제1항 각 호 외의 부분 후단에 따라 계약 또는 협약을 체결하기 위하여 제안요청서를 작성하는 경우 각군의 의견을 반영해야 한다.","items":[]},{"id":"DAPA_L_230705_ART_4_P3","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 법 제8조제1항에 따라 연구개발기관을 선정하려는 경우 다음 각 호의 사항을 공고해야 한다. 다만, 군사기밀이 요구되거나 국가의 안전보장을 위하여 필요한 경우에는 공고하지 않을 수 있다.","items":[{"id":"DAPA_L_230705_ART_4_P3_I1","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제3항-제1호","item_number":"1","content":"연구개발사업의 추진목적 및 사업내용","subitems":[]},{"id":"DAPA_L_230705_ART_4_P3_I2","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제3항-제2호","item_number":"2","content":"연구개발기관의 선정기준","subitems":[]},{"id":"DAPA_L_230705_ART_4_P3_I3","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제3항-제3호","item_number":"3","content":"연구개발사업 제안서의 작성기준 또는 계약ㆍ협약 이행능력 심사자료","subitems":[]},{"id":"DAPA_L_230705_ART_4_P3_I4","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제3항-제4호","item_number":"4","content":"그 밖에 방위사업청장이 연구개발기관을 공정하게 선정하기 위하여 필요하다고 인정한 사항","subitems":[]}]},{"id":"DAPA_L_230705_ART_4_P4","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 연구개발기관을 공정하고 전문적으로 선정하기 위하여 방위사업청, 각군, 국방과학연구소 또는 국방기술품질원의 관계전문가 및 민간전문가로 구성된 연구개발사업 제안서 평가팀을 운영할 수 있다.","items":[]},{"id":"DAPA_L_230705_ART_4_P5","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"방위사업청장은 필요하다고 인정하는 경우 법 제8조제1항제1호에 따른 연구개발주관기관(이하 \"연구개발주관기관\"이라 한다)을 둘 이상 선정할 수 있다.","items":[]},{"id":"DAPA_L_230705_ART_4_P6","display_id":"국방과학기술혁신-촉진법-시행규칙-제4조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"제1항부터 제5항까지에서 규정한 사항 외에 연구개발기관의 선정에 필요한 사항은 방위사업청장이 정한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-03-30","source_file":"국방과학기술혁신 촉진법 시행규칙.json","source_path":"원문/법제처API/국방과학기술혁신 촉진법 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_283941_ART_2","DAPA_L_283941_ART_8","DAPA_L_287549_ART_3","DEFENSE_ACQ_ACT_ART_9"],"related_regulations":["DAPA_L_283941","DAPA_L_287549","DEFENSE_ACQ_ACT"],"external_references":[],"keywords":["제안서","협상에 의한 계약"]},{"id":"DAPA_L_230705_ART_5","display_id":"국방과학기술혁신-촉진법-시행규칙-제5조","regulation_id":"DAPA_L_230705","regulation_name":"국방과학기술혁신 촉진법 시행규칙","short_name":"국방과학기술혁신 촉진법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"체계개발단계의 무기체계 연구개발사업에 대한 협약 체결기준 금액","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_230705_ART_5_P0","display_id":"국방과학기술혁신-촉진법-시행규칙-제5조","paragraph_number":"","paragraph_index":null,"content":"영 제4조제1항제2호에서 \"국방부령으로 정하는 금액\"이란 500억원을 말한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-03-30","source_file":"국방과학기술혁신 촉진법 시행규칙.json","source_path":"원문/법제처API/국방과학기술혁신 촉진법 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287549_ART_4"],"related_regulations":["DAPA_L_287549"],"external_references":[],"keywords":[]},{"id":"DAPA_L_230705_ART_6","display_id":"국방과학기술혁신-촉진법-시행규칙-제6조","regulation_id":"DAP