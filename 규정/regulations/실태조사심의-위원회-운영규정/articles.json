false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_5_P1","display_id":"실태조사심의-위원회-운영규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원은 다음 각 호의 자가 된다.","items":[{"id":"DAPA_A_2100000198057_ART_5_P1_I1","display_id":"실태조사심의-위원회-운영규정-제5조-제1항-제1호","item_number":"1","content":"방위사업청 국방기술보호국 기술보호과, 기술심사과 등의 관련부서 4급 이상 공무원 또는 영관급 장교","subitems":[]},{"id":"DAPA_A_2100000198057_ART_5_P1_I2","display_id":"실태조사심의-위원회-운영규정-제5조-제1항-제2호","item_number":"2","content":"방위산업기술 보호법(이하 ‘법’이라 한다) 시행령 제5조에 의한 정보수사기관의 관련 부서 담당","subitems":[]},{"id":"DAPA_A_2100000198057_ART_5_P1_I3","display_id":"실태조사심의-위원회-운영규정-제5조-제1항-제3호","item_number":"3","content":"방위산업기술보호 관련 기관·단체 등의 관련 부서 담당","subitems":[]},{"id":"DAPA_A_2100000198057_ART_5_P1_I4","display_id":"실태조사심의-위원회-운영규정-제5조-제1항-제4호","item_number":"4","content":"그 밖에 위원장이 필요하다고 판단하여 위촉하는 자","subitems":[]}]},{"id":"DAPA_A_2100000198057_ART_5_P2","display_id":"실태조사심의-위원회-운영규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"상기 2호 내지 4호의 외부 위원 수는 전체 위원의 3분의 1 이상으로 구성한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_5_P3","display_id":"실태조사심의-위원회-운영규정-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원이 출장 등 사유로 위원회에 출석하지 못하여 직무대리 규정에 따라 그 직무를 대행하는 자가 위원회에 참석하고자 할 때에는 위원회 개최 전까지 위원장의 승인을 받아 위원회에 출석하여 발언 및 표결을 할 수 있다.","items":[]},{"id":"DAPA_A_2100000198057_ART_5_P4","display_id":"실태조사심의-위원회-운영규정-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"위원의 임기는 그 직에 있는 동안 재임하는 것으로 한다. 다만, 제1항제3호, 제4호의 위원의 임기는 3년으로 하되, 1회 연임할 수 있다.","items":[]},{"id":"DAPA_A_2100000198057_ART_5_P5","display_id":"실태조사심의-위원회-운영규정-제5조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"위원은 필요한 경우 위원회에 서면으로 별지 제3호 서식의 의견서를 제출할 수 있다.","items":[]},{"id":"DAPA_A_2100000198057_ART_5_P6","display_id":"실태조사심의-위원회-운영규정-제5조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"위원장은 위촉된 자가 청렴서약서의 내용을 지키지 아니하는 경우에는 해촉할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_5_2","display_id":"실태조사심의-위원회-운영규정-제5조의2","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5의2","article_label":"제5조의2","article_title":"위원의 제척·기피·회피","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_5_2_P1","display_id":"실태조사심의-위원회-운영규정-제5조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원의 제척·기피 및 회피에 관한 사항은 법 시행령 제9조에 따른다.","items":[]},{"id":"DAPA_A_2100000198057_ART_5_2_P2","display_id":"실태조사심의-위원회-운영규정-제5조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원은 별지 제4호 서식의 확인서를 작성하여 위원장에게 제출한다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000198057_ART_9"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_6","display_id":"실태조사심의-위원회-운영규정-제6조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"위촉직 위원의 변동","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_6_P0","display_id":"실태조사심의-위원회-운영규정-제6조","paragraph_number":"","paragraph_index":null,"content":"위원장은 제5조제1항제4호에 해당하는 위촉직 위원이 사임 등으로 인해 결원이 발생한 경우에는 새로이 위원을 위촉한다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000198057_ART_5"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_7","display_id":"실태조사심의-위원회-운영규정-제7조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"간사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_7_P1","display_id":"실태조사심의-위원회-운영규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원회에 간사 1인을 둔다.","items":[]},{"id":"DAPA_A_2100000198057_ART_7_P2","display_id":"실태조사심의-위원회-운영규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 방위사업청 국방기술보호국 기술보호과의 소속직원 중에서 위원장이 정한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_7_P3","display_id":"실태조사심의-위원회-운영규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"간사는 위원장의 명을 받아 위원회 일자 지정, 위원회 소집 및 회의장 준비와 안건을 종합하여 위원회에 상정하고, 위원에 대한 위촉·해촉, 자문수행을 위한 행정조치 등의 사무를 처리한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_7_P4","display_id":"실태조사심의-위원회-운영규정-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"간사는 위원장을 보좌하고 회의 시 제기된 의견을 별지 제1호 서식의 의사록에 기록하며, 위원회 참석 중 위원장의 지시에 따라 또는 승인을 얻어 발언할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_8","display_id":"실태조사심의-위원회-운영규정-제8조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"위원회의 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_8_P1","display_id":"실태조사심의-위원회-운영규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원장은 재적위원 3분의 1이상의 요구가 있거나 위원장이 필요하다고 인정하는 경우 수시로 위원회를 소집할 수 있다.","items":[]},{"id":"DAPA_A_2100000198057_ART_8_P2","display_id":"실태조사심의-위원회-운영규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제2조에서 규정한 심의·조정할 사항이 발생한 부서(이하 ‘안건제기부서’라 한다)의 장은 다음 각 호의 사항이 포함된 위원회 상정안건을 작성하여 위원회 개최 15일 이전에 위원장에게 선행보고 후 기술보호과에 통보하고, 위원회 소집을 건의한다. 안건제기부서는 사전 배부가 곤란하거나 부적절하다고 위원장이 판단하는 경우를 제외하고는 위원회 개최 7일 이전에 각 위원에게 배부하고, 위원회에 참석하여 안건보고 및 위원의 질문에 답변한다.","items":[{"id":"DAPA_A_2100000198057_ART_8_P2_I1","display_id":"실태조사심의-위원회-운영규정-제8조-제2항-제1호","item_number":"1","content":"제안이유","subitems":[]},{"id":"DAPA_A_2100000198057_ART_8_P2_I2","display_id":"실태조사심의-위원회-운영규정-제8조-제2항-제2호","item_number":"2","content":"주요내용","subitems":[]},{"id":"DAPA_A_2100000198057_ART_8_P2_I3","display_id":"실태조사심의-위원회-운영규정-제8조-제2항-제3호","item_number":"3","content":"심의·의결사항","subitems":[]},{"id":"DAPA_A_2100000198057_ART_8_P2_I4","display_id":"실태조사심의-위원회-운영규정-제8조-제2항-제4호","item_number":"4","content":"증거자료 등 기타 필요사항","subitems":[]}]},{"id":"DAPA_A_2100000198057_ART_8_P3","display_id":"실태조사심의-위원회-운영규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"안건제기부서는 간사와 위원회 일정을 협조하여야 한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_8_P4","display_id":"실태조사심의-위원회-운영규정-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"간사는 위원회 개최 7일 이전까지 의사일정을 각 위원에게 서면으로 통지하여야 한다. 다만, 긴급을 요하는 때에는 그러하지 아니할 수 있다.","items":[]},{"id":"DAPA_A_2100000198057_ART_8_P5","display_id":"실태조사심의-위원회-운영규정-제8조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"위원회 회의는 재적위원 과반수의 출석으로 개의하고, 출석위원 과반수의 찬성으로 심의한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_8_P6","display_id":"실태조사심의-위원회-운영규정-제8조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"위원장과 위원은 별지 제2호 서식의 의결서에 동의여부와 의견을 자필로 기록한 후 서명하여야 한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_8_P7","display_id":"실태조사심의-위원회-운영규정-제8조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"위원회 안건에 비밀관련 사항이 포함된 경우 안건제기부서는 비문으로 생산하여 위원회 개최 7일 이전에 비문보관시설이 갖추어진 관련기관에만 배부하고, 그 이외의 위원에게는 비밀등급을 표시한 안건을 7일 이전에 대면보고 후 회수하여 위원회 시작 전에 재 배부한다. 이 경우 위원회 안건은 위원회 종료 후 회수한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_8_P8","display_id":"실태조사심의-위원회-운영규정-제8조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"위원회 진행은 위원회에서 비공개로 결정하거나 공개범위, 시기, 방법 등에 대하여 별도로 정한 경우를 제외하고는 공개를 원칙으로 한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_8_P9","display_id":"실태조사심의-위원회-운영규정-제8조-제9항","paragraph_number":"⑨","paragraph_index":9,"content":"심의·조정 안건이 경미하거나, 부득이한 사유 등으로 위원장이 필요하다고 인정하는 경우 서면으로 심의·의결할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000198057_ART_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_9","display_id":"실태조사심의-위원회-운영규정-제9조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"자료제출요청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_9_P1","display_id":"실태조사심의-위원회-운영규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원장은 제2조 각 호의 안건에 대하여 관련기관에 자료제출 또는 의견제시를 요구할 수 있다.","items":[]},{"id":"DAPA_A_2100000198057_ART_9_P2","display_id":"실태조사심의-위원회-운영규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 규정에 따라 자료제출 또는 의견제시를 요구받은 기관 등은 특별한 사유가 없는 한 이에 협조하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000198057_ART_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_10","display_id":"실태조사심의-위원회-운영규정-제10조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"의견청취","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_10_P1","display_id":"실태조사심의-위원회-운영규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원회는 상정된 안건을 심의하기 위하여 위원회 개최되는 날로부터 10일 전까지 처분 대상자에게 통지하고, 의견제출 또는 진술의 기회를 부여하여야 한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_10_P2","display_id":"실태조사심의-위원회-운영규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원회는 상정된 안건을 심의하기 위하여 필요한 경우 이해관계인을 위원회에 출석하게 하여 의견을 듣거나 관련서류의 제출을 요구할 수 있다.","items":[]},{"id":"DAPA_A_2100000198057_ART_10_P3","display_id":"실태조사심의-위원회-운영규정-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원회는 필요한 경우 외부 전문기관(실무 자문위원 포함)등에 조사·연구 및 감정·시험 등을 의뢰할 수 있고, 필요한 경우에는 출석하여 발언하게 할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_11","display_id":"실태조사심의-위원회-운영규정-제11조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"청렴서약제 및 비밀준수","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_11_P0","display_id":"실태조사심의-위원회-운영규정-제11조","paragraph_number":"","paragraph_index":null,"content":"방위사업법 제6조, 제50조 및 보안업무관련 규정에 따라 위원회 위원은 청렴서약서를 위원장에게 제출하고, 방위사업과 관련하여 업무수행 중 알게 된 비밀을 누설하거나 도용하여서는 아니 된다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_6","DEFENSE_ACQ_ACT_ART_50"],"related_regulations":["DEFENSE_ACQ_ACT"],"external_references":[],"keywords":["청렴계약"]},{"id":"DAPA_A_2100000198057_ART_12","display_id":"실태조사심의-위원회-운영규정-제12조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"수당·여비","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_12_P0","display_id":"실태조사심의-위원회-운영규정-제12조","paragraph_number":"","paragraph_index":null,"content":"위원회에 출석한 위원에게는 예산의 범위 안에서 수당과 여비를 지급할 수 있다. 다만, 공무원이 당해 직무와 직접 관련하여 출석한 경우에는 그러하지 아니하다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000198057_ART_13","display_id":"실태조사심의-위원회-운영규정-제13조","regulation_id":"DAPA_A_2100000198057","regulation_name":"실태조사심의 위원회 운영규정","short_name":"실태조사심의 위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"회의록 유지·관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000198057_ART_13_P1","display_id":"실태조사심의-위원회-운영규정-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"안건제기부서는 해당안건에 대하여 주요 의사결정 문서를 실명화하여 유지·관리하여야 한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_13_P2","display_id":"실태조사심의-위원회-운영규정-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 위원회 종료 후 의결서를 포함한 위원회 결과를 안건제기부서에 통보해야 한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_13_P3","display_id":"실태조사심의-위원회-운영규정-제13조-제3항","paragraph_number":"③","paragraph_index":3,"content":"안건제기부서는 위원회 결과에 따른 필요한 조치를 하고 그 결과를 2개월 이내에 위원장에게 보고하여야 한다.","items":[]},{"id":"DAPA_A_2100000198057_ART_13_P4","display_id":"실태조사심의-위원회-운영규정-제13조-제4항","paragraph_number":"④","paragraph_index":4,"content":"간사는 공공기관의 기록물관리에 관한 법률 등 관련법령에 따라 위원회 심의안건, 심의결과, 의결서, 의사록 등 위원회관련 자료를 연도별, 위원회 횟수별로 보존한다.","items":[]}],"notes":[],"effective_date":"2021-02-10","revision_date":"2021-02-10","source_file":"실태조사심의 위원회 운영규정.json","source_path":"원문/법제처API/실태조사심의 위원회 운영규정