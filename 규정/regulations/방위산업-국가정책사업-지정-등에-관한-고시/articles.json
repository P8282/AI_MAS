[{"id":"DAPA_A_2100000284682_ART_1","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제1조","regulation_id":"DAPA_A_2100000284682","regulation_name":"방위산업 국가정책사업 지정 등에 관한 고시","short_name":"방위산업 국가정책사업 지정 등에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000284682_ART_1_P0","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제1조","paragraph_number":"","paragraph_index":null,"content":"이 고시는 「방위산업 발전 및 지원에 관한 법률 시행령」 제5조제3항에 따라 방위산업 국가정책사업의 지정 등에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-09-03","revision_date":"2026-09-03","source_file":"방위산업 국가정책사업 지정 등에 관한 고시.json","source_path":"원문/법제처API/방위산업 국가정책사업 지정 등에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_289447_ART_5"],"related_regulations":["DAPA_L_289447"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000284682_ART_2","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제2조","regulation_id":"DAPA_A_2100000284682","regulation_name":"방위산업 국가정책사업 지정 등에 관한 고시","short_name":"방위산업 국가정책사업 지정 등에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"지정검토","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000284682_ART_2_P1","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 해당 사업이 방위산업 국가정책사업으로 지정이 필요하다고 판단되는 경우 방위산업 국가정책사업 지정관련 선행연구 검토항목을 포함하여 방위사업정책국장에게 선행연구를 요청한다.","items":[]},{"id":"DAPA_A_2100000284682_ART_2_P2","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 제1항에 따른 선행연구 결과를 반영하여 【별지 제1호】 서식에 따라 방위산업진흥국장에게 「방위산업발전 및 지원에 관한 법률」제5조제2항제4호의 방위산업 국가정책사업 지정기준(이하 \"지정기준\"이라 한다.) 부합여부에 대한 검토를 요청한다.","items":[]},{"id":"DAPA_A_2100000284682_ART_2_P3","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위산업진흥국장은 「방위산업 발전 및 지원에 관한 법률 시행령」 제5조제2항에 따른 방위산업 국가정책사업 검토위원회(이하 \"검토위원회\"라 한다.)를 개최한다.","items":[]},{"id":"DAPA_A_2100000284682_ART_2_P4","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제2조-제4항","paragraph_number":"④","paragraph_index":4,"content":"검토위원회는 해당 사업이 지정기준에 부합하는지를 검토하고, 방위산업진흥국장은 그 결과를 통합사업관리팀장에게 통보한다.","items":[]}],"notes":[],"effective_date":"2026-09-03","revision_date":"2026-09-03","source_file":"방위산업 국가정책사업 지정 등에 관한 고시.json","source_path":"원문/법제처API/방위산업 국가정책사업 지정 등에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_5","DAPA_L_289447_ART_5"],"related_regulations":["DAPA_L_287981","DAPA_L_289447"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000284682_ART_3","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제3조","regulation_id":"DAPA_A_2100000284682","regulation_name":"방위산업 국가정책사업 지정 등에 관한 고시","short_name":"방위산업 국가정책사업 지정 등에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"지정심의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000284682_ART_3_P1","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 제2조제4항의 검토결과를 반영하여 사업추진기본전략(안)을 수립하고 이를 방위사업추진위원회(이하 \"위원회\"라 한다.)에 상정한다. 다만, 사업추진기본전략(안)이 방위사업기획ㆍ 관리분과위원회 심의?조정 대상인 사업의 경우 사업추진기본전략(안) 심의 후 방위산업 국가정책사업 지정에 관한 안건을 위원회에 별도 로 상정한다.","items":[]},{"id":"DAPA_A_2100000284682_ART_3_P2","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 체계개발기본계획서 확정 전까지 제1항에 따라 위원회 심의를 거쳐 방위산업 국가정책사업으로 지정한다.","items":[]}],"notes":[],"effective_date":"2026-09-03","revision_date":"2026-09-03","source_file":"방위산업 국가정책사업 지정 등에 관한 고시.json","source_path":"원문/법제처API/방위산업 국가정책사업 지정 등에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000284682_ART_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000284682_ART_4","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조","regulation_id":"DAPA_A_2100000284682","regulation_name":"방위산업 국가정책사업 지정 등에 관한 고시","short_name":"방위산업 국가정책사업 지정 등에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"검토위원회","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000284682_ART_4_P1","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"검토위원회는 위원장을 포함하여 5인 이상 15인 이내의 위원으로 구성하고, 위원장은 방위산업진흥국장으로 한다.","items":[]},{"id":"DAPA_A_2100000284682_ART_4_P2","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원은 다음 각 호의 사람으로 한다.","items":[{"id":"DAPA_A_2100000284682_ART_4_P2_I1","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제2항-제1호","item_number":"1","content":"방위사업청 : 방산정책과장, 계약제도발전과장, 기술정책과장, 재정담당관 및 각 사업본부 총괄팀장","subitems":[]},{"id":"DAPA_A_2100000284682_ART_4_P2_I2","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제2항-제2호","item_number":"2","content":"국방과학연구소, 국방기술품질원 및 한국국방연구원 관련 부서장 중 위원장이 지명하는 사람","subitems":[]},{"id":"DAPA_A_2100000284682_ART_4_P2_I3","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제2항-제3호","item_number":"3","content":"위원장이 방위산업 국가정책사업 지정과 관련하여 검토위원회에 참여하는 것이 필요하다고 인정하는 중앙행정기관의 과장으로서 소속기관의 장이 지명하는 사람","subitems":[]}]},{"id":"DAPA_A_2100000284682_ART_4_P3","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장은 검토위원회를 대표하고, 위원장이 부득이한 사유로 직무를 수행할 수 없는 때에는 위원장이 지명하는 위원이 그 직무를 수행한다.","items":[]},{"id":"DAPA_A_2100000284682_ART_4_P4","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"검토위원회 회의는 검토 요청된 안건에 대하여 위원 과반수 출석으로 개의하고, 출석위원 과반수 찬성으로 검토결과를 정한다.","items":[]},{"id":"DAPA_A_2100000284682_ART_4_P5","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"검토위원회에 검토위원회 업무의 사무처리 등을 위하여 간사 1명을 두고, 간사는 방산정책과 소속 직원 중 위원장이 지명하는 사람으로 한다.","items":[]}],"notes":[],"effective_date":"2026-09-03","revision_date":"2026-09-03","source_file":"방위산업 국가정책사업 지정 등에 관한 고시.json","source_path":"원문/법제처API/방위산업 국가정책사업 지정 등에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000284682_ART_5","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제5조","regulation_id":"DAPA_A_2100000284682","regulation_name":"방위산업 국가정책사업 지정 등에 관한 고시","short_name":"방위산업 국가정책사업 지정 등에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000284682_ART_5_P0","display_id":"방위산업-국가정책사업-지정-등에-관한-고시-제5조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 고시에 대하여 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2026년 1월 1일 기준으로 매3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 취하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-03","revision_date":"2026-09-03","source_file":"방위산업 국가정책사업 지정 등에 관한 고시.json","source_path":"원문/법제처API/방위산업 국가정책사업 지정 등에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_ref