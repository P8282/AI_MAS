[{"id":"DAPA_A_2100000214044_ART_1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제1조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_1_P0","display_id":"군용총포도검화약류-허가감독에-관한-지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「방위사업법」 제53조 및 동법 시행령 제66조에 따른 군용총포ㆍ도검ㆍ화약류 제조 등에 관한 허가ㆍ감독에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 허가·감독에 관한 지침.json","source_path":"원문/법제처API/군용총포·도검·화약류 허가·감독에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_53","DEFENSE_ACQ_ENFORCEMENT_ART_66"],"related_regulations":["DEFENSE_ACQ_ACT","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214044_ART_2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제2조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_2_P1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 지침은 다음 각 호의 기관에 적용한다.","items":[{"id":"DAPA_A_2100000214044_ART_2_P1_I1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제2조-제1항-제1호","item_number":"1","content":"방위사업청(이하 \"청\"이라 한다.)","subitems":[]},{"id":"DAPA_A_2100000214044_ART_2_P1_I2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제2조-제1항-제2호","item_number":"2","content":"국방과학연구소(이하 \"국과연\"이라 한다.)","subitems":[]},{"id":"DAPA_A_2100000214044_ART_2_P1_I3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제2조-제1항-제3호","item_number":"3","content":"국방기술품질원(이하 \"기품원\"이라 한다)과 그 부설기관(국방기술진흥연구소, 이하 \"국기연\"이라 한다)","subitems":[]}]},{"id":"DAPA_A_2100000214044_ART_2_P2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"이 지침은 방위력개선사업을 수행하면서 「방위사업법」(이하 \"법\"이라 한다.) 제53조에 따라 방위사업청장의 허가ㆍ감독을 받는 업체에도 적용한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_2_P3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"군용총포ㆍ도검ㆍ화약류(이하 \"군용총포등\"이라 한다.)에 관하여 이 지침에서 정한 사항을 제외하고는「국방 탄약 및 폭발물 안전관리 훈령」,「방위산업보안업무훈령」을 적용한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 허가·감독에 관한 지침.json","source_path":"원문/법제처API/군용총포·도검·화약류 허가·감독에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_53"],"related_regulations":["DEFENSE_ACQ_ACT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214044_ART_3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_3_P0","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 뜻은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000214044_ART_3_P0_I1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제1호","item_number":"1","content":"군용총포류 : 군사적 목적으로 사용하는 다음 각 목의 화력ㆍ방호무기체계 및 그 구성품을 말하며, 분류는 다음과 같다.","subitems":[{"id":"DAPA_A_2100000214044_ART_3_P0_I1_S1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제1호-가목","subitem_number":"가","content":"소화기 : 개인화기, 기관총 등나. 대전차화기 : 대전차 로켓, 대전차 유도무기, 무반동총 등다. 화포 : 박격포, 야포, 다련장ㆍ로켓, 함포 등라. 유도무기 : 지상발사ㆍ해상발사ㆍ공중발사ㆍ수중 유도무기 등마. 특수무기 : 레이저무기 등바. 방공무기 : 대공포, 대공유도무기 등사. 총포의 주요 구성품 : 총열, 포신, 소음기, 조준경 등아. 기타 인적ㆍ물적 피해를 주는 용도로 제작된 총포류"}]},{"id":"DAPA_A_2100000214044_ART_3_P0_I2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제2호","item_number":"2","content":"군용도검류 : 군사적 목적으로 사용하는 칼ㆍ검ㆍ창ㆍ치도ㆍ비수 등을 말한다.","subitems":[]},{"id":"DAPA_A_2100000214044_ART_3_P0_I3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제3호","item_number":"3","content":"군용화약류 : 군사적 목적으로 사용하는 탄약, 화약, 폭약, 화공품을 말한다.","subitems":[{"id":"DAPA_A_2100000214044_ART_3_P0_I3_S1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제3호-가목","subitem_number":"가","content":"탄약 : 지상탄, 함정탄, 항공탄, 특수탄약, 유도탄능동유인체 등나. 화약, 폭약 : 「총포화약법」제2조에 정의된 화약ㆍ폭약류다. 화공품 : 화약 및 폭약을 점화ㆍ기폭ㆍ추진ㆍ파괴 등의 목적에 적합하도록 가공한 것으로서 신관, 뇌관, 발연탄, 발연통, 폭음탄, 조명탄, 신호탄, 수류탄, 도폭선, 도화선 등"}]},{"id":"DAPA_A_2100000214044_ART_3_P0_I4","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제4호","item_number":"4","content":"운반책임자 : 운반간 안전을 통제하고, 임무분담 및 교육을 실시하는 자. 단, 군용화약류의 경우 군용화약류 제조보안책임자 또는 관리보안책임자로 선임된 자","subitems":[]},{"id":"DAPA_A_2100000214044_ART_3_P0_I5","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제5호","item_number":"5","content":"운반호송관 : 운반차량에 선탑하고 무기를 휴대하여 경계 및 우발상황 등을 조치하는 자","subitems":[]},{"id":"DAPA_A_2100000214044_ART_3_P0_I6","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제6호","item_number":"6","content":"안전성검사 : 「방위사업법 시행령」(이하 \"시행령\"이라 한다.) 제66조제3항에 따라 군용총포등 허가 신청에 대해 청이 허가하기 전에 국과연이 제조시설에 대하여 현지검사를 실시하는 것","subitems":[]},{"id":"DAPA_A_2100000214044_ART_3_P0_I7","display_id":"군용총포도검화약류-허가감독에-관한-지침-제3조-제7호","item_number":"7","content":"안전검사 : 시행령 제66조의2제4항 및 「방위사업법 시행규칙」(이하 \"시행규칙\"이라 한다.)제40조제5항에 따라 제조ㆍ저장시설에 대하여 청이 허가한 이후 국과연이 매년 1회 이상 정기적으로 안전성 검사 기준 충족 여부 등을 검사하는 것","subitems":[]}]}],"notes":[],"effective_date":"