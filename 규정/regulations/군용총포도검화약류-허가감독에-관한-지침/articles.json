rce_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_53","DEFENSE_ACQ_ENFORCEMENT_ART_71"],"related_regulations":["DEFENSE_ACQ_ACT","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":["감독"]},{"id":"DAPA_A_2100000214044_ART_5","display_id":"군용총포도검화약류-허가감독에-관한-지침-제5조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"군용총포등의 허가 신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_5_P1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"시행규칙 제40조부터 제43조까지의 규정에 따라 군용총포등의 제조 등의 허가를 받으려는 자는 방산수출입지원시스템(D4B)으로 신청하여야 한다. 다만, 방산수출입지원시스템(D4B)이 정상적으로 운영되지 않는 경우 공문 등 다른 방법으로 신청할 수 있다.","items":[]},{"id":"DAPA_A_2100000214044_ART_5_P2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"시행규칙 제40조제1항에 따라 제조업 또는 제조품목을 추가하려는 자는 양산단계 전에 허가를 신청하여야 한다. 단, 연구개발 시제품을 제조하려는 경우 국과연 주관 연구개발 사업은 국과연이, 업체 주관 연구개발사업은 통합사업관리팀장이 승인한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_5_P3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"군용총포등의 수입에 관한 사항은 시행규칙 제41조, 수출에 관한 사항은 시행규칙 제56조를 따른다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 허가·감독에 관한 지침.json","source_path":"원문/법제처API/군용총포·도검·화약류 허가·감독에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_RULE_ART_40","DEFENSE_ACQ_RULE_ART_43","DEFENSE_ACQ_RULE_ART_41","DEFENSE_ACQ_RULE_ART_56"],"related_regulations":["DEFENSE_ACQ_RULE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214044_ART_6","display_id":"군용총포도검화약류-허가감독에-관한-지침-제6조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"군용총포등의 제조 등 허가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_6_P1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제5조제1항에 따라 제조업, 제조품목 추가, 제조ㆍ저장시설 신축ㆍ증축ㆍ변경ㆍ사용, 저장에 대한 허가신청을 받은 경우 국과연은 군용총포등의 제조ㆍ저장시설에 대하여 안전성 검사를 실시하고, 그 결과를 방위사업청장(방산정책과장)에게 통보한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_6_P2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따른 안전성검사 기준은「방위사업법 시행규칙」별표 1, 「탄약 및 폭발물 안전관리기준 지시」(국방부 지시)를 준용하여 국과연이 별도로 정한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_6_P3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장(방산정책과장)은 제12항의 안전성 검사 결과와 업체가 제출한 구비서류를 확인하여 해당 시설의 안전위해요소를 등을 종합적으로 고려 후 허가여부를 결정하여 통보한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 허가·감독에 관한 지침.json","source_path":"원문/법제처API/군용총포·도검·화약류 허가·감독에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000214044_ART_5"],"related_regulations":[],"external_references":[],"keywords":["검사"]},{"id":"DAPA_A_2100000214044_ART_7","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"군용총포등의 운반 허가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_7_P1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장(방산정책과장)은 제5조제1항에 따라 운반허가 신청을 받은 경우 다음 각 호의 요건 등을 고려하여 허가여부를 결정하여 통보한다.","items":[{"id":"DAPA_A_2100000214044_ART_7_P1_I1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제1항-제1호","item_number":"1","content":"운반품목, 수량ㆍ중량, 운반목적, 운반목적지 등 운반 적절성","subitems":[]},{"id":"DAPA_A_2100000214044_ART_7_P1_I2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제1항-제2호","item_number":"2","content":"적재차량 중량, 운반구간, 호송관 인원, 운반책임자 목록, GPS 및 블랙박스 등을 활용한 운반차량에 대한 추적관리의 용이성 등 운반 안전성","subitems":[]},{"id":"DAPA_A_2100000214044_ART_7_P1_I3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제1항-제3호","item_number":"3","content":"도착장소의 허가된 저장시설 보유여부(군부대, 정부시험장, 정부공공기관(경찰청 등) 의 경우는 제외)","subitems":[]}]},{"id":"DAPA_A_2100000214044_ART_7_P2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기품원장 및 국기연소장은 제1항에 따라 운반허가를 받고 운반하고자 하는 자에 대하여 다음 각 호의 요건을 확인하여 운반신고필증을 발급하고, 운반절차의 이행 여부를 관리ㆍ감독한다.","items":[{"id":"DAPA_A_2100000214044_ART_7_P2_I1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제2항-제1호","item_number":"1","content":"청의 운반허가서와 신고서와의 일치여부(운반품목, 수량ㆍ중량, 운반목적, 운반목적지 등)","subitems":[]},{"id":"DAPA_A_2100000214044_ART_7_P2_I2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제2항-제2호","item_number":"2","content":"운반차량, 운반책임자, 호송관, 운반일시 및 운반경로 등","subitems":[]},{"id":"DAPA_A_2100000214044_ART_7_P2_I3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제2항-제3호","item_number":"3","content":"GPS 및 블랙박스 장착현황","subitems":[]}]},{"id":"DAPA_A_2100000214044_ART_7_P3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"군용총포등 운반신고필증 발급 등에 관한 세부절차는 기품원장 및 국기연소장이 정한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_7_P4","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"기품원장 및 국기연소장은 운반절차의 이행여부 관리 감독 시 업체가 운반허가나 운반신고필증을 발급받지 않고 운반하였을 경우 업체명, 운반품목, 운반일시, 운반구간, 인지방법, 운반책임자 등을 포함하여 인지한 날로부터 5근무일 이내에 방위사업청장(방산정책과장)에게 보고한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_7_P5","display_id":"군용총포도검화약류-허가감독에-관한-지침-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"기품원장 및 국기연소장은 제2항에 따른 군용총포등 운반 신고필증 발급 현황 및 이행여부 관리ㆍ감독 결과(별지 제1호 서식)를 당해 연도 7월 31일까지, 다음 연도 1월 31일까지 2회에 걸쳐 방위사업청장(방산정책과장)에게 제출한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 허가·감독에 관한 지침.json","source_path":"원문/법제처API/군용총포·도검·화약류 허가·감독에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000214044_ART_5"],"related_regulations":[],"external_references":[],"keywords":["감독"]},{"id":"DAPA_A_2100000214044_ART_8","display_id":"군용총포도검화약류-허가감독에-관한-지침-제8조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"군용총포등의 폐기 허가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_8_P1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장(방산정책과장)은 폐기허가 신청서 접수 후 10근무일까지 다음 각 호의 요건을 고려하여 폐기허가 여부를 결정하여 통보한다.","items":[{"id":"DAPA_A_2100000214044_ART_8_P1_I1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제8조-제1항-제1호","item_number":"1","content":"폐기일시 및 장소, 폐기 품목의 내용, 폐기 방법, 폐기책임자 지정 여부","subitems":[]},{"id":"DAPA_A_2100000214044_ART_8_P1_I2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제8조-제1항-제2호","item_number":"2","content":"폐기 시 안전수칙, 불발 시 조치대책","subitems":[]}]},{"id":"DAPA_A_2100000214044_ART_8_P2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기품원장 및 국기연소장은 폐기허가를 받은 자의 폐기에 대하여 감독한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_8_P3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기품원장 및 국기연소장은 군용총포등 폐기 사항 관리ㆍ감독에 대한 결과를 당해 연도 7월 31일까지, 다음 연도 1월 31일까지 연간 2회에 걸쳐 방위사업청장(방산정책과장)에게 제출한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 허가·감독에 관한 지침.json","source_path":"원문/법제처API/군용총포·도검·화약류 허가·감독에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["감독"]},{"id":"DAPA_A_2100000214044_ART_9","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"허가 없이 취급할 수 있는 경우","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214044_ART_9_P1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"시행령 제66조제1항 단서에 따라 1회 취급하는 화약량이 위험급수 1.4급 군용화약류 62.5g 미만을 제조(동일업체 내 타 사업장을 포함하여 외부로부터 화약류를 구입하여 자체 생산품에 단순 조립하는 행위만 해당), 양도ㆍ양수, 저장, 소지, 운반하는 경우 허가 없이 취급할 수 있다. 이때 1회 취급하는 화약량은 한 공실에서 동시에 취급할 수 있는 최대 화약량을 말한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_9_P2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"업체가 제1항에서 정하는 화약량에 해당하는지가 명확하지 않은 경우 방위사업청장(방산정책과장)은 국과연에 검토를 의뢰할 수 있으며, 국과연소장은 7근무일 이내에 방위사업청장(방산정책과장)에게 검토결과를 통보한다.","items":[]},{"id":"DAPA_A_2100000214044_ART_9_P3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"다음 각 호에 해당하는 경우 운반허가 없이 운반할 수 있다.","items":[{"id":"DAPA_A_2100000214044_ART_9_P3_I1","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제3항-제1호","item_number":"1","content":"「방위사업법 시행령」 제66조제1항제9호 각 목에 해당하는 경우","subitems":[]},{"id":"DAPA_A_2100000214044_ART_9_P3_I2","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제3항-제2호","item_number":"2","content":"군용총포류 주요 구성품의 다음 각 목 수량을 운반하는 경우가. 총열ㆍ소음기ㆍ조준경 : 2중 잠금장치로 밀폐된 용기에 포장되어 30개 미만을 운반하는 경우나. 포신 : 개당 250kg 이상 운반하는 경우","subitems":[]},{"id":"DAPA_A_2100000214044_ART_9_P3_I3","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제3항-제3호","item_number":"3","content":"군용도검류 100개 미만을 운반하는 경우","subitems":[]},{"id":"DAPA_A_2100000214044_ART_9_P3_I4","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제3항-제4호","item_number":"4","content":"위험급수 1.5급 또는 1.6급 군용화약류 5kg 미만을 각각 운반하는 경우","subitems":[]},{"id":"DAPA_A_2100000214044_ART_9_P3_I5","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제3항-제5호","item_number":"5","content":"별도로 정하는 법률에 따라 군용총포등을 철도, 선박, 항공 등으로 운반하는 경우","subitems":[]}]},{"id":"DAPA_A_2100000214044_ART_9_P4","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"시행령 제66조제1항에 따라 국과연소장, 기품원장 및 국기연소장은 방위사업청장의 허가 없이 군용총포등 제조시설의 신축ㆍ증축ㆍ변경ㆍ사용 및 운반 등을 할 수 있다.","items":[]},{"id":"DAPA_A_2100000214044_ART_9_P5","display_id":"군용총포도검화약류-허가감독에-관한-지침-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"국과연소장, 기품원장 및 국기연소장은 군용총포등 제조시설의 신축ㆍ증축ㆍ변경ㆍ사용, 운반 등에 대해 내부지침을 수립한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 허가·감독에 관한 지침.json","source_path":"원문/법제처API/군용총포·도검·화약류 허가·감독에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_66"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214044_ART_10","display_id":"군용총포도검화약류-허가감독에-관한-지침-제10조","regulation_id":"DAPA_A_2100000214044","regulation_name":"군용총포·도검·화약류 허가·감독에 관한 지침","short_name":"군용총포·도검·화약류 허가·감독에 관한 지침","document_type":"훈령","part":"","cha