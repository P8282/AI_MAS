[{"id":"DAPA_A_2100000238974_ART_1","display_id":"DQ마크-인증제도-운영에-관한-고시-제1조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_1_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위산업 발전 및 지원에 관한 법률」제15조 및「군수품관리법」 제2조에 따른 군수품의 수출 진흥을 위하여 수출잠재력이 우수한 제품에 DQ마크를 부여하여 기술력, 품질 등을 인증(이하 \"DQ마크인증\"이라 한다)하는 업무에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_15"],"related_regulations":["DAPA_L_287981"],"external_references":["군수품관리법"],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_2","display_id":"DQ마크-인증제도-운영에-관한-고시-제2조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"인증기관","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_2_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제2조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 「방위산업 발전 및 지원에 관한 법률 시행령」 제20조 및 제34조에 따라 국방기술품질원을 DQ마크 인증기관(이하 \"인증기관\"이라 한다)으로 하여 DQ마크인증에 대한 업무(이하 \"인증업무\"라 한다)를 위탁한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_289447_ART_20","DAPA_L_289447_ART_34"],"related_regulations":["DAPA_L_289447"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_3","display_id":"DQ마크-인증제도-운영에-관한-고시-제3조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"인증위원회","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_3_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관의 장(이하 \"인증기관장\"이라 한다)은 DQ마크 인증제도의 공정하고 효율적인 운영을 위하여 인증기관장 소속의 DQ마크 인증위원회(이하 \"인증위원회\"라 한다)를 둔다.","items":[]},{"id":"DAPA_A_2100000238974_ART_3_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증위원회의 구성 및 운영 등 세부사항은 인증기관장이 정한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_4","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"인증대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_4_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"DQ마크인증의 대상(이하 \"인증대상\"이라 한다)은 국내기업이 생산하여 수출하려는 방산물자등과 군수품으로서 수출용으로 개조ㆍ개발된 제품을 포함하며, 국방규격, 구매국의 요구사양 또는 업체규격 등 제품심사에 적용할 수 있는 기준이 있는 제품으로 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_4_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 인증대상이 되는 품목에 대한 세부 분류기준은 별표3에 따른다. 다만, 다음 각 호의 경우는 인증대상에서 제외된다.","items":[{"id":"DAPA_A_2100000238974_ART_4_P2_I1","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제1호","item_number":"1","content":"최근 2년 이내 중대한 하자가 발생한 신청품목","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I2","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제2호","item_number":"2","content":"전체 또는 핵심부품 일체가 수입품인 품목","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I3","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제3호","item_number":"3","content":"구매하여 수출하고자 하는 품목","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I4","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제4호","item_number":"4","content":"개발이 완료되지 않은 품목","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I5","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제5호","item_number":"5","content":"기술도입생산 등으로 수출에 제한이 있는 품목","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I6","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제6호","item_number":"6","content":"삭제","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I7","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제7호","item_number":"7","content":"삭제","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I8","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제8호","item_number":"8","content":"「군복 및 군용장구의 단속에 관한 법률」에서 제조 및 판매가 제한된 경우(단, 수출용으로 형태가 상이하게 개발된 품목은 가능)","subitems":[]},{"id":"DAPA_A_2100000238974_ART_4_P2_I9","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제2항-제9호","item_number":"9","content":"제1항에 따라 업체에서 제출한 자료로 심사기준 수립이 곤란한 품목","subitems":[]}]},{"id":"DAPA_A_2100000238974_ART_4_P3","display_id":"DQ마크-인증제도-운영에-관한-고시-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"인증기관장은 제2항 제1호의 중대한 하자에 대한 판단을 위해 공장심사에서 하자를 확인하고 그 결과를 인증위원회에 보고하며 인증위원회에서 결정한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_5","display_id":"DQ마크-인증제도-운영에-관한-고시-제5조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"인증신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_5_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장은 당해 연도 인증심사 계획을 인증기관 및 방위사업청 홈페이지에 공고한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_5_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"DQ마크인증을 받고자 하는 자(이하 \"신청인\"이라 한다)는 별지 제2호의1서식의 DQ마크 인증신청서(이하 \"인증신청서\"라 한다)에 별표4에서 정한 구비서류 및 인증기관이 요청하는 자료를 첨부하여 인증기관장에게 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_5_P3","display_id":"DQ마크-인증제도-운영에-관한-고시-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"인증기관장은 제1항의 규정에 의한 인증신청서를 접수한 때에는 이를 검토하여 미비한 사항이 있는 경우에는 일정한 기간을 정하여 보완을 요구할 수 있으며 기간 내에 보완하지 않는 경우에는 신청서류를 반려할 수 있다.","items":[]},{"id":"DAPA_A_2100000238974_ART_5_P4","display_id":"DQ마크-인증제도-운영에-관한-고시-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"신청인은 DQ마크인증을 신청한 제품(이하 \"인증신청제품\"이라 한다)이 이 규정에 의한 인증심사에서 불합격으로 판정된 경우에는 그 날로부터 6개월이 경과하지 않으면 재신청할 수 없다. 다만, 인증기관장이 필요하다고 인정하는 경우에는 6개월 이내라도 재신청할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_6","display_id":"DQ마크-인증제도-운영에-관한-고시-제6조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"인증심사의 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_6_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장은 제5조의 규정에 의한 DQ마크인증의 신청이 있는 때에는 해당 인증신청제품에 대한 DQ마크 인증심사(이하 \"인증심사\"라 한다)를 실시한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_6_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 인증심사는 공장심사, 제품심사 및 종합심의를 하는 것을 원칙으로 하며, 인증심사 결과가 별표5에서 정한 인증기준에 적합한 경우에 DQ마크인증을 받은 제품(이하 \"인증제품\"이라 한다)으로 판정한다. 다만, 신청품목이 다음 각 호의 어느 하나에 해당하는 경우에는 인증심사의 일부를 생략할 수 있다.","items":[{"id":"DAPA_A_2100000238974_ART_6_P2_I1","display_id":"DQ마크-인증제도-운영에-관한-고시-제6조-제2항-제1호","item_number":"1","content":"인증제품의 성능향상 등으로 모델명이 변경된 경우","subitems":[]},{"id":"DAPA_A_2100000238974_ART_6_P2_I2","display_id":"DQ마크-인증제도-운영에-관한-고시-제6조-제2항-제2호","item_number":"2","content":"DQ마크인증을 인증받은 자(이하 \"인증받은 자\"라 한다)가 6개월 이내 추가 품목을 신청한 경우","subitems":[]},{"id":"DAPA_A_2100000238974_ART_6_P2_I3","display_id":"DQ마크-인증제도-운영에-관한-고시-제6조-제2항-제3호","item_number":"3","content":"제15조의 규정에 따라 인증제품의 사후관리가 도래한 경우","subitems":[]}]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000238974_ART_5","DAPA_A_2100000238974_ART_15"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_7","display_id":"DQ마크-인증제도-운영에-관한-고시-제7조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"서류심사","is_deleted":true,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_7_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제7조","paragraph_number":"","paragraph_index":null,"content":"삭제","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_8","display_id":"DQ마크-인증제도-운영에-관한-고시-제8조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"공장심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_8_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장은 신청인이 우수한 품질의 제품을 지속적으로 생산할 수 있는지 여부를 평가하여 별표5의 심사항목별 평가점수의 합계가 80점 이상인 경우에 공장심사를 합격한 것으로 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_8_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증기관장은 공장심사 시 인증신청서 기재사항의 현장 확인이 필요한 경우에 이와 연계한 확인을 병행할 수 있다.","items":[]},{"id":"DAPA_A_2100000238974_ART_8_P3","display_id":"DQ마크-인증제도-운영에-관한-고시-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"인증기관장은 제1항에 규정한 공장심사를 공장심사팀을 구성하여 실시하되, 공장심사 5근무일 이전에 심사일정과 심사항목 등을 신청인에게 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_8_P4","display_id":"DQ마크-인증제도-운영에-관한-고시-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"국방품질경영체제 인증 또는 ISO품질경영시스템 인증을 받은 업체의 경우 제1항 심사의 일부 또는 전부를 생략할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_9","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"제품심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_9_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장은 인증신청제품이 제8조에 의한 공장심사에 합격한 경우에는 제품심사팀을 구성하여 인증신청제품에 대한 제품심사를 실시한다. 이 경우 인증신청제품에 대한 시험ㆍ검사는 제품심사팀 입회하에 실시하는 현장시험ㆍ검사와 인증기관에서 지정한 공인시험ㆍ검사기관에 의뢰하여 실시하는 위탁시험ㆍ검사로 구분하여 실시할 수 있다.","items":[]},{"id":"DAPA_A_2100000238974_ART_9_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 제품심사는 인증신청제품이 규격 또는 이에 준하는 심사기준을 모두 충족시키는 경우에 제품심사를 합격한 것으로 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_9_P3","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항에 의한 규격 또는 이에 준하는 심사기준은 다음 각 호와 같다. 다만, 다음 각 호의 어느 하나를 심사기준으로 적용하기에 미흡하다고 판단되는 경우 인증기관장은 심사기준을 보완할 수 있다.","items":[{"id":"DAPA_A_2100000238974_ART_9_P3_I1","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제3항-제1호","item_number":"1","content":"국방규격(KDS),국방도면 및 품질보증보충규정, 구매요구서","subitems":[]},{"id":"DAPA_A_2100000238974_ART_9_P3_I2","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제3항-제2호","item_number":"2","content":"구매국이 사용 또는 요구하는 규격","subitems":[]},{"id":"DAPA_A_2100000238974_ART_9_P3_I3","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제3항-제3호","item_number":"3","content":"기타 인증기관장이 적용이 가능하다고 판단한 자료","subitems":[]},{"id":"DAPA_A_2100000238974_ART_9_P3_I4","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제3항-제4호","item_number":"4","content":"업체규격(단, 업체규격은 유사장비의 국방규격, 공인규격(KS, MIL-SPEC 등)에 준하는 자체 시험성적서로 함.)","subitems":[]}]},{"id":"DAPA_A_2100000238974_ART_9_P4","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제2항의 규정에 의한 심사기준은 심사항목과 심사방법이 명시되어야 하며, 각 항목별 합격기준과 기준미달사항이 설정되어 있어야 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_9_P5","display_id":"DQ마크-인증제도-운영에-관한-고시-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"인증기관장은 최근 3년 이내 발행한 제품성적서 또는 공인시험기관 성적서를 신청인이 제출하는 경우에는 제1항의 심사의 일부 또는 전부를 생략할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000238974_ART_8"],"related_regulations":[],"external_references":[],"keywords":["검사"]},{"id":"DAPA_A_2100000238974_ART_10","display_id":"DQ마크-인증제도-운영에-관한-고시-제10조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"종합심의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_10_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제10조","paragraph_number":"","paragraph_index":null,"content":"인증기관장은 제8조 내지 제9조의 심사결과에 대한 인증위원회의 종합적 심의를 통하여 인증신청제품의 DQ마크 인증여부를 결정한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000238974_ART_8","DAPA_A_2100000238974_ART_9"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_11","display_id":"DQ마크-인증제도-운영에-관한-고시-제11조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"인증서의 교부 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_11_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장이 제10조의 규정에 따라 인증신청제품의 인증을 결정한 때에는 4년 이내의 유효기간을 정하여 별지 제6호 서식의 DQ인증마크와 별지 제7호 서식의 DQ마크 인증서(국문 및 영문)를 발급하여야 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_11_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증기관장이 DQ마크 인증서를 발급한 때에는 인증번호, 제품명, 모델번호(재고번호), 대표자, 회사명, 소재지 등에 대한 정보를 유지하여야 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_11_P3","display_id":"DQ마크-인증제도-운영에-관한-고시-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"인증기관장은 업체의 요청이 있고, 제품의 기술력과 품질의 신뢰성 제고를 위해 필요한 경우에는 군 등에 납품한 사항을 기재할 수 있다.","items":[]},{"id":"DAPA_A_2100000238974_ART_11_P4","display_id":"DQ마크-인증제도-운영에-관한-고시-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"인증받은 자는 해당 제품, 포장, 홍보물 등에 DQ마크를 사용할 수 있으며, DQ마크에 대한 사용은 방위사업청에서 정한「DQ 마크 사용자매뉴얼」에 따른다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000238974_ART_10"],"related_regulations":[],"external_references":[],"keywords":["전자서명"]},{"id":"DAPA_A_2100000238974_ART_12","display_id":"DQ마크-인증제도-운영에-관한-고시-제12조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"처리기간","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_12_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제12조","paragraph_number":"","paragraph_index":null,"content":"인증심사 처리기간은 인증신청일로부터 4개월로 한다. 다만, 제품심사를 위한 시험에 장기간 소요되는 경우에는 처리기간을 연장할 수 있으며, 그 기간은 처리기간에서 제외한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_13","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"인증제품에 대한 지원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_13_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 인증제품의 수출지원을 위하여 다음 각 호의 조치를 취할 수 있다.","items":[{"id":"DAPA_A_2100000238974_ART_13_P1_I1","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조-제1항-제1호","item_number":"1","content":"절충교역(Offset)의 협상방안으로 우선 추천","subitems":[]},{"id":"DAPA_A_2100000238974_ART_13_P1_I2","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조-제1항-제2호","item_number":"2","content":"수출전문인력 양성 우선 지원","subitems":[]},{"id":"DAPA_A_2100000238974_ART_13_P1_I3","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조-제1항-제3호","item_number":"3","content":"국내ㆍ외 전시회 참가비용 우선 지원(단, 지원 범위, 기준 등에 대한 사항은 「방산전시회 참가비 및 시장개척활동비 국고보조금 지급 지침」에 따름.)","subitems":[]},{"id":"DAPA_A_2100000238974_ART_13_P1_I4","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조-제1항-제4호","item_number":"4","content":"인증제품 홍보물 제작 및 해외배포 우선 지원","subitems":[]},{"id":"DAPA_A_2100000238974_ART_13_P1_I5","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조-제1항-제5호","item_number":"5","content":"기타 방위사업청장이 수출지원을 위해 필요하다고 판단한 사항","subitems":[]}]},{"id":"DAPA_A_2100000238974_ART_13_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 제1항의 규정에 의한 지원을 위해 인증기관 또는 제3의 기관을 정하여 업무를 위탁할 수 있으며, 그에 소요되는 비용을 지원할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_14","display_id":"DQ마크-인증제도-운영에-관한-고시-제14조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"이의신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_14_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증신청제품의 인증과 관련된 이해관계자는 인증기관에 별지 제3호서식의 이의신청서에 따라 이의신청을 할 수 있다.","items":[]},{"id":"DAPA_A_2100000238974_ART_14_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증기관장은 제1항에 의하여 이의신청서가 접수된 경우에 인증위원회에 회부하여 심의하도록 하며, 세부 절차는 인증기관장이 정한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["이의신청"]},{"id":"DAPA_A_2100000238974_ART_15","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"사후관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_15_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장은 인증제품에 대한 사후관리를 정기심사, 갱신심사, 변경심사, 특별심사로 구분하여 다음 각 호에 따라 실시한다.","items":[{"id":"DAPA_A_2100000238974_ART_15_P1_I1","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조-제1항-제1호","item_number":"1","content":"정기심사는 매년 1회 제8조의 공장심사절차에 준하여 해당공장에서 인증제품에 대한 생산여건의 변동 및 품질문제 발생 여부 등을 심사한다. 다만, 인증제품과 연관된 국방품질경영체제 인증 또는 ISO품질경영시스템 인증을 받은 업체의 경우에는 정기심사를 생략할 수 있다. 이러한 경우 인증기관장은 인증받은 자에게 인증제품의 생산실적 및 수출 실적, 시험기준 유지여부 등을 서면으로 제출하게 할 수 있다.","subitems":[]},{"id":"DAPA_A_2100000238974_ART_15_P1_I2","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조-제1항-제2호","item_number":"2","content":"갱신심사는 제11조의 규정에 따라 교부된 인증서의 유효기간이 도래하는 경우에 제8조의 공장심사 및 제9조의 제품심사에서 정한 절차에 따라 실시한다. 다만, 인증제품과 연관된 국방품질경영체제 인증 또는 ISO품질경영시스템 인증을 받은 업체의 경우에는 갱신심사를 생략할 수 있다.","subitems":[]},{"id":"DAPA_A_2100000238974_ART_15_P1_I3","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조-제1항-제3호","item_number":"3","content":"변경심사는 품목추가, 공장이전, 핵심공정 변경 등 생산여건의 변화로 인증범위가 변동된 경우 제8조의 공장심사 또는 제9조의 제품심사 절차에 준하여 실시한다.","subitems":[]},{"id":"DAPA_A_2100000238974_ART_15_P1_I4","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조-제1항-제4호","item_number":"4","content":"특별심사는 인증제품이 치명결함(물품을 사용, 유지 혹은 보관하고 있는 사람에게 위험이 미치거나, 안전하지 않은 상황을 초래할 것으로 예상되는 부적합 및 최종물품의 기본적 기능에 중대한 영향을 미칠 것으로 예상되는 부적합을 말함.)인 경우 또는 반복적인 구매자 불만 등이 하자로 판명될 경우 제8조의 공장심사 또는 제9조의 제품심사절차에 준하여 실시한다.","subitems":[]}]},{"id":"DAPA_A_2100000238974_ART_15_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증기관장은 제1항에 따른 연간 사후 관리계획을 수립한 후 매년 1월말까지 인증기관 홈페이지에 게시하여야 한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_15_P3","display_id":"DQ마크-인증제도-운영에-관한-고시-제15조-제3항","paragraph_number":"③","paragraph_index":3,"content":"인증기관장은 사후관리를 실시하는 경우 10근무일 전에 그 사실을 인증받은 자에게 통보하여야 한다. 다만 신속한 조사 및 조치를 위하여 필요하다고 인정되는 경우에는 10근무일 이내라도 사후관리에 착수할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000238974_ART_8","DAPA_A_2100000238974_ART_11","DAPA_A_2100000238974_ART_9"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_16","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"인증의 취소 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_16_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장은 인증제품에 대한 유지ㆍ관리를 위하여 다음 각 호의 기준에 따라 인증받은 자에게 필요한 처분을 할 수 있다.","items":[{"id":"DAPA_A_2100000238974_ART_16_P1_I1","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조-제1항-제1호","item_number":"1","content":"다음 각목의 어느 하나에 해당하는 경우에는 3개월 이내의 기간을 정하여 시정요구를 할 수 있다.","subitems":[{"id":"DAPA_A_2100000238974_ART_16_P1_I1_S1","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조-제1항-제1호-가목","subitem_number":"가","content":"제11조제3항에 의한 「DQ마크 사용자매뉴얼」을 준수하지 않는 경우나. 제15조의 규정에 의한 사후관리심사기준을 충족하지 못한 경우다. 인증제품에 경미한 결함이 발견된 경우"}]},{"id":"DAPA_A_2100000238974_ART_16_P1_I2","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조-제1항-제2호","item_number":"2","content":"다음 각목의 어느 하나에 해당하는 경우에는 DQ마크인증을 취소하거나 6개월 이내의 기간을 정하여 DQ마크사용의 중단을 명할 수 있다. 단, 가목의 경우 DQ마크인증을 취소하여야 한다.","subitems":[{"id":"DAPA_A_2100000238974_ART_16_P1_I2_S1","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조-제1항-제2호-가목","subitem_number":"가","content":"허위 또는 기타 부정한 방법으로 DQ마크인증을 받은 경우나. 제15조의 규정에 의한 사후관리를 정당한 사유 없이 거부 또는 회피하는 경우다. 제1호의 규정에 의한 처분을 받고 정당한 사유 없이 기한 내에 시정하지 아니한 경우라. 인증제품에 치명적 결함이 발견되거나 중대한 하자로 사회적인 물의를 일으킨 경우마. 휴업ㆍ폐업 등으로 인증받은 품목의 생산이 불가능한 경우바. 인증업체의 경영 등 자체 사정에 의해 인증서를 자진 반납한 경우"}]}]},{"id":"DAPA_A_2100000238974_ART_16_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항 규정에 따라 인증이 취소된 품목은 그 날로부터 6개월이 경과하지 않으면 인증을 재신청 할 수 없다. 인증취소 품목의 인증절차는 제8조 내지 제10조의 규정에 따른다.","items":[]},{"id":"DAPA_A_2100000238974_ART_16_P3","display_id":"DQ마크-인증제도-운영에-관한-고시-제16조-제3항","paragraph_number":"③","paragraph_index":3,"content":"인증기관장이 제1항의 처분을 하고자 할 경우에는 해당 인증받은 자에게 지정된 일시, 장소에 출석하여 의견을 진술하게 하거나 서면으로 의견을 제출하게 할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000238974_ART_11","DAPA_A_2100000238974_ART_15","DAPA_A_2100000238974_ART_8","DAPA_A_2100000238974_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_17","display_id":"DQ마크-인증제도-운영에-관한-고시-제17조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"인증서의 재발급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_17_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제17조-제1항","paragraph_number":"①","paragraph_index":1,"content":"다음 각 호의 어느 하나에 해당하는 경우에 인증받은 자 또는 인증제품에 대한 권리를 승계 받은 자는 이미 교부받은 인증서(분실한 경우는 제외한다)와 관련 증빙서류를 첨부하여 인증서의 재교부를 신청할 수 있다.","items":[{"id":"DAPA_A_2100000238974_ART_17_P1_I1","display_id":"DQ마크-인증제도-운영에-관한-고시-제17조-제1항-제1호","item_number":"1","content":"인증서를 분실하였거나 인증서가 훼손된 경우","subitems":[]},{"id":"DAPA_A_2100000238974_ART_17_P1_I2","display_id":"DQ마크-인증제도-운영에-관한-고시-제17조-제1항-제2호","item_number":"2","content":"인증제품의 양도ㆍ양수에 따른 권리변동이 있는 경우","subitems":[]},{"id":"DAPA_A_2100000238974_ART_17_P1_I3","display_id":"DQ마크-인증제도-운영에-관한-고시-제17조-제1항-제3호","item_number":"3","content":"기타 인증서의 기재사항에 변동이 있는 경우","subitems":[]}]},{"id":"DAPA_A_2100000238974_ART_17_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제17조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증기관장은 제1항에 따른 인증서 재발급 신청을 받은 때에는 제1항 각 호의 사실 여부를 확인하고 30일 이내에 인증서를 재발급 한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["전자서명"]},{"id":"DAPA_A_2100000238974_ART_18","display_id":"DQ마크-인증제도-운영에-관한-고시-제18조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"비용의 지원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_18_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제18조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 인증기관장의 요청에 따라 인증위원회 운영, DQ마크 홍보 등 인증업무의 수행에 필요한 비용을 예산범위 내에서 지원할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_19","display_id":"DQ마크-인증제도-운영에-관한-고시-제19조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"사업계획 및 사업결과보고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_19_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제19조-제1항","paragraph_number":"①","paragraph_index":1,"content":"인증기관장은 별지 제4호 서식을 활용하여 제18조에 따라 요청할 비용 등이 포함된 차기연도(F+1년) DQ마크인증 사업계획을 당해연도(F년) 12월말까지 방위사업청장에게 보고한다.","items":[]},{"id":"DAPA_A_2100000238974_ART_19_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제19조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증기관장은 방위사업청장에게 사업진도결과는 분기별로 보고하고, DQ마크인증 사업결과는 매년 12월말까지 별지 제5호 서식을 활용하여 예산정산 내용을 포함하여 보고한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000238974_ART_18"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_20","display_id":"DQ마크-인증제도-운영에-관한-고시-제20조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"20","article_label":"제20조","article_title":"인증제도의 홍보","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_20_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제20조","paragraph_number":"","paragraph_index":null,"content":"인증기관장은 국제시험인증기관과의 협력 및 홍보, 국제품질보증 회의 시에 홍보 등 DQ마크인증의 국제적 신뢰성 확보 및 인지도 향상을 위하여 노력하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_21","display_id":"DQ마크-인증제도-운영에-관한-고시-제21조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"21","article_label":"제21조","article_title":"보고 및 감사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_21_P1","display_id":"DQ마크-인증제도-운영에-관한-고시-제21조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 이 규정의 시행을 위하여 필요한 때에는 인증기관에 대하여 그 업무에 관한 사항을 보고하게 할 수 있다.","items":[]},{"id":"DAPA_A_2100000238974_ART_21_P2","display_id":"DQ마크-인증제도-운영에-관한-고시-제21조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 제1항에 따른 보고를 받은 결과 인증기관에 대한 감사가 필요하다고 인정하는 때에는 해당 인증기관에 대한 감사를 실시할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_22","display_id":"DQ마크-인증제도-운영에-관한-고시-제22조","regulation_id":"DAPA_A_2100000238974","regulation_name":"DQ마크 인증제도 운영에 관한 고시","short_name":"DQ마크 인증제도 운영에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"22","article_label":"제22조","article_title":"","is_deleted":true,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000238974_ART_22_P0","display_id":"DQ마크-인증제도-운영에-관한-고시-제22조","paragraph_number":"","paragraph_index":null,"content":"<삭제>","items":[]}],"notes":[],"effective_date":"2024-04-08","revision_date":"2024-04-08","source_file":"DQ마크 인증제도 운영에 관한 고시.json","source_path":"원문/법제처API/DQ마크 인증제도 운영에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000238974_ART_23","disp