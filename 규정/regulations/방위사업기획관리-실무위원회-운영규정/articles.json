[{"id":"DAPA_A_2100000256988_ART_1","display_id":"방위사업기획관리-실무위원회-운영규정-제1조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_1_P0","display_id":"방위사업기획관리-실무위원회-운영규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위사업법」(이하 \"법\"이라 한다) 제10조(분과위원회, 실무위원회 및 전문위원), 동법 시행령(이하 \"시행령\"이라 한다) 제15조의2(실무위원회)에 근거하여 설치된 방위사업기획ㆍ관리실무위원회(이하 \"실무위원회\"라 한다)의 운영에 필요한 사항을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_10"],"related_regulations":["DEFENSE_ACQ_ACT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_2","display_id":"방위사업기획관리-실무위원회-운영규정-제2조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"심의안건 및 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_2_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"실무위원회는 다음 각 호의 사항을 심의ㆍ조정한다.","items":[{"id":"DAPA_A_2100000256988_ART_2_P1_I1","display_id":"방위사업기획관리-실무위원회-운영규정-제2조-제1항-제1호","item_number":"1","content":"방위사업기획ㆍ관리분과위원회(이하 \"분과위원회\"라 한다.)의 심의ㆍ조정사항으로서 분과위원회 심의ㆍ조정 전 사전검토가 필요하다고 실무위원회 위원장이 인정하는 사항","subitems":[]},{"id":"DAPA_A_2100000256988_ART_2_P1_I2","display_id":"방위사업기획관리-실무위원회-운영규정-제2조-제1항-제2호","item_number":"2","content":"분과위원회의 업무를 지원하기 위해 필요한 다음 각 목의 사항가. 총사업비 3,000억원 이상 5,000억원 미만인 구매사업 또는 총사업비가 1,000억원 이상, 3,000억원 미만인 연구개발사업의 국방규격 제ㆍ개정 및 폐지에 관한 사항나. 계약금액 500억원 미만(단, 정비품목의 경우 500억원 이상도 포함), 5,000만불 미만의 계약을 체결한 방산업체의 존립이 불확실한 경우의 계약 관련 사항","subitems":[]},{"id":"DAPA_A_2100000256988_ART_2_P1_I3","display_id":"방위사업기획관리-실무위원회-운영규정-제2조-제1항-제3호","item_number":"3","content":"효율적인 업무추진을 위하여 필요한 다음 각 목의 사항가. 핵심기술 소요결정(안)(기초연구, 응용연구, 시험개발)나. 시제품 제작비용 100억원 이상에 해당하는 핵심기술 연구개발 시제품 소요군 제공 승인다. 방위사업법 제9조제2항에서 정한 위원회 심의ㆍ조정사항에 해당하지 않는 경우로서 소규모사업(총사업비 200억원 미만)에 해당하거나 반복ㆍ계속사업 등 분과위원회의 심의ㆍ조정이 불필요한 사항라. 무기체계의 기술적ㆍ부수적 성능 결정 및 수정마. 경미한 사항의 소요수정 중 전력화지원요소 수정바. 함정건조기본지침서사. 함수품 목록 확정아. 경미한 성능개량자. <삭제>차. 조달계획 및 조달집행 관련 사항카. 업체ㆍ생산 정비능력에 관한 사항타. 군수품 무역대리업 등록취소에 관한 사항파. 중점관리대상업체 수의계약 품목 지정에 관한 사항하. <삭제>거. <삭제>너. <삭제>더. 현존전력 성능 극대화 사업 선정 등에 관한 사항러. 국방규격 제ㆍ개정 및 폐지에 관한 일반사항머. 선행연구 대상과제 선정에 관한 사항버. 목표양산단가관리에 관한 사항서. 기타 실무위원회 위원장이 필요하다고 인정하는 사항","subitems":[]}]},{"id":"DAPA_A_2100000256988_ART_2_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항제1호에 해당하는 사항은 안건제기 부서장이 실무위원회 심의ㆍ조정 결과를 분과위원회 상정 안건에 반영한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_2_P3","display_id":"방위사업기획관리-실무위원회-운영규정-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항제2호에 해당하는 사항은 실무위원회 심의ㆍ조정을 거쳐 실무위원회 위원장 결재 후 실무위원회 주관부서장(과ㆍ팀장)이 분과위원회에 결과를 보고한다. 다만, 분과위원회의 효율적인 심의를 위해 필요한 경우 안건제기부서장(과ㆍ팀장)이 직접 분과위원회에 결과를 보고할 수 있다.","items":[]},{"id":"DAPA_A_2100000256988_ART_2_P4","display_id":"방위사업기획관리-실무위원회-운영규정-제2조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항제3호에 해당하는 사항은 실무위원회 심의ㆍ조정을 거쳐 실무위원회 위원장 결재 후 실무위원회 주관부서장이 안건 제기부서 및 관련기관 등에 결과를 통보한다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_9"],"related_regulations":["DEFENSE_ACQ_ACT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_3","display_id":"방위사업기획관리-실무위원회-운영규정-제3조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"위원회 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_3_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"실무위원회는 위원장 1인을 포함한 5인 이상 20인 이내의 위원으로 성별을 고려하여 구성한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_3_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"실무위원회의 각 분야별 구성 및 주관부서ㆍ심의대상은「별표 1」과 같다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_4","display_id":"방위사업기획관리-실무위원회-운영규정-제4조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"위원장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_4_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"실무위원회의 위원장은 안건소관 국ㆍ부ㆍ단장이 된다.","items":[]},{"id":"DAPA_A_2100000256988_ART_4_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"실무위원회 위원장은 실무위원회를 대표하고, 그 사무를 총괄하며 부득이한 사유로 직무를 수행할 수 없는 때에는 실무위원회 위원장이 미리 지명한 부위원장이 그 직무를 대행한다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_5","display_id":"방위사업기획관리-실무위원회-운영규정-제5조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"위원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_5_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"실무위원회의 위원은 다음 각 호의 자로 성별을 고려하여 구성한다.","items":[{"id":"DAPA_A_2100000256988_ART_5_P1_I1","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제1항-제1호","item_number":"1","content":"국방부, 합참 및 각군(해병대 포함) 관련 과장","subitems":[]},{"id":"DAPA_A_2100000256988_ART_5_P1_I2","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제1항-제2호","item_number":"2","content":"방위사업청 관련 팀ㆍ과장","subitems":[]},{"id":"DAPA_A_2100000256988_ART_5_P1_I3","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제1항-제3호","item_number":"3","content":"국방과학연구소, 국방기술품질원 및 한국국방연구원 관련 부서장","subitems":[]},{"id":"DAPA_A_2100000256988_ART_5_P1_I4","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제1항-제4호","item_number":"4","content":"시행령 제15조의2 제4항 제4호에 해당하는 민간전문가","subitems":[]},{"id":"DAPA_A_2100000256988_ART_5_P1_I5","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제1항-제5호","item_number":"5","content":"기타 관계기관 부서장 등","subitems":[]}]},{"id":"DAPA_A_2100000256988_ART_5_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"각 실무위원회 위원은 시행령 제15조의2 제4항의 위원 중에서 해당 실무위원회의 성격 및 심의안건의 특성 등을 고려, 실무위원회 위원장이 정한다. 다만, 실무위원회 위원의 20%이상은 제1항 제4호의 민간전문가로 구성하여야 하고,「방위사업청 내 위원회의 투명한 운영에 관한 규정」제5조의2(외부위원의 위촉) 및 다음 각 호에 따라 민간전문가를 위촉한다.","items":[{"id":"DAPA_A_2100000256988_ART_5_P2_I1","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제2항-제1호","item_number":"1","content":"실무위원회 주관부서의 장은 민간전문가에 적합한 대상자를 별지4호 서식에 따라 추천을 받고,「보안업무규정」에 따라 보안담당관에게 신원조사를 요청한다.","subitems":[]},{"id":"DAPA_A_2100000256988_ART_5_P2_I2","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제2항-제2호","item_number":"2","content":"추천 대상자에 대한 신원조사 완료 후, 실무위원회 주관부서의 장은 추천 대상자의 적합여부를 검토한 후 실무위원회 위원장에게 보고하고 승인받음으로써 결과를 확정한다.","subitems":[]}]},{"id":"DAPA_A_2100000256988_ART_5_P3","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"실무위원회 위원의 제척ㆍ기피ㆍ회피에 관한 사항은 시행령 제14조의2를 준용한다. 이 경우 ‘위원회’는 ‘실무위원회’로 본다.","items":[]},{"id":"DAPA_A_2100000256988_ART_5_P4","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"실무위원회 위원의 해촉에 관한 사항은 시행령 제14조의3를 준용한다. 이 경우 ‘국방부장관’은 ‘방위사업청장’으로 본다.","items":[]},{"id":"DAPA_A_2100000256988_ART_5_P5","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"방위사업청장은 시행령 제15조의2 제4항 제4호에 따른 위원의 위촉 및 동조 제6항, 제14조의3에 따른 위원의 해촉에 관한 사무를 각 실무위원회 위원장에게 내부위임한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_5_P6","display_id":"방위사업기획관리-실무위원회-운영규정-제5조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"시행령 제15조의2 제4항 제4호에 따른 위원의 임기는 2년으로 하며, 1회에 한하여 중임할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000216972_ART_5_2"],"related_regulations":["DAPA_A_2100000216972"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_6","display_id":"방위사업기획관리-실무위원회-운영규정-제6조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"간사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_6_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"실무위원회에는 간사 1인을 둔다.","items":[]},{"id":"DAPA_A_2100000256988_ART_6_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 실무위 주관부서 소속 직원 중 실무위원장이 지명하는 자로 정한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_6_P3","display_id":"방위사업기획관리-실무위원회-운영규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"간사는 실무위원회 위원장의 명을 받아 회의일자 지정, 위원회 소집, 심의안건 배포, 회의장 준비, 외부참석자에 대한 행정조치, 위원회 진행 및 결과보고 등의 업무를 담당한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_6_P4","display_id":"방위사업기획관리-실무위원회-운영규정-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"간사는 회의시 제기된 의견을 별지 제1호 서식의 의사록에 기록하여 관리하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_7","display_id":"방위사업기획관리-실무위원회-운영규정-제7조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"대리출석 및 배석","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_7_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"실무위원회 위원이 궐원ㆍ출장 또는 사고의 사유로 위원회에 출석하지 못하여 직무대리규정에 따라 그 직무를 대행하는 자가 실무위원회에 참석하고자 할 때에는 실무위원회 개최 전까지 실무위원회 위원장의 승인을 받아 실무위원회에 출석하여 발언 및 표결을 할 수 있다.","items":[]},{"id":"DAPA_A_2100000256988_ART_7_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"안건과 관련된 방위사업청(출연기관 포함), 국방부, 합참, 소요군 등 관련기관의 담당자는 청렴서약서를 제출 후 실무위원회에 배석할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["대리"]},{"id":"DAPA_A_2100000256988_ART_8","display_id":"방위사업기획관리-실무위원회-운영규정-제8조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"위원회 운영 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_8_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"안건제기 부서의 장(과ㆍ팀장)은 다음 각 호의 사항이 포함된 실무위원회 상정 안건을 작성하여 실무위원회 주관부서에 제출하고, 실무위원회 위원장에게 선행보고 후, 해당 안건을 각 위원에게 배부하며, 실무위원회에 참석하여 안건보고 및 위원의 질문에 답변한다.","items":[{"id":"DAPA_A_2100000256988_ART_8_P1_I1","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제1항-제1호","item_number":"1","content":"제안이유","subitems":[]},{"id":"DAPA_A_2100000256988_ART_8_P1_I2","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제1항-제2호","item_number":"2","content":"주요내용","subitems":[]},{"id":"DAPA_A_2100000256988_ART_8_P1_I3","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제1항-제3호","item_number":"3","content":"심의의결사항","subitems":[]},{"id":"DAPA_A_2100000256988_ART_8_P1_I4","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제1항-제4호","item_number":"4","content":"기타 필요사항","subitems":[]}]},{"id":"DAPA_A_2100000256988_ART_8_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 회의개최 7일 이전까지 의사일정 및 심의안건을 각 위원에게 통지하여야 한다. 다만, 사전배부가 곤란하거나 부적절하다고 실무위원회 위원장이 승인하는 경우와 긴급을 요하는 때에는 그러하지 아니한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_8_P3","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"실무위원회는 위원장을 포함하여 재적위원 과반수의 출석으로 개회하고, 출석위원 과반수의 찬성으로 의결하되 표결은 기명으로 한다. 다만, 위원장은 심의안건의 내용이 경미하거나, 긴급한 사유로 회의를 소집할 시간적 여유가 없는 경우에는 서면으로 심의할 수 있다.","items":[]},{"id":"DAPA_A_2100000256988_ART_8_P4","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"실무위원회 위원장과 위원은 별지 제2호 서식의 의결서에 찬반여부와 의견을 자필로 기록한 후 서명하여야 하며 복수 안건일 경우 안건별로 의결서를 작성할 수 있다.","items":[]},{"id":"DAPA_A_2100000256988_ART_8_P5","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"심의결과는 실무위원회에서 비공개로 결정하거나 공개범위, 시기, 방법 등에 대하여 별도로 정한 경우를 제외하고는 공개를 원칙으로 한다. 다만, 위원회 또는 분과위원회에 상정되는 안건에 대한 심의 결과는 분과위원회 보고 및 심의ㆍ조정이 종결될 때까지 비공개를 원칙으로 한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_8_P6","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"실무위원회의 심의ㆍ조정과정에서 분과위원회 심의시 참고할 만한 추가적인 자료수집이 필요하거나 정책적 고려요소가 있을 때에는 실무위원회 의결시 부대의견을 첨부할 수 있다. 이때 추가적인 자료수집이 필요한 경우 간사는 관련 기관 및 업체 등에 요청하여 관련 자료를 제출하도록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_8_P7","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"기타 실무위원회의 운영절차는 분과위원회 운영규정을 준용한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_8_P8","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"실무위원회 회의 간 토의된 사항 중 실무위원회 종료 후 미결ㆍ추가 검토가 요구되는 사항은 간사 책임 하에 검토ㆍ수정 후 관련 위원에게 통보한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_8_P9","display_id":"방위사업기획관리-실무위원회-운영규정-제8조-제9항","paragraph_number":"⑨","paragraph_index":9,"content":"실무위원회 주관부서의 장은 해당 안건의 심의 전 출석한 위원으로부터 별지 제3호 서식의 제척ㆍ회피사유 부존재 등 확인서를 제출받아 원본은 보관하며 사본을 방위사업감독관실(감독총괄담당관)에게 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_9","display_id":"방위사업기획관리-실무위원회-운영규정-제9조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"자료요청 및 협조","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_9_P0","display_id":"방위사업기획관리-실무위원회-운영규정-제9조","paragraph_number":"","paragraph_index":null,"content":"안건 제기부서는 각 위원으로부터 해당 분야 검토에 필요한 추가자료 요청 및 질의에 대하여 적극 협조하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000256988_ART_10","display_id":"방위사업기획관리-실무위원회-운영규정-제10조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"청렴서약제 및 비밀준수","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_10_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"법 제6조, 제50조 및 보안업무관련규정에 의거 실무위원회 위원의 임명ㆍ위촉 시 임명ㆍ위촉되는 위원은 청렴서약서를 위원장에게 제출하고, 방위사업과 관련하여 업무수행 중 알게 된 비밀을 누설하거나 도용하여서는 아니 된다.","items":[]},{"id":"DAPA_A_2100000256988_ART_10_P2","display_id":"방위사업기획관리-실무위원회-운영규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 실무위원회 개최 시 위원에게 청렴서약 및 보안 준수 등에 대한 사항을 고지한다.","items":[]}],"notes":[],"effective_date":"2025-03-26","revision_date":"2025-03-26","source_file":"방위사업기획·관리 실무위원회 운영규정.json","source_path":"원문/법제처API/방위사업기획·관리 실무위원회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_6","DEFENSE_ACQ_ACT_ART_50"],"related_regulations":["DEFENSE_ACQ_ACT"],"external_references":[],"keywords":["청렴계약"]},{"id":"DAPA_A_2100000256988_ART_11","display_id":"방위사업기획관리-실무위원회-운영규정-제11조","regulation_id":"DAPA_A_2100000256988","regulation_name":"방위사업기획·관리 실무위원회 운영규정","short_name":"방위사업기획·관리 실무위원회 운영규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"회의록 유지ㆍ관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000256988_ART_11_P1","display_id":"방위사업기획관리-실무위원회-운영규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"간사는 실무위원회에서 토의된 내용의 안건, 의결서, 의사록, 청렴서약서 등을 포함하여 유지ㆍ관리하여야 한다.","items":[]},{"id":"DAPA_A_2100000256988_ART_11_P2","display_id":"방위사업기획관리