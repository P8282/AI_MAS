[{"id":"DAPA_A_2100000274630_ART_1","display_id":"지식재산권-관리지침-제1조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_1_P0","display_id":"지식재산권-관리지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「국방과학기술혁신 촉진법」 제10조(개발성과물의 귀속 등) 및 동법 시행령 제13조(지식재산권의 공동소유)에 따라 방위사업청 소유 지식재산권 및 「공무원 직무발명의 처분ㆍ관리 및 보상 등에 관한 규정」 제3조 및 제5조부터 제9조까지에 따른 방위사업청 소속 공무원의 직무발명에 대한 관리에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_283941_ART_10","DAPA_A_2100000274630_ART_13"],"related_regulations":["DAPA_L_283941"],"external_references":["공무원 직무발명의 처분ㆍ관리 및 보상 등에 관한 규정"],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_2","display_id":"지식재산권-관리지침-제2조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_2_P0","display_id":"지식재산권-관리지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 뜻은 다음과 같다.","items":[{"id":"DAPA_A_2100000274630_ART_2_P0_I1","display_id":"지식재산권-관리지침-제2조-제1호","item_number":"1","content":"\"지식재산\"이란 ‘특허법’, ‘실용신안법’ 및 ‘디자인보호법’에 의하여 보호 대상이 되는 발명, 고안 및 디자인을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I2","display_id":"지식재산권-관리지침-제2조-제2호","item_number":"2","content":"\"지식재산권\"이란 ‘특허법’, ‘실용신안법’ 및 ‘디자인보호법’에 따라 등록된 ‘특허권’, ‘실용신안권’ 및 ‘디자인권’을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I3","display_id":"지식재산권-관리지침-제2조-제3호","item_number":"3","content":"\"국방연구개발사업\"이란 「국방과학기술혁신 촉진법」제2조제5호 가목에서 라목까지의 연구개발사업을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I4","display_id":"지식재산권-관리지침-제2조-제4호","item_number":"4","content":"\"연구개발주관기관\"이란 국방연구개발사업을 주관하여 수행하는 자를 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I5","display_id":"지식재산권-관리지침-제2조-제5호","item_number":"5","content":"\"연구개발참여기관\"이란 국방연구개발사업을 효과적으로 수행하기 위하여 필요한 경우로서 연구개발주관기관 외에 해당 국방연구개발사업에 참여하는자를 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I6","display_id":"지식재산권-관리지침-제2조-제6호","item_number":"6","content":"\"통합사업관리팀\"이란 기반전력사업본부 또는 미래전력사업본부에 소속된 팀으로서 국방연구개발사업을 관리하는 부서를 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I7","display_id":"지식재산권-관리지침-제2조-제7호","item_number":"7","content":"\"발명\"이란 특허법, 실용신안법 및 디자인보호법에서 정의한 발명, 고안 및 디자인을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I8","display_id":"지식재산권-관리지침-제2조-제8호","item_number":"8","content":"\"직무발명\"이란 방위사업청 공무원이 자기가 맡은 직무에 관하여 발명한 것이 성질상 방위사업청의 업무범위에 속하고 그 발명을 하게 된 행위가 해당 공무원의 현재 또는 과거의 직무에 속하는 발명을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I9","display_id":"지식재산권-관리지침-제2조-제9호","item_number":"9","content":"\"발명자\"란 직무발명을 한 공무원을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I10","display_id":"지식재산권-관리지침-제2조-제10호","item_number":"10","content":"\"특허\"란 특허법상 발명에 대한 특허, 실용신안법상 고안에 대한 실용신안등록 및 디자인보호법상 디자인에 대한 디자인등록을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274630_ART_2_P0_I11","display_id":"지식재산권-관리지침-제2조-제11호","item_number":"11","content":"\"양도계약\"이란 지식재산권을 공동소유하기 위해 연구개발주관기관 또는 연구개발참여기관이 방위사업청장과 체결하는 계약을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_283941_ART_2"],"related_regulations":["DAPA_L_283941"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_3","display_id":"지식재산권-관리지침-제3조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제2장 지식재산의 식별 및 권리화","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"지식재산의 식별","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_3_P0","display_id":"지식재산권-관리지침-제3조","paragraph_number":"","paragraph_index":null,"content":"통합사업관리팀장은 연구개발주관기관의 장이 연구개발사업 수행과정에서 식별된 지식재산을 신고하려할 경우 다음 각 호의 서류가 첨부된 별지 제1호 서식의 지식재산신고서를 연구개발주관기관의 장으로부터 제출받아야 한다.","items":[{"id":"DAPA_A_2100000274630_ART_3_P0_I1","display_id":"지식재산권-관리지침-제3조-제1호","item_number":"1","content":"지식재산에 대한 요약서(별지 제2호 서식)","subitems":[]},{"id":"DAPA_A_2100000274630_ART_3_P0_I2","display_id":"지식재산권-관리지침-제3조-제2호","item_number":"2","content":"지식재산에 대한 설명서(별지 제3호 서식)","subitems":[]},{"id":"DAPA_A_2100000274630_ART_3_P0_I3","display_id":"지식재산권-관리지침-제3조-제3호","item_number":"3","content":"지식재산에 대한 도면(필요시)","subitems":[]},{"id":"DAPA_A_2100000274630_ART_3_P0_I4","display_id":"지식재산권-관리지침-제3조-제4호","item_number":"4","content":"지식재산 관련 유사기술 존재 여부에 대한 검토 결과(필요시)","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_4","display_id":"지식재산권-관리지침-제4조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제2장 지식재산의 식별 및 권리화","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"지식재산의 권리화","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_4_P1","display_id":"지식재산권-관리지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 제3조에 따라 연구개발주관기관의 장이 제출한 지식재산신고서 및 첨부 서류를 확인한 후 지식재산 출원 절차의 진행을 기술정책과장에게 요청하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_P2","display_id":"지식재산권-관리지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기술정책과장은 통합사업관리팀장으로부터 지식재산 출원에 대한 요청을 받았을 때에는 해당 사업 연구개발주관기관의 장에게 지식재산 출원에 관한 제반 절차를 이행하도록 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_P3","display_id":"지식재산권-관리지침-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기술정책과장은 연구개발주관기관의 장으로부터 제2항에 따른 지식재산의 출원 결과를 제출받아야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_P4","display_id":"지식재산권-관리지침-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"기술정책과장은 제2항에 따른 지식재산의 출원에 의해 지식재산권이 취득되었을 때에는 이를 운영지원과장에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274630_ART_3"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_4_2","display_id":"지식재산권-관리지침-제4조의2","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제2장 지식재산의 식별 및 권리화","section":"","subsection":"","article_number":"4의2","article_label":"제4조의2","article_title":"무기체계 연구개발사업 지식재산권 공동출원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_4_2_P1","display_id":"지식재산권-관리지침-제4조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"「국방과학기술혁신 촉진법 시행령」제13조제1항제1호에 따라 연구개발주관기관이 연구개발비의 전부 또는 일부를 부담한 경우, 통합사업관리팀은 해당 사업의 계약서 또는 협약서에 연구개발주관기관이 지식재산권 공동소유기관임을 명시한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_2_P2","display_id":"지식재산권-관리지침-제4조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 연구개발주관기관은 개발성과물을 지식재산으로 출원하는 경우, 공동출원의 방식으로 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_2_P3","display_id":"지식재산권-관리지침-제4조의2-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀은 해당사업의 계약서 또는 협약서에 명시된 공동소유 지식재산권 자료를 기술정책과에 제출하고, 기술정책과는 국방기술품질원 부설기관 국방기술진흥연구소(이하 \"국기연\"이라 한다)로 하여금 이를 국방기술정보통합서비스에 등록하게 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_2_P4","display_id":"지식재산권-관리지침-제4조의2-제4항","paragraph_number":"④","paragraph_index":4,"content":"통합사업관리팀은 지식재산권 공동소유자가 해당사업의 계약서 또는 협약서에 명시되지 않은 사항들에 대하여 각 지식재산권이 등록된 근거법령(「특허법」, 「실용신안법」 및 「디자인보호법」)을 준수하여 관리하도록 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287549_ART_13"],"related_regulations":["DAPA_L_287549"],"external_references":[],"keywords":["계약서 작성"]},{"id":"DAPA_A_2100000274630_ART_4_3","display_id":"지식재산권-관리지침-제4조의3","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제2장 지식재산의 식별 및 권리화","section":"","subsection":"","article_number":"4의3","article_label":"제4조의3","article_title":"기술 연구개발사업 지식재산권 양도계약","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_4_3_P1","display_id":"지식재산권-관리지침-제4조의3-제1항","paragraph_number":"①","paragraph_index":1,"content":"「국방과학기술혁신촉진법 시행령」제13조제1항제2호에 따라 연구개발주관기관 또는 연구개발참여기관이 해당 연구개발 사업 종료 후 지식재산권을 공동소유 하고자 하는 경우 지식재산권(분할, 변경출원의 경우도 같다)의 등록공고일(다수의 지식재산권이 출원된 경우 최종 등록공고일, 거절된 경우에는 거절결정 확정일 또는 거절한다는 취지의 심결 확정일) 60일 이내에 지식재산권 공동소유를 위해 방위사업청장(기술정책과)에게 지식재산권 양도계약 체결을 신청하여야 한다. 위 기간 내 양도계약 체결을 신청하지 않는 경우 지식재산권 공동소유의 의사가 없는 것으로 간주한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P2","display_id":"지식재산권-관리지침-제4조의3-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따른 신청이 있는 경우 기술정책과장은 공동소유 자격 여부를 포함한 양도계약 내용을 국방과학연구소 또는 국기연에 의뢰하여 검토한 후, 양도계약 체결 신청 접수일 60일 이내에 운영지원과장에게 양도계약 체결을 의뢰하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P3","display_id":"지식재산권-관리지침-제4조의3-제3항","paragraph_number":"③","paragraph_index":3,"content":"기술정책과장은 연구개발주관기관 또는 연구개발참여기관이 공동소유 자격을 갖추지 못하였다고 판단한 경우, 양도계약 신청 접수일 60일 이내 그 결과를 신청기관에 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P4","display_id":"지식재산권-관리지침-제4조의3-제4항","paragraph_number":"④","paragraph_index":4,"content":"연구개발주관기관 또는 연구개발참여기관은 양도계약 신청 시 별지 제11호(지식재산권 양도계약서) 서식을 작성한 후 제출하여야 한다. 연구개발주관기관 또는 연구개발참여기관은 지식재산권을 공동소유하기 위하여 방위사업청장에게 양도계약서에 명시된 기한까지 아래와 같은 대금을 지급하여야 한다.","items":[{"id":"DAPA_A_2100000274630_ART_4_3_P4_I1","display_id":"지식재산권-관리지침-제4조의3-제4항-제1호","item_number":"1","content":"대기업 : 정부출연금의 40%","subitems":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P4_I2","display_id":"지식재산권-관리지침-제4조의3-제4항-제2호","item_number":"2","content":"중견기업 : 정부출연금의 20%","subitems":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P4_I3","display_id":"지식재산권-관리지침-제4조의3-제4항-제3호","item_number":"3","content":"중소기업 : 정부출연금의 10%","subitems":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P4_I4","display_id":"지식재산권-관리지침-제4조의3-제4항-제4호","item_number":"4","content":"비영리법인 : 양도 대상 지식재산권의 출원ㆍ등록(출원료 및 설정등록료 등)에 발생한 모든 비용의 50%","subitems":[]}]},{"id":"DAPA_A_2100000274630_ART_4_3_P5","display_id":"지식재산권-관리지침-제4조의3-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"지식재산권 공동소유자는 지식재산권 실시에 따른 기술료를 「국방과학기술료 산정ㆍ징수방법 및 징수절차 등에 관한 고시」에 의거하여 징수한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P6","display_id":"지식재산권-관리지침-제4조의3-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"연구개발주관기관 또는 연구개발참여기관이 양도계약을 통해 공동소유 한 지식재산을 해외에 출원하는 경우 방위사업청장으로부터 사전 서면동의를 받아야 하고, 출원비용을 부담하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_4_3_P7","display_id":"지식재산권-관리지침-제4조의3-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"방위사업청장은 지식재산권 공동소유자가 양도계약 사항을 위반한 경우 양도계약을 취소할 수 있다. 이 경우 방위사업청장은 지식재산권 대금을 반환하지 않는다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287549_ART_13"],"related_regulations":["DAPA_L_287549"],"external_references":[],"keywords":["계약서 작성"]},{"id":"DAPA_A_2100000274630_ART_5","display_id":"지식재산권-관리지침-제5조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제1절 직무발명심의위원회 구성ㆍ운영","subsection":"","article_number":"5","article_label":"제5조","article_title":"직무발명심의위원회","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_5_P0","display_id":"지식재산권-관리지침-제5조","paragraph_number":"","paragraph_index":null,"content":"직무발명에 관한 주요 사항을 심의하기 위하여 국방기술개발보호국에 직무발명심의위원회(이하 \"위원회\"라 한다)를 둘 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_6","display_id":"지식재산권-관리지침-제6조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제1절 직무발명심의위원회 구성ㆍ운영","subsection":"","article_number":"6","article_label":"제6조","article_title":"기능","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_6_P0","display_id":"지식재산권-관리지침-제6조","paragraph_number":"","paragraph_index":null,"content":"위원회는 다음 각 호의 사항을 심의ㆍ의결하고, 별지 제4호 서식의 심의의결서를 작성한다.","items":[{"id":"DAPA_A_2100000274630_ART_6_P0_I1","display_id":"지식재산권-관리지침-제6조-제1호","item_number":"1","content":"제9조에 따라 신고를 받은 발명이 직무발명에 속하는지 여부","subitems":[]},{"id":"DAPA_A_2100000274630_ART_6_P0_I2","display_id":"지식재산권-관리지침-제6조-제2호","item_number":"2","content":"직무발명으로 결정된 발명의 국가승계 여부","subitems":[]},{"id":"DAPA_A_2100000274630_ART_6_P0_I3","display_id":"지식재산권-관리지침-제6조-제3호","item_number":"3","content":"그 밖에 위원회의 심의ㆍ의결이 필요하다고 인정되는 사항","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274630_ART_9"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_7","display_id":"지식재산권-관리지침-제7조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제1절 직무발명심의위원회 구성ㆍ운영","subsection":"","article_number":"7","article_label":"제7조","article_title":"구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_7_P1","display_id":"지식재산권-관리지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원회는 위원장을 포함한 5인 이상 10인 이내의 위원으로 구성한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_7_P2","display_id":"지식재산권-관리지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원장은 국방기술개발보호국장이 되고, 위원은 다음 각 호의 자 중에서 위원장이 위촉하는 자로 한다.","items":[{"id":"DAPA_A_2100000274630_ART_7_P2_I1","display_id":"지식재산권-관리지침-제7조-제2항-제1호","item_number":"1","content":"심의 안건 소관 과ㆍ팀장","subitems":[]},{"id":"DAPA_A_2100000274630_ART_7_P2_I2","display_id":"지식재산권-관리지침-제7조-제2항-제2호","item_number":"2","content":"국방과학연구소 연구원","subitems":[]},{"id":"DAPA_A_2100000274630_ART_7_P2_I3","display_id":"지식재산권-관리지침-제7조-제2항-제3호","item_number":"3","content":"산업체ㆍ대학ㆍ정부출연연구기관 전문가","subitems":[]},{"id":"DAPA_A_2100000274630_ART_7_P2_I4","display_id":"지식재산권-관리지침-제7조-제2항-제4호","item_number":"4","content":"변호사ㆍ변리사","subitems":[]},{"id":"DAPA_A_2100000274630_ART_7_P2_I5","display_id":"지식재산권-관리지침-제7조-제2항-제5호","item_number":"5","content":"기타 심의대상 기술 분야에 관한 학식과 경험이 풍부한 자","subitems":[]}]},{"id":"DAPA_A_2100000274630_ART_7_P3","display_id":"지식재산권-관리지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원회 운영에 관한 사무 처리를 위해 간사를 둔다. 간사는 기술정책과의 부서원 중에서 위원장이 정하여 임명한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_8","display_id":"지식재산권-관리지침-제8조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제1절 직무발명심의위원회 구성ㆍ운영","subsection":"","article_number":"8","article_label":"제8조","article_title":"운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_8_P1","display_id":"지식재산권-관리지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원장은 위원회를 소집하고 회의를 주관한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_8_P2","display_id":"지식재산권-관리지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원회의 심의는 위원장을 포함하여 과반수 이상의 출석으로 개의하고, 출석위원 과반수의 찬성으로 의결한다. 다만, 가부동수인 경우에는 가결된 것으로 본다.","items":[]},{"id":"DAPA_A_2100000274630_ART_8_P3","display_id":"지식재산권-관리지침-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장은 필요하다고 인정하는 경우 위원이 아닌 사람을 위원회에 참석하게 하여 의견을 들을 수 있다.","items":[]},{"id":"DAPA_A_2100000274630_ART_8_P4","display_id":"지식재산권-관리지침-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"위원회의 회의 내용은 의결로 공개하는 경우를 제외하고는 모두 비공개로 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_8_P5","display_id":"지식재산권-관리지침-제8조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제1항부터 제4항까지 규정한 사항 외에 위원회의 운영 등에 필요한 사항은 위원회의 의결을 거쳐 위원장이 정한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_9","display_id":"지식재산권-관리지침-제9조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제2절 직무발명의 관리","subsection":"","article_number":"9","article_label":"제9조","article_title":"직무발명의 신고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_9_P0","display_id":"지식재산권-관리지침-제9조","paragraph_number":"","paragraph_index":null,"content":"공무원이 자기가 맡은 직무와 관계되는 발명을 한 경우(특허 출원하기 이전을 말한다) 또는 보유 중인 지식재산권이 자기의 직무와 관계되는 것을 알았을 경우에는 지체 없이 그 내용을 별지 제5호 서식에 따라 직무발명신고서를 작성하여 기술정책과장에게 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_10","display_id":"지식재산권-관리지침-제10조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제2절 직무발명의 관리","subsection":"","article_number":"10","article_label":"제10조","article_title":"직무발명의 심의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_10_P1","display_id":"지식재산권-관리지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기술정책과장은 제9조에 의해 직무발명의 신고를 받았을 때에는 위원회에 심의를 요청하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_10_P2","display_id":"지식재산권-관리지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원장은 직무발명의 신고를 받은 날로부터 2개월 이내에 위원회를 소집하고, 위원회는 해당 직무발명에 대해 제6조 제1호 및 제2호의 사항을 심의ㆍ의결하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_10_P3","display_id":"지식재산권-관리지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"위원장은 제2항에 의한 심의결과를 발명자에게 서면으로 통지하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274630_ART_9","DAPA_A_2100000274630_ART_6"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_11","display_id":"지식재산권-관리지침-제11조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제2절 직무발명의 관리","subsection":"","article_number":"11","article_label":"제11조","article_title":"권리양도 및 출원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_11_P1","display_id":"지식재산권-관리지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원회의 위원장으로부터 국가승계 결정의 통지를 받은 발명자는 지체 없이 그 직무발명에 대하여 특허를 받을 수 있는 권리 또는 지식재산권을 국가에 양도하여야 한다. 이 경우 발명자는 권리 양도를 위한 제반서류를 기술정책과장에게 제출하여야 하고, 기술정책과장은 해당 권리를 국가에 양도하기 위한 절차를 이행하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_11_P2","display_id":"지식재산권-관리지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"발명자는 제10조제3항에 따라 국가승계를 하지 아니한다는 결정의 통지를 받지 아니하고는 직무발명에 대하여 자기의 명의로 특허출원을 할 수 없다. 다만, 그 발명이 자기가 맡은 직무와 관계되는 발명에 해당되지 아니하는 경우에는 그러하지 아니하다.","items":[]},{"id":"DAPA_A_2100000274630_ART_11_P3","display_id":"지식재산권-관리지침-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기술정책과장은 제1항에 의해 특허를 받을 수 있는 권리를 양도 받았을 때에는 지체 없이 방위사업청장을 부기하여 국가 명의로 특허출원을 하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_11_P4","display_id":"지식재산권-관리지침-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"기술정책과장은 제1항에 의한 권리의 국가 양도 및 제3항에 의한 특허출원을 완료하면 이를 운영지원과장과 발명자에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274630_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_12","display_id":"지식재산권-관리지침-제12조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제3장 공무원 직무발명","section":"제2절 직무발명의 관리","subsection":"","article_number":"12","article_label":"제12조","article_title":"국유특허권 등록","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_12_P1","display_id":"지식재산권-관리지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기술정책과장은 지식재산권을 국가승계하거나 특허출원 중인 직무발명이 등록결정되었을 때에는 지체 없이 별지 제8호의 국유특허권 등록요청서를 첨부하여 특허청장에게 국유특허권의 등록을 요청하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_12_P2","display_id":"지식재산권-관리지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기술정책과장은 제1항에 의한 국유특허권의 등록이 완료되면 이를 운영지원과장과 발명자에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274630_ART_13","display_id":"지식재산권-관리지침-제13조","regulation_id":"DAPA_A_2100000274630","regulation_name":"지식재산권 관리지침","short_name":"지식재산권 관리지침","document_type":"예규","part":"","chapter":"제4장 지식재산권 정보 관리","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"기술정책과의 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274630_ART_13_P1","display_id":"지식재산권-관리지침-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기술정책과장은 제4조에 따라 취득되는 지식재산권의 현황을 관리하고, 이를 다음 년도 1월15일까지 국방기술정보통합서비스에 등록하여야 한다.","items":[]},{"id":"DAPA_A_2100000274630_ART_13_P2","display_id":"지식재산권-관리지침-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기술정책과장은 제1항에 의한 지식재산 현황을 국방기술정보통합서비스에 등록하기 위해 국방기술품질원(국기연) 등 관련 기관에 협조를 요청할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"지식재산권 관리지침.json","source_path":"원문/법제처API/지식재산권 관리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274630_ART_4"],"related_regulations":[],"external_refer