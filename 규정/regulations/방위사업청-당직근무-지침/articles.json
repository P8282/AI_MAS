[{"id":"DAPA_A_2100000271364_ART_1","display_id":"방위사업청-당직근무-지침-제1조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제1장 총칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_1_P0","display_id":"방위사업청-당직근무-지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「국가공무원 복무규정」(대통령령) 및 「국가공무원 복무규칙」(총리령)에 따라 방위사업청의 당직근무에 관하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_2","display_id":"방위사업청-당직근무-지침-제2조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제1장 총칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_2_P0","display_id":"방위사업청-당직근무-지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업청(소속기관 포함)의 당직근무에 적용한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_3","display_id":"방위사업청-당직근무-지침-제3조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"당직의 구분","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_3_P1","display_id":"방위사업청-당직근무-지침-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"당직은 일직과 숙직으로 구분하며, 재택당직을 원칙으로 한다. 다만, 긴급사태가 발생하였거나 발생할 것이 예상되는 경우 운영지원과장은 당직근무자에게 사무실 당직을 명령할 수 있다.","items":[]},{"id":"DAPA_A_2100000271364_ART_3_P2","display_id":"방위사업청-당직근무-지침-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"당직은 자체당직(과천청사 및 대전임시청사 당직을 말한다)과 정부과천청사 당직사령실 당직으로 구분한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_3_P3","display_id":"방위사업청-당직근무-지침-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"일직은 토요일과 공휴일에 두며, 그 근무시간은 정상근무일의 근무시간에 준한다. 재택당직의 경우 특별한 사유가 없으면 그 근무시간은 다음 날의 정상근무 또는 일직근무가 시작될 때까지로 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_3_P4","display_id":"방위사업청-당직근무-지침-제3조-제4항","paragraph_number":"④","paragraph_index":4,"content":"숙직근무시간은 정상근무시간 또는 일직근무시간이 종료된 때부터 다음 날의 정상근무 또는 일직근무가 시작될 때까지로 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_4","display_id":"방위사업청-당직근무-지침-제4조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"당직편성, 면제 및 유예","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_4_P1","display_id":"방위사업청-당직근무-지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"자체당직 근무자는 과천청사 및 대전임시청사 각 1명으로 편성한다. 다만, 당직근무 여건 등 제반 실정을 고려하여 필요한 경우에는 이를 조정하여 운영할 수 있다.","items":[]},{"id":"DAPA_A_2100000271364_ART_4_P2","display_id":"방위사업청-당직근무-지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"당직근무자는 과ㆍ팀장급 이하 직원으로 편성한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_4_P3","display_id":"방위사업청-당직근무-지침-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"당직근무 편성기준은 다음 각 호와 같으며, 당직근무 편성여건을 고려하여 조정할 수 있다.","items":[{"id":"DAPA_A_2100000271364_ART_4_P3_I1","display_id":"방위사업청-당직근무-지침-제4조-제3항-제1호","item_number":"1","content":"과천청사 당직근무자는 6급 이하의 공무원 또는 소령 이하의 군인 1명으로 편성한다.","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P3_I2","display_id":"방위사업청-당직근무-지침-제4조-제3항-제2호","item_number":"2","content":"대전임시청사 당직근무자는 직(계)급 구분 없이 1명으로 편성한다.","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P3_I3","display_id":"방위사업청-당직근무-지침-제4조-제3항-제3호","item_number":"3","content":"정부과천청사 당직사령은 3급, 4급 또는 수석전문관인 공무원 및 대령인 군인 1명으로 편성하며, 당직보좌관은 5급 또는 전문관인 공무원 및 중령인 군인 2명으로 편성한다.","subitems":[]}]},{"id":"DAPA_A_2100000271364_ART_4_P4","display_id":"방위사업청-당직근무-지침-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"운영지원과장은 당직근무 편성기준에 따라 당직순번을 관리ㆍ운영하며, 평일과 휴무일 당직순번을 별도로 관리ㆍ운영할 수 있다.","items":[]},{"id":"DAPA_A_2100000271364_ART_4_P5","display_id":"방위사업청-당직근무-지침-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"운영지원과장은 다음 각 호에 해당하는 자의 당직근무를 면제 또는 유예할 수 있다.","items":[{"id":"DAPA_A_2100000271364_ART_4_P5_I1","display_id":"방위사업청-당직근무-지침-제4조-제5항-제1호","item_number":"1","content":"당직근무의 지휘ㆍ감독자, 당직담당자 및 비상근무 통제직위에 있는 자","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I2","display_id":"방위사업청-당직근무-지침-제4조-제5항-제2호","item_number":"2","content":"국ㆍ부장 이상, 지휘부의 보좌관ㆍ비서, 만 55세 이상의 공무원, 정년 전역 3년 이내의 대령 및 정년 전역 2년 이내의 중령","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I3","display_id":"방위사업청-당직근무-지침-제4조-제5항-제3호","item_number":"3","content":"별도 자체당직을 실시하는 정보화데이터담당관실 및 대변인실 소속 직원","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I4","display_id":"방위사업청-당직근무-지침-제4조-제5항-제4호","item_number":"4","content":"지방사무소 근무자","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I5","display_id":"방위사업청-당직근무-지침-제4조-제5항-제5호","item_number":"5","content":"신규임용자 및 전입자(신규 임용 및 전입일부터 1개월 면제)","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I6","display_id":"방위사업청-당직근무-지침-제4조-제5항-제6호","item_number":"6","content":"임신 중인 자 및 출산 후 1년 이내인 여직원","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I7","display_id":"방위사업청-당직근무-지침-제4조-제5항-제7호","item_number":"7","content":"셋 이상의 미성년 자녀를 둔 직원","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I8","display_id":"방위사업청-당직근무-지침-제4조-제5항-제8호","item_number":"8","content":"신체적ㆍ정신적 결함으로 당직근무가 제한되어 의사의 소견서를 제출한 자(소견서에 명시된 기간 동안 유예)","subitems":[]},{"id":"DAPA_A_2100000271364_ART_4_P5_I9","display_id":"방위사업청-당직근무-지침-제4조-제5항-제9호","item_number":"9","content":"기타 당직근무 면제가 필요하다고 운영지원과장이 지정한 자","subitems":[]}]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_5","display_id":"방위사업청-당직근무-지침-제5조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"당직명령 및 변경","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_5_P1","display_id":"방위사업청-당직근무-지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"운영지원과장은 당직근무 7일 전까지 당직근무를 명령하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_5_P2","display_id":"방위사업청-당직근무-지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"당직근무 대상자 중 전출 예정(순환근무 포함), 교육 및 출장 등 부득이한 사유로 당직근무를 할 수 없는 경우에는 지체없이 당직담당자에게 통보하고 행정업무지원체계를 활용하여 당직근무 변경 신청을 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_6","display_id":"방위사업청-당직근무-지침-제6조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"당직근무자의 준수사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_6_P1","display_id":"방위사업청-당직근무-지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"당직근무자는 근무상의 공무가 아닌 용무로 근무지(사무실 또는 자택)를 이탈해서는 아니되며, 당직근무자는 당직자로서의 품위를 손상하거나 당직근무에 지장이 있는 행위를 하여서는 아니된다.","items":[]},{"id":"DAPA_A_2100000271364_ART_6_P2","display_id":"방위사업청-당직근무-지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"재택당직 중 부득이한 사유로 자택에서 출타한(또는 출타하고자 하는) 경우 운영지원과장의 승인을 얻어야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_7","display_id":"방위사업청-당직근무-지침