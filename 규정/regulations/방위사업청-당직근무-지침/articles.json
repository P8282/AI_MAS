,{"id":"DAPA_A_2100000271364_ART_9_P0_I7","display_id":"방위사업청-당직근무-지침-제9조-제7호","item_number":"7","content":"재택당직자와의 연락 유지","subitems":[]},{"id":"DAPA_A_2100000271364_ART_9_P0_I8","display_id":"방위사업청-당직근무-지침-제9조-제8호","item_number":"8","content":"재택당직자가 긴급사태 발생에 따라 지시하는 초동조치","subitems":[]}]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_10","display_id":"방위사업청-당직근무-지침-제10조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"비상근무 발령 시 당직중지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_10_P1","display_id":"방위사업청-당직근무-지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"비상근무 발령 시 당직근무자는 신속히 청 직원(소속기관을 포함한다) 및 출연기관에 비상근무 발령을 전파하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_10_P2","display_id":"방위사업청-당직근무-지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"비상근무 중일 때에는 당직근무를 중지한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_10_P3","display_id":"방위사업청-당직근무-지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"당직근무자가 당직근무 중 비상근무가 발령되어 제2항에 따라 당직근무를 중지할 때에는 행정업무지원체계을 활용하여 당직근무일지를 보고하고 당직담당자에게 모든 당직근무용 비품을 인계하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_10_P4","display_id":"방위사업청-당직근무-지침-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"운영지원과장은 정상근무시간이 아닌 때에 비상근무가 해제되었을 때에는 즉시 당직근무를 하도록 조치하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_10_P5","display_id":"방위사업청-당직근무-지침-제10조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"이 지침에서 정하지 아니한 비상근무에 대한 사항은 청 충무계획을 따른다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_11","display_id":"방위사업청-당직근무-지침-제11조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"당직근무 방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_11_P1","display_id":"방위사업청-당직근무-지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"당직근무자는 당직근무 개시 30분 전에 운영지원과장에게 당직신고를 하여야 한다. 다만, 토요일 및 공휴일의 당직근무자는 그 직전 정상근무일에 당직신고를 하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_11_P2","display_id":"방위사업청-당직근무-지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"당직근무자는 당직신고 시 운영지원과 당직담당자로부터 당직근무일지, 재택당직 근무 참고철 및 그 밖에 필요한 당직근무용 비품을 인수 및 확인하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_11_P3","display_id":"방위사업청-당직근무-지침-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"재택당직의 경우 평일 근무자는 정상근무 종료시부터 1시간 이상 당직실에서 근무 후 당직실 전화기를 착신전환하고 재택근무로 전환한다. 토요일 및 공휴일 근무자는 보안요원의 협조를 받아 근무시작 30분 전까지 당직실 전화기를 착신전환하고 근무한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_11_P4","display_id":"방위사업청-당직근무-지침-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"재택당직자는 인수한 재택당직 근무 참고철을 상시 소지하여 긴급사태에 대비하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_11_P5","display_id":"방위사업청-당직근무-지침-제11조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"당직근무자는 당직 종료 직후 별지 제1호 서식에 따른 당직근무일지를 행정지원체계를 활용하여 보고하고 당직근무용 비품을 당직담당자에게 인계하여야 한다. 토요일 및 공휴일 재택당직자는 당직이 종료된 직후 근무일에 당직근무일지 보고 및 재택당직 근무 참고철을 인계하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_12","display_id":"방위사업청-당직근무-지침-제12조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"당직근무의 외부감사 및 점검","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_12_P0","display_id":"방위사업청-당직근무-지침-제12조","paragraph_number":"","paragraph_index":null,"content":"당직근무자는 외부기관으로부터 당직근무의 감사 및 점검이 있을 때에는 운영지원과장에게 보고하고 점검관의 신분을 확인한 후 점검에 응하고 그 결과를 당직일지에 기록하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_13","display_id":"방위사업청-당직근무-지침-제13조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"당직수당 지급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_13_P0","display_id":"방위사업청-당직근무-지침-제13조","paragraph_number":"","paragraph_index":null,"content":"재택당직자에게는 당직수당을 지급하지 아니한다. 다만, 당직업무 수행을 위해 출근하여 사무실 근무시간이 3시간을 초과한 경우 당직수당을 익월 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_14","display_id":"방위사업청-당직근무-지침-제14조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제2장 당직근무","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"당직휴무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_14_P0","display_id":"방위사업청-당직근무-지침-제14조","paragraph_number":"","paragraph_index":null,"content":"재택당직자에게는 당직휴무를 부여하지 아니한다. 다만, 사무실 당직을실시한 경우 각급 부서의 장은 그 종료시각이 속하는 날부터 토요일 또는 공휴일을 제외한 10일째 되는 날까지의 기간 중 1일의 일정 시간(전부 휴무 포함)을 정하여 휴무하게 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_15","display_id":"방위사업청-당직근무-지침-제15조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제3장 당직 지원 등","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"당직실","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_15_P1","display_id":"방위사업청-당직근무-지침-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"당직실은 당직근무 수행에 가장 적합한 위치에 설치 및 운영하여야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_15_P2","display_id":"방위사업청-당직근무-지침-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"당직실에는 착신전환기능을 탑재한 전화기를 설치하여야 하며, 긴급상황 발생에 대비하여 관할 군부대, 경찰서 및 소방서 등 유관기관과 상시 연락체제를 유지할 수 있도록 통신연락망 체계를 갖추어야 한다.","items":[]},{"id":"DAPA_A_2100000271364_ART_15_P3","display_id":"방위사업청-당직근무-지침-제15조-제3항","paragraph_number":"③","paragraph_index":3,"content":"당직실에는 다음 각 호의 서류 및 물품을 갖추어 두어야 한다.","items":[{"id":"DAPA_A_2100000271364_ART_15_P3_I1","display_id":"방위사업청-당직근무-지침-제15조-제3항-제1호","item_number":"1","content":"비치서류 및 비품가. 당직근무자의 긴급사태 시 대처방법나. 긴급사태 시 직원 연락처다. 기관 간 비상연락 체계도라. 관계 기관의 당직실 전화번호부마. 당직 관련 법령 및 본 지침바. 당직근무일지(별지 제1호 서식)사. 재택당직 근무 참고철(가, 나, 다, 라, 마, 바목을 포함한다.)아. 직원 비상소집 명부자. 향토예비군 비상소집 명부차. 민방위대원 비상소집 명부카. 비상열쇠함 및 비상열쇠 관리기록부타. 초과근무수당 일지파. 기타 당직근무 수행에 필요한 비품 및 문서","subitems":[]},{"id":"DAPA_A_2100000271364_ART_15_P3_I2","display_id":"방위사업청-당직근무-지침-제15조-제3항-제2호","item_number":"2","content":"부착물가. 일반현황판나. 기관별 당직실 현황다. 상황보고 및 연락체계도라. 긴급사태 시 조치요령마. 긴급구조 구급환자 발생 시 행동요령바. 당직근무 게시판사. 기타 당직근무 수행에 필요한 사항","subitems":[]}]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_16","display_id":"방위사업청-당직근무-지침-제16조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제3장 당직 지원 등","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"당직실 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_16_P0","display_id":"방위사업청-당직근무-지침-제16조","paragraph_number":"","paragraph_index":null,"content":"운영지원과장은 당직실 운영에 필요한 행정지원을 하고, 정보화데이터담당관은 당직실에 필요한 전화기ㆍ전산장비 등을 설치 및 지원하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_17","display_id":"방위사업청-당직근무-지침-제17조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제3장 당직 지원 등","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"당직차량 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_17_P0","display_id":"방위사업청-당직근무-지침-제17조","paragraph_number":"","paragraph_index":null,"content":"운영지원과장은 당직업무의 원활한 수행을 위하여 당직차량을 지원할 수 있다. 당직차량은 당직업무 수행 목적에 한하여 운행한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_18","display_id":"방위사업청-당직근무-지침-제18조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제3장 당직 지원 등","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"운영지원과장의 임무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_18_P1","display_id":"방위사업청-당직근무-지침-제18조-제1항","paragraph_number":"①","paragraph_index":1,"content":"운영지원과장은 다음 각 호의 임무를 수행한다","items":[{"id":"DAPA_A_2100000271364_ART_18_P1_I1","display_id":"방위사업청-당직근무-지침-제18조-제1항-제1호","item_number":"1","content":"당직실의 시설관리","subitems":[]},{"id":"DAPA_A_2100000271364_ART_18_P1_I2","display_id":"방위사업청-당직근무-지침-제18조-제1항-제2호","item_number":"2","content":"당직근무에 소요되는 각종 비품 등의 정리 비치","subitems":[]},{"id":"DAPA_A_2100000271364_ART_18_P1_I3","display_id":"방위사업청-당직근무-지침-제18조-제1항-제3호","item_number":"3","content":"당직근무명령 발령","subitems":[]},{"id":"DAPA_A_2100000271364_ART_18_P1_I4","display_id":"방위사업청-당직근무-지침-제18조-제1항-제4호","item_number":"4","content":"당직근무자 및 보안요원에 대한 지도ㆍ감독","subitems":[]},{"id":"DAPA_A_2100000271364_ART_18_P1_I5","display_id":"방위사업청-당직근무-지침-제18조-제1항-제5호","item_number":"5","content":"기타 당직근무에 필요한 제반업무","subitems":[]}]},{"id":"DAPA_A_2100000271364_ART_18_P2","display_id":"방위사업청-당직근무-지침-제18조-제2항","paragraph_number":"②","paragraph_index":2,"content":"운영지원과장은 대전임시청사 긴급상황 발생 시 대전임시청사 지방이전추진TF팀장 등에게 대전임시청사 당직근무자 지휘ㆍ통제 및 상황대응을 요청할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_ART_19","display_id":"방위사업청-당직근무-지침-제19조","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"제3장 당직 지원 등","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"당직근무 태만자 등에 대한 조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_ART_19_P0","display_id":"방위사업청-당직근무-지침-제19조","paragraph_number":"","paragraph_index":null,"content":"운영지원과장은 당직근무자가 당직근무와 관련하여 「국가공무원복무규칙」제3장 제2절(당직) 및 이 지침을 위반한 때에는 당직근무일부터 6개월 이내 공휴일 당직 재편성, 국가공무원법에 의한 징계의 요구 등 기타 필요한 조치를 할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000271364_SUPP_PRE","display_id":"방위사업청-당직근무-지침-부칙","regulation_id":"DAPA_A_2100000271364","regulation_name":"방위사업청 당직근무 지침","short_name":"방위사업청 당직근무 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000271364_SUPP_PRE_P0","display_id":"방위사업청-당직근무-지침-부칙","paragraph_number":"","paragraph_index":null,"content":"(시행일) 이 지침은 2026년 1월 1일부터 시행한다.","items":[]}],"notes":[],"effective_date":"2026-01-01","revision_date":"2025-12-30","source_file":"방위사업청 당직근무 지침.json","source_path":"원문/법제처API/방위사업청 당직근무 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제1017호, 2025. 12. 30.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]}]
