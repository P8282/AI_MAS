[{"id":"DAPA_A_2100000257920_ART_1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제1조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_1_P0","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 세칙은「방위산업에 관한 착수금 및 중도금 지급규칙」(이하 \"규칙\"이라 한다) 제14조에 의한 착수금 및 중도금의 지급ㆍ반환 등에 관한 세부사항을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위산업에 관한 착수금 및 중도금 지급세칙.json","source_path":"원문/법제처API/방위산업에 관한 착수금 및 중도금 지급세칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_286201_ART_14"],"related_regulations":["DAPA_L_286201"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257920_ART_2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"지급대상 및 기준 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_2_P1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"착수금 및 중도금은「방위사업법」제46조제1항의 규정에 의하여 체결한 방위사업계약에 대하여 동법 제46조의2 및 「방위사업법 시행령」(이하 \"영\"이라 한다) 제61조의7 규정에 따라 지급한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_2_P2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"영 제61조의7제1항의 착수금 및 중도금의 지급기준이 되는 \"계약 잔여이행기간\", \"계약금액\" 및 이 세칙 제8조제2항의 \"대외국지급경비\"란 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000257920_ART_2_P2_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제2항-제1호","item_number":"1","content":"계약 잔여 이행기간 : 착수금 또는 중도금을 청구한 날부터 납품기일까지의 기간, 다만, 분할납품의 경우에는 청구한 날부터 각각의 납품기일까지의 기간으로 한다.","subitems":[]},{"id":"DAPA_A_2100000257920_ART_2_P2_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제2항-제2호","item_number":"2","content":"계약금액 : 단기계약은 당해연도 계약금액을 말하며, 장기계약은 총계약기간 동안의 연차별 계약금액의 총합계금액으로 한다.","subitems":[]},{"id":"DAPA_A_2100000257920_ART_2_P2_I3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제2항-제3호","item_number":"3","content":"대외국지급경비 : 계약상대자가 외국업체와의 계약(정부간 계약을 포함한다)에 의 하여 계약이행에 필요한 물품을제조ㆍ구입하거나 기술지원 기타 용역 등을 제공받는 경우에 당해 국가의 회계규정ㆍ국제관행 및 계약조건 등에 따라 지급하여야 할 경비를 말한다.","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_2_P3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"규칙 제4조 및 제5조에 따라 착수금 또는 중도금을 지급하는 경우에는 배정된 예산의 범위 내에서 지급한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_2_P4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약담당공무원은 계약상대자가 규칙 제3조제2항에 따라 다음 각 호의 사유 등으로 당해 계약이행을 위하여 계약상대자의 자체자금을 사용한 후 사용내역서를 문서로 제출하여 중도금 지급을 청구하였을 때에는 중도금으로 지급할 수 있다.","items":[{"id":"DAPA_A_2100000257920_ART_2_P4_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제4항-제1호","item_number":"1","content":"영 제50조 및 「방위사업법 시행규칙」제33조의 규정에 따라 계약체결 전에 생산 및 품질보증 활동이 개시됨으로써 자체자금을 먼저 사용한 경우","subitems":[]},{"id":"DAPA_A_2100000257920_ART_2_P4_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제4항-제2호","item_number":"2","content":"계약을 체결하고 자체자금을 사용한 경우","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_2_P5","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약담당공무원은 착수금 및 중도금 청구서류를 접수하면 청구액 및 구비서류의 적정성 등을 심사한 후 지급승인서를 작성 지급승인 결재권자(또는 전결권자)에게 승인을 받아야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_2_P6","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"계약담당공무원은 영 제61조의7제1항에 따라 방위사업계약의 잔여이행기간에 해당되지 아니하더라도 착수금 및 중도금을 지급하지 않고서는 계약이행이 곤란한 때에는 지급사유 및 지급업체 등을 명시하여 착수금 및 중도금 지급승인 결재권자(또는 전결권자)의 승인을 얻어 지급할 수 있다.","items":[]},{"id":"DAPA_A_2100000257920_ART_2_P7","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"규칙 제4조제3항에 따라 신기술 사용과 관련된 계약에 있어서 착수금 추가지급에 대해서는 제6항을 준용한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_2_P8","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"계약담당공무원은 규칙 제4조제7항에 따라 자금사정 등 불가피한 사유로 인하여 착수금 또는 중도금을 지급할 수 없는 경우에는 착수금 및 중도금 지급 승인 결재권자(또는 전결권자)의 승인을 얻어 그 사유를 서면으로 통지하여야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_2_P9","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제9항","paragraph_number":"⑨","paragraph_index":9,"content":"계약담당공무원은 규칙 제5조제2항에 따라 특별한 사유로 지급한도액을 초과하여 지급할 필요가 있는 경우에는 지급대상기관(업체), 지급대상품목, 지급사유 및 지급한도액(계약금액에 대한 지급율) 등을 명시하여 기획재정부장관 협의 및 재무관의 승인을 받은 후 지급할 수 있다.","items":[]},{"id":"DAPA_A_2100000257920_ART_2_P10","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제2조-제10항","paragraph_number":"⑩","paragraph_index":10,"content":"각 사업본부 지출심사부서장은 제5항 부터 제9항까지 관련업무 수행시 필요한 경우에는 계약팀, 통합사업관리팀, 원가팀 또는 국방기술품질원등 관련부서의 협조를 받아 처리할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위산업에 관한 착수금 및 중도금 지급세칙.json","source_path":"원문/법제처API/방위산업에 관한 착수금 및 중도금 지급세칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_46","DEFENSE_ACQ_ACT_ART_46_2","DEFENSE_ACQ_ENFORCEMENT_ART_61_7","DAPA_A_2100000257920_ART_8","DAPA_L_286201_ART_4","DAPA_L_286201_ART_5","DAPA_L_286201_ART_3","DEFENSE_ACQ_ENFORCEMENT_ART_50","DEFENSE_ACQ_RULE_ART_33"],"related_regulations":["DEFENSE_ACQ_ACT","DEFENSE_ACQ_ENFORCEMENT","DAPA_L_286201","DEFENSE_ACQ_RULE"],"external_references":[],"keywords":["계약담당공무원","계약의 이행","계약금액","계약상대자"]},{"id":"DAPA_A_2100000257920_ART_3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"청구 및 지급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_3_P1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 계약상대자가 착수금 및 중도금을 청구 할 때에는 다음 각 호의 서류를 구비하여 제출하게 하여야 하며, 제4호부터 제6호까지의 서류는 이미 지급 받은 착수금 또는 중도금이 있는 경우에 한한다.","items":[{"id":"DAPA_A_2100000257920_ART_3_P1_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제1호","item_number":"1","content":"착수금 및 중도금 신청서 (별지 #2)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제2호","item_number":"2","content":"착수금 및 중도금 사용계획서(별지 #3)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제3호","item_number":"3","content":"직접재료비 및 직접경비 지급계획서(별지 #3-1)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제4호","item_number":"4","content":"착수금 및 중도금 사용내역서(별지 #4)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I5","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제5호","item_number":"5","content":"국내재료비 및 직접경비 지급내역서(별지 #4-1), 수입재료비 지급내역서 (별지 #4-2)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I6","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제6호","item_number":"6","content":"착수금 및 중도금 사용기간 경과 사용 세부내역서(별지 #5)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I7","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제7호","item_number":"7","content":"규칙 제6조에 따른 채권보전서류","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I8","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제8호","item_number":"8","content":"규칙 제3조 제4항에 따른 이행확약서 (별지 #6)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I9","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제9호","item_number":"9","content":"규칙 제13조에 따른 착수금 및 중도금 지급조건 (별지 #7)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I10","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제10호","item_number":"10","content":"세금계산서(착수금 및 중도금 수령에 대한 공급자 제출용)","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P1_I11","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제1항-제11호","item_number":"11","content":"영 제50조제3항 및 제4항에 따른 계약체결전에 생산 및 품질보증활동 승인이 있는 경우에는 문서사본","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_3_P2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 계약상대자로부터 착수금 및 중도금의 지급청구서류를 제출받을 때에는 착수금 및 중도금 사용내역서 등 관계증빙서류에 다음과 같이 기재하고 계약서에 날인한 인감으로 날인을 하도록 하여야 한다. 단, 착수금 및 중도금 사용내역서 등을 전자서명으로 제출시 생략할 수 있다.<img id=\"151170495\"></img>","items":[]},{"id":"DAPA_A_2100000257920_ART_3_P3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항제2호의 착수금 및 중도금 사용계획서, 제1항제4호의 착수금 및 중도금 사용내역서에는 다음 각 호의 내용에 비목별로 집계한 총액을 구분 기재하되, 제1항제4호의 착수금 및 중도금 사용내역서는 규칙 제9조의 사용기간{착수금을 지급 받은날(협력업체와 계약을 체결하기 전에 착수금을 받은 경우에는 계약을 체결한 날을 말한다)부터 15일}과 규칙 제5조의2의 사용기간 이내에 사용한 금액 및 그 사용기간을 경과하여 사용한 금액과 미사용액을 구분 기재하여야 하며, 제1항제5호의 국내재료비 및 직접경비 지급내역서, 수입재료비 지급내역서에는 제1항제4호에서 규정한 착수금 및 중도금 사용내역서에 기재된 \"금회정산액\"에 대하여 거래업체명, 품명, 지급기준일, 지급일자, 지급액을 기재하여야 한다.","items":[{"id":"DAPA_A_2100000257920_ART_3_P3_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제3항-제1호","item_number":"1","content":"재료비 : 수입재료비, 국내재료비, 간접재료비","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P3_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제3항-제2호","item_number":"2","content":"노무비 : 직접노무비, 간접노무비","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P3_I3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제3항-제3호","item_number":"3","content":"경 비 : 직접경비, 간접경비","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P3_I4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제3항-제4호","item_number":"4","content":"일반관리비","subitems":[]},{"id":"DAPA_A_2100000257920_ART_3_P3_I5","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제3항-제5호","item_number":"5","content":"기타","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_3_P4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약담당공무원은 제3항에 따른 사용기간을 경과하여 사용한 금액 및 미사용액에 대해서는 비목별로 수령 및 사용일자, 금액 등이 구분 기재된 착수금 및 중도금 사용기간 경과 사용 세부내역서(별지#5)를 제출하게 하여야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_3_P5","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제3항에 따라 비목별로 집계한 총액을 구분 기재할 때는 간접재료비, 간접노무비, 간접경비, 일반관리비와 직접경비중 간접비와 성격이 유사한 감가상각비ㆍ연구개발비ㆍ지급임차료 등은 계약서(산출내역서)의 해당금액을 기준으로 계약기간에 걸쳐 안분한 금액을 적용할 수 있다.","items":[]},{"id":"DAPA_A_2100000257920_ART_3_P6","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"착수금 및 중도금의 청구를 받은 후 그 청구내용의 전부 또는 일부가 부당함을 발견한 때에는 그 사유를 명시하여 계약상대자에게 당해 청구서를 반송할 수 있다. 이 경우 재청구를 받은 경우에는 새로운 청구로 간주한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_3_P7","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제3조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"계약담당공무원은 계약상대자가 협력업체에게 착수금을 현금으로 지급하도록 하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위산업에 관한 착수금 및 중도금 지급세칙.json","source_path":"원문/법제처API/방위산업에 관한 착수금 및 중도금 지급세칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_286201_ART_6","DAPA_L_286201_ART_3","DAPA_L_286201_ART_13","DEFENSE_ACQ_ENFORCEMENT_ART_50","DAPA_L_286201_ART_9","DAPA_L_286201_ART_5_2"],"related_regulations":["DAPA_L_286201","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":["계약담당공무원","계약상대자","계약서 작성"]},{"id":"DAPA_A_2100000257920_ART_4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제4조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"채권보전","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_4_P1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"규칙 제6조제1항제5호 및 제6호의 방법으로 채권을 확보할 때에는 유가증권취급공무원으로 하여금 질권(質權)을 설정하도록 조치하여야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_4_P2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"규칙 제6조제2항의 \"약정이자 상당액\"은 규칙 제6조제4항에 규정한 보증기간 또는 보험기간에 한국은행에서 발표하는 통계월보상의 금융기관 대출 평균금리에 의하여 아래와 같이 산출한 금액을 말하며, 착수금 또는 중도금 청구일자에 해당되는 대출 평균금리를 적용한다.<img id=\"151170497\"></img>","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위산업에 관한 착수금 및 중도금 지급세칙.json","source_path":"원문/법제처API/방위산업에 관한 착수금 및 중도금 지급세칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_286201_ART_6"],"related_regulations":["DAPA_L_286201"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257920_ART_5","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제5조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"착수금 및 중도금의 정산","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_5_P1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"착수금 및 중도금이 지급된 계약에 대하여 기성대가 또는 기납대가를 지급할 때마다 규칙 제7조에 따라 착수금 또는 중도금을 정산 하여야 한다. 이 경우 산출된 정산액에서 10원 미만은 버린다.","items":[]},{"id":"DAPA_A_2100000257920_ART_5_P2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"「방위사업법」제46조의2제2항의 규정에 따라 장기계약을 체결한 경우에 지급되는 착수금 및 중도금에 대하여는 계약물품을 최종납품할 때까지 정산을 유예할 수 있다.","items":[]},{"id":"DAPA_A_2100000257920_ART_5_P3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"영 제61조의7제1항에 따라 지급대상에서 제외된 납품기일의 물량에 대한 기성대가 또는 기납대가를 청구한 때에는 제1항의 정산방법에 의하지 아니하고 대가 전액을 지급한다. 다만, 계약상대자가 보증금액 감액 등을 이유로 정산을 신청할 때에는 정산후 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위산업에 관한 착수금 및 중도금 지급세칙.json","source_path":"원문/법제처API/방위산업에 관한 착수금 및 중도금 지급세칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_286201_ART_7","DEFENSE_ACQ_ACT_ART_46_2","DEFENSE_ACQ_ENFORCEMENT_ART_61_7"],"related_regulations":["DAPA_L_286201","DEFENSE_ACQ_ACT","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":["기성대가"]},{"id":"DAPA_A_2100000257920_ART_6","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제6조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"착수금의 중도금 전환 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_6_P1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 계약상대자에게 착수금을 지급한 경우에는 사용기간 종료일로 부터 30일 이내에 다음 각 호의 서류를 문서로 제출하게 하여야 한다. 다만, 단기계약의 경우에는 국내재료비 및 직접경비(간접비와 성격이 유사한 감가상각비ㆍ연구개발비ㆍ지급임차료 등은 해당되지 않음)를 제외한 자료의 제출을 생략할 수 있다.","items":[{"id":"DAPA_A_2100000257920_ART_6_P1_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제6조-제1항-제1호","item_number":"1","content":"제3조제1항제4호의 착수금 및 중도금 사용내역서","subitems":[]},{"id":"DAPA_A_2100000257920_ART_6_P1_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제6조-제1항-제2호","item_number":"2","content":"제3조제1항제5호의 국내재료비 및 직접경비 지급내역서, 수입재료비 지급내역서","subitems":[]},{"id":"DAPA_A_2100000257920_ART_6_P1_I3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제6조-제1항-제3호","item_number":"3","content":"제3조제1항제6호의 착수금 및 중도금 사용기간 경과 사용 세부내역서","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_6_P2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 제출하는 서류에는 계약상대자가 다음과 같이 기재하고 계약서에 날인 인감으로 날인하게 하여야 한다. 단, 착수금 및 중도금 사용내역서 등을 전자서명으로 제출시 생략할 수 있다.<img id=\"151170499\"></img>","items":[]},{"id":"DAPA_A_2100000257920_ART_6_P3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약상대자가 지출한 금액중 제1항에 따라 사용내역서 등을 문서로 제출한 금액은 중도금으로 전환하여야 한다. 이 경우 재료비, 노무비, 경비, 일반관리비 등 비목별 금액에 관계없이 총액 기준으로 정산한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위산업에 관한 착수금 및 중도금 지급세칙.json","source_path":"원문/법제처API/방위산업에 관한 착수금 및 중도금 지급세칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000257920_ART_3"],"related_regulations":[],"external_references":[],"keywords":["계약상대자","계약담당공무원"]},{"id":"DAPA_A_2100000257920_ART_7","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제7조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"협력업체에 대한 착수금 지급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_7_P1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 규칙 제9조제1항에 따라 계약상대자가 협력업체로부터 원자재, 중간재, 외주가공비 및 용역 등을 구입하는 경우에는 제3조제1항제3호 직접재료비 및 직접경비 지급계획서를 제출받아야 하며 계약상대자는 제출한 지급계획에 따라 착수금을 지급받은 날(협력업체 와 계약을 체결하기 전에 착수금을 받은 경우에는 그 계약을 체결한 날을 말한다.)부터 15일 이내에 지급토록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_7_P2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"규칙 제9조의 지급기간을 경과하여 지급한 경우에는 그 초과기간에 대한 약정이자 상당액을 산출하여 수입징수관(또는 전결권자)으로 하여금「국가채권관리법」에서 정한 절차에 따라 국고에 환수하도록 조치하여야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_7_P3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제3조제1항제3호 직접재료비 및 직접경비 지급계획서를 제출한 계약상대자는 착수금을 지급받은 날로부터 5일 이내에 협력업체에게 착수금 수령 사실을 서면으로 통지하고, 그 결과를 계약담당공무원에게 문서로 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_7_P4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항에 해당되는 계약상대자와 계약상대자로부터 착수금을 지급받은 협력업체는 계약상대자가 착수금을 수령한 날(협력업체와 계약을 체결하기 전에 착수금을 받은 경우에는 그 계약을 체결한 날을 말한다)로부터 20일 이내에 증빙서류(별지 #4-1, #4-2)를 계약담당공무원에게 제출하여야 하며, 계약담당공무원은 착수금 지급 및 수령 내역을 제출받은 증빙서류를 통해 비교ㆍ확인하여야 한다.","items":[]},{"id":"DAPA_A_2100000257920_ART_7_P5","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약담당공무원은 계약상대자가 협력업체에게 지급할 착수금의 전부 또는 일부를 지급하지 아니한 경우에는 제8조제1항에 따라 반환받은 착수금을 협력업체에게 직접 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위산업에 관한 착수금 및 중도금 지급세칙.json","source_path":"원문/법제처API/방위산업에 관한 착수금 및 중도금 지급세칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_286201_ART_9","DAPA_A_2100000257920_ART_3","DAPA_A_2100000257920_ART_8"],"related_regulations":["DAPA_L_286201"],"external_references":[],"keywords":["계약담당공무원","계약상대자"]},{"id":"DAPA_A_2100000257920_ART_8","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조","regulation_id":"DAPA_A_2100000257920","regulation_name":"방위산업에 관한 착수금 및 중도금 지급세칙","short_name":"방위산업에 관한 착수금 및 중도금 지급세칙","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"반환","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257920_ART_8_P1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 착수금 또는 중도금을 지급한 후 영 제61조의7제4항 및 규칙 제5조의2에 따른 다음 각 호의 어느 하나에 해당되는 경우에는 지체없이 계약상대자에게 착수금 및 중도금의 전부 또는 일부에 대하여 반환을 청구해야 하며, 계약상대자의 귀책사유로 인하여 반환을 청구하는 때에는 해당 착수금 또는 중도금 지급일 다음 날부터 반환일까지의 약정이자 상당액을 가산하여 청구하여야 한다. 다만, 제2호가목의 착수금 사용기간을 경과하여 사용한 금액에 대하여는 지급일 다음 날부터 사용일까지의 약정이자 상당액을 청구하여야 한다.","items":[{"id":"DAPA_A_2100000257920_ART_8_P1_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제1항-제1호","item_number":"1","content":"해당 방위사업계약을 해제 또는 해지하는 경우","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P1_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제1항-제2호","item_number":"2","content":"다음 각 목의 조건을 위반한 경우가. 착수금을 착수금 사용계획서에 따라 계획된 착수금 사용기간 이내에 사용하여야 하는 조건나. 제3조제1항제3호의 서류를 제출한 계약상대자가 정당한 사유가 없는 한 착수금 수령일(협력업체와 계약을 체결하기 전에 착수금을 받은 경우에는 그 계약을 체결한 날을 말한다)부터 15일 이내에 협력업체에게 착수금의 전부 또는 일부를 지급하여야 하는 조건다. 착수금 또는 중도금을 계약의 수행을 위한 용도 외에 사용하지 않아야 하는 조건라. 그 밖에 가목부터 다목까지에 준하는 조건으로서 계약의 수행을 위하여 청장이 필요하다고 인정하여 부가하는 착수금 또는 중도금의 지급 등에 관한 조건","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P1_I3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제1항-제3호","item_number":"3","content":"기타 사고이월등의 사유로 반환이 불가피하다고 인정되는 경우","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_8_P2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의하여 반환 받을 시 다음 각 호의 경우는 약정이자 상당액을 징수하지 아니한다.","items":[{"id":"DAPA_A_2100000257920_ART_8_P2_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제2항-제1호","item_number":"1","content":"환율변동에 따라 발생된 대외국 지급경비의 미사용액","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P2_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제2항-제2호","item_number":"2","content":"수입부품을 국산으로 대체하는 등 원가절감 또는 국가이익을 위하여 착수금 또는 중도금을 지급목적으로 사용할 수 없었음을 증거서류로 입증할 때","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P2_I3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제2항-제3호","item_number":"3","content":"규칙 제5조제3항에 따라 개산계약금액을 기준으로 착수금 및 중도금을 지급한 이후 최종계약금액이 당초 개산계약금액보다 감액확정되어 영 제61조의7제2항 및 규칙 제5조제1항의 지급한도액을 초과하였을 경우","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P2_I4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제2항-제4호","item_number":"4","content":"그 밖에 계약상대자의 귀책사유가 아님을 증빙서류로 입증하는 경우","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_8_P3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"사고이월로 반환 받을시 착수금 또는 중도금 잔액 및 약정이자 상당액을 반환 받지 않는 경우는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000257920_ART_8_P3_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제3항-제1호","item_number":"1","content":"장기계약의 사고이월 경우","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P3_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제3항-제2호","item_number":"2","content":"단기계약시 사고이월이 계약상대자의 책임에 속하지 아니하고 동시에 해당 계약 목적달성을 위한 노임지급ㆍ자재확보 등에 사용하였음이 제3조제3항의 사용내역서 제출로 확인된 경우","subitems":[]}]},{"id":"DAPA_A_2100000257920_ART_8_P4","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약담당공무원은 제1항에 의하여 반환을 받고자 하는 경우에는 다음 각 호의 절차에 따른다.","items":[{"id":"DAPA_A_2100000257920_ART_8_P4_I1","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제4항-제1호","item_number":"1","content":"당해연도에 지출된 착수금 또는 중도금이 반납되는 경우 : 지출관에게 그 지출한 과목으로 반납조치","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P4_I2","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제4항-제2호","item_number":"2","content":"출납이 완결된 회계연도에 지출된 착수금 또는 중도금이 반납되는 경우 : 수입징수관에게 국고금관리법에서 정한 절차에 따라 현 연도의 수입에 편입되도록 조치","subitems":[]},{"id":"DAPA_A_2100000257920_ART_8_P4_I3","display_id":"방위산업에-관한-착수금-및-중도금-지급세칙-제8조-제4항-제3호","item_number":"3","content":"약정이자상당액 : 수입징수관으로 하여금 국고금관리법에서 정한 절차에 따라 국고에 환수하도록 조치","subitems":[]}]}],"notes":[],"effective_date":"2025