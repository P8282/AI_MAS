[{"id":"DAPA_A_2100000217899_ART_1","display_id":"성과기반계약-운영지침-제1조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_1_P0","display_id":"성과기반계약-운영지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 전투준비태세 향상과 총소유비용의 절감을 위해 「방위사업법 시행령」 제28조제4항 및 제61조제1항제10호, 「군수품관리법 시행령」 제12조의3제4항, 국방부 「성과기반군수지원 훈령」에 따라 무기체계 등의 후속적인 군수지원을 위해 성과기반계약 업무의 추진을 위한 세부지침을 제공하는 것을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_28","DEFENSE_ACQ_ENFORCEMENT_ART_61"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":["군수품관리법 시행령"],"keywords":[]},{"id":"DAPA_A_2100000217899_ART_2","display_id":"성과기반계약-운영지침-제2조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"지침적용의 우선순위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_2_P0","display_id":"성과기반계약-운영지침-제2조","paragraph_number":"","paragraph_index":null,"content":"성과기반계약 업무의 추진은 이 지침의 규정에 따라 처리하며, 기타 계약관련 사항은 「방위사업법」ㆍ「국가를 당사자로 하는 계약에 관한 법률」 등 관련 법규에 따른다. 다만, 「군수품조달관리규정」과 이 지침이 불일치하는 경우에는 「군수품조달관리규정」을 우선 적용한다.","items":[]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000217899_ART_3","display_id":"성과기반계약-운영지침-제3조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_3_P0","display_id":"성과기반계약-운영지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 정의는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000217899_ART_3_P0_I1","display_id":"성과기반계약-운영지침-제3조-제1호","item_number":"1","content":"\"성과금\"이란 「방위사업법 시행령」 제61조제1항제10호에 따라 성과기반계약을 체결한 경우 성과에 따라 기준계약금액에 추가 또는 감액하는 금액을 말한다.","subitems":[]},{"id":"DAPA_A_2100000217899_ART_3_P0_I2","display_id":"성과기반계약-운영지침-제3조-제2호","item_number":"2","content":"\"기준계약금액\"이란 「방위사업법 시행령」 제61조제1항제10호에 따라 성과기반계약을 체결할 때 예정가격 및 개산가격(이하 \"예정가격 등\"이라 한다)에 기초하여 계약당사자가 합의하여 정하는 금액을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_61"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":["예정가격","계약금액"]},{"id":"DAPA_A_2100000217899_ART_4","display_id":"성과기반계약-운영지침-제4조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"계약절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_4_P0","display_id":"성과기반계약-운영지침-제4조","paragraph_number":"","paragraph_index":null,"content":"성과기반계약의 절차는 다음과 같다.","items":[{"id":"DAPA_A_2100000217899_ART_4_P0_I1","display_id":"성과기반계약-운영지침-제4조-제1호","item_number":"1","content":"통합사업관리팀장은 방위력개선사업으로 성과기반군수지원(PBL)의 적용범위가 결정된 대상사업에 대하여 조달요구서 및 성과지표를 포함한 관련자료 등을 첨부하여 해당 계약팀장에게 계약체결을 의뢰한다.","subitems":[]},{"id":"DAPA_A_2100000217899_ART_4_P0_I2","display_id":"성과기반계약-운영지침-제4조-제2호","item_number":"2","content":"소요군은 전력운영사업으로 성과기반군수지원(PBL)의 적용범위가 결정된 대상사업에 대하여 조달요구서 및 성과지표를 포함한 군 요구서 등을 방위사업정책국장(계약제도발전과장)에게 계약체결을 의뢰하고, 국방부 총수명주기관리팀장에게 보고한다.","subitems":[]},{"id":"DAPA_A_2100000217899_ART_4_P0_I3","display_id":"성과기반계약-운영지침-제4조-제3호","item_number":"3","content":"방위사업정책국장(계약제도발전과장)은 소요군으로부터 접수된 조달요구서 및 성과지표를 포함한 관련자료 등을 해당 계약팀장에게 통보한다.","subitems":[]},{"id":"DAPA_A_2100000217899_ART_4_P0_I4","display_id":"성과기반계약-운영지침-제4조-제4호","item_number":"4","content":"해당 계약팀장은 소요군에서 작성한 성과지표에 대하여 해당 종합군수지원팀장의 검토의견을 첨부하여 소요군에 재검토를 의뢰할 수 있다.","subitems":[]}]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약서 작성"]},{"id":"DAPA_A_2100000217899_ART_5","display_id":"성과기반계약-운영지침-제5조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"계약특수조건에 포함할 사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_5_P0","display_id":"성과기반계약-운영지침-제5조","paragraph_number":"","paragraph_index":null,"content":"계약팀장은 성과기반계약과 관련하여 다음 각 호의 사항을 [별지]서식에 따라 표준계약특수조건에 포함한다.","items":[{"id":"DAPA_A_2100000217899_ART_5_P0_I1","display_id":"성과기반계약-운영지침-제5조-제1호","item_number":"1","content":"계약금액, 기준계약금액","subitems":[]},{"id":"DAPA_A_2100000217899_ART_5_P0_I2","display_id":"성과기반계약-운영지침-제5조-제2호","item_number":"2","content":"성과지표, 성과목표, 성과측정 방법 및 주기","subitems":[]},{"id":"DAPA_A_2100000217899_ART_5_P0_I3","display_id":"성과기반계약-운영지침-제5조-제3호","item_number":"3","content":"성과점수 및 등급 산정방식","subitems":[]},{"id":"DAPA_A_2100000217899_ART_5_P0_I4","display_id":"성과기반계약-운영지침-제5조-제4호","item_number":"4","content":"성과금 지급 및 감액의 상한","subitems":[]},{"id":"DAPA_A_2100000217899_ART_5_P0_I5","display_id":"성과기반계약-운영지침-제5조-제5호","item_number":"5","content":"성과금의 지급시기","subitems":[]},{"id":"DAPA_A_2100000217899_ART_5_P0_I6","display_id":"성과기반계약-운영지침-제5조-제6호","item_number":"6","content":"성과평가 주기 및 평가결과 통보절차","subitems":[]},{"id":"DAPA_A_2100000217899_ART_5_P0_I7","display_id":"성과기반계약-운영지침-제5조-제7호","item_number":"7","content":"전시 군수지원에 관한 조건 등","subitems":[]}]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["특수조건","계약금액"]},{"id":"DAPA_A_2100000217899_ART_6","display_id":"성과기반계약-운영지침-제6조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"계약기간","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_6_P0","display_id":"성과기반계약-운영지침-제6조","paragraph_number":"","paragraph_index":null,"content":"성과기반계약의 계약기간은 5년 이내로 한다. 다만, 방위력개선사업은 무기체계의 초도 보급소요를 고려하여 3년 이내로 한다.","items":[]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약기간"]},{"id":"DAPA_A_2100000217899_ART_7","display_id":"성과기반계약-운영지침-제7조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"계약금액의 결정 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_7_P1","display_id":"성과기반계약-운영지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약팀장은 기준계약금액에 성과평가에 따른 최대성과금을 반영하여 계약금액을 결정한다.","items":[]},{"id":"DAPA_A_2100000217899_ART_7_P2","display_id":"성과기반계약-운영지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"원가팀장은 예정가격등을 결정하기 위한 기초금액을 산정할 경우에 다음 각 호의 방법에 따라 최대 성과금을 산정하여야 한다.","items":[{"id":"DAPA_A_2100000217899_ART_7_P2_I1","display_id":"성과기반계약-운영지침-제7조-제2항-제1호","item_number":"1","content":"원가계산의 방법으로 예정가격등을 작성할 경우에는 제조원가와 일반관리비를 합한 총원가의 10%","subitems":[]},{"id":"DAPA_A_2100000217899_ART_7_P2_I2","display_id":"성과기반계약-운영지침-제7조-제2항-제2호","item_number":"2","content":"원가계산 이외의 방법으로 예정가격등을 작성할 경우에는 기초금액에서 세액과 이윤상당액을 차감한 금액의 10%","subitems":[]}]},{"id":"DAPA_A_2100000217899_ART_7_P3","display_id":"성과기반계약-운영지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약팀장은 소요군으로부터 통보받은 성과평가의 결과에 따라 기준계약금액에 성과금을 지급하거나 감액할 수 있다.","items":[]},{"id":"DAPA_A_2100000217899_ART_7_P4","display_id":"성과기반계약-운영지침-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"성과의 평가결과에 따라 성과금 지급 및 감액의 범위는 계약금액 결정 당시에 산정된 최대성과금 이내로 한다.","items":[]},{"id":"DAPA_A_2100000217899_ART_7_P5","display_id":"성과기반계약-운영지침-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"개산계약으로 계약을 체결한 후 정산하여 계약금액을 확정할 경우 기준계약금액은 실제발생원가를 기준으로 한다.","items":[]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약금액","예정가격","원가계산","기초금액"]},{"id":"DAPA_A_2100000217899_ART_8","display_id":"성과기반계약-운영지침-제8조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"성과의 반영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_8_P1","display_id":"성과기반계약-운영지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"성과평가의 결과가 평균기준등급을 초과한 경우 성과금을 지급하거나 재계약할 수 있다.","items":[]},{"id":"DAPA_A_2100000217899_ART_8_P2","display_id":"성과기반계약-운영지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"성과평가의 결과가 평균기준등급에 미달한 경우 기준계약금액에서 감액하여 지급하거나 계약을 해지할 수 있다.","items":[]},{"id":"DAPA_A_2100000217899_ART_8_P3","display_id":"성과기반계약-운영지침-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항의 규정에 따라 재계약이 필요한 경우 소요군은 무기체계의 특성, 군수지원환경 등을 고려하여 재계약 여부를 검토 후 해당 계약팀장에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000217899_ART_9","display_id":"성과기반계약-운영지침-제9조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"개산계약의 정산","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_9_P1","display_id":"성과기반계약-운영지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"성과기반계약의 정산 대상품목은 방산물자와 일반물자로 구분하여 원가를 산정한다.","items":[]},{"id":"DAPA_A_2100000217899_ART_9_P2","display_id":"성과기반계약-운영지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"재료비 중 재고자산의 정상적인 감모손실이란 해당사업에서 발생한 감모로서 다음 각 호의 비용을 말하며, 수요군의 확인을 받은 품목을 기준으로 계상한다.","items":[{"id":"DAPA_A_2100000217899_ART_9_P2_I1","display_id":"성과기반계약-운영지침-제9조-제2항-제1호","item_number":"1","content":"노후화로 인한 폐기","subitems":[]},{"id":"DAPA_A_2100000217899_ART_9_P2_I2","display_id":"성과기반계약-운영지침-제9조-제2항-제2호","item_number":"2","content":"사양변경으로 인한 폐기","subitems":[]},{"id":"DAPA_A_2100000217899_ART_9_P2_I3","display_id":"성과기반계약-운영지침-제9조-제2항-제3호","item_number":"3","content":"시효성 자재 폐기","subitems":[]}]},{"id":"DAPA_A_2100000217899_ART_9_P3","display_id":"성과기반계약-운영지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"변동노무비 단가는 다음 각 호에 따라 계상함을 원칙으로 한다.","items":[{"id":"DAPA_A_2100000217899_ART_9_P3_I1","display_id":"성과기반계약-운영지침-제9조-제3항-제1호","item_number":"1","content":"정산대상 기간중 직전년도 실적 발생분은 해당년도 발생실적을 적용한다.","subitems":[]},{"id":"DAPA_A_2100000217899_ART_9_P3_I2","display_id":"성과기반계약-운영지침-제9조-제3항-제2호","item_number":"2","content":"정산대상 기간중 정산년도 실적 발생분은 당해연도 공통원가를 적용한다. 다만, 공통원가가 산정되어 있지 아니한 때에는 「방산물자의 원가계산에 관한 시행세칙」 제20조 제5항을 적용한다.","subitems":[]}]},{"id":"DAPA_A_2100000217899_ART_9_P4","display_id":"성과기반계약-운영지침-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"보관비는 해당사업의 적기 부품지원을 위한 창고 운용비용을 추적 가능한 경우에 직접경비로 계상한다.","items":[]},{"id":"DAPA_A_2100000217899_ART_9_P5","display_id":"성과기반계약-운영지침-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"사업관리지원체계비는 다음 각 호의 비용을 직접경비로 계상한다. 다만, 노무인력은 당해 성과기반계약관련 시스템 운용업무를 전담하는 자로 한정하며, 향후 동일 또는 유사사업에 대한 계약이 체결되어 사업관리지원체계비가 발생할 경우에는 제2호의 비용만 인정한다.","items":[{"id":"DAPA_A_2100000217899_ART_9_P5_I1","display_id":"성과기반계약-운영지침-제9조-제5항-제1호","item_number":"1","content":"시스템 구축 비용","subitems":[]},{"id":"DAPA_A_2100000217899_ART_9_P5_I2","display_id":"성과기반계약-운영지침-제9조-제5항-제2호","item_number":"2","content":"시스템 운용을 위한 인력의 노무비용","subitems":[]}]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["방산물자의 원가계산에 관한 시행세칙"],"keywords":[]},{"id":"DAPA_A_2100000217899_ART_10","display_id":"성과기반계약-운영지침-제10조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"개산계약의 정산금액 확정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_10_P1","display_id":"성과기반계약-운영지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"원가팀장은 계산계약에 대한 정산원가를 산정한 후 방위사업정책국장(계약제도발전과장)에게 통보한다. 이 경우 방위사업정책국장(계약제도발전과장)은 이를 심사하여 확정한 후 원가팀장에게 통보한다.","items":[]},{"id":"DAPA_A_2100000217899_ART_10_P2","display_id":"성과기반계약-운영지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"원가팀장은 제1항의 규정에 따라 방위사업정책국장(계약제도발전과장)으로부터 접수한 심사결과를 반영하여 기준계약금액을 계약관에게 보고 및 확정한 후 그 결과를 해당 계약팀장에게 통보한다.","items":[]},{"id":"DAPA_A_2100000217899_ART_10_P3","display_id":"성과기반계약-운영지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"원가팀장은 당해 계약특수조건에 따라 성과금 산정을 위한 대상금액을 계약팀장에게 통보한다.","items":[]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["특수조건"]},{"id":"DAPA_A_2100000217899_ART_11","display_id":"성과기반계약-운영지침-제11조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"계약심의회 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_11_P0","display_id":"성과기반계약-운영지침-제11조","paragraph_number":"","paragraph_index":null,"content":"계약팀장은 성과기반계약의 이행과 관련하여 계약업체와 이견이 있는 경우 계약심의회에 성과평가 결과, 성과금 지급범위 등의 안건을 상정하여 심의할 수 있다.","items":[]}],"notes":[],"effective_date":"2022-12-30","revision_date":"2022-12-30","source_file":"성과기반계약 운영지침.json","source_path":"원문/법제처API/성과기반계약 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000217899_ART_12","display_id":"성과기반계약-운영지침-제12조","regulation_id":"DAPA_A_2100000217899","regulation_name":"성과기반계약 운영지침","short_name":"성과기반계약 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"재검토 기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000217899_ART_12_P0","display_id":"성과기반계약-운영지침-제12조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 예규에 대하여 「