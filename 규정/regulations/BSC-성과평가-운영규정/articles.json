[{"id":"DAPA_A_2100000196824_ART_1","display_id":"BSC-성과평가-운영규정-제1조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_1_P0","display_id":"BSC-성과평가-운영규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「정부업무평가 기본법」, 동 시행령, 「공무원 성과평가 등에 관한 규정(대통령령)」 및 지침(인사혁신처 예규) 등에 근거하여 청 미션·비전에 기반한 성과목표를 달성하기 위해 조직과 개인의 성과를 평가하는 BSC 성과평가 기준 및 절차를 제정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_2","display_id":"BSC-성과평가-운영규정-제2조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_2_P1","display_id":"BSC-성과평가-운영규정-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 규정은 방위사업청과 그 소속기관 공무원 및 군인에게 적용한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_2_P2","display_id":"BSC-성과평가-운영규정-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청의 성과평가 운영에 관한 제반사항은 관련법령·규정에 특별한 규정이 있는 경우를 제외하고는 이 규정이 정하는 바에 따른다. 다만, 이 규정에서 정하지 않은 사항이나 적용상 이견 등이 있는 사항에 대해서는 제6조 성과관리위원회의 심의·의결을 거쳐 시행한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000196824_ART_6"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_3","display_id":"BSC-성과평가-운영규정-제3조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_3_P0","display_id":"BSC-성과평가-운영규정-제3조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000196824_ART_3_P0_I1","display_id":"BSC-성과평가-운영규정-제3조-제1호","item_number":"1","content":"\"BSC(Balanced Scorecard)”라 함은 조직의 성과목표 달성을 위해 재무적·비재무적 관점의 균형 잡힌 성과지표를 설정하고 그 성과를 측정하는 성과관리 기법을 말한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_3_P0_I2","display_id":"BSC-성과평가-운영규정-제3조-제2호","item_number":"2","content":"\"소속기관”이라 함은 기반전력사업본부, 미래전력사업본부, 방위사업교육원을 말한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_3_P0_I3","display_id":"BSC-성과평가-운영규정-제3조-제3호","item_number":"3","content":"\"정부업무평가”는 국정운영의 능률성·효과성 및 책임성을 확보하기 위하여 각 평가대상기관이 행하는 정책 등을 평가하는 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_3_P0_I4","display_id":"BSC-성과평가-운영규정-제3조-제4호","item_number":"4","content":"\"성과관리”라 함은 방위사업청의 미션과 비전을 달성할 수 있도록 전략목표와 성과목표들을 연계하고, 성과지표의 목표달성을 관리하는 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_3_P0_I5","display_id":"BSC-성과평가-운영규정-제3조-제5호","item_number":"5","content":"\"성과평가”는 성과목표의 달성도를 성과지표에 따라 측정·평가하는 활동을 말한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_3_P0_I6","display_id":"BSC-성과평가-운영규정-제3조-제6호","item_number":"6","content":"\"성과평가 대상자”는 「공무원 성과평가 등에 관한 규정(대통령령)」 및 동 지침을 준용하여 평가대상기간중 2개월 이상 근무한 자를 대상으로 한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_3_P0_I7","display_id":"BSC-성과평가-운영규정-제3조-제7호","item_number":"7","content":"\"개인단위과제카드”는 온나라 부서단위과제에 포함되어 개인 업무계획 및 실적을 기록·관리하는 개인단위의 과제카드를 말한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_3_P0_I8","display_id":"BSC-성과평가-운영규정-제3조-제8호","item_number":"8","content":"\"개인지표”는 온나라 개인단위과제카드를 성과관리시스템으로 연계·설정하여 개인성과를 평가하기 위해 생성된 개인단위의 성과지표를 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_4","display_id":"BSC-성과평가-운영규정-제4조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"성과평가 항목의 구분","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_4_P0","display_id":"BSC-성과평가-운영규정-제4조","paragraph_number":"","paragraph_index":null,"content":"성과평가 항목은 조직성과평가와 개인성과평가로 구분한다.","items":[{"id":"DAPA_A_2100000196824_ART_4_P0_I1","display_id":"BSC-성과평가-운영규정-제4조-제1호","item_number":"1","content":"조직성과평가는 조직지표 평가 및 상급자정성평가로 구분한다.","subitems":[]},{"id":"DAPA_A_2100000196824_ART_4_P0_I2","display_id":"BSC-성과평가-운영규정-제4조-제2호","item_number":"2","content":"개인성과평가는 개인지표 평가 및 상급자정성평가로 구분한다.","subitems":[]}]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_5","display_id":"BSC-성과평가-운영규정-제5조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"성과평가 평가군 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_5_P1","display_id":"BSC-성과평가-운영규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"성과평가의 공정성을 확보하기 위하여 조직의 기능, 업무의 유사성 및 직제 등을 기준으로 평가군을 분류한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_5_P2","display_id":"BSC-성과평가-운영규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 성과평가군은 청본부(방위사업교육원 포함), 기반전력사업본부, 미래전력사업본부로 구분하여 구성한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_6","display_id":"BSC-성과평가-운영규정-제6조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"성과관리위원회","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_6_P1","display_id":"BSC-성과평가-운영규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"공정하고 효율적인 성과관리를 위해서 청 성과관리위원회 및 평가군별 성과관리위원회를 둔다.","items":[]},{"id":"DAPA_A_2100000196824_ART_6_P2","display_id":"BSC-성과평가-운영규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"청 성과관리위원회는 차장을 위원장으로 하고 국장 및 소속기관 총괄 부장을 위원으로 하며, 다음 각 호의 사항을 심의한다.","items":[{"id":"DAPA_A_2100000196824_ART_6_P2_I1","display_id":"BSC-성과평가-운영규정-제6조-제2항-제1호","item_number":"1","content":"성과평가제도 운영의 기본방침 수립 및 평가체계의 개선","subitems":[]},{"id":"DAPA_A_2100000196824_ART_6_P2_I2","display_id":"BSC-성과평가-운영규정-제6조-제2항-제2호","item_number":"2","content":"평가기준의 설정 및 변경","subitems":[]}]},{"id":"DAPA_A_2100000196824_ART_6_P3","display_id":"BSC-성과평가-운영규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"평가군별 성과관리위원회는 평가군에 따라 기획조정관(청본부), 기반전력사업지원부장(기반전력사업본부), 미래전력사업지원부장(미래전력사업본부)을 위원장으로 하고 각국·부별 선임 과·팀장을 위원으로 하며, 다음 각 호의 사항을 심의한다.","items":[{"id":"DAPA_A_2100000196824_ART_6_P3_I1","display_id":"BSC-성과평가-운영규정-제6조-제3항-제1호","item_number":"1","content":"부서별 성과지표 및 목표의 검증, 조정","subitems":[]},{"id":"DAPA_A_2100000196824_ART_6_P3_I2","display_id":"BSC-성과평가-운영규정-제6조-제3항-제2호","item_number":"2","content":"평가결과 이의신청에 대한 심사·확정","subitems":[]},{"id":"DAPA_A_2100000196824_ART_6_P3_I3","display_id":"BSC-성과평가-운영규정-제6조-제3항-제3호","item_number":"3","content":"기타 평가군내 성과관련 내부 지침의 제정 및 수정","subitems":[]}]},{"id":"DAPA_A_2100000196824_ART_6_P4","display_id":"BSC-성과평가-운영규정-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제2항 및 제3항의 성과관리위원회는 필요한 경우 수시로 개최한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_7","display_id":"BSC-성과평가-운영규정-제7조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"평가시기","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_7_P1","display_id":"BSC-성과평가-운영규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"성과평가는 해당 연도 추진실적에 대하여 평가함을 원칙으로 하며 중간평가와 최종평가로 구분하여 실시한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_7_P2","display_id":"BSC-성과평가-운영규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"중간평가는 해당 연도 상반기 추진실적을 반영하여 매년 6월 30일을 기준으로 7월 중에 실시한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_7_P3","display_id":"BSC-성과평가-운영규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"최종평가는 조직과 개인의 해당 연도 추진실적을 종합적으로 반영하여 매년 12월 31일을 기준으로 다음 연도 1월 중에 실시한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_8","display_id":"BSC-성과평가-운영규정-제8조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제2장 평가항목별 평가내용 및 방법","section":"제1절 조직성과평가","subsection":"","article_number":"8","article_label":"제8조","article_title":"조직지표 설정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_8_P1","display_id":"BSC-성과평가-운영규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"조직지표는 청 성과목표 및 정부업무평가 주요정책 관리과제와의 연계, 부서별 핵심업무의 대표성, 성과의 효율적인 측정 및 성과산출물을 고려하여 다음 각 호의 기준에 따라 선정한다.","items":[{"id":"DAPA_A_2100000196824_ART_8_P1_I1","display_id":"BSC-성과평가-운영규정-제8조-제1항-제1호","item_number":"1","content":"정부업무평가등 외부평가 추진과제","subitems":[]},{"id":"DAPA_A_2100000196824_ART_8_P1_I2","display_id":"BSC-성과평가-운영규정-제8조-제1항-제2호","item_number":"2","content":"방위사업청 직제령 및 직제시행규칙에 규정된 부서의 업무","subitems":[]},{"id":"DAPA_A_2100000196824_ART_8_P1_I3","display_id":"BSC-성과평가-운영규정-제8조-제1항-제3호","item_number":"3","content":"해당 년도 업무추진계획상의 주요업무","subitems":[]},{"id":"DAPA_A_2100000196824_ART_8_P1_I4","display_id":"BSC-성과평가-운영규정-제8조-제1항-제4호","item_number":"4","content":"청 주요현안 및 지시사항 이행과제 등","subitems":[]}]},{"id":"DAPA_A_2100000196824_ART_8_P2","display_id":"BSC-성과평가-운영규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"「정부업부평가 기본법」에 의한 청‘성과관리시행계획’관리과제에 대한 자체평가 결과는 모든 부서(국·부 및 과·팀)의 조직지표로 선정한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_9","display_id":"BSC-성과평가-운영규정-제9조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제2장 평가항목별 평가내용 및 방법","section":"제1절 조직성과평가","subsection":"","article_number":"9","article_label":"제9조","article_title":"조직성과평가의 방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_9_P1","display_id":"BSC-성과평가-운영규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"조직성과평가는 조직지표(정량지표, 정성지표)평가와 상급자 정성평가 결과를 반영하고, 평가항목별 배점은 [별표1]과 같다.","items":[]},{"id":"DAPA_A_2100000196824_ART_9_P2","display_id":"BSC-성과평가-운영규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"‘정량지표’는 부서별 성과담당자가 부서실적을 성과관리시스템에 입력하고, 이를 성과관리부서 및 평가군별 성과관리위원회가 검증한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_9_P3","display_id":"BSC-성과평가-운영규정-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"‘정성지표’는 제10조 제1항의 성과평가단이 평가한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_9_P4","display_id":"BSC-성과평가-운영규정-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"상급자정성평가는 평가자(1차직상급자, 2차 차상급자)가 소속 하위조직에 대해 정성평가를 실시한 후 조직평가 점수에 합산한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000196824_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_10","display_id":"BSC-성과평가-운영규정-제10조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제2장 평가항목별 평가내용 및 방법","section":"제1절 조직성과평가","subsection":"","article_number":"10","article_label":"제10조","article_title":"성과평가단","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_10_P1","display_id":"BSC-성과평가-운영규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"부서별 정성지표의 성과목표 대비 추진실적을 검증·평가하기 위하여 성과평가단을 운영한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_10_P2","display_id":"BSC-성과평가-운영규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"성과평가단은 청 차원의 단일 평가단으로 운영하고, 평가위원은 평가군별 과·팀장급 3명씩 총9명으로 구성하며, 필요시 외부인원을 추가할 수 있다.","items":[]},{"id":"DAPA_A_2100000196824_ART_10_P3","display_id":"BSC-성과평가-운영규정-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"성과평가단으로 선정된 평가자는 본인이 소속하는 국·부의 정성지표는 평가할 수 없으며, 전체 평가위원의 점수를 합산하여 평균한 값을 해당 정성지표의 성과평가 점수로 반영한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["평가위원"]},{"id":"DAPA_A_2100000196824_ART_11","display_id":"BSC-성과평가-운영규정-제11조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제2장 평가항목별 평가내용 및 방법","section":"제2절 개인성과평가","subsection":"","article_number":"11","article_label":"제11조","article_title":"개인성과평가의 방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_11_P1","display_id":"BSC-성과평가-운영규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"개인성과평가는 직책에 따라 구분하고, 부서장 및 파트리더의 경우에는 조직성과평가 결과를 반영하며, 담당의 경우에는 개인지표 평가, 상급자 정성평가와 소속부서의 조직성과평가 결과를 반영하고, 평가항목별 배점은 [별표1]과 같다.","items":[]},{"id":"DAPA_A_2100000196824_ART_11_P2","display_id":"BSC-성과평가-운영규정-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"개인지표평가는 담당급 직원에 한하여 성과관리시스템에 등록된 개인지표의 계획관리수준 및 기안문서 실적을 참고하여 직상급자가 평가한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_11_P3","display_id":"BSC-성과평가-운영규정-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"상급자 정성평가는 평가자(1차직상급자, 2차 차상급자)가 개인의 업무성과와 역량 등을 종합 판단하여 평가한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_11_P4","display_id":"BSC-성과평가-운영규정-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"개인지표 평가 및 상급자 정성평가는 부서이동에 따른 불이익을 최소화하기 위해 반기별로 1회(6월말, 12월말 기준) 평가를 시행한 후, 이들의 평균값을 최종평가에 반영한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_12","display_id":"BSC-성과평가-운영규정-제12조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제2장 평가항목별 평가내용 및 방법","section":"제2절 개인성과평가","subsection":"","article_number":"12","article_label":"제12조","article_title":"개인성과 평가의 예외","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_12_P1","display_id":"BSC-성과평가-운영규정-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"파견·휴직 등의 사유로 인하여 실제 근무한 기간이 2개월 미만인 경우에는 개인성과 평가를 실시하지 아니할 수 있다.","items":[]},{"id":"DAPA_A_2100000196824_ART_12_P2","display_id":"BSC-성과평가-운영규정-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"평가군별로 상대평가가 불가하거나 조직 및 개인지표의 설정이 제한되어 평가의 실효성이 결여되는 경우, 해당연도 성과관리 추진계획에 명시하고 평가를 실시하지 아니할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_13","display_id":"BSC-성과평가-운영규정-제13조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제2장 평가항목별 평가내용 및 방법","section":"제2절 개인성과평가","subsection":"","article_number":"13","article_label":"제13조","article_title":"최종점수 산출 및 결과공개","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_13_P1","display_id":"BSC-성과평가-운영규정-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"성과평가 항목에 대한 평가결과는 조직성과평가 결과와 개인성과평가 결과를 합산하여 산출한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_13_P2","display_id":"BSC-성과평가-운영규정-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"평가항목별 배점은[별표1〕과 같으며, 제1항의 합산치에 가감점을 적용하고, 평가군별로 동일직급간 상대서열화된 최종점수를 산출한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_13_P3","display_id":"BSC-성과평가-운영규정-제13조-제3항","paragraph_number":"③","paragraph_index":3,"content":"최종점수는 성과평가 대상자 본인에게 일정기간 공개하며, 이의가 있는 성과평가 대상자는 [별지 제1호 서식]을 작성하여 이의신청 할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_14","display_id":"BSC-성과평가-운영규정-제14조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제2장 평가항목별 평가내용 및 방법","section":"제2절 개인성과평가","subsection":"","article_number":"14","article_label":"제14조","article_title":"세부 평가기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_14_P0","display_id":"BSC-성과평가-운영규정-제14조","paragraph_number":"","paragraph_index":null,"content":"평가시기, 평가 배점, 지표 가중치, 조직성과·개인성과·상급자 정성평가 기준 등 세부 평가기준은 해당 연도 성과관리 추진계획에 의거 적용한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_15","display_id":"BSC-성과평가-운영규정-제15조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제3장 성과평가 결과의 활용","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"성과급 지급에 반영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_15_P1","display_id":"BSC-성과평가-운영규정-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"5급(이에 상당하는 계급 포함) 이상에 대한 성과연봉 지급, 6급 이하(이에 상당하는 계급포함) 및 군인에 대한 성과상여금 지급시 성과평가 결과를 활용한다.","items":[]},{"id":"DAPA_A_2100000196824_ART_15_P2","display_id":"BSC-성과평가-운영규정-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"성과연봉 및 성과상여금 지급시 성과평가결과의 반영기준·활용방법 등에 관한 사항은「공무원 보수 등의 업무지침(인사혁신처 예규)」에 따라 주관부서에서 정하는 바에 따른다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_16","display_id":"BSC-성과평가-운영규정-제16조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제3장 성과평가 결과의 활용","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"조직·예산관리 등에 반영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_16_P0","display_id":"BSC-성과평가-운영규정-제16조","paragraph_number":"","paragraph_index":null,"content":"조직개편·정원조정 및 부서별 일반경비에 대한 예산배정시 성과평가 결과를 반영할 수 있다. 이 경우 그 기준과 방법은 주관부서에서 따로 정한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_17","display_id":"BSC-성과평가-운영규정-제17조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제3장 성과평가 결과의 활용","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"승진 및 진급 심사에 반영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_17_P0","display_id":"BSC-성과평가-운영규정-제17조","paragraph_number":"","paragraph_index":null,"content":"승진 및 진급 심사시 성과평가 결과를 반영할 수 있다. 이 경우 그 기준과 방법은 인사 관계법령 및 인사위원회에서 정하는 바에 따른다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196824_ART_18","display_id":"BSC-성과평가-운영규정-제18조","regulation_id":"DAPA_A_2100000196824","regulation_name":"BSC 성과평가 운영규정","short_name":"BSC 성과평가 운영규정","document_type":"훈령","part":"","chapter":"제3장 성과평가 결과의 활용","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"교육·연수 대상자 선발에 반영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196824_ART_18_P0","display_id":"BSC-성과평가-운영규정-제18조","paragraph_number":"","paragraph_index":null,"content":"국내·외, 장·단기간의 교육·연수 대상자 선발시 성과평가 결과를 반영할 수 있다. 이 경우 그 기준과 방법은 주관부서에서 따로 정한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"BSC 성과평가 운영규정.json","source_path":"원문/법제처API/BSC 성과평가 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2