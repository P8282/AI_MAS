s":[]},{"id":"DAPA_A_2100000171270_ART_3","display_id":"방위사업청-공무원-징계규정-제3조","regulation_id":"DAPA_A_2100000171270","regulation_name":"(방위사업청) 공무원 징계규정","short_name":"(방위사업청) 공무원 징계규정","document_type":"훈령","part":"","chapter":"","section":"제2절 위원회 구성","subsection":"","article_number":"3","article_label":"제3조","article_title":"위원회 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171270_ART_3_P1","display_id":"방위사업청-공무원-징계규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원회는 차장을 위원장으로 하여 공무원위원 2인과 민간위원 2인으로 구성하며 방위사업청장은 국·부장급 2인을 공무원위원으로 임명하고, 민간위원 2인은 다음 각 호의 어느 하나에 해당하는 사람 중에서 3년을 임기로 위촉한다.","items":[{"id":"DAPA_A_2100000171270_ART_3_P1_I1","display_id":"방위사업청-공무원-징계규정-제3조-제1항-제1호","item_number":"1","content":"법관, 검사 또는 변호사로 5년 이상 근무한 사람","subitems":[]},{"id":"DAPA_A_2100000171270_ART_3_P1_I2","display_id":"방위사업청-공무원-징계규정-제3조-제1항-제2호","item_number":"2","content":"대학에서 법학 또는 행정학을 담당하는 조교수 이상으로 재직 중인 사람","subitems":[]},{"id":"DAPA_A_2100000171270_ART_3_P1_I3","display_id":"방위사업청-공무원-징계규정-제3조-제1항-제3호","item_number":"3","content":"공무원으로 20년 이상 근속하고 퇴직한 사람","subitems":[]}]},{"id":"DAPA_A_2100000171270_ART_3_P2","display_id":"방위사업청-공무원-징계규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원회의 사무를 처리하기 위하여 간사 1인을 두되, 간사는 조직인사담당관(공무원인사파트리더)이 된다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 공무원 징계규정.json","source_path":"원문/법제처API/(방위사업청) 공무원 징계규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171270_ART_4","display_id":"방위사업청-공무원-징계규정-제4조","regulation_id":"DAPA_A_2100000171270","regulation_name":"(방위사업청) 공무원 징계규정","short_name":"(방위사업청) 공무원 징계규정","document_type":"훈령","part":"","chapter":"","section":"제2절 위원회 구성","su