[{"id":"DAPA_A_2100000257924_ART_1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제1조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_1_P0","display_id":"방위사업-입찰질서-공정화에-관한-지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업 관련 입찰과정의 공정성과 투명성 확보를 위해 계약담당공무원이「독점규제 및 공정거래에 관한 법률」제19조에 따라 판단해야 할 입찰담합의 유형 및 내용과 구체적인 판단기준을 제시하고 입찰담합 가능성이 큰 사항에 대해서는 「독점규제 및 공정거래에 관한 법률」제49조제2항에 따라 공정거래위원회에 통보하는 등의 조치를 취함으로써 방위사업 참여업체의 자율적인 경쟁여건 조성과 건전한 경영활동 보장을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["독점규제 및 공정거래에 관한 법률"],"keywords":["계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제2조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"입찰담합 판단근거","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_2_P1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"입찰담합이란「독점규제 및 공정거래에 관한 법률」(이하 \"법\" 또는 \"공정거래법\"이라 한다) 제19조 제1항 각호의 부당한 공동행위 및 동법 제26조 제1항 각호의 행위(이하 '담합'이라 한다) 중 입찰행위에 관한 것을 의미한다.","items":[]},{"id":"DAPA_A_2100000257924_ART_2_P2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"입찰담합으로 추정되는 사항으로 본 지침에 설명되어 있지 않은 활동에 대해서는 공정거래법 및 관련법령에 따라 개별적으로 판단한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["독점규제 및 공정거래에 관한 법률"],"keywords":[]},{"id":"DAPA_A_2100000257924_ART_3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제3조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_3_P0","display_id":"방위사업-입찰질서-공정화에-관한-지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업에 참여하는 사업자 및 사업자단체의 입찰과 관련된 활동에 적용한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257924_ART_4","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제2장 입찰담합의 제 유형","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"입찰가격담합","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_4_P1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 사업자(이하 \"사업자단체\"를 포함한다)가 공동으로 최저입찰가격(계약목적에 따라서는 최고입찰가격), 수주예정가격 또는 그와 비슷한 것으로 인정되는 것을 결정(계약, 협정, 결의 등 명시적 결정뿐만 아니라 기타 합의에 도달하게 되는 모든 행위를 의미한다)하여 경쟁을 제한하는 다음 각 호의 어느 하나에 해당하는 행위에 대하여 공정거래법 위반 가능성이 큰 행위로 판단할 수 있다.","items":[{"id":"DAPA_A_2100000257924_ART_4_P1_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제1항-제1호","item_number":"1","content":"사업자가 공동으로 입찰에 관련한 최저입찰가격 등을 결정하거나 관련 사업자가 이에 응하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_4_P1_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제1항-제2호","item_number":"2","content":"사업자간에 입찰가격을 협의하거나 그에 관한 정보의 교환ㆍ제공을 통해 입찰가격을 결정하는 행위와 사업자단체가 입찰가격결정에 관여하고 그 사실을 관련사업자에게 제공하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_4_P1_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제1항-제3호","item_number":"3","content":"입찰에 참가하는 사업자들이 다른 사업자의 산출내역서를 복사 또는 대신 작성하여 주는 등의 방법에 의해 입찰하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_4_P1_I4","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제1항-제4호","item_number":"4","content":"사업자가 공동으로 예정가격을 인상시킬 목적으로 예정금액보다 높은 수주금액 또는 수준을 정한 후 고의적으로 유찰시키는 행위","subitems":[]}]},{"id":"DAPA_A_2100000257924_ART_4_P2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 규정은 다음 각 호의 1에 해당하는 경우에는 적용하지 아니한다.","items":[{"id":"DAPA_A_2100000257924_ART_4_P2_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제2항-제1호","item_number":"1","content":"사업자가 독자적으로 입찰대상사업에 관한 관련업계의 정보를 수집하는 영업활동 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_4_P2_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제2항-제2호","item_number":"2","content":"사업자가 공동으로 단순히 공표된 사업금액의 계산에 대해 조사하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_4_P2_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제2항-제3호","item_number":"3","content":"사업자가 공동으로 품질향상과 원가인하를 위해 신공법 또는 신기술에 관한정보를 교환하거나 관련사례를 수집하여 제공하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_4_P2_I4","display_id":"방위사업-입찰질서-공정화에-관한-지침-제4조-제2항-제4호","item_number":"4","content":"중소기업단체 및 사업자단체가 관련사업자의 사업금액 계산능력을 향상시킬 목적으로 공통적인 항목에 대해 표준적인 계산방법이나 작업량 등을 알려주는 지도 행위","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["예정가격","계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_5","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제2장 입찰담합의 제 유형","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"낙찰예정자 사전결정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_5_P1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 사업자가 공동으로 낙찰예정자 또는 낙찰예정자의 선정방법을 결정(계약, 협정, 결의 등 명시적 결정뿐만 아니라 기타 합의에 도달하게 되는 모든 행위를 의미한다)함으로써 입찰제도의 취지에 반하고 상품 및 용역거래에 관한 경쟁을 본질적으로 제한하는 다음 각 호의 어느 하나에 해당하는 행위에 대하여 공정거래법 위반 가능성이 큰 행위로 판단할 수 있다.","items":[{"id":"DAPA_A_2100000257924_ART_5_P1_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제1항-제1호","item_number":"1","content":"사업자가 공동으로 수주를 희망하는 자 가운데 낙찰예정자를 미리 결정하고 이에 협조하는 다음 각 목의 행위가. 수주예정자가 낙찰 받을 수 있도록 하기 위하여 다른 입찰참가자가 공동으로 수주예정자보다 입찰가격을 높게 하여 응찰하는 행위나. 개별사업자의 지명회수, 수주실적 등을 정리하여 낙찰예정자 선정의 우선순위를 정하고 입찰에 참가하려는 사업자들이 이에 협조토록 강요하는 행위다. 수주희망업체가 협조업체에게 낙찰에 협조하는 대가로 차기 사업발주 시 낙찰의 협조, 금품지급 등의 이익을 공여하거나 또는 이익공여를 약정하는 방법에 의해 낙찰자를 사전 결정하는 행위라. 입찰에 참가하려는 사업자에 대하여 수주예정자 결정에 따르도록 강요하고 협력하지 않는 사업자에 대해 입찰참가를 방해하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_5_P1_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제1항-제2호","item_number":"2","content":"특정입찰에 대한 연고권 주장을 통하여 특정업체에 낙찰이 이루어지도록 하거나 이에 협조하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_5_P1_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제1항-제3호","item_number":"3","content":"특정업체들 간에 일정한 범위내의 사업을 교대로 수주하거나 특정업체가 다른 입찰참가업체들의 산출내역서를 대신 작성하여 주면서 입찰에 참가하게 하거나 입찰내역서를 첨부하지 않는 등의 형태로 입찰에 참가하여 특정업체의 낙찰을 밀어주는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_5_P1_I4","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제1항-제4호","item_number":"4","content":"특정업체가 산출내역서를 전문적으로 작성하는 용역업체에 다른 사업자의 산출내역서 작성을 의뢰하고 이를 참여사업자에게 배분하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_5_P1_I5","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제1항-제5호","item_number":"5","content":"수주예정자 선정과 관련하여 사업자가 공동으로 낙찰예정자를 결정한 후 이를 관련사업자에게 통지하고 협조를 요구하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_5_P1_I6","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제1항-제6호","item_number":"6","content":"낙찰에서 배제된 사업자가 공동으로 낙찰자선정에 협조한 대가로 낙찰사업자에게 사례금 또는 특별회비, 부과금 등을 징수하는 행위","subitems":[]}]},{"id":"DAPA_A_2100000257924_ART_5_P2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 규정은 다음 각 호의 1에 해당하는 경우에는 적용하지 아니한다.","items":[{"id":"DAPA_A_2100000257924_ART_5_P2_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제2항-제1호","item_number":"1","content":"경쟁입찰에 지명을 받은 사업자가 다른 사업자와 협의 없이 경쟁력이 우위인 사업자가 있어 자주적으로 입찰을 사퇴하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_5_P2_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제2항-제2호","item_number":"2","content":"입찰공고 등에 따른 예산금액 낮아 수익성이 없다는 등의 이유로 자주적 판단에 의해 입찰참가를 하지 않는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_5_P2_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제5조-제2항-제3호","item_number":"3","content":"관련사업 수행능력이 부족 또는 기술경쟁력저위 등의 요인으로 입찰에 참가하지 않는 행위 등","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["산출내역서","입찰참가자격","낙찰자","용역","계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_6","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제2장 입찰담합의 제 유형","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"경쟁입찰계약을 수의계약으로 유도","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_6_P1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 사업자가 공동으로 특정사업자가 수의계약에 의해 계약할 수 있도록 결정(계약, 협정, 결의 등 명시적 결정뿐만 아니라 기타 합의에 도달하게 되는 모든 행위를 의미한다)유도 하여 자유로운 경쟁을 배제하는 다음 각 호의 어느 하나에 해당하는 행위에 대하여 공정거래법 위반 가능성이 큰 행위로 판단할 수 있다.","items":[{"id":"DAPA_A_2100000257924_ART_6_P1_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조-제1항-제1호","item_number":"1","content":"사업자가 공동으로 당해입찰을 수의계약으로 유도할 것을 합의하고 입찰참가자 모두 예정가격보다 높은 가격에 의해 계속적으로 유찰시키거나 입찰참가를 의도적으로 거부하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_6_P1_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조-제1항-제2호","item_number":"2","content":"특정사업자의 수주를 목적으로 몇몇 사업자가 공모하여 들러리 등 형식적으로 입찰에 참여하였다가 도중에 입찰을 포기하여 특정사업자 이외의 다른 사업자가 입찰에 참여하는 것을 실질적으로 봉쇄하여 수의계약으로 유도하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_6_P1_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조-제1항-제3호","item_number":"3","content":"사업자가 공동으로 객관적 기준 없이 특정한 사업자를 입찰계약과 관련하여 부당업자 또는 불량업자로 구분하여 관련부서에 통보하거나 대외공표 함으로써 입찰참여를 방해한 후 수의계약을 유도하는 행위","subitems":[]}]},{"id":"DAPA_A_2100000257924_ART_6_P2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 규정은 다음 각 호의 1에 해당하는 경우에는 적용하지 아니한다.","items":[{"id":"DAPA_A_2100000257924_ART_6_P2_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조-제2항-제1호","item_number":"1","content":"급격한 가격상승 등으로 입찰공고당시 예산금액으로는 입찰참가가 불가능하여 자주적으로 입찰에 참가하지 않는 경우","subitems":[]},{"id":"DAPA_A_2100000257924_ART_6_P2_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제6조-제2항-제2호","item_number":"2","content":"1차 입찰에만 참여하고 같은 입찰조건이하에서는 수주할 여건이 안 되어 재입찰에는 참가하지 않는 경우","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["수의계약","입찰참가자격","예정가격","계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_7","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제2장 입찰담합의 제 유형","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"수주물량 등의 결정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_7_P1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 사업자가 공동으로 입찰에 관련된 수주물량결정(계약, 협정, 결의 등 명시적 결정뿐만 아니라 기타 합의에 도달하게 되는 모든 행위를 의미한다)과 이러한 수주물량을 나누어 갖기 위해 입찰참가자간 배분 등을 결정하는 다음 각 호의 어느 하나에 해당하는 행위에 대하여 공정거래법 위반 가능성이 큰 행위로 판단할 수 있다.","items":[{"id":"DAPA_A_2100000257924_ART_7_P1_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조-제1항-제1호","item_number":"1","content":"사업자가 공동으로 회합 등을 통해 수주물량을 결정하거나 입찰참가자간 수주물량배분을 결정하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_7_P1_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조-제1항-제2호","item_number":"2","content":"사업자가 공동으로 수주물량 배분 등의 결정에 비협조적인 사업자에 대해 입찰참가를 방해하거나 기타 불이익 제공 등의 차별적 취급을 하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_7_P1_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조-제1항-제3호","item_number":"3","content":"단독으로 사업을 수행할 수 있음에도 불구하고 일부 물량에 대하여만 응찰하여 다른 사업자와의 공동수주를 유도하는 행위","subitems":[]}]},{"id":"DAPA_A_2100000257924_ART_7_P2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 규정은 다음 각 호의 1에 해당하는 경우에는 적용하지 아니한다.","items":[{"id":"DAPA_A_2100000257924_ART_7_P2_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조-제2항-제1호","item_number":"1","content":"사업자단체 등이 발주에 관한 전반적인 동향(실적 및 전망 등)을 파악하여 개괄적으로 정리ㆍ공표하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_7_P2_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제7조-제2항-제2호","item_number":"2","content":"관련 법령 또는 청의 요구에 의한 경우 및 기술적 필요 등에 의해 공동 수주하는 경우","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["입찰참가자격","계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_8","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제2장 입찰담합의 제 유형","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"경영간섭 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_8_P1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 입찰에 참가하려는 사업자가 공동으로 당해 입찰에 관련된 사업자 활동에 대해 지도를 행함에 있어서 입찰가격이나 수주예정자 결정에 영향을 주는 다음 각 호의 어느 하나에 해당하는 행위에 대하여 경쟁제한적인 공정거래법 위반 가능성이 큰 행위로 판단할 수 있다.","items":[{"id":"DAPA_A_2100000257924_ART_8_P1_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제1항-제1호","item_number":"1","content":"사업자단체가 원재료를 공동구매하여 판매함에 있어 입찰금액이 낮거나 임의적으로 입찰에 참여한 사업자에게는 판매물량의 제한이나 기타 불리한 조건에 의해 판매하는 등을 정하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_8_P1_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제1항-제2호","item_number":"2","content":"사업자단체가 입찰에 참가하는 구성사업자에 대해 입찰가격에 관한 목표를 부여하거나 수주예정자 결정을 위하여 입찰참여 여부를 사전에 통지토록 요청하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_8_P1_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제1항-제3호","item_number":"3","content":"사업자가 공동으로 사전에 입찰참여자로 하여금 수주물량의 일부를 특정사업자에게 하도급 형태로 분할하는 조건이나 특정사업자로부터의 자재구입 사용조건 등을 정하여 입찰에 참여하도록 하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_8_P1_I4","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제1항-제4호","item_number":"4","content":"낙찰예정자로 하여금 계약금액의 일정률을 기부금 형태로 납부토록 하거나 특별회비로 납부토록 하여 이익의 일부를 공동사용 또는 배분하는 행위","subitems":[]}]},{"id":"DAPA_A_2100000257924_ART_8_P2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 규정은 다음 각 호의 1에 해당하는 경우에는 적용하지 아니한다.","items":[{"id":"DAPA_A_2100000257924_ART_8_P2_I1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제2항-제1호","item_number":"1","content":"사업자단체 등이 입찰에 참가하는 구성사업자(주로 중소기업자)를 대상으로 하여 입찰제도의 운용에 관해 단순한 요망 또는 의견표명을 하는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_8_P2_I2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제2항-제2호","item_number":"2","content":"사업자가 공동으로 품질보증 및 기술교류를 위해 회합 또는 기타의 의견ㆍ자료교환 방식으로 기술분야의 개발 또는 교류를 촉진ㆍ확산시키려는 행위","subitems":[]},{"id":"DAPA_A_2100000257924_ART_8_P2_I3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제8조-제2항-제3호","item_number":"3","content":"특정사업자(또는 단체)가 입찰에 참여하는 사업자에 대하여 계약 관련 기술관계 등 입찰에 관한 일반적인 사항을 설명하는 것을 지원해 주는 행위","subitems":[]}]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_9","display_id":"방위사업-입찰질서-공정화에-관한-지침-제9조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제3장 입찰담합에 대한 조치사항","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"법 위반 가능성이 큰 행위에 대한 조치사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_9_P1","display_id":"방위사업-입찰질서-공정화에-관한-지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 제4조부터 제8조까지 규정한 공정거래법 위반 가능성이 큰 행위에 대해서는 감독지원담당관과 협의를 거쳐 해당 계약관에게 보고 후 공정거래위원회에 통보해야 한다.","items":[]},{"id":"DAPA_A_2100000257924_ART_9_P2","display_id":"방위사업-입찰질서-공정화에-관한-지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제4조부터 제8조까지 규정한 공정거래법 위반 가능성이 큰 행위로 판단되는 경우에는 해당 사업자에게 공정거래법에 따라 입찰담합으로 처분 받을 수 있다는 것을 통보할 수 있다.","items":[]},{"id":"DAPA_A_2100000257924_ART_9_P3","display_id":"방위사업-입찰질서-공정화에-관한-지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제4조부터 제8조까지의 법 위반 행위에 대한 조치에 있어서 입찰담합을 주도한 사업자와 입찰과정에서 최종 낙찰자에 협력한 사업자는 모두 담합 참가자로 간주하여 처리하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000257924_ART_4","DAPA_A_2100000257924_ART_8"],"related_regulations":[],"external_references":[],"keywords":["계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_10","display_id":"방위사업-입찰질서-공정화에-관한-지침-제10조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제3장 입찰담합에 대한 조치사항","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"입찰참가자격제한 의뢰 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_10_P0","display_id":"방위사업-입찰질서-공정화에-관한-지침-제10조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 공정거래위원회로부터 법 위반 행위를 하여 입찰참가자격제한 통보를 받은 사업자(또는 사업자단체)에 대하여 「국가를 당사자로 하는 계약에 관한 법률 시행령」제76조 또는 제76조의2 규정에 따라 입찰참가자격제한 또는 과징금 부과를 위해 계약심의회에 상정해야 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_76","STATE_CONTRACT_ENFORCEMENT_ART_76_2"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["입찰참가자격","입찰참가자격 제한","부정당업자","계약담당공무원"]},{"id":"DAPA_A_2100000257924_ART_11","display_id":"방위사업-입찰질서-공정화에-관한-지침-제11조","regulation_id":"DAPA_A_2100000257924","regulation_name":"방위사업 입찰질서 공정화에 관한 지침","short_name":"방위사업 입찰질서 공정화에 관한 지침","document_type":"예규","part":"","chapter":"제3장 입찰담합에 대한 조치사항","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"자진신고를 위한 조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257924_ART_11_P0","display_id":"방위사업-입찰질서-공정화에-관한-지침-제11조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 제9조제1항에 의한 담합의혹으로 공정거래위원회 통보하는 사업자(또는 사업자단체)에 대하여 공정거래법 제22조의2에 따라 공정거래위원회에 자진신고에 필요한 입찰담합 판단기준과 자진신고 절차 등을 통보할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"방위사업 입찰질서 공정화에 관한 지침.json","source_path":"원문/법제처API/방위사업 입찰질서 공정화에 관한 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000257924_ART_9"],"related_regulations":[],"external_references":["공정거래법"],"keywords":["계약담당공무원"]},{"id":"DAPA_A_2100000257