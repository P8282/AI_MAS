paragraph_number":"①","paragraph_index":1,"content":"부터 <30> 까지 생략","items":[]},{"id":"GOODS_LIST_INFO_ACT_API_SUPP_1c5a87324767_ART_6_P31","display_id":"물품목록정보법-부칙5-제6조-제31항","paragraph_number":"㉛","paragraph_index":31,"content":"물품목록정보의관리및이용에관한법률 일부를 다음과 같이 개정한다.\n제4조제1항 및 제21조 중 \"재정경제부장관\"을 각각 \"기획재정부장관\"으로 한다.\n제9조제3항 중 \"재정경제부령\"을 \"기획재정부령\"으로 한다.\n제18조제1항 중 \"재정경제부\"를 \"기획재정부\"로 한다.","items":[]},{"id":"GOODS_LIST_INFO_ACT_API_SUPP_1c5a87324767_ART_6_P32","display_id":"물품목록정보법-부칙5-제6조-제32항","paragraph_number":"㉜","paragraph_index":32,"content":"부터 <760> 까지 생략\n제7조 생략","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2025-10-01","source_file":"GOODS_LIST_INFO_ACT.json","source_path":"원문/법제처API/GOODS_LIST_INFO_ACT.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙(정부조직법) <제8852호,2008.2.29>","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=276109","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"GOODS_LIST_INFO_ACT_API_SUPP_4eef4ad65d75_PRE","display_id":"물품목록정보법-부칙6","regulation_id":"GOODS_LIST_INFO_ACT","regulation_name":"물품목록정보의 관리 및 이용에 관한 법률","short_name":"물품목록정보법","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":6,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"GOODS_LIST_INFO_ACT_API_SUPP_4eef4ad65d75_PRE_P0","display_id":"물품목록정보법-부칙6","paragraph_number":"","paragraph_index":null,"content":"이 법은 공포 후 3개월이 경과한 날부터 시행한다.","items":[]}],"notes":[],"effective_date":"2026-01-02","revision_date":"2025-10-01","source_file":"GOODS_LIST_INFO_ACT.json","source_path":"원문/법제처API/GOODS_LIST_INFO_ACT.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제9517호,2009.3.25>","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=276109","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"GOODS_LIST_INFO_ACT_API_SUPP_666921bbabed_ART_1","display_id":"물품목록정보법-부칙7-제1조","regulation_id":"GOODS_LIST_INFO_ACT","regulation_name":"물품목록정보의 관리 및 이용에 관한 법률","short_name":"물품목록정보법","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":7,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"GOODS_LIST_INFO_ACT_API_SUPP_666921bbabed_ART_1_P0","display_id":"물품목록정보법-부칙7-제1조","paragraph_number":"","paragraph_index":null,"content":"이 법은 공포한 날부터 시행한다. 다만, 부칙 제7조에 따라 개정되는 법률 중 이 법 시행 전에 공포되었으나 시행일이 도래하지 아니한 법률을 개정한 부분은 각각 해당 법률의 시행일부터 시행하고, 다음 각 호의 개정규정은 해당 호에서 정하는 날부터 시행한다.","items":[{"id":"GOODS_LIST_INFO_ACT_API_SUPP_666921bbabed_ART_1_P0_I1","display_id":"물품목록정보법-부칙7-제1조-제1호","item_number":"1","content":"다음 각 목의 개정규정은 2026년 1월 2일부터 시행한다. 다만, 부칙 제7조에 따라 개정되는 법률(가목 및 나목의 개정규정과 관련되는 부분으로 한정한다) 중 본문에 따른 시행일 전에 공포되었으나 본문에 따른 시행일이 도래하지 아니한 법률을 개정한 부분은 각각 해당 법률의 시행일부터 시행한다.","subitems":[{"id":"GOODS_LIST_INFO_ACT_API_SUPP_666921bbabed_ART_1_P0_I1_S1","display_id":"물품목록정보법-부칙7-제1조-제1호-가목","subitem_number":"가","content":"제19조제4항, 제23조, 제29조제1항제1호 및 제30조의 개정규정"},{"id":"GOODS_LIST_INFO_ACT_API_SUPP_666921bbabed_ART_1_P0_I1_S2","display_id":"물품목록정보법-부칙7-제1조-제1호-나목","subitem_number":"나","content":"제12조제2항, 제19조제3항, 제22조 및 제29조제2항 단서의 개정규정(재정경제부장관 및 재정경제부에 관한 부분으로 한정한다)"},{"id":"GOODS_LIST_INFO_ACT_API_SUPP_666921bbabed_ART_1_P0_I1_S3","display_id":"물품목록정보법-부칙7-제1조-제1호-다목","subitem_number":"다","content":"부칙 제7조에 따라 개정되는 법률(가목 및 나목의 개정규정과 관련되는 부분으로 한정한다)"}]},{"id":"GOODS_LIST_INFO_ACT_API_SUPP_666921bbabed_ART_1_P0_I2","display_id":"물품목록정보법-부칙7-제1조-제2호","item_number":"2","content":"생략\n제2조 부터 제