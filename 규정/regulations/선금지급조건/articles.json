[{"id":"DAPA_A_2100000281998_ART_1","display_id":"선금지급조건-제1조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_1_P0","display_id":"선금지급조건-제1조","paragraph_number":"","paragraph_index":null,"content":"이 조건은 「국고금관리법 시행령」제40조 제1항 제15호와 「정부 입찰ㆍ계약집행기준」 제12장에 따라 방위사업청과 계약상대자의 선금의 청구ㆍ지급ㆍ사용ㆍ반환 등에 필요한 사항을 정한다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["NATIONAL_TREASURY_ENFORCEMENT_ART_40"],"related_regulations":["NATIONAL_TREASURY_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000281998_ART_2","display_id":"선금지급조건-제2조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"권리와 의무의 확약","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_2_P1","display_id":"선금지급조건-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청 계약담당공무원(하 \"계약담당공무원\"이라 한다)과 계약상대자 및 계약상대자의 하수급인(이하 \"협력업체\"라 한다)은 「정부입찰ㆍ계약 집행기준」 제12장에 따른 선금의 청구ㆍ지급ㆍ사용ㆍ채권보전ㆍ정산 및 반환 사항 등에 관한 회계처리의 기준ㆍ방법ㆍ절차에 대하여 계약당사자 쌍방이 상호 합의 하에 이 조건에서 명시한 권리와 의무사항을 계약서의 일부로서 수락한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_2_P2","display_id":"선금지급조건-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약상대자는 제1항에 따라 수락한 사항을 신의ㆍ성실의 원칙에 따라 이행할 것을 확약하는 이행확약서를 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약담당공무원","계약상대자","하도급"]},{"id":"DAPA_A_2100000281998_ART_3","display_id":"선금지급조건-제3조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"지급범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_3_P1","display_id":"선금지급조건-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공사, 물품 제조 또는 용역계약에 대하여 선금을 지급할 수 있다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P2","display_id":"선금지급조건-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 계약상대자가 당해 계약체결 이후 계약목적 달성을 위하여 사용할 것에 대해 선금의 지급을 요청한 때에는 계약형태별로 다음 각호에 해당하는 금액의 100분의 70을 초과하지 아니하는 범위 내에서 선금을 지급할 수 있다.","items":[{"id":"DAPA_A_2100000281998_ART_3_P2_I1","display_id":"선금지급조건-제3조-제2항-제1호","item_number":"1","content":"단기계약 : 당해연도 세출예산액","subitems":[]},{"id":"DAPA_A_2100000281998_ART_3_P2_I2","display_id":"선금지급조건-제3조-제2항-제2호","item_number":"2","content":"계속비와 명시이월비 예산에 의한 계약 : 계약금액(또는 총부기금액) 중 당해연도 이행금액","subitems":[]},{"id":"DAPA_A_2100000281998_ART_3_P2_I3","display_id":"선금지급조건-제3조-제2항-제3호","item_number":"3","content":"장기계속계약 : 각 연차별 계약금액","subitems":[]},{"id":"DAPA_A_2100000281998_ART_3_P2_I4","display_id":"선금지급조건-제3조-제2항-제4호","item_number":"4","content":"단가계약 : 선금지급 요청일까지 당해연도 세출 예산액에 의한 물품납품통지서 발주금액","subitems":[]}]},{"id":"DAPA_A_2100000281998_ART_3_P3","display_id":"선금지급조건-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약상대자가 제2항에 따른 선금의 지급을 최초로 신청하는 경우 「정부 입찰ㆍ계약 집행기준」제34조제4항 및 제5항에 따른 선금의무지급률(이하 \"선금의무지급률\"이라 한다)을 초과하지 아니하는 범위 내에서 선금을 지급하여야 한다. 다만, 계약상대자가 선금의무지급률 이하로 신청하는 경우에는 신청한 바에 따라 지급한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P4","display_id":"선금지급조건-제3조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약담당공무원은 다음 각호의 어느 하나에 해당하는 경우에는 계약상대자의 청구에 의해 「정부 입찰ㆍ계약 집행기준」제34조제4항제1호 또는 제2호에 해당하는 금액 이외에 해당 계약금액의 100분의 10범위 내에서 추가로 지급하여야한다.","items":[{"id":"DAPA_A_2100000281998_ART_3_P4_I1","display_id":"선금지급조건-제3조-제4항-제1호","item_number":"1","content":"「정부 입찰ㆍ계약 집행기준」제70조의4제1항 각호에 따른 원자재 가격이 급등한 경우","subitems":[]},{"id":"DAPA_A_2100000281998_ART_3_P4_I2","display_id":"선금지급조건-제3조-제4항-제2호","item_number":"2","content":"신기술을 사용하는 물품 및 용역계약에 있어서 기술개발투자를 위한 자금이 계약이행초기에 집중적으로 소요되는 경우","subitems":[]},{"id":"DAPA_A_2100000281998_ART_3_P4_I3","display_id":"선금지급조건-제3조-제4항-제3호","item_number":"3","content":"계약상대자가 「기후위기 대응을 위한 탄소중립ㆍ녹색성장 기본법」제60조제2항에 따라 녹색기술ㆍ녹색사업에 대한 적합성 인증을 받거나 녹색전문기업으로 확인받은 경우(동법 제60조제3항 각호에 해당하는 자 제외)","subitems":[]}]},{"id":"DAPA_A_2100000281998_ART_3_P5","display_id":"선금지급조건-제3조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약담당공무원은 제3항에도 불구하고 계약상대자가 최초 선금 신청시 선금의무지급률을 초과한 선금을 요청할 경우 계약의 목적, 특성 등을 고려하여 불가피하다고 인정되는 때에는 그 초과분에 대하여 선금을 지급할 수 있다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P6","display_id":"선금지급조건-제3조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"계약담당공무원은 계약상대자가 제3항 내지 제5항에 따라 선금을 수령한 후 추가로 선금 지급을 요청할 경우 제7조제2항에 따라 이미 지급된 선금의 사용내역 또는 선금 지급분에 해당하는 공정률을 확인한 후 추가로 선금을 지급할 수 있다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P7","display_id":"선금지급조건-제3조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"제3항 내지 제6항의 경우에서「국가를 당사자로 하는 계약에 관한 법률」제15조와 당해 계약조건에 따라 기성부분 또는 기납부분에 대하여 대가를 지급한 때에는 계약금액(단가계약의 경우 발주금액)에서 그 대가를 공제한 금액을 기준으로 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P8","display_id":"선금지급조건-제3조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"계약상대자가 계약체결 이후에 자체자금을 사용하여 계약을 이행한 부분에 대해 사용내역서를 제출하는 경우에는 제2항의 지급한도 범위 내에서 선금을 지급할 수 있다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P9","display_id":"선금지급조건-제3조-제9항","paragraph_number":"⑨","paragraph_index":9,"content":"계약담당공무원은 제3항 내지 제6항에 해당하는 선금에 대해서는 계약상대자의 청구를 받은 날로부터 14일 이내에 지급하여야 한다. 다만 제10항에 따라 서류 보완을 요구한 경우에는 보완서류를 제출한 날부터 14일 이내에 지급하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P10","display_id":"선금지급조건-제3조-제10항","paragraph_number":"⑩","paragraph_index":10,"content":"계약담당공무원은 계약상대자가 제3항 내지 제6항에 따라 선금지급을 요청하는 경우 협력업체에 대한 선금지급계획을 포함한 선금사용계획서 및 당해 계약만을 위해 사용되는 선금전용계좌를 제출하도록 하여야 하며, 필요시 기한을 정해 보완을 요구할 수 있다.","items":[]},{"id":"DAPA_A_2100000281998_ART_3_P11","display_id":"선금지급조건-제3조-제11항","paragraph_number":"⑪","paragraph_index":11,"content":"계약담당공무원은 제3항, 제5항 및 제6항에 따라 선금을 지급하는 경우, 계약상대자의 의사에 반하는 선금의 신청을 요구하거나 강제하여서는 아니 된다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["BID_CONTRACT_EXECUTION_RULE_ART_34","BID_CONTRACT_EXECUTION_RULE_ART_70_4","CARBON_NEUTRALITY_ACT_ART_60","DAPA_A_2100000281998_ART_7","STATE_CONTRACT_ACT_ART_15"],"related_regulations":["BID_CONTRACT_EXECUTION_RULE","CARBON_NEUTRALITY_ACT","STATE_CONTRACT_ACT"],"external_references":[],"keywords":["선금","계약담당공무원","계약상대자","계약금액","용역","장기계속계약"]},{"id":"DAPA_A_2100000281998_ART_4","display_id":"선금지급조건-제4조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"지급 제한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_4_P1","display_id":"선금지급조건-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 자금사정 등 불가피한 사유에 의하여 선금지급이 불가능한 경우에는 지체없이 계약상대자에게 그 사유를 서면으로 통지하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_4_P2","display_id":"선금지급조건-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 선금지급이 불가능한 경우란 다음 각호에 해당하는 경우를 말한다.","items":[{"id":"DAPA_A_2100000281998_ART_4_P2_I1","display_id":"선금지급조건-제4조-제2항-제1호","item_number":"1","content":"자금배정이 지연될 경우. 단, 자금배정이 있을 경우 즉시 선금을 지급함","subitems":[]},{"id":"DAPA_A_2100000281998_ART_4_P2_I2","display_id":"선금지급조건-제4조-제2항-제2호","item_number":"2","content":"계약체결후 불가피한 사유로 이행착수가 상당기간 지연될 것이 명백한 경우. 단, 동사유 해제시 즉시 선금을 지급하여야 함","subitems":[]},{"id":"DAPA_A_2100000281998_ART_4_P2_I3","display_id":"선금지급조건-제4조-제2항-제3호","item_number":"3","content":"계약상대자로부터 선금지급 요청이 없거나 유예신청이 있는 경우","subitems":[]}]},{"id":"DAPA_A_2100000281998_ART_4_P3","display_id":"선금지급조건-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 계약상대자가「국가를 당사자로 하는 계약에 관한 법률 시행령」 제76조에 따른 입찰참가자격제한을 받고 그 제한기간 중에 있을 때에는 선금을 지급하지 않는다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_76"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["선금","입찰참가자격","계약담당공무원","입찰참가자격 제한","계약상대자"]},{"id":"DAPA_A_2100000281998_ART_5","display_id":"선금지급조건-제5조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"신청 및 지급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_5_P1","display_id":"선금지급조건-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약상대자가 선금을 신청할 때에는 다음 각 호의 모든 서류를 구비하여 계약담당공무원에게 제출하여야 한다. 이 경우 계약상대자는 계약담당공무원이 지정한 표준서식을 사용하여야 한다.","items":[{"id":"DAPA_A_2100000281998_ART_5_P1_I1","display_id":"선금지급조건-제5조-제1항-제1호","item_number":"1","content":"선금 신청서(별지 제1호 서식) 2부","subitems":[]},{"id":"DAPA_A_2100000281998_ART_5_P1_I2","display_id":"선금지급조건-제5조-제1항-제2호","item_number":"2","content":"당해 계약 선금전용계좌 통장 사본 1부","subitems":[]},{"id":"DAPA_A_2100000281998_ART_5_P1_I3","display_id":"선금지급조건-제5조-제1항-제3호","item_number":"3","content":"전자세금계산서(선금 수령에 대한 공급자 제출용) 1부","subitems":[]},{"id":"DAPA_A_2100000281998_ART_5_P1_I4","display_id":"선금지급조건-제5조-제1항-제4호","item_number":"4","content":"제6조에 따른 채권확보서류 1부","subitems":[]},{"id":"DAPA_A_2100000281998_ART_5_P1_I5","display_id":"선금지급조건-제5조-제1항-제5호","item_number":"5","content":"선금 사용계획서(별지 제2호 서식) 2부","subitems":[]},{"id":"DAPA_A_2100000281998_ART_5_P1_I6","display_id":"선금지급조건-제5조-제1항-제6호","item_number":"6","content":"제2조에 따른 이행확약서(별지 제3호 서식) 2부","subitems":[]},{"id":"DAPA_A_2100000281998_ART_5_P1_I7","display_id":"선금지급조건-제5조-제1항-제7호","item_number":"7","content":"제10조에 따라 기명 날인한 선금지급조건 2부","subitems":[]},{"id":"DAPA_A_2100000281998_ART_5_P1_I8","display_id":"선금지급조건-제5조-제1항-제8호","item_number":"8","content":"선금 사용내역서(별지 제4호 서식) 1부","subitems":[]}]},{"id":"DAPA_A_2100000281998_ART_5_P2","display_id":"선금지급조건-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약상대자는 계약서에 첨부된 산출내역서상의 비목별 금액을 기준으로 그 사용내역을 제출할 수 있는 범위 내의 금액을 신청하여야 하며, 각 비목별 금액은 총액 범위 내에서 조정하여 사용할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000281998_ART_6","DAPA_A_2100000281998_ART_2","DAPA_A_2100000281998_ART_10"],"related_regulations":[],"external_references":[],"keywords":["선금","계약담당공무원","계약상대자"]},{"id":"DAPA_A_2100000281998_ART_6","display_id":"선금지급조건-제6조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"채권확보","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_6_P1","display_id":"선금지급조건-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약상대자가 선금을 청구할 때에는「국가를 당사자로 하는 계약에 관한 법률 시행령」 제37조 제2항에 의한 증권 또는 보증서를 계약담당공무원에게 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_6_P2","display_id":"선금지급조건-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 채권확보조치를 하는 경우에 보증 또는 보험금액은 선금액에 그 금액에 대한 보증 또는 보험기간에 해당하는 약정이자상당액{사유발생 시점(선금 지급 청구일)의 금융기관 대출평균금리(한국은행 통계월보상의 대출평균금리)에 의하여 산출한 금액을 말한다}을 가산한 금액 이상으로 하여야 하며, 산출식은 다음과 같다.<img id=\"166836801\"></img>","items":[]},{"id":"DAPA_A_2100000281998_ART_6_P3","display_id":"선금지급조건-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"선금을 지급받은 계약에 대하여 이행기간이 연장된 경우에 계약상대자는 연장된 이행기간만큼 보증기간 또는 보험기간이 연장된 선금 지급보증서를 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_6_P4","display_id":"선금지급조건-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약담당공무원은 제9조 제4항에 따라 협력업체에게 선금을 직접 지급하고자 하는 경우로서 계약상대자가 요구하는 경우에는 해당 협력업체로 하여금 계약상대자에게 보증서를 제출하도록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_6_P5","display_id":"선금지급조건-제6조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약담당공무원은 제9조 제4항에 따라 협력업체에게 선금을 직접 지급하는 경우에는 제1항에 따라 계약상대자가 제출한 보증서의 보증금액을 감액하지 아니한다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_37","DAPA_A_2100000281998_ART_9"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["선금","계약담당공무원","계약상대자","계약의 이행"]},{"id":"DAPA_A_2100000281998_ART_7","display_id":"선금지급조건-제7조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"선금의 사용","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_7_P1","display_id":"선금지급조건-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약상대자는 해당 선금을 당해 계약목적달성을 위한 용도 또는 협력업체에 대한 선금배분 이외의 다른 목적에 사용할 수 없으며, 노임지급 및 자재확보에 우선 사용하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_7_P2","display_id":"선금지급조건-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약상대자는 지급된 선금이 제1항에 의한 용도로 사용되었는지 여부를 확인하기 위한 선금사용내역서 및 세금계산서 등 증빙서류를 계약담당공무원에게 요청받은 경우 이를 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_7_P3","display_id":"선금지급조건-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약상대자는 지급받은 선금을 전액 정산하기 이전에는 당해 계약에 의하여 발생한 권리ㆍ의무를 제3자에게 양도하여서는 아니 된다.","items":[]},{"id":"DAPA_A_2100000281998_ART_7_P4","display_id":"선금지급조건-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약상대자는 선금을 지급받은 날(하도급계약을 체결하기 전에 선금을 받은 경우에는 하도급계약을 체결한 날을 말한다. 이하 같다)로부터 5일 이내에 협력업체에게 선금수령 사실을 서면으로 통지하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_7_P5","display_id":"선금지급조건-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약상대자는 선금을 지급받은 날로부터 15일 이내에 협력업체에게 선금을 배분하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_7_P6","display_id":"선금지급조건-제7조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"계약상대자와 협력업체는 선금을 지급받은 날로부터 20일 이내에 계약담당공무원에게 선금배분 및 수령내역을 확인할 수 있는 증빙서류를 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_7_P7","display_id":"선금지급조건-제7조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"계약상대자는 협력업체에게 선금을 현금으로 지급하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["선금","계약상대자","하도급","계약담당공무원","도급"]},{"id":"DAPA_A_2100000281998_ART_8","display_id":"선금지급조건-제8조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"정산","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_8_P1","display_id":"선금지급조건-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"선금은 기성 또는 기납부분의 대가 지급시마다 이미 지급된 선금에서 다음의 방식에 의하여 산출한 선금정산액 이상을 정산한다. 이 경우 정산액을 산출한 결과 10원 미만의 끝수가 있을 때에는 그 끝수는 계산하지 아니한다.<img id=\"166837299\"></img>","items":[]},{"id":"DAPA_A_2100000281998_ART_8_P2","display_id":"선금지급조건-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 계약 이행기간의 종료일 이전에 제1항에 따라 선금 전액의 정산이 완료된 경우로서, 계약상대자의 신청이 있는 경우에는 선금의 정산이 완료되었음을 증명하는 서류를 발급하여야 한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_8_P3","display_id":"선금지급조건-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"납기가 수회로 나누어진 분할 납품계약에 있어서 당초 선금을 지급할 때에 계약이행기간 부족 등의 사유로 지급대상에서 제외된 납기의 물량에 대하여 계약상대자가 기성 또는 기납부분의 대가를 청구한 때에 계약담당공무원은 제1항의 정산방법에 의하지 아니하고 대가전액을 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["선금","계약의 이행","계약담당공무원","납품기한","계약상대자"]},{"id":"DAPA_A_2100000281998_ART_9","display_id":"선금지급조건-제9조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"반환청구 및 이자징수","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_9_P1","display_id":"선금지급조건-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"선금을 지급받은 후 다음 각 호의 어느 하나에 해당하는 사유로 계약담당공무원이 당해 선금잔액의 반환을 청구한 때에 계약상대자는 지체없이 이를 반환하여야 한다. 다만, 계약상대자의 귀책사유에 의하여 반환하는 경우에는 당해 선금잔액에 대한 약정이자상당액을 가산하여 반환하여야 한다.","items":[{"id":"DAPA_A_2100000281998_ART_9_P1_I1","display_id":"선금지급조건-제9조-제1항-제1호","item_number":"1","content":"계약을 해제 또는 해지하는 경우","subitems":[]},{"id":"DAPA_A_2100000281998_ART_9_P1_I2","display_id":"선금지급조건-제9조-제1항-제2호","item_number":"2","content":"선금사용계획 등 선금지급조건을 위반한 경우","subitems":[]},{"id":"DAPA_A_2100000281998_ART_9_P1_I3","display_id":"선금지급조건-제9조-제1항-제3호","item_number":"3","content":"선금사용내역 확인에 필요한 자료를 제출하지 않거나, 위ㆍ변조, 허위 서류를 제출하는 등 선금사용내역 확인에 협조하지 않는 경우","subitems":[]},{"id":"DAPA_A_2100000281998_ART_9_P1_I4","display_id":"선금지급조건-제9조-제1항-제4호","item_number":"4","content":"선금을 계약이행기간 이내에 사용하지 아니한 경우","subitems":[]},{"id":"DAPA_A_2100000281998_ART_9_P1_I5","display_id":"선금지급조건-제9조-제1항-제5호","item_number":"5","content":"정당한 사유 없이 선금 수령일로부터 15일 이내에 선금사용계획서에 따라 협력업체에게 배분하지 않은 경우","subitems":[]},{"id":"DAPA_A_2100000281998_ART_9_P1_I6","display_id":"선금지급조건-제9조-제1항-제6호","item_number":"6","content":"계약변경으로 인해 계약금액이 감액되었을 경우","subitems":[]}]},{"id":"DAPA_A_2100000281998_ART_9_P2","display_id":"선금지급조건-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따른 이자상당액의 계산방법은 매일의 선금잔액에 대한 일변계산에 의하며, 계산기간은 선금을 지급한 날부터 반환된 날까지로 하되 첫날은 산입하지 아니한다. 이때 이자율은 사유발생 시점(선금을 지급한 시점)의 금융기관 대출평균금리(한국은행 통계월보상의 대출평균금리)를 적용한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_9_P3","display_id":"선금지급조건-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 제1항에 따라 계약상대자로부터 선금을 반환받아야 할 때에 계약상대자에게 지급해야 할 기성ㆍ기납 부분의 대가 또는 납품대금(다른 계약의 이행 대가를 포함한다) 등이 있는 경우에는 반환액을 우선 상계하고 지급한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_9_P4","display_id":"선금지급조건-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약상대자가 협력업체에게 정당한 사유 없이 선금을 적정하게 배분하지 않은 경우에는 계약담당공무원이 제1항에 따라 반환 받은 선금을 협력업체에게 직접 지급할 수 있다.","items":[]},{"id":"DAPA_A_2100000281998_ART_9_P5","display_id":"선금지급조건-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"계약상대자는 제1항 제6호의 경우 계약금액이 감액되는 비율만큼 선금을 반환해야 한다. 다만, 계약상대자가 지급받은 선금이 「정부 입찰ㆍ계약집행기준」제34조 제1항에서 정하고 있는 최대 선금지급률을 초과하지 아니하였을 경우에 계약담당공무원은 변경계약에 따른 배서증권 징구 등 채권확보를 안전하게 하는 것으로 이를 갈음할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["BID_CONTRACT_EXECUTION_RULE_ART_34"],"related_regulations":["BID_CONTRACT_EXECUTION_RULE"],"external_references":[],"keywords":["선금","계약담당공무원","계약상대자","계약의 이행","계약금액"]},{"id":"DAPA_A_2100000281998_ART_10","display_id":"선금지급조건-제10조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"조건에 대한 법률적 합의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_10_P1","display_id":"선금지급조건-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원과 계약상대자 쌍방은 이 조건에 대하여 면밀히 검토하고 자의로 판단하여 법률적 효력 발생에 대하여 합의하였으므로 이에 기명 날인한다.","items":[]},{"id":"DAPA_A_2100000281998_ART_10_P2","display_id":"선금지급조건-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약상대자는 법인인감 또는 법인인감의 위임에 의한 사용 인감을 사용하여 날인하여야 한다. 단, 선금 사용내역서 등 관계서류를 전자서명으로 제출시 생략할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["법인","계약상대자","계약담당공무원"]},{"id":"DAPA_A_2100000281998_ART_11","display_id":"선금지급조건-제11조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_ART_11_P0","display_id":"선금지급조건-제11조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 예규에 대하여「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2026년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.<img id=\"166837297\"></img>","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지급조건.json","source_path":"원문/법제처API/선금지급조건.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000281998_SUPP1_ART_1","display_id":"선금지급조건-부칙1-제1조","regulation_id":"DAPA_A_2100000281998","regulation_name":"선금지급조건","short_name":"선금지급조건","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000281998_SUPP1_ART_1_P0","display_id":"선금지급조건-부칙1-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 발령한 날로부터 시행한다.","items":[]}],"notes":[],"effective_date":"2026-07-07","revision_date":"2026-07-07","source_file":"선금지