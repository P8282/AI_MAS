[{"id":"DAPA_A_2100000274604_ART_1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제1조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_1_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업청과 그 소속기관의 조직 및 정원의 운영과 관리에 관한 절차와 파트리더(Part Leader) 설치와 운영에 관한 사항을 정하는데 그 목적이 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제2조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_2_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-제2조","paragraph_number":"","paragraph_index":null,"content":"방위사업청과 그 소속기관의 조직 및 정원관리에 관한 사항과 파트리더의 설치와 운영에 관하여는 다른 법령에 별도 규정이 있는 경우를 제외하고는 이 규정에 의한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_3_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000274604_ART_3_P0_I1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조-제1호","item_number":"1","content":"\"정원\"이라 함은 조직체의 임무 또는 과업을 가장 효율적으로 수행할 수 있는 적정인력으로서, 「방위사업청과 그 소속기관 직제」(이하 \"직제\"라고 한다) 및 「방위사업청과 그 소속기관 직제 시행규칙」(이하 \"직제 시행규칙\"이라 한다)에 의한 ‘공무원정원’과 국방부의 군인정원 인가서에 의한 ‘군인정원’으로 구분한다.","subitems":[]},{"id":"DAPA_A_2100000274604_ART_3_P0_I2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조-제2호","item_number":"2","content":"\"임시조직\"이라 함은 일시적 과제ㆍ사업 등을 처리하기 위해 하부조직과 유사한 형태로 운영되는 비정규조직으로, 일시적 과제 등의 효율적 수행을 위해 필요시 법령에 직접 근거하지 않더라도 기관운영의 자율권 내에서 설치ㆍ운영하는 조직을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274604_ART_3_P0_I3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조-제3호","item_number":"3","content":"삭제","subitems":[]},{"id":"DAPA_A_2100000274604_ART_3_P0_I4","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조-제4호","item_number":"4","content":"\"부서장\"이라 함은 방위사업감독관, 기획조정관, 국제협력관, 감사관, 방위사업정책국장, 방위산업진흥국장, 국방기술개발보호국장, 대변인, 조직인사담당관, 운영지원과장, 기반전력사업본부와 미래전력사업본부의 각 부ㆍ단장, 방위사업교육원장을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274604_ART_3_P0_I5","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조-제5호","item_number":"5","content":"\"주관부서장\"이라 함은 일시적 과제ㆍ사업 등을 처리하기 위해 임시조직의 설치를 주관하는 부서장을 말한다.","subitems":[]},{"id":"DAPA_A_2100000274604_ART_3_P0_I6","display_id":"조직정원관리-및-파트리더-설치-운영규정-제3조-제6호","item_number":"6","content":"\"파트리더\"는 과ㆍ팀원으로서 소속 과ㆍ팀장의 권한의 일부를 위임받아 과ㆍ팀장을 보조하여 수행하는 자를 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_4","display_id":"조직정원관리-및-파트리더-설치-운영규정-제4조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"조직","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_4_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-제4조","paragraph_number":"","paragraph_index":null,"content":"방위사업청과 그 소속기관의 조직은 직제, 직제 시행규칙, 하부조직 편성에 관한 규정 및 기타 법령에서 정한 바에 의한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_5","display_id":"조직정원관리-및-파트리더-설치-운영규정-제5조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"정원표 및 세부편성표 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_5_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-제5조","paragraph_number":"","paragraph_index":null,"content":"방위사업청과 그 소속기관의 정원 및 세부편성표는 방위사업청장(이하 \"청장\"이라 한다)(조직인사담당관 소관)이 다음 각 호의 서식에 따라 관리한다.","items":[{"id":"DAPA_A_2100000274604_ART_5_P0_I1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제5조-제1호","item_number":"1","content":"공무원의 정원의 경우는 별지 제1호서식 ‘공무원 정원표’에 의한다.","subitems":[]},{"id":"DAPA_A_2100000274604_ART_5_P0_I2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제5조-제2호","item_number":"2","content":"군인의 정원의 경우는 별지 제2호서식 ‘군인 정원표’에 의한다.","subitems":[]},{"id":"DAPA_A_2100000274604_ART_5_P0_I3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제5조-제3호","item_number":"3","content":"정원의 세부편성은 별지 제3호서식 ‘세부편성표’에 의한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_6","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"정원조정 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_6_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"과ㆍ팀 단위 이상 보조기관 및 보좌기관의 정원조정은 청장(조직인사담당관 소관)이 정한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_6_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에도 불구하고 통합사업관리팀의 효율적 운영을 위하여 기반전력사업본부, 미래전력사업본부 내 팀간 정원조정은 기반전력사업본부장, 미래전력사업본부장이 조직인사담당관과 협의하여 조정할 수 있다. 다만, 신규 통합사업관리팀의 설치는 조직인사담당관과 사전협의 후 청장의 승인을 받아 그 결과를 조직인사담당관에게 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_6_P3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"조직인사담당관은 부서별 정원 변동사항에 대하여는 정원표를 수정하여 관련부서에 통보하고, 직제, 직제 시행규칙 및 하부조직 편성에 관한 규정의 개정이 필요한 사항에 대하여는 청장의 승인을 얻은 후 개정에 필요한 업무를 수행한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_6_P4","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"운영지원과 등 관련부서가 조직인사담당관으로부터 정원 변동사항을 통보받은 경우에는 그에 따라 예산 등의 필요한 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_6_2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조의2","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"6의2","article_label":"제6조의2","article_title":"공통정원 보임 운영 기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_6_2_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"별지 제2호서식 세부편성표 상의 군인의 공통정원은 군을 달리하여 1/3씩 보임하여야 한다. 다만, 소수점 이하를 절상한 인원과 군별 비율의 차이로 초과되는 인원에 대하여는 특정 군에 추가 보임할 수 있다.","items":[]},{"id":"DAPA_A_2100000274604_ART_6_2_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제6조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 세부편성표 상의 공통정원에 대한 보임 운영 기준은 청 본부는 국ㆍ부 단위로 하며 기반전력사업본부 및 미래전력사업본부는 팀 단위로 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_7","display_id":"조직정원관리-및-파트리더-설치-운영규정-제7조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"사무분장의 조정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_7_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"국ㆍ부 단위 내 과ㆍ팀간 사무분장의 조정은 부서장이 정한 후 조직인사담당관에게 통보하여야 한다. 다만, 직제 및 직제 시행규칙에 명시된 국ㆍ부 및 과ㆍ팀의 사무분장의 변경이 필요한 경우 조직인사담당관에게 그 개정소요를 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_7_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"과ㆍ팀원에 대한 사무분장의 조정은 과ㆍ팀장이 정한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_7_P3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"직제 시행규칙 제22조에 따른 팀별 주관사업은 소속기관 각 부서장이 정한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_7_2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제7조의2","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"7의2","article_label":"제7조의2","article_title":"과ㆍ팀원의 직책명 부여","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_7_2_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제7조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"과ㆍ팀원에 대한 직책명은 과ㆍ팀장이 정하되, 세부편성표 상의 직책명을 변경하고자 하는 경우에는 과ㆍ팀장이 조직인사담당관과 사전 협의 후 변경하며, 그 결과를 조직인사담당관에게 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_7_2_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제7조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 통보된 내용에 대하여 조직인사담당관은 군인에 대하여 인사명령 및 세부편성표 관리와 관련한 제반사항을 조치하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_8","display_id":"조직정원관리-및-파트리더-설치-운영규정-제8조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"소요정원 요구","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_8_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"부서장은 소요정원을 「행정기관의 조직과 정원에 관한 통칙」(이하 \"통칙\"이라고 한다.) 제8조제2항에 따라 기구와 정원을 조정할 필요가 있을 때에는 소요정원 안을 작성하여 조직인사담당관에게 제출하여야 한다. 다만, 통칙 제8조제4항에 따라 긴급히 기구와 정원을 조정할 필요가 있을 때에는 부서장이 조직인사담당관과 사전 협조한 후 청장의 승인을 얻고 이를 조직인사담당관에게 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_8_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"부서장이 조직 또는 정원의 조정이 필요하다고 판단한 때에는 다음 각 호의 서류를 조직인사담당관에게 제출하여야 한다.","items":[{"id":"DAPA_A_2100000274604_ART_8_P2_I1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제8조-제2항-제1호","item_number":"1","content":"직제 등의 안","subitems":[]},{"id":"DAPA_A_2100000274604_ART_8_P2_I2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제8조-제2항-제2호","item_number":"2","content":"기구의 개편 또는 정원의 조정을 필요로 하는 사유와 그 배경 설명서","subitems":[]},{"id":"DAPA_A_2100000274604_ART_8_P2_I3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제8조-제2항-제3호","item_number":"3","content":"소요정원 설명서(공무원과 현역군인 구분작성)","subitems":[]}]},{"id":"DAPA_A_2100000274604_ART_8_P3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"조직인사담당관은 제1항 본문에 의하여 제출된 각 부서별 소요정원을 검토하여 청장에게 보고한 후 자체 정원조정사항은 반영하고 공무원 소요정원에 대하여는 행정안전부에 통보한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["행정기관의 조직과 정원에 관한 통칙"],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_9","display_id":"조직정원관리-및-파트리더-설치-운영규정-제9조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제2장 조직 및 정원관리","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"중기인력운영계획 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_9_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청 중기인력운영계획 수립은 통칙 제8조제1항에서 정한 지침에 따라 작성하며, 부서장은 자체 중기인력운영계획 (F+1년～F+5 년)을 조직인사담당관에게 제출한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_9_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"조직인사담당관은 각 부서ㆍ기관별 중기인력운영계획을 종합하여 청 중기인력운영계획을 수립한 후 행정안전부에 통보한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274604_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_10","display_id":"조직정원관리-및-파트리더-설치-운영규정-제10조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제3장 임시조직의 설치","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"승인권한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_10_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"부서장은 한시적으로 발생하는 행정수요에 대처하기 위하여 필요하거나 기존의 보조기관 등으로는 그 목적을 달성하기 곤란한 중요한 업무가 발생한 때에 한하여 조직인사담당관과 협조한 후 청장의 승인을 받아 임시조직을 설치ㆍ운영할 수 있다.","items":[]},{"id":"DAPA_A_2100000274604_ART_10_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에도 불구하고 청 본부 부서 또는 소속기관의 정원범위 내에서 그 존속기간을 1년 이내로 하는 임시조직의 설치는 부서장이 설치ㆍ운영할 수 있고 이 경우에 조직인사담당관에게 설치결과를 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_11","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제3장 임시조직의 설치","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"설치절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_11_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제10조제1항에 의하여 임시조직을 설치하고자 하는 주관부서장은 다음 각 호의 사항을 포함한 임시조직 설치(안)을 조직인사담당관 및 관계부서장의 사전 검토 및 협조를 받은 후 청장의 임시조직 설치계획에 대한 승인을 얻어 그 결과를 조직인사담당관에게 통보한다.","items":[{"id":"DAPA_A_2100000274604_ART_11_P1_I1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제1항-제1호","item_number":"1","content":"목 적(필요성)","subitems":[]},{"id":"DAPA_A_2100000274604_ART_11_P1_I2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제1항-제2호","item_number":"2","content":"임무ㆍ기능","subitems":[]},{"id":"DAPA_A_2100000274604_ART_11_P1_I3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제1항-제3호","item_number":"3","content":"편성방안(기구도, 정원해결방안, 지휘관계 등)","subitems":[]},{"id":"DAPA_A_2100000274604_ART_11_P1_I4","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제1항-제4호","item_number":"4","content":"존속기간 및 기대효과 등","subitems":[]},{"id":"DAPA_A_2100000274604_ART_11_P1_I5","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제1항-제5호","item_number":"5","content":"삭제","subitems":[]}]},{"id":"DAPA_A_2100000274604_ART_11_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"조직인사담당관은 임시조직의 설치를 위한 승인결과를 주관부서장, 운영지원과장 및 관계부서장에게 통보하며, 임시조직의 폐지 시까지 별지 제4호서식 ‘임시조직 관리카드’에 의거 관리하여야 한다. 제10조제2항에 의하여 통보를 받은 경우에도 별지 제4호서식에 의거 관리하여야 한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_11_P3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제10조에 의하여 임시조직을 설치하고자 하는 주관부서장은 임시조직에 대한 인사 소요를 조직인사담당관과, 예산ㆍ사무공간 등의 소요를 운영지원과장 등 관계부서장과 사전 협조하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274604_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_12","display_id":"조직정원관리-및-파트리더-설치-운영규정-제12조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제3장 임시조직의 설치","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"변경사항 통보","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_12_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-제12조","paragraph_number":"","paragraph_index":null,"content":"임시조직을 설치ㆍ운영하는 부서장은 임시조직의 구성원, 기능 등 별지 제4호서식의 변경이 있는 때에는, 그 변경사항을 조직인사담당관에 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_13","display_id":"조직정원관리-및-파트리더-설치-운영규정-제13조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제3장 임시조직의 설치","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"존속기간 및 연장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_13_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"임시조직의 존속기간은 3년 이내로 하여야 한다. 다만, 최초 설치목적에 중대한 변화가 있다고 인정되어 존속기간 연장이 필요할 경우 만료 2개월 전까지 조직인사담당관의 협조를 거쳐 승인권자에게 사전승인을 얻어야 하며, 총 2년의 기간 내에서 1회에 한하여 연장할 수 있다.","items":[]},{"id":"DAPA_A_2100000274604_ART_13_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"승인된 임시조직은 존속기간 만료와 동시에 해체된다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_14","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제4장 파트리더의 설치","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"설치 원칙","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_14_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"파트리더는 다음 각 호의 1에 해당하는 경우 설치할 수 있다.","items":[{"id":"DAPA_A_2100000274604_ART_14_P1_I1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제1항-제1호","item_number":"1","content":"다수의 사업 또는 업무분야 통합으로 효율적 수행이나 조직관리를 위해 필요한 경우","subitems":[]},{"id":"DAPA_A_2100000274604_ART_14_P1_I2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제1항-제2호","item_number":"2","content":"팀내 업무량ㆍ팀원의 과다로 업무의 효율화를 위해 필요한 경우","subitems":[]},{"id":"DAPA_A_2100000274604_ART_14_P1_I3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제1항-제3호","item_number":"3","content":"과ㆍ팀내 이질적인 기능이 혼합되어 팀장의 통합관리가 어려운 경우","subitems":[]}]},{"id":"DAPA_A_2100000274604_ART_14_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제14조제1항의 각호에 해당하는 과ㆍ팀의 소관 국ㆍ부장(운영지원과장을 포함한다. 이하 같다)은 별지 제5호서식 ‘파트리더(PL) 관리카드’를 작성하여 조직인사담당관에게 파트리더 설치를 요청할 수 있으며, 조직인사담당관은 직제 시행규칙에 따른 정원표를 고려하여 청장의 승인을 받아 파트리더를 설치할 수 있다.","items":[]},{"id":"DAPA_A_2100000274604_ART_14_P3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제3항","paragraph_number":"③","paragraph_index":3,"content":"파트리더에 속하는 과ㆍ팀원의 범위는 과ㆍ팀장이 파트리더와 협의하여 정한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_14_P4","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제4항","paragraph_number":"④","paragraph_index":4,"content":"파트리더를 설치ㆍ운영하는 과ㆍ팀장은 제1항각호의 사유가 존재하지 않는 등의 사유로 해당 파트리더 폐지가 필요하다고 판단한 경우 조직인사담당관에게 파트리더 폐지를 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000274604_ART_14_P5","display_id":"조직정원관리-및-파트리더-설치-운영규정-제14조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"조직인사담당관은 제1항각호의 사유가 존재하지 않는 등의 사유 또는 제4항의 요청에 따라 파트리더를 유지할 필요가 없는 경우에는 해당 파트리더를 폐지할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_15","display_id":"조직정원관리-및-파트리더-설치-운영규정-제15조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제4장 파트리더의 설치","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"운영 방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_15_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"파트리더를 설치ㆍ운영할 경우 과ㆍ팀장하에 \"과ㆍ팀원을 보유한 파트리더\"와 \"개별 과ㆍ팀원\"으로 구성 하되, 과ㆍ팀별 업무 성격에 맞게 소관 국ㆍ부에서 자율적으로 정한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_15_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"파트리더를 설치ㆍ운영하는 과ㆍ팀장은 파트리더 폐지 시까지 별지 제5호서식에 의거 관리하여야 한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_15_P3","display_id":"조직정원관리-및-파트리더-설치-운영규정-제15조-제3항","paragraph_number":"③","paragraph_index":3,"content":"주관부서장은 별지 제5호서식의 변경이 있는 때, 그 변경사항을 조직인사담당관에 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_16","display_id":"조직정원관리-및-파트리더-설치-운영규정-제16조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제4장 파트리더의 설치","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"보직기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_16_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-제16조","paragraph_number":"","paragraph_index":null,"content":"파트리더는 서기관, 사무관, 수석전문관, 전문관 또는 영관급장교로 보임할 수 있다","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_ART_17","display_id":"조직정원관리-및-파트리더-설치-운영규정-제17조","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"제4장 파트리더의 설치","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"소관업무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_ART_17_P1","display_id":"조직정원관리-및-파트리더-설치-운영규정-제17조-제1항","paragraph_number":"①","paragraph_index":1,"content":"파트리더의 소관업무 범위는 「방위사업청과 그 소속기관 위임전결 규정」에 따르되, 세부적 사항은 소속 국ㆍ부장 주관으로 과ㆍ팀장 및 파트리더와 협의하여 업무의 성질과 종류에 따라 정한다.","items":[]},{"id":"DAPA_A_2100000274604_ART_17_P2","display_id":"조직정원관리-및-파트리더-설치-운영규정-제17조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따른 소관업무 범위 확정시 구체적인 업무명, 업무내용, 파트원 등을 명기하여 문서화한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"조직·정원관리 및 파트리더 설치 운영규정.json","source_path":"원문/법제처API/조직·정원관리 및 파트리더 설치 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274604_SUPP1_PRE","display_id":"조직정원관리-및-파트리더-설치-운영규정-부칙1","regulation_id":"DAPA_A_2100000274604","regulation_name":"조직·정원관리 및 파트리더 설치 운영규정","short_name":"조직·정원관리 및 파트리더 설치 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274604_SUPP1_PRE_P0","display_id":"조직정원관리-및-파트리더-설치-운영규정-부칙1","paragraph_number":"","paragraph_index":null,"content":"이 규정은 발령한 날부터 시행한다.","it