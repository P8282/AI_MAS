[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_1","display_id":"혁신제품-지원센터-지정-운영-고시-제1조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_1_P0","display_id":"혁신제품-지원센터-지정-운영-고시-제1조","paragraph_number":"","paragraph_index":null,"content":"이 고시는 「조달사업에 관한 법률」(이하 ‘법’이라 한다) 제27조의2, 같은 법 시행령(이하 ‘영’이라 한다) 제33조의2에서 조달청장에게 위임된 사항과 혁신제품 지원센터(이하 ‘지원센터’라 한다) 지정ㆍ운영 등에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제1조(목적) 이 고시는 「조달사업에 관한 법률」(이하 ‘법’이라 한다) 제27조의2, 같은 법 시행령(이하 ‘영’이라 한다) 제33조의2에서 조달청장에게 위임된 사항과 혁신제품 지원센터(이하 ‘지원센터’라 한다) 지정ㆍ운영 등에 필요한 사항을 규정함을 목적으로 한다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PROCUREMENT_BUSINESS_ACT_ART_27_2"],"related_regulations":["PROCUREMENT_BUSINESS_ACT"],"external_references":[],"keywords":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_2","display_id":"혁신제품-지원센터-지정-운영-고시-제2조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"지원센터 업무범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_2_P0","display_id":"혁신제품-지원센터-지정-운영-고시-제2조","paragraph_number":"","paragraph_index":null,"content":"지원센터의 업무범위는 법 제27조의2제1항 각 호에 따른다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제2조(지원센터 업무범위) 지원센터의 업무범위는 법 제27조의2제1항 각 호에 따른다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PROCUREMENT_BUSINESS_ACT_ART_27_2"],"related_regulations":["PROCUREMENT_BUSINESS_ACT"],"external_references":[],"keywords":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_3","display_id":"혁신제품-지원센터-지정-운영-고시-제3조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"지정기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_3_P0","display_id":"혁신제품-지원센터-지정-운영-고시-제3조","paragraph_number":"","paragraph_index":null,"content":"영 제33조의2제1항에서 정한 지원센터 지정기준 외에 영 제33조의2제8항에 따라 조달청장이 정하는 지원센터의 지정 기준은 다음 각 호와 같다.","items":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_3_P0_I1","display_id":"혁신제품-지원센터-지정-운영-고시-제3조-제1호","item_number":"1","content":"지원센터 지정 신청일 기준 2억 원 이상 자산을 갖추고 있을 것","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_3_P0_I2","display_id":"혁신제품-지원센터-지정-운영-고시-제3조-제2호","item_number":"2","content":"영 제33조의2제1항제3호에 따른 전담인력 중 석사학위 이상 또는 「국가기술자격법」에 따른 기사 이상을 취득한 전문 인력 10명 이상을 보유하고 있을 것","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_3_P0_I3","display_id":"혁신제품-지원센터-지정-운영-고시-제3조-제3호","item_number":"3","content":"최근 3년간 수행 완료한 공공조달분야 연구ㆍ위탁 용역 합산 실적금액 10억 원 이상일 것","subitems":[]}]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제3조(지정기준) 영 제33조의2제1항에서 정한 지원센터 지정기준 외에 영 제33조의2제8항에 따라 조달청장이 정하는 지원센터의 지정 기준은 다음 각 호와 같다.1. 지원센터 지정 신청일 기준 2억 원 이상 자산을 갖추고 있을 것2. 영 제33조의2제1항제3호에 따른 전담인력 중 석사학위 이상 또는 「국가기술자격법」에 따른 기사 이상을 취득한 전문 인력 10명 이상을 보유하고 있을 것3. 최근 3년간 수행 완료한 공공조달분야 연구ㆍ위탁 용역 합산 실적금액 10억 원 이상일 것","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_4","display_id":"혁신제품-지원센터-지정-운영-고시-제4조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"지정계획 공고 및 지정 신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_4_P1","display_id":"혁신제품-지원센터-지정-운영-고시-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"조달청장은 지원센터를 지정하고자 하는 경우 그 계획을 60일 이상 공고하여야 한다. 다만, 공고 후 지원센터를 지정하지 못해 재공고하거나, 사업목적을 달성하기 위하여 긴급한 필요가 있는 경우에는 30일 이상으로 단축하여 공고할 수 있다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_4_P2","display_id":"혁신제품-지원센터-지정-운영-고시-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"지원센터로 지정을 받으려는 자는 「조달사업에 관한 법률 시행규칙」(이하 ‘규칙’이라 한다) 제11조의2제1항에 따른 지원센터 지정신청서 및 첨부서류를 제1항의 공고에서 정한 바에 따라 조달청장에게 제출해야 한다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제4조(지정계획 공고 및 지정 신청) ① 조달청장은 지원센터를 지정하고자 하는 경우 그 계획을 60일 이상 공고하여야 한다. 다만, 공고 후 지원센터를 지정하지 못해 재공고하거나, 사업목적을 달성하기 위하여 긴급한 필요가 있는 경우에는 30일 이상으로 단축하여 공고할 수 있다.② 지원센터로 지정을 받으려는 자는 「조달사업에 관한 법률 시행규칙」(이하 ‘규칙’이라 한다) 제11조의2제1항에 따른 지원센터 지정신청서 및 첨부서류를 제1항의 공고에서 정한 바에 따라 조달청장에게 제출해야 한다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PROCUREMENT_BUSINESS_RULE_ART_11_2"],"related_regulations":["PROCUREMENT_BUSINESS_RULE"],"external_references":[],"keywords":["조달청장"]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_5","display_id":"혁신제품-지원센터-지정-운영-고시-제5조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"사실확인 및 적합평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_5_P1","display_id":"혁신제품-지원센터-지정-운영-고시-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"조달청장은 제4조에 따른 지정신청에 대해 지원센터 지정기준 충족 여부 및 제출서류 기재사항의 사실 여부를 확인하고, 지원센터 지정기준을 충족하는 신청자에 대해 혁신제품 공공구매 지원 업무 수행에 적합한지를 평가(이하 ‘평가’라 한다)하여야 한다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_5_P2","display_id":"혁신제품-지원센터-지정-운영-고시-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"조달청장은 제1항에 따른 확인 및 평가를 위하여 5인 이상으로 구성된 지정평가반을 구성하여 운영할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제5조(사실확인 및 적합평가) ① 조달청장은 제4조에 따른 지정신청에 대해 지원센터 지정기준 충족 여부 및 제출서류 기재사항의 사실 여부를 확인하고, 지원센터 지정기준을 충족하는 신청자에 대해 혁신제품 공공구매 지원 업무 수행에 적합한지를 평가(이하 ‘평가’라 한다)하여야 한다.② 조달청장은 제1항에 따른 확인 및 평가를 위하여 5인 이상으로 구성된 지정평가반을 구성하여 운영할 수 있다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_4"],"related_regulations":[],"external_references":[],"keywords":["조달청장"]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6","display_id":"혁신제품-지원센터-지정-운영-고시-제6조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"지원센터 지정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P1","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"조달청장은 제5조에 따른 평가에서 적합 판정을 받은 자를 대상으로「조달청 계약심사협의회 운영규정」에 따른 계약심사협의회 심의를 통해 혁신제품 공공구매 지원 업무 수행에 가장 적합한 지원센터 지정 신청자(이하 이 조에서 ‘위원회 심의 대상자’라 한다)를 결정하여야 한다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P2","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"조달청장은 제1항에 따라 결정된 위원회 심의 대상자의 적정성을 심의하기 위하여 법 제5조에 따른 조달정책심의위원회 또는 영 제7조제2항제1호에 따른 공공수요발굴위원회에 상정하여야 한다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P3","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"조달청장은 제2항에 따른 조달정책심의위원회 또는 공공수요발굴위원회 심의에서 위원회 심의 대상자가 적정한 자로 결정된 경우에는 지원센터로 지정하고 규칙 제11의2제3항 따른 지원센터 지정서를 발급한다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P4","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"조달청장은 지원센터를 지정한 경우 다음 각 호의 사항을 조달청 홈페이지에 공고하여야 한다.","items":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P4_I1","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제4항-제1호","item_number":"1","content":"지원센터의 명칭","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P4_I2","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제4항-제2호","item_number":"2","content":"지원센터의 소재지","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P4_I3","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제4항-제3호","item_number":"3","content":"지원센터 지정일, 지정기간","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P4_I4","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제4항-제4호","item_number":"4","content":"지원센터의 업무범위 등","subitems":[]}]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_6_P5","display_id":"혁신제품-지원센터-지정-운영-고시-제6조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"조달청장은 규칙 제11조의3에 따른 지원센터 지정 변경 신청이 있는 경우 그 내용을 확인하여 지원센터 지정서를 재발급해야 한다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제6조(지원센터 지정) ① 조달청장은 제5조에 따른 평가에서 적합 판정을 받은 자를 대상으로「조달청 계약심사협의회 운영규정」에 따른 계약심사협의회 심의를 통해 혁신제품 공공구매 지원 업무 수행에 가장 적합한 지원센터 지정 신청자(이하 이 조에서 ‘위원회 심의 대상자’라 한다)를 결정하여야 한다.② 조달청장은 제1항에 따라 결정된 위원회 심의 대상자의 적정성을 심의하기 위하여 법 제5조에 따른 조달정책심의위원회 또는 영 제7조제2항제1호에 따른 공공수요발굴위원회에 상정하여야 한다.③ 조달청장은 제2항에 따른 조달정책심의위원회 또는 공공수요발굴위원회 심의에서 위원회 심의 대상자가 적정한 자로 결정된 경우에는 지원센터로 지정하고 규칙 제11의2제3항 따른 지원센터 지정서를 발급한다.④ 조달청장은 지원센터를 지정한 경우 다음 각 호의 사항을 조달청 홈페이지에 공고하여야 한다.1. 지원센터의 명칭2. 지원센터의 소재지3. 지원센터 지정일, 지정기간4. 지원센터의 업무범위 등⑤ 조달청장은 규칙 제11조의3에 따른 지원센터 지정 변경 신청이 있는 경우 그 내용을 확인하여 지원센터 지정서를 재발급해야 한다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_5","PROCUREMENT_BUSINESS_ACT_ART_5","PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7","PROCUREMENT_BUSINESS_RULE_ART_11_3"],"related_regulations":["PROCUREMENT_BUSINESS_ACT","PROCUREMENT_BUSINESS_RULE"],"external_references":[],"keywords":["조달청장"]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7","display_id":"혁신제품-지원센터-지정-운영-고시-제7조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"사업위탁 및 계약","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P1","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"조달청장은 지원센터에 제2조 업무의 전부 또는 일부를 3년 이내의 단위로 위탁할 수 있다. 이 경우 매년 사업이 시작되기 전에 사업범위 및 사업예산 등 사업계획을 지원센터에 통지하여야 한다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P2","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"지원센터는 제1항의 통지를 받은 날로부터 30일 이내에 다음 각 호의 내용이 포함된 사업계획서를 조달청장에게 제출하여야 한다.","items":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P2_I1","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제2항-제1호","item_number":"1","content":"조직 및 사업관리 계획","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P2_I2","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제2항-제2호","item_number":"2","content":"관련 조직운영 및 분야별 인력투입계획","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P2_I3","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제2항-제3호","item_number":"3","content":"계약관리 방안","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P2_I4","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제2항-제4호","item_number":"4","content":"품질보증계획 및 활동","subitems":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P2_I5","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제2항-제5호","item_number":"5","content":"사업추진일정","subitems":[]}]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P3","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"조달청장은 제2항에 따라 제출된 사업계획서를 검토하여 사업 수행에 지장이 없다고 판단되는 경우 지원센터에 사업을 위탁할 수 있다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P4","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항에 따라 사업을 위탁받은 지원센터가 위탁받은 업무의 일부를 제3자에게 재위탁하고자 하는 경우에는 조달청장의 사전 승인을 받아야 한다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_7_P5","display_id":"혁신제품-지원센터-지정-운영-고시-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"조달청장은 제3항에 따라 지원센터에 사업을 위탁하는 경우 「국가를 당사자로 하는 계약에 관한 법률」 제7조제1항 단서 및 같은 법 시행령 제26조제1항제5호마목에 따라 계약을 체결한다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제7조(사업위탁 및 계약) ① 조달청장은 지원센터에 제2조 업무의 전부 또는 일부를 3년 이내의 단위로 위탁할 수 있다. 이 경우 매년 사업이 시작되기 전에 사업범위 및 사업예산 등 사업계획을 지원센터에 통지하여야 한다.② 지원센터는 제1항의 통지를 받은 날로부터 30일 이내에 다음 각 호의 내용이 포함된 사업계획서를 조달청장에게 제출하여야 한다.1. 조직 및 사업관리 계획2. 관련 조직운영 및 분야별 인력투입계획3. 계약관리 방안4. 품질보증계획 및 활동5. 사업추진일정③ 조달청장은 제2항에 따라 제출된 사업계획서를 검토하여 사업 수행에 지장이 없다고 판단되는 경우 지원센터에 사업을 위탁할 수 있다.④ 제3항에 따라 사업을 위탁받은 지원센터가 위탁받은 업무의 일부를 제3자에게 재위탁하고자 하는 경우에는 조달청장의 사전 승인을 받아야 한다.⑤ 조달청장은 제3항에 따라 지원센터에 사업을 위탁하는 경우 「국가를 당사자로 하는 계약에 관한 법률」 제7조제1항 단서 및 같은 법 시행령 제26조제1항제5호마목에 따라 계약을 체결한다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_2","STATE_CONTRACT_ACT_ART_7"],"related_regulations":["STATE_CONTRACT_ACT"],"external_references":[],"keywords":["조달청장"]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_8","display_id":"혁신제품-지원센터-지정-운영-고시-제8조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"감독ㆍ보고 및 지원센터 의무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_8_P1","display_id":"혁신제품-지원센터-지정-운영-고시-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"조달청장은 지원센터에 대하여 위탁업무 수행과 관련하여 감독상 필요한 명령을 할 수 있다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_8_P2","display_id":"혁신제품-지원센터-지정-운영-고시-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"조달청장은 매년 계약을 체결하기 전이나 그 밖에 필요한 경우에 지원센터가 영 제33조의2제1항 각 호 및 제3조제2호에서 정한 지정기준을 충족하고 있는지를 확인할 수 있다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_8_P3","display_id":"혁신제품-지원센터-지정-운영-고시-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"지원센터는 위탁업무 수행과 관련하여 매년 해당 연도의 사업이 끝난 후 2개월 이내에 해당 연도 사업추진실적, 예산집행실적 및 다음 연도의 사업계획 등을 조달청장에게 제출하여야 한다.","items":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_8_P4","display_id":"혁신제품-지원센터-지정-운영-고시-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"지원센터는 혁신제품 공공구매지원 업무와 관련하여 수요기관 및 조달업체 등을 대상으로 더 나은 서비스 제공을 위해 지속적인 노력을 하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제8조(감독ㆍ보고 및 지원센터 의무) ① 조달청장은 지원센터에 대하여 위탁업무 수행과 관련하여 감독상 필요한 명령을 할 수 있다.② 조달청장은 매년 계약을 체결하기 전이나 그 밖에 필요한 경우에 지원센터가 영 제33조의2제1항 각 호 및 제3조제2호에서 정한 지정기준을 충족하고 있는지를 확인할 수 있다.③ 지원센터는 위탁업무 수행과 관련하여 매년 해당 연도의 사업이 끝난 후 2개월 이내에 해당 연도 사업추진실적, 예산집행실적 및 다음 연도의 사업계획 등을 조달청장에게 제출하여야 한다.④ 지원센터는 혁신제품 공공구매지원 업무와 관련하여 수요기관 및 조달업체 등을 대상으로 더 나은 서비스 제공을 위해 지속적인 노력을 하여야 한다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_3"],"related_regulations":[],"external_references":[],"keywords":["감독","조달청장"]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_9","display_id":"혁신제품-지원센터-지정-운영-고시-제9조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"지정 취소 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_9_P0","display_id":"혁신제품-지원센터-지정-운영-고시-제9조","paragraph_number":"","paragraph_index":null,"content":"조달청장은 법 제27조의2제3항 각 호의 어느 하나에 해당하는 경우에는 영 제33조의2제6항 [별표1]에 따라 그 지정을 취소하거나 업무의 정지를 명할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제9조(지정 취소 등) 조달청장은 법 제27조의2제3항 각 호의 어느 하나에 해당하는 경우에는 영 제33조의2제6항 [별표1]에 따라 그 지정을 취소하거나 업무의 정지를 명할 수 있다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":["PROCUREMENT_BUSINESS_ACT_ART_27_2"],"related_regulations":["PROCUREMENT_BUSINESS_ACT"],"external_references":[],"keywords":[]},{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_10","display_id":"혁신제품-지원센터-지정-운영-고시-제10조","regulation_id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE","regulation_name":"혁신제품 지원센터 지정·운영에 관한 고시","short_name":"혁신제품 지원센터 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"비밀준수의무 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE_ART_10_P0","display_id":"혁신제품-지원센터-지정-운영-고시-제10조","paragraph_number":"","paragraph_index":null,"content":"지원센터는 조달청장으로부터 위탁받은 혁신제품 공공구매지원 업무를 수행하면서 알게 된 비밀을 누설하거나 도용해서는 아니 되며, 사업 범위를 넘어 개인정보를 이용하거나 이를 제3자에게 제공 또는 누설하여서는 아니 된다.","items":[]}],"notes":[],"effective_date":"2024-07-04","revision_date":"2024-07-04","source_file":"PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","source_path":"원문/법제처API/PPS_INNOVATION_PRODUCT_SUPPORT_CENTER_NOTICE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제10조(비밀준수의무 등) 지원센터는 조달청장으로부터 위탁받은 혁신제품 공공구매지원 업무를 수행하면서 알게 된 비밀을 누설하거나 도용해서는 아니 되며, 사업 범위를 넘어 개인정보를 이용하거나 이를 제3자에게 제공 또는 누설하여서는 아니 된다.","source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000243896","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"PPS_INNOVATION_