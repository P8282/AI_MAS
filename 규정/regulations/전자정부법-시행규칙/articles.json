[{"id":"EGOVERNMENT_RULE_ART_1","display_id":"전자정부법-시행규칙-제1조","regulation_id":"EGOVERNMENT_RULE","regulation_name":"전자정부법 시행규칙","short_name":"전자정부법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"EGOVERNMENT_RULE_ART_1_P0","display_id":"전자정부법-시행규칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규칙은 「전자정부법」 및 같은 법 시행령에서 위임된 사항과 그 시행에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2025-12-31","revision_date":"2025-12-31","source_file":"EGOVERNMENT_RULE.json","source_path":"원문/법제처API/EGOVERNMENT_RULE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제1조(목적) 이 규칙은 「전자정부법」 및 같은 법 시행령에서 위임된 사항과 그 시행에 필요한 사항을 규정함을 목적으로 한다.","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=282543","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"EGOVERNMENT_RULE_ART_2","display_id":"전자정부법-시행규칙-제2조","regulation_id":"EGOVERNMENT_RULE","regulation_name":"전자정부법 시행규칙","short_name":"전자정부법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정보주체 본인에 관한 행정정보의 제공 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"EGOVERNMENT_RULE_ART_2_P0","display_id":"전자정부법-시행규칙-제2조","paragraph_number":"","paragraph_index":null,"content":"「전자정부법 시행령」(이하 \"영\"이라 한다) 제51조의2제2항제3호에서 \"행정안전부령으로 정하는 자\"란 다음 각 호의 자를 말한다. <개정 2025.12.31>","items":[{"id":"EGOVERNMENT_RULE_ART_2_P0_I1","display_id":"전자정부법-시행규칙-제2조-제1호","item_number":"1","content":"「의료법」 제3조에 따른 의료기관","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_2_P0_I2","display_id":"전자정부법-시행규칙-제2조-제2호","item_number":"2","content":"「전기통신사업법」 제2조제8호에 따른 전기통신사업자","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_2_P0_I3","display_id":"전자정부법-시행규칙-제2조-제3호","item_number":"3","content":"「관세법」 제116조제1항제5호라목에 해당하는 기관 또는 법인ㆍ단체","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_2_P0_I4","display_id":"전자정부법-시행규칙-제2조-제4호","item_number":"4","content":"「관세사법」 제17조의2에 따라 등록한 관세법인 또는 같은 법 제19조에 따라 등록한 통관취급법인등","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_2_P0_I5","display_id":"전자정부법-시행규칙-제2조-제5호","item_number":"5","content":"「세무사법」 제16조의4에 따라 등록한 세무법인","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_2_P0_I6","display_id":"전자정부법-시행규칙-제2조-제6호","item_number":"6","content":"「에너지이용 합리화법」 제25조에 따라 등록한 에너지절약전문기업 또는 같은 법 제32조에 따라 지정된 에너지진단전문기관","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_2_P0_I7","display_id":"전자정부법-시행규칙-제2조-제7호","item_number":"7","content":"「항공사업법」 제2조제10호에 따른 국내항공운송사업자 또는 같은 조 제12호에 따른 국제항공운송사업자","subitems":[]}]}],"notes":[],"effective_date":"2025-12-31","revision_date":"2025-12-31","source_file":"EGOVERNMENT_RULE.json","source_path":"원문/법제처API/EGOVERNMENT_RULE.json","pdf_path":"","source_page":"","amendments":["<개정 2025.12.31>"],"last_amended":"2025-12-31","api_text":"제2조(정보주체 본인에 관한 행정정보의 제공 등) 「전자정부법 시행령」(이하 \"영\"이라 한다) 제51조의2제2항제3호에서 \"행정안전부령으로 정하는 자\"란 다음 각 호의 자를 말한다. <개정 2025.12.31>\n1. 「의료법」 제3조에 따른 의료기관\n2. 「전기통신사업법」 제2조제8호에 따른 전기통신사업자\n3. 「관세법」 제116조제1항제5호라목에 해당하는 기관 또는 법인ㆍ단체\n4. 「관세사법」 제17조의2에 따라 등록한 관세법인 또는 같은 법 제19조에 따라 등록한 통관취급법인등\n5. 「세무사법」 제16조의4에 따라 등록한 세무법인\n6. 「에너지이용 합리화법」 제25조에 따라 등록한 에너지절약전문기업 또는 같은 법 제32조에 따라 지정된 에너지진단전문기관\n7. 「항공사업법」 제2조제10호에 따른 국내항공운송사업자 또는 같은 조 제12호에 따른 국제항공운송사업자","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=282543","api_received":"2026-10-14","related_articles":["EGOVERNMENT_ENFORCEMENT_ART_51_2"],"related_regulations":["EGOVERNMENT_ENFORCEMENT"],"external_references":["의료법","전기통신사업법","관세법","관세사법","세무사법","에너지이용 합리화법","항공사업법"],"keywords":[]},{"id":"EGOVERNMENT_RULE_ART_3","display_id":"전자정부법-시행규칙-제3조","regulation_id":"EGOVERNMENT_RULE","regulation_name":"전자정부법 시행규칙","short_name":"전자정부법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"본인정보제공 심의위원회","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"EGOVERNMENT_RULE_ART_3_P1","display_id":"전자정부법-시행규칙-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"다음 각 호의 사항을 심의하기 위하여 행정안전부장관 소속으로 본인정보제공 심의위원회(이하 \"심의위원회\"라 한다)를 둔다.","items":[{"id":"EGOVERNMENT_RULE_ART_3_P1_I1","display_id":"전자정부법-시행규칙-제3조-제1항-제1호","item_number":"1","content":"「전자정부법」 제43조의2제1항에 따른 제3자의 범위에 관한 사항","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_3_P1_I2","display_id":"전자정부법-시행규칙-제3조-제1항-제2호","item_number":"2","content":"영 제51조의2제8항에 따른 본인정보의 종류에 관한 사항","subitems":[]},{"id":"EGOVERNMENT_RULE_ART_3_P1_I3","display_id":"전자정부법-시행규칙-제3조-제1항-제3호","item_number":"3","content":"그 밖에 행정안전부장관 또는 심의위원회의 위원장이 본인정보의 제공 요구에 관하여 심의가 필요하다고 인정하는 사항","subitems":[]}]},{"id":"EGOVERNMENT_RULE_ART_3_P2","display_id":"전자정부법-시행규칙-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심의위원회는 위원장 1명을 포함하여 10명 이내의 위원으로 구성하고, 위원장은 위원 중에서 행정안전부장관이 지명한다.","items":[]},{"id":"EGOVERNMENT_RULE_ART_3_P3","display_id":"전자정부법-시행규칙-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"심의위원회의 위원은 본인정보 제공 업무를 담당하는 행정안전부 소속 공무원, 관계 중앙행정기관 소속 공무원 또는 본인정보 제공에 관한 학식과 경험이 풍부한 사람 중에서 행정안전부장관이 임명하거나 위촉한다.","items":[]},{"id":"EGOVERNMENT_RULE_ART_3_P4","display_id":"전자정부법-시행규칙-제3조-제4항","paragraph_number":"④","paragraph_index":4,"content":"심의위원회의 위원 중 공무원이 아닌 위원의 임기는 2년으로 하되, 한 차례만 연임할 수 있다.","items":[]},{"id":"EGOVERNMENT_RULE_ART_3_P5","display_id":"전자정부법-시행규칙-제3조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"심의위원회 위원은 제4항에 따른 임기가 만료된 경우에도 후임 위원이 위촉될 때까지 그 직무를 수행할 수 있다. <신설 2025.12.31>","items":[]},{"id":"EGOVERNMENT_RULE_ART_3_P6","display_id":"전자정부법-시행규칙-제3조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"심의위원회의 위원장은 위원회를 대표하고, 위원회의 업무를 총괄한다. 다만, 위원장이 부득이한 사유로 직무를 수행할 수 없을 때에는 위원장이 미리 지명한 위원이 그 직무를 대리한다. <개정 2025.12.31>","items":[]},{"id":"EGOVERNMENT_RULE_ART_3_P7","display_id":"전자정부법-시행규칙-제3조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"심의위원회의 위원장은 심의위원회 회의를 소집하고 그 의장이 된다. <개정 2025.12.31>","items":[]},{"id":"EGOVERNMENT_RULE_ART_3_P8","display_id":"전자정부법-시행규칙-제3조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"심의위원회의 회의는 재적위원 과반수의 출석으로 개의(開議)하고, 출석위원 과반수의 찬성으로 의결한다. <개정 2025.12.31>","items":[]},{"id":"EGOVERNMENT_RULE_ART_3_P9","display_id":"전자정부법-시행규칙-제3조-제9항","paragraph_number":"⑨","paragraph_index":9,"content":"제1항부터 제8항까지에서 규정한 사항 외에 심의위원회의 구성 및 운영 등에 필요한 사항은 행정안전부장관이 정한다. <개정 2025.12.31>","items":[]}],"notes":[],"effective_date":"2025-12-31","revision_date":"2025-12-31","source_file":"EGOVERNMENT_RULE.json","source_path":"원문/법제처API/EGOVERNMENT_RULE.json","pdf_path":"","source_page":"","amendments":["<신설 2025.12.31>","<개정 2025.12.31>"],"last_amended":"2025-12-31","api_text":"제3조(본인정보제공 심의위원회)\n① 다음 각 호의 사항을 심의하기 위하여 행정안전부장관 소속으로 본인정보제공 심의위원회(이하 \"심의위원회\"라 한다)를 둔다.\n1. 「전자정부법」 제43조의2제1항에 따른 제3자의 범위에 관한 사항\n2. 영 제51조의2제8항에 따른 본인정보의 종류에 관한 사항\n3. 그 밖에 행정안전부장관 또는 심의위원회의 위원장이 본인정보의 제공 요구에 관하여 심의가 필요하다고 인정하는 사항\n② 심의위원회는 위원장 1명을 포함하여 10명 이내의 위원으로 구성하고, 위원장은 위원 중에서 행정안전부장관이 지명한다.\n③ 심의위원회의 위원은 본인정보 제공 업무를 담당하는 행정안전부 소속 공무원, 관계 중앙행정기관 소속 공무원 또는 본인정보 제공에 관한 학식과 경험이 풍부한 사람 중에서 행정안전부장관이 임명하거나 위촉한다.\n④ 심의위원회의 위원 중 공무원이 아닌 위원의 임기는 2년으로 하되, 한 차례만 연임할 수 있다.\n⑤ 심의위원회 위원은 제4항에 따른 임기가 만료된 경우에도 후임 위원이 위촉될 때까지 그 직무를 수행할 수 있다. <신설 2025.12.31>\n⑥ 심의위원회의 위원장은 위원회를 대표하고, 위원회의 업무를 총괄한다. 다만, 위원장이 부득이한 사유로 직무를 수행할 수 없을 때에는 위원장이 미리 지명한 위원이 그 직무를 대리한다. <개정 2025.12.31>\n⑦ 심의위원회의 위원장은 심의위원회 회의를 소집하고 그 의장이 된다. <개정 2025.12.31>\n⑧ 심의위원회의 회의는 재적위원 과반수의 출석으로 개의(開議)하고, 출석위원 과반수의 찬성으로 의결한다. <개정 2025.12.31>\n⑨ 제1항부터 제8항까지에서 규정한 사항 외에 심의위원회의 구성 및 운영 등에 필요한 사항은 행정안전부장관이 정한다. <개정 2025.12.31>","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=282543","api_received":"2026-10-14","related_articles":["EGOVERNMENT_ACT_ART_43_2","EGOVERNMENT_ENFORCEMENT_ART_51_2"],"related_regulations":["EGOVERNMENT_ACT","EGOVERNMENT_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"EGOVERNMENT_RULE_API_SUPP_4b842e531bd9_PRE","display_id":"전자정부법-시행규칙-부칙1","regulation_id":"EGOVERNMENT_RULE","regulation_name":"전자정부법 시행규칙","short_name":"전자정부법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"EGOVERNMENT_RULE_API_SUPP_4b842e531bd9_PRE_P0","display_id":"전자정부법-시행규칙-부칙1","paragraph_number":"","paragraph_index":null,"content":"이 규칙은 공포한 날부터 시행한다.","items":[]}],"notes":[],"effective_date":"2025-12-31","revision_date":"2025-12-31","source_file":"EGOVERNMENT_RULE.json","source_path":"원문/법제처API/EGOVERNMENT_RULE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제364호,2022.12.30>","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=282543","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"EGOVERNMENT_RULE_SUPP_PRE","display_id":"전자정부법-시행규칙-부칙2","regulation_id":"EGOVERNMENT_RULE","regulation_name":"전자정부법 시행규칙","short_name":"전자정부법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":2,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"EGOVERNMENT_RULE_SUPP_PRE_P0","display_id":"전자정부법-시행규칙-부칙2","paragraph_number":"","paragraph_index":null,"content":"이 규칙은 공포한 날부터 시행한다.","items":[]}],"notes":[],"effective_date":"2025-12-31","revision_date":"2025-12-31","source_file":"EGOVERNMENT_RULE.json","source_path":"원문/법제처API/EGOVERNMENT_RULE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제595호,2025.12.31>","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=282543","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]}]
