ll,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285308_SUPP11_ART_3_P0","display_id":"국외조달-적격심사기준-부칙11-제3조","paragraph_number":"","paragraph_index":null,"content":"[별표] 국외조달 적격심사기준 1. 적격심사 항목 및 배점 한도의 보안사고 발생 감점평가에서「군사기밀보호법」또는「방위산업기술보호법」위반에 의한 감점 적용은 아래 각 호에 따른다.","items":[{"id":"DAPA_A_2100000285308_SUPP11_ART_3_P0_I1","display_id":"국외조달-적격심사기준-부칙11-제3조-제1호","item_number":"1","content":"감점대상 사건이 1개를 초과하거나 총 피의자(피고인)이 1인을 초과할 경우에 대한 감점은 이 예규 시행일 이후 ‘기소유예’ 또는 ‘기소’되거나 ‘형벌이 확정’된 경우부터 적용한다.","subitems":[]},{"id":"DAPA_A_2100000285308_SUPP11_ART_3_P0_I2","display_id":"국외조달-적격심사기준-부칙11-제3조-제2호","item_number":"2","content":"「방위산업기술보호법」위반에 따른 감점은 이 예규 시행일 이후 ‘기소유예’ 또는 ‘기소’되거나 ‘형벌이 확정’된 경우부터 적용한다.","subitems":[]},{"id":"DAPA_A_2100000285308_SUPP11_ART_3_P0_I3","display_id":"국외조달-적격심사기준-부칙11-제3조-제3호","item_number":"3","content":"「군사기밀보호법」위반에 따른 감점 중 ‘기소’된 경우는 이 예규 시행일 이후 기소된 경우부터 적용하고, ‘기소유예’와 ‘형벌이 확정’된 경우는 2021년 8월 8일 이후 기소유예되거나 징역형, 벌금형 등 형벌이 확정된 경우부터 적용한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국외조달 적격심사기준.json","source_path":"원문/법제처API/국외조달 적격심사기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제793호, 2022. 8. 8.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규","적격심사"]},{"id":"DAPA_A_2100000285308_SUPP12_ART_1","display_id":"국외조달-적격심사기준-부칙12-제1조","regulation_id":"DAPA_A_2100000285308","regulation_name":"국외조달 적격심사기준","short_name":"국외조달 적격심사기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":12,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285308_SUPP12_ART_1_P0","display_id":"국외조달-적격심사기준-부칙12-제1조","paragraph_number":"","paragraph_index":null,"content":"이 예규는 발령한 날부터 시행한다.","items":[]}],"not