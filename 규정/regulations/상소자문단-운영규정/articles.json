[{"id":"DAPA_A_2100000274610_ART_1","display_id":"상소자문단-운영규정-제1조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274610_ART_1_P0","display_id":"상소자문단-운영규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업청 소관 국가송무(국가소송ㆍ행정소송 사건 및 불복절차가 있는 분쟁해결절차)의 상소권 행사 및 이의신청 여부에 대한 결정에 외부 법률 전문가의 다양한 의견을 반영함으로써 상소 및 이의신청의 법리적 정합성과 적정성을 제고하기 위한 ‘상소자문단’의 설치, 자문대상, 구성 등에 관하여 필요한 사항을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"상소자문단 운영규정.json","source_path":"원문/법제처API/상소자문단 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["이의신청"]},{"id":"DAPA_A_2100000274610_ART_2","display_id":"상소자문단-운영규정-제2조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"자문대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274610_ART_2_P0","display_id":"상소자문단-운영규정-제2조","paragraph_number":"","paragraph_index":null,"content":"상소자문단의 자문대상사건은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000274610_ART_2_P0_I1","display_id":"상소자문단-운영규정-제2조-제1호","item_number":"1","content":"주요 무기체계 등 방위사업청의 정책결정에 중대한 영향을 미칠 우려가 있는 사업에 관련된 사건","subitems":[]},{"id":"DAPA_A_2100000274610_ART_2_P0_I2","display_id":"상소자문단-운영규정-제2조-제2호","item_number":"2","content":"소가(訴價) 100억 원 이상으로 국가재정에 중대한 영향을 미칠 우려가 있는 사건","subitems":[]},{"id":"DAPA_A_2100000274610_ART_2_P0_I3","display_id":"상소자문단-운영규정-제2조-제3호","item_number":"3","content":"주요 방산비리로 보도되는 등 사회의 이목을 끄는 사업에 관련된 사건","subitems":[]},{"id":"DAPA_A_2100000274610_ART_2_P0_I4","display_id":"상소자문단-운영규정-제2조-제4호","item_number":"4","content":"기타 사안의 중대성에 비추어 자문이 필요하다고 인정되는 사건","subitems":[]}]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"상소자문단 운영규정.json","source_path":"원문/법제처API/상소자문단 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274610_ART_3","display_id":"상소자문단-운영규정-제3조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"구성 및 위촉","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274610_ART_3_P1","display_id":"상소자문단-운영규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 기획조정관의 건의를 받아 10인 이내의 상소자문위원을 위촉할 수 있다.","items":[]},{"id":"DAPA_A_2100000274610_ART_3_P2","display_id":"상소자문단-운영규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"상소자문위원은 다음 각 호의 자격이 있는 사람 중에서 위촉한다.","items":[{"id":"DAPA_A_2100000274610_ART_3_P2_I1","display_id":"상소자문단-운영규정-제3조-제2항-제1호","item_number":"1","content":"판사ㆍ검사ㆍ군법무관 또는 변호사의 직에 5년 이상 종사한 사람으로서 국방ㆍ방산 관련 경험이 풍부한 사람","subitems":[]},{"id":"DAPA_A_2100000274610_ART_3_P2_I2","display_id":"상소자문단-운영규정-제3조-제2항-제2호","item_number":"2","content":"공인된 대학의 법률학 조교수 이상의 직에 있는 사람으로서 국방ㆍ방산 관련 경험이 풍부한 사람","subitems":[]}]},{"id":"DAPA_A_2100000274610_ART_3_P3","display_id":"상소자문단-운영규정-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 제1항에 따라 위원을 위촉할 때에는 별지 제1호 서식의 직무윤리 서약서를 위원으로부터 제출받은 다음 별지 제2호 서식의 위촉장을 교부하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"상소자문단 운영규정.json","source_path":"원문/법제처API/상소자문단 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274610_ART_4","display_id":"상소자문단-운영규정-제4조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"임기","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274610_ART_4_P0","display_id":"상소자문단-운영규정-제4조","paragraph_number":"","paragraph_index":null,"content":"위원의 임기는 2년으로 하되, 연임할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"상소자문단 운영규정.json","source_path":"원문/법제처API/상소자문단 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274610_ART_5","display_id":"상소자문단-운영규정-제5조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"자문","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274610_ART_5_P1","display_id":"상소자문단-운영규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청 기획조정관은 혁신행정법무담당관의 건의를 받아 자문위원으로부터 상소제기 여부에 관한 자문을 받을 수 있다.","items":[]},{"id":"DAPA_A_2100000274610_ART_5_P2","display_id":"상소자문단-운영규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전항의 자문은 서면자문(자문서)을 원칙으로 한다.","items":[]},{"id":"DAPA_A_2100000274610_ART_5_P3","display_id":"상소자문단-운영규정-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"자문위원은 자문을 하기 전에 별지 제3호 서식의 이해관계 부존재 등 확인서를 방위사업청에 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000274610_ART_5_P4","display_id":"상소자문단-운영규정-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항의 자문이 상소기간 등 사유로 긴급한 경우 대면 또는 유선자문도 가능하나, 이 경우 자문대상 사건의 소송수행자가 간사로서 별지 제4호 서식의 자문요지보고서를 작성하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"상소자문단 운영규정.json","source_path":"원문/법제처API/상소자문단 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274610_ART_6","display_id":"상소자문단-운영규정-제6조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"자문위원의 준수사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274610_ART_6_P1","display_id":"상소자문단-운영규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"자문위원은 다음 각 호의 사항을 준수하여야 한다.","items":[{"id":"DAPA_A_2100000274610_ART_6_P1_I1","display_id":"상소자문단-운영규정-제6조-제1항-제1호","item_number":"1","content":"자문위원은 자문업무 중 알게 된 직무상 비밀을 누설하여서는 아니 된다.","subitems":[]},{"id":"DAPA_A_2100000274610_ART_6_P1_I2","display_id":"상소자문단-운영규정-제6조-제1항-제2호","item_number":"2","content":"자문위원은 자문업무 중 수집한 자료를 자문 이외의 용도로 사용하여서는 아니 된다.","subitems":[]},{"id":"DAPA_A_2100000274610_ART_6_P1_I3","display_id":"상소자문단-운영규정-제6조-제1항-제3호","item_number":"3","content":"그 밖에 직위를 이용하여 부당한 이익을 얻거나 타인이 부당한 이익을 얻도록 하여서는 아니 된다.","subitems":[]}]},{"id":"DAPA_A_2100000274610_ART_6_P2","display_id":"상소자문단-운영규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 자문위원이 제1항의 준수사항을 위반하거나 위원으로서 품위를 손상하는 행위를 하였음이 명백한 경우에 제4조 전단의 규정에도 불구하고 해당 위원을 해촉할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"상소자문단 운영규정.json","source_path":"원문/법제처API/상소자문단 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274610_ART_4"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274610_ART_7","display_id":"상소자문단-운영규정-제7조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"자문료 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274610_ART_7_P0","display_id":"상소자문단-운영규정-제7조","paragraph_number":"","paragraph_index":null,"content":"자문위원이 자문업무를 수행한 경우 예산의 범위 안에서 자문료, 여비 기타 필요한 경비를 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"상소자문단 운영규정.json","source_path":"원문/법제처API/상소자문단 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274610_ART_8","display_id":"상소자문단-운영규정-제8조","regulation_id":"DAPA_A_2100000274610","regulation_name":"상소자문단 운영규정","short_name":"상소자문단 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"재검토 기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note"