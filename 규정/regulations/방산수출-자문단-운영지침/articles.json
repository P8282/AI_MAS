[{"id":"DAPA_A_2100000260050_ART_1","display_id":"방산수출-자문단-운영지침-제1조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_1_P0","display_id":"방산수출-자문단-운영지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위산업 발전 및 지원에 관한 법률 」제15조에 따라 방산수출 자문단 구성 및 운영에 관하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_15"],"related_regulations":["DAPA_L_287981"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_2","display_id":"방산수출-자문단-운영지침-제2조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_2_P0","display_id":"방산수출-자문단-운영지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업청 국제협력관에서 방산수출 자문단을 구성ㆍ운영하는 경우에 적용한다. 이때 \"방산수출 자문단\"이라 함은 전문지식이 요구되는 업무의 자문을 위하여 국제협력관의 승인을 받아 외부전문가로 구성한 인력풀을 말한다","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_3","display_id":"방산수출-자문단-운영지침-제3조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_3_P1","display_id":"방산수출-자문단-운영지침-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"국제협력관은 방산수출 업무수행 시 전문지식이 요구되는 경우에는 15인 이하로 별도의 외부 전문가로 방산수출 자문단을 구성하여 자문에 활용할 수 있다.","items":[]},{"id":"DAPA_A_2100000260050_ART_3_P2","display_id":"방산수출-자문단-운영지침-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방산수출 자문단은 방산수출에 대한 지식과 경험이 풍부한 전문가로서 방산수출을 위한 관련분야에 폭넓은 자문과 필요한 정보, 자료 등을 제공하는 자로 구성한다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_4","display_id":"방산수출-자문단-운영지침-제4조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"수행업무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_4_P0","display_id":"방산수출-자문단-운영지침-제4조","paragraph_number":"","paragraph_index":null,"content":"방산수출 자문단에 소속된 자문위원이 수행하여야 하는 업무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000260050_ART_4_P0_I1","display_id":"방산수출-자문단-운영지침-제4조-제1호","item_number":"1","content":"방산협력 소요 발굴 및 수출 지원, 신흥시장 개척 방안 지원 검토","subitems":[]},{"id":"DAPA_A_2100000260050_ART_4_P0_I2","display_id":"방산수출-자문단-운영지침-제4조-제2호","item_number":"2","content":"방산협력 공동위 개최, 방산수출 관련 행사 개최 시 전문분야 자문","subitems":[]},{"id":"DAPA_A_2100000260050_ART_4_P0_I3","display_id":"방산수출-자문단-운영지침-제4조-제3호","item_number":"3","content":"해외 현지 지원단 운영 및 수출지원 원팀 운영에 대한 검토","subitems":[]},{"id":"DAPA_A_2100000260050_ART_4_P0_I4","display_id":"방산수출-자문단-운영지침-제4조-제4호","item_number":"4","content":"방산수출을 위한 권역별 특성에 맞는 자문요청 사항","subitems":[]},{"id":"DAPA_A_2100000260050_ART_4_P0_I5","display_id":"방산수출-자문단-운영지침-제4조-제5호","item_number":"5","content":"그 밖의 방산수출 관련사항 등과 관련하여 국제협력관이 필요하다고 인정하는 사항","subitems":[]}]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_5","display_id":"방산수출-자문단-운영지침-제5조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"자격요건","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_5_P0","display_id":"방산수출-자문단-운영지침-제5조","paragraph_number":"","paragraph_index":null,"content":"국제협력관은 「국가공무원법」제33조에 의한 결격사유에 해당되지 않은 자로서 다음 각 호의 어느 하나에 해당하는 자를 방산수출 자문위원으로 선정할 수 있다.","items":[{"id":"DAPA_A_2100000260050_ART_5_P0_I1","display_id":"방산수출-자문단-운영지침-제5조-제1호","item_number":"1","content":"방위산업 분야 근무 경력자로 방산수출 지식과 경험이 풍부한 자","subitems":[]},{"id":"DAPA_A_2100000260050_ART_5_P0_I2","display_id":"방산수출-자문단-운영지침-제5조-제2호","item_number":"2","content":"방위사업 관련 연구 및 학술활동 경력이 있는 자","subitems":[]},{"id":"DAPA_A_2100000260050_ART_5_P0_I3","display_id":"방산수출-자문단-운영지침-제5조-제3호","item_number":"3","content":"외교 및 통상교섭 관련분야에서 5년 이상 종사한 경력이 있는 자","subitems":[]}]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["국가공무원법"],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_6","display_id":"방산수출-자문단-운영지침-제6조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"자문위원 선정절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_6_P1","display_id":"방산수출-자문단-운영지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"국제협력총괄담당관은 자문위원 풀 구성을 위해 청 본부, 기반전력사업본부, 미래전력사업본부 등의 추천을 받아 (별지 제1호) 서식의 자문위원 추천서를 작성하여 국제협력관에게 자문위원을 추천하고, 국제협력관은 자문위원 선정심의회를 통해 확정한다.","items":[]},{"id":"DAPA_A_2100000260050_ART_6_P2","display_id":"방산수출-자문단-운영지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"국제협력총괄담당관은 자문위원 추천자 대상자에 대하여「보안업무규정」에 따라 신원조사를 실시해야 한다.","items":[]},{"id":"DAPA_A_2100000260050_ART_6_P3","display_id":"방산수출-자문단-운영지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항의 자문위원 선정 심의회(이하 \"심의회\"라 한다)는 다음 각 호와 같이 구성한다.","items":[{"id":"DAPA_A_2100000260050_ART_6_P3_I1","display_id":"방산수출-자문단-운영지침-제6조-제3항-제1호","item_number":"1","content":"위원장 : 국제협력관","subitems":[]},{"id":"DAPA_A_2100000260050_ART_6_P3_I2","display_id":"방산수출-자문단-운영지침-제6조-제3항-제2호","item_number":"2","content":"위 원 : 국제협력총괄담당관, 유럽협력담당관, 중동아프리카협력담당관, 북미협력담당관, 아시아중남미협력담당관(이하 ‘각 담당관’이라 한다)","subitems":[]},{"id":"DAPA_A_2100000260050_ART_6_P3_I3","display_id":"방산수출-자문단-운영지침-제6조-제3항-제3호","item_number":"3","content":"간 사 : 국제협력총괄담당관실 직원 중에서 위원장이 정하는 1인","subitems":[]}]},{"id":"DAPA_A_2100000260050_ART_6_P4","display_id":"방산수출-자문단-운영지침-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"심의회는 제5조에 따라 자문위원 자격기준 등을 검토하고 (별지 제2호) 서식에 따라 자문위원 선정 심의회 결과서를 작성하여 보존ㆍ관리한다.","items":[]},{"id":"DAPA_A_2100000260050_ART_6_P5","display_id":"방산수출-자문단-운영지침-제6조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"간사는 자문위원 선정결과를 각 담당관 및 추천된 자문위원에게 통보해야 한다.","items":[]},{"id":"DAPA_A_2100000260050_ART_6_P6","display_id":"방산수출-자문단-운영지침-제6조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"방산수출 자문단의 자문위원은 필요에 따라 국제협력관의 승인을 받아 추가 할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000260050_ART_5"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_7","display_id":"방산수출-자문단-운영지침-제7조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"자문위원의 임기","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_7_P1","display_id":"방산수출-자문단-운영지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"자문위원의 임기는 2년으로 한다.","items":[]},{"id":"DAPA_A_2100000260050_ART_7_P2","display_id":"방산수출-자문단-운영지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"국제협력관은 자문위원의 임기만료 시에는 심의회의 심의를 거쳐 자문위원을 재선정할 수 있다.","items":[]},{"id":"DAPA_A_2100000260050_ART_7_P3","display_id":"방산수출-자문단-운영지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"자문위원은 2회에 한하여 연임이 가능하다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_8","display_id":"방산수출-자문단-운영지침-제8조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"자문위원의 자격취소","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_8_P0","display_id":"방산수출-자문단-운영지침-제8조","paragraph_number":"","paragraph_index":null,"content":"국제협력관은 다음 각 호에 해당하는 사유가 있을 때에는 방산수출 자문위원의 자격을 취소할 수 있다.","items":[{"id":"DAPA_A_2100000260050_ART_8_P0_I1","display_id":"방산수출-자문단-운영지침-제8조-제1호","item_number":"1","content":"업무를 태만히 하거나 업무수행능력이 부족한 때","subitems":[]},{"id":"DAPA_A_2100000260050_ART_8_P0_I2","display_id":"방산수출-자문단-운영지침-제8조-제2호","item_number":"2","content":"신체ㆍ정신상의 이상으로 기간 내에 자문을 수행하기 곤란한 때","subitems":[]},{"id":"DAPA_A_2100000260050_ART_8_P0_I3","display_id":"방산수출-자문단-운영지침-제8조-제3호","item_number":"3","content":"자문 직위를 존속시킬 필요성이 소멸한 때","subitems":[]},{"id":"DAPA_A_2100000260050_ART_8_P0_I4","display_id":"방산수출-자문단-운영지침-제8조-제4호","item_number":"4","content":"형사사건으로 기소된 때","subitems":[]},{"id":"DAPA_A_2100000260050_ART_8_P0_I5","display_id":"방산수출-자문단-운영지침-제8조-제5호","item_number":"5","content":"직무를 수행하는데 필요한 자격증의 효력이 상실 또는 허위로 밝혀진 경우나 면허 취소로 담당직무를 수행할 수 없게 된 때","subitems":[]},{"id":"DAPA_A_2100000260050_ART_8_P0_I6","display_id":"방산수출-자문단-운영지침-제8조-제6호","item_number":"6","content":"이권개입, 비밀자료 등의 정보유출 행위로 물의를 일으킨 때","subitems":[]},{"id":"DAPA_A_2100000260050_ART_8_P0_I7","display_id":"방산수출-자문단-운영지침-제8조-제7호","item_number":"7","content":"본인의 희망 또는 기타 부득이한 사유가 있는 경우","subitems":[]}]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_9","display_id":"방산수출-자문단-운영지침-제9조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"자문신청 및 자문결과 조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_9_P1","display_id":"방산수출-자문단-운영지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"각 담당관은 선정된 자문위원의 자문이 필요거나, 방산전시회ㆍ컨퍼런스 참석 등 동행이 필요한 경우 (별지 제3호) 서식의 자문신청서를 작성하여 국제협력관의 승인을 받아 활용할 수 있다.","items":[]},{"id":"DAPA_A_2100000260050_ART_9_P2","display_id":"방산수출-자문단-운영지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"각 담당관은 자문위원을 활용한 자문을 수행한 경우 (별지 제4호) 서식에 따라 자문결과보고서를 작성하여 국제협력관에게 보고한다.","items":[]},{"id":"DAPA_A_2100000260050_ART_9_P3","display_id":"방산수출-자문단-운영지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"각 담당관은 제2항에서 작성된 자문결과 보고서 및 업무실적 자료를 국제협력총괄담당관에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_10","display_id":"방산수출-자문단-운영지침-제10조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"자문위원의 비밀문서 열람","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_10_P1","display_id":"방산수출-자문단-운영지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방산수출 자문위원의 비밀문서 열람은 해당 등급의 비밀취급 인가를 받은 자에 한하며, 방위사업청 소속 공무원 입회 하에 비밀이력카드에 소정의 사항을 기록 및 서명 날인 후에 열람하여야 한다.","items":[]},{"id":"DAPA_A_2100000260050_ART_10_P2","display_id":"방산수출-자문단-운영지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"자문위원은 비밀문서를 대출 및 반출할 수 없으며, 열람 후 즉시 반납하여야 한다. 이때 비밀문서를 복사, 복제, 기록하여서는 아니된다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_11","display_id":"방산수출-자문단-운영지침-제11조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"비밀보호","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_11_P0","display_id":"방산수출-자문단-운영지침-제11조","paragraph_number":"","paragraph_index":null,"content":"방산수출 자문위원은 업무수행을 통해서 알게 된 군사상의 비밀, 해당업체의 영업비밀 등을 외부에 누설하여서는 아니되며, (별지 제5호) 서식의 보안서약서를 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_12","display_id":"방산수출-자문단-운영지침-제12조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"이권개입금지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_12_P0","display_id":"방산수출-자문단-운영지침-제12조","paragraph_number":"","paragraph_index":null,"content":"방산수출 자문위원은 방위사업청과 관련된 직위을 이용하여 부당한 이익을 얻거나 타인이 부당한 이익을 얻도록 하여서는 아니되며, (별지 제6호)서식의 청렴서약서를 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_13","display_id":"방산수출-자문단-운영지침-제13조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"수당 및 경비","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_13_P0","display_id":"방산수출-자문단-운영지침-제13조","paragraph_number":"","paragraph_index":null,"content":"국제협력관은 자문위원이 자문 업무를 수행한 경우에 청 기준 및 예산의 범위 내에서 자문료, 수당 등을 지급할 수 있고, 특정과제의 연구 및 조사, 현장방문 등이 필요한 경우에는 이에 소요되는 경비를 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000260050_ART_14","display_id":"방산수출-자문단-운영지침-제14조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_ART_14_P0","display_id":"방산수출-자문단-운영지침-제14조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 예규에 대하여 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2026년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-06-09","revision_date":"2025-06-09","source_file":"방산수출 자문단 운영지침.json","source_path":"원문/법제처API/방산수출 자문단 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000260050_SUPP_ART_1","display_id":"방산수출-자문단-운영지침-부칙-제1조","regulation_id":"DAPA_A_2100000260050","regulation_name":"방산수출 자문단 운영지침","short_name":"방산수출 자문단 운영지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000260050_SUPP_ART_1_P0","display_id":"방산수출-자문단-운영지침-부칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 발령한 날로부터 시행한다.","items":