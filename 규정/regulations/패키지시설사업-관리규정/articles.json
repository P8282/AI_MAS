[{"id":"DAPA_A_2100000283408_ART_1","display_id":"패키지시설사업-관리규정-제1조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_1_P0","display_id":"패키지시설사업-관리규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 국방부 「국방전력발전업무훈령」, 방위사업청 「방위사업관리규정」을 근거로 방위력개선 시설사업의 업무수행에 필요한 방법 및 절차 등 필요한 사항 등을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_2","display_id":"패키지시설사업-관리규정-제2조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_2_P0","display_id":"패키지시설사업-관리규정-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 사용하는 용어의 뜻은 다음과 같다.","items":[{"id":"DAPA_A_2100000283408_ART_2_P0_I1","display_id":"패키지시설사업-관리규정-제2조-제1호","item_number":"1","content":"\"패키지시설사업\"이란 무기체계와 연계하여 일괄 확보되어야 하는 방위력 개선사업으로 추진되는 시설사업(방위력개선사업으로 추진되는 정보통신공사사업을 포함)으로, 시설은 전력화지원요소로서 무기체계의 운용ㆍ시험ㆍ훈련을 지원하거나 군수지원(저장ㆍ정비ㆍ보급)을 수행하는데 필요한 부동산 및 설비 등을 말한다.","subitems":[]},{"id":"DAPA_A_2100000283408_ART_2_P0_I2","display_id":"패키지시설사업-관리규정-제2조-제2호","item_number":"2","content":"\"집행기관\"이란 패키지시설사업을 시행하는 기관으로, 국방부(군사시설기획관실)에서 선정한 국방시설본부, 국군지휘통신사령부 또는 각 군, 해병대를 말한다.","subitems":[]},{"id":"DAPA_A_2100000283408_ART_2_P0_I3","display_id":"패키지시설사업-관리규정-제2조-제3호","item_number":"3","content":"\"소요제기기관\"이란 각 군 및 해병대 등 패키지시설사업이 포함된 방위력개선사업의 소요를 제기하는 기관을 말한다.","subitems":[]},{"id":"DAPA_A_2100000283408_ART_2_P0_I4","display_id":"패키지시설사업-관리규정-제2조-제4호","item_number":"4","content":"\"시설사업기본계획\"이란 시설사업의 현황, 추진계획, 대관협의, 재원확보 등 업무수행을 합리적이고 경제적으로 수행하기 위한 기본계획을 말한다.","subitems":[]},{"id":"DAPA_A_2100000283408_ART_2_P0_I5","display_id":"패키지시설사업-관리규정-제2조-제5호","item_number":"5","content":"\"설계기본요구조건\"이란 건축물의 건축 등에 관한 공사용 도면, 구조계산서, 시방서 등 공사에 필요한 서류의 작성근거가 되는 군 요구사항을 말한다.","subitems":[]},{"id":"DAPA_A_2100000283408_ART_2_P0_I6","display_id":"패키지시설사업-관리규정-제2조-제6호","item_number":"6","content":"\"대관협의\"란 시설사업과 관련된 인ㆍ허가를 받기 위해 해당 권한을 가진 기관과 인ㆍ허가에 필요한 사항을 협의하는 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000283408_ART_2_P0_I7","display_id":"패키지시설사업-관리규정-제2조-제7호","item_number":"7","content":"\"집행계획서\"란 국방중기계획 및 예산편성, 시설사업기본계획 등에 따라 작성된 시설사업 집행계획을 말한다.","subitems":[]},{"id":"DAPA_A_2100000283408_ART_2_P0_I8","display_id":"패키지시설사업-관리규정-제2조-제8호","item_number":"8","content":"\"전문기관\"이란 건축관련 학술정책연구, 컨설팅, 건축관련 기술서비스 등 관련분야에 전문적인 지식과 경험을 갖춘 기관을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공사"]},{"id":"DAPA_A_2100000283408_ART_3","display_id":"패키지시설사업-관리규정-제3조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_3_P0","display_id":"패키지시설사업-관리규정-제3조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 정하지 않은 사항은 건축 및 정보통신 관련 법규, 국방부 「국방전력발전업무훈령」, 「군 시설사업 관리훈령」에 따른다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_4","display_id":"패키지시설사업-관리규정-제4조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"업무분장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_4_P0","display_id":"패키지시설사업-관리규정-제4조","paragraph_number":"","paragraph_index":null,"content":"업무수행을 위한 관련기관의 업무분장은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000283408_ART_4_P0_I1","display_id":"패키지시설사업-관리규정-제4조-제1호","item_number":"1","content":"국방부 군사시설기획관실가. 집행기관 선정","subitems":[]},{"id":"DAPA_A_2100000283408_ART_4_P0_I2","display_id":"패키지시설사업-관리규정-제4조-제2호","item_number":"2","content":"방위사업청 방위사업정책국(이하, \"방위사업정책국\"이라 한다.)","subitems":[{"id":"DAPA_A_2100000283408_ART_4_P0_I2_S1","display_id":"패키지시설사업-관리규정-제4조-제2호-가목","subitem_number":"가","content":"연간 사업추진계획 수립나. 패키지시설사업 중기계획 및 예산 검토다. 시설사업기본계획 및 집행계획서 검토라. 시설사업 연구용역 예산 지원마. 패키지시설사업 집행진도 점검"}]},{"id":"DAPA_A_2100000283408_ART_4_P0_I3","display_id":"패키지시설사업-관리규정-제4조-제3호","item_number":"3","content":"방위사업청 통합사업관리팀(이하, \"통합사업관리팀\"이라 한다.)","subitems":[{"id":"DAPA_A_2100000283408_ART_4_P0_I3_S1","display_id":"패키지시설사업-관리규정-제4조-제3호-가목","subitem_number":"가","content":"패키지시설사업 중기계획 및 예산편성요구서(안) 작성나. 패키지시설사업 사업관리(연구용역관리 포함)다. 시설사업기본계획 수립 및 집행계획 승인라. 설계기본요구조건 검토 및 확정"}]},{"id":"DAPA_A_2100000283408_ART_4_P0_I4","display_id":"패키지시설사업-관리규정-제4조-제4호","item_number":"4","content":"집행기관가. 패키지시설사업 집행, 설계 및 공사관리나. 패키지시설사업 중기계획 및 예산 검토다. 시설사업기본계획 검토라. 설계기본요구조건 검토마. 단계별 집행계획서 작성","subitems":[]},{"id":"DAPA_A_2100000283408_ART_4_P0_I5","display_id":"패키지시설사업-관리규정-제4조-제5호","item_number":"5","content":"소요제기기관가. 패키지시설사업 중기계획 및 예산편성요구(안) 기초자료 제출나. 시설사업기본계획 및 집행계획 검토다. 비밀사업 여부, 방호등급 판단 및 탄약고 폭발물안전거리 충족 사전검토 등라. 설계기본요구조건 작성 및 수정마. 부지확보 및 사업여건 조성(토지소유권 확인, 사ㆍ공유지 사용동의서, 갈등 관리 및 주민설명회, 대안마련 등)","subitems":[]}]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_5","display_id":"패키지시설사업-관리규정-제5조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제2장 중기계획 및 예산","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"중기계획","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_5_P1","display_id":"패키지시설사업-관리규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"소요제기기관은 시설사업기본계획과 시설소요를 근거로 추가 식별한 소요를 포함한 중기계획 작성 자료를 「국방중기계획 작성지침」에서 정하는 기간까지 통합사업관리팀에 제출한다. 이때 소요제기기관은 방위력개선사업이 진행될 부대(부지)에 일반회계 및 특별회계(부대 이전ㆍ개편ㆍ토양정화 등)와 관련된 별도의 사업계획ㆍ진행ㆍ간섭 여부 사항을 각 군(공병실 등)에 확인하고, 중기대상 기간 중 F+2년도 신규 착수사업은 제6조의2 제1항에 따른 신규사업 적정성 검토를 실시하여 전력화지연 유발 요인이 있는지 사전 확인한 결과를 포함하여 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_5_P2","display_id":"패키지시설사업-관리규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 소요제기기관으로부터 확인된 패키지 시설소요를 검토 후 방위사업정책국과 협의하여 중기계획요구서(안)에 반영하고 기획조정관에게 제출한다. 이때, F+2년도 신규 착수사업은 시설소요에 대한 구체적인 사업설명서(별지 제1호서식), 중기계획 기본요구서(별지 제2호서식) 등을 포함하는 사업계획서를 작성하여 제출한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000283408_ART_6_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_6","display_id":"패키지시설사업-관리규정-제6조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제2장 중기계획 및 예산","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"예산편성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_6_P1","display_id":"패키지시설사업-관리규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"집행기관 및 소요제기기관은 시설소요에 대한 예산편성 요구자료를 「국방예산안 편성 및 기금운용계획안 작성지침」에서 정하는 기한까지 통합사업관리팀에 제출한다. 이때 F+1년도에 착수하는 신규사업의 경우, 소요제기기관은 제6조의2 제1항에 따른 신규사업 적정성 검토를 실시하고 그 결과를 포함한 예산편성 요구자료를 통합사업관리팀에 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_6_P2","display_id":"패키지시설사업-관리규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 집행기관 및 소요제기기관으로부터 확인된 패키지 시설소요를 검토 후 방위사업정책국과 협의하여 예산편성요구서(안)에 반영하고 기획조정관에게 제출한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000283408_ART_6_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_6_2","display_id":"패키지시설사업-관리규정-제6조의2","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제2장 중기계획 및 예산","section":"","subsection":"","article_number":"6의2","article_label":"제6조의2","article_title":"신규사업 적정성 검토 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_6_2_P1","display_id":"패키지시설사업-관리규정-제6조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"예산을 효율적으로 집행하고 패키지시설을 적기에 확보하기 위해, 소요제기기관은 신규사업 적정성 검토(별지 제5호서식)를 시행하여 패키지시설사업 집행에 필요한 사항 및 추진 가능 여부를 확인하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_6_2_P2","display_id":"패키지시설사업-관리규정-제6조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"소요제기기관은 중기계획 및 예산편성요구자료 작성시 신규사업 적정성 검토를 실시하고, 그 결과를「국방중기계획 작성지침」과「국방예산안 편성 및 기금운용계획안 작성지침」에서 정하는 기한 내 통합사업관리팀에 제출하여야 한다. 다만, 불가피한 사유로 기한 내 서류를 제출하지 못할 경우 통합사업관리팀과 협의하여 기한을 연장할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_6_2_P3","display_id":"패키지시설사업-관리규정-제6조의2-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀이 중기계획요구서 제출시 신규사업 적정성 검토결과 적정한 것으로 판단한 사업은 F+1년도 예산편성시 신규사업 적정성 검토를 생략할 수 있다. 다만, 이후 사업부지 변경 등에 따라 사업계획이 변경된 경우에는 F+1년도 예산편성시 신규사업 적정성 검토를 다시 실시하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_6_2_P4","display_id":"패키지시설사업-관리규정-제6조의2-제4항","paragraph_number":"④","paragraph_index":4,"content":"통합사업관리팀은 신규사업 적정성 검토 결과 집행 가능성이 미흡한 경우 소요제기기관에 보완을 요구할 수 있다. 다만, 보완이 불가하다고 판단될 경우에는 사업부지 변경 등을 요청할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_7","display_id":"패키지시설사업-관리규정-제7조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제3장 선행조치","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"부지매입 업무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_7_P0","display_id":"패키지시설사업-관리규정-제7조","paragraph_number":"","paragraph_index":null,"content":"소요제기기관은 시설소요 제기 전 인ㆍ허가에 문제가 없는 사업부지를 명확히 지정하고, 토지소유자 현황을 확인하여 국ㆍ공유지, 사유지 등 국방부 소유가 아닌 토지는 매입ㆍ사용동의 등을 통해 토지 사용에 대한 조치를 완료한 이후 시설소요를 제기하여야 한다. 다만, 사업계획 승인 후 부지매입이 가능한 대형사업의 경우는 매입계획을 포함하여 소요를 제기하되, 통합사업관리팀장은 초년도 예산에 부지매입과 관련된 비용만 편성하고, 국방시설본부는 제4조 제5호마목에도 불구하고 부지매입 업무를 수행한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000283408_ART_4"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_8","display_id":"패키지시설사업-관리규정-제8조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제3장 선행조치","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"인ㆍ허가 등 대관협의 업무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_8_P1","display_id":"패키지시설사업-관리규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"소요제기 이후 인ㆍ허가 등 대관협의는 시설사업 전단계(설계전, 설계/공사 중)에 걸쳐 집행기관에서 수행한다. 다만, 장시간 소요되고 설계 전에 반영ㆍ변경이 필요한 개발제한구역 관리계획, 공유수면매립 기본계획, 도시ㆍ군관리계획에 관한 사항은 소요제기기관에서 수행하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_8_P2","display_id":"패키지시설사업-관리규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"집행기관은 대관협의 필요사항을 검토하고, 기본 및 실시설계 용역 전에 대관협의를 위한 기본조사용역이 필요한 경우 별도로 추진할 수 있으며, 기본조사 용역을 수행하기 위한 집행계획서(안)을 통합사업관리팀에 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["용역"]},{"id":"DAPA_A_2100000283408_ART_9","display_id":"패키지시설사업-관리규정-제9조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제3장 선행조치","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"집행기관 선정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_9_P1","display_id":"패키지시설사업-관리규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 시설사업기본계획 수립 전에 소요제기기관과 협의하여 국방부(군사시설기획관실)에 집행기관 선정을 의뢰한다. 다만, 정보통신공사사업 중 방위사업청에서 직접 수행하는 경우에는 제외한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_9_P2","display_id":"패키지시설사업-관리규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"국방부(군사시설기획관실)은 집행기관을 선정하여 방위사업청 및 선정기관에 통보한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_10","display_id":"패키지시설사업-관리규정-제10조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제4장 연간 사업추진계획 수립","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"연간 사업추진계획 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_10_P1","display_id":"패키지시설사업-관리규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업정책국장은 매년 말 다음 각 호의 내용이 포함된 패키지시설사업의 다음연도 개별사업 추진계획을 수립하여 집행기관에 통보한다.","items":[{"id":"DAPA_A_2100000283408_ART_10_P1_I1","display_id":"패키지시설사업-관리규정-제10조-제1항-제1호","item_number":"1","content":"주장비 사업개요 및 추진경위","subitems":[]},{"id":"DAPA_A_2100000283408_ART_10_P1_I2","display_id":"패키지시설사업-관리규정-제10조-제1항-제2호","item_number":"2","content":"패키지시설소요 및 근거, 추진경위","subitems":[]},{"id":"DAPA_A_2100000283408_ART_10_P1_I3","display_id":"패키지시설사업-관리규정-제10조-제1항-제3호","item_number":"3","content":"단계별 추진계획 작성 필요내용(단위시설 목록, 규모, 예산)","subitems":[]},{"id":"DAPA_A_2100000283408_ART_10_P1_I4","display_id":"패키지시설사업-관리규정-제10조-제1항-제4호","item_number":"4","content":"패키지시설 향후 추진일정(주장비 사업일정과 비교) 및 예산집행계획 등","subitems":[]}]},{"id":"DAPA_A_2100000283408_ART_10_P2","display_id":"패키지시설사업-관리규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업정책국장은 연간 사업추진계획 수립에 필요한 지원을 통합사업관리팀에 요청할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_11","display_id":"패키지시설사업-관리규정-제11조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제5장 시설사업기본계획 수립 등","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"시설사업기본계획 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_11_P1","display_id":"패키지시설사업-관리규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 사업추진기본전략(안) 수립 시에 패키지시설의 시설개요, 소요예산 등 개략계획을 포함하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_11_P2","display_id":"패키지시설사업-관리규정-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 설계착수 2년 전까지 국방부, 방위사업정책국, 집행기관, 소요제기기관의 검토를 거쳐 시설사업기본계획을 수립하고 관련기관에 통보한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_11_P3","display_id":"패키지시설사업-관리규정-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 시설사업기본계획을 수립 시 국방부ㆍ합참ㆍ집행기관ㆍ소요제기기관ㆍ전문기관에 필요한 지원을 요청하거나, 전문기관에 연구용역을 의뢰할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_11_P4","display_id":"패키지시설사업-관리규정-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"소요제기기관은 비밀사업 여부, 방호등급 판단 및 탄약고 폭발물안전거리 충족여부 등을 시설사업기본계획 작성 단계에서 검토ㆍ적용할 수 있도록 하여야 하며, 비밀사업은 국군방첩사령부로부터 발급받은 비밀사업확인서를 함께 통합사업관리팀에 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_11_P5","display_id":"패키지시설사업-관리규정-제11조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"통합사업관리팀장은 시설사업기본계획 수립 후 사업규모, 총사업비, 사업기간 등을 기획재정부와 협의한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_11_P6","display_id":"패키지시설사업-관리규정-제11조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"시설사업기본계획 수립과 관련된 업무절차는 별표 1과 같으며, 시설사업기본계획을 수정하거나 폐지하는 경우에도 이와 같다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_12","display_id":"패키지시설사업-관리규정-제12조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제5장 시설사업기본계획 수립 등","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"시설사업기본계획 내용","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_12_P1","display_id":"패키지시설사업-관리규정-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"시설사업기본계획에는 다음 각 호의 사항이 포함되어야 한다.","items":[{"id":"DAPA_A_2100000283408_ART_12_P1_I1","display_id":"패키지시설사업-관리규정-제12조-제1항-제1호","item_number":"1","content":"「건설기술진흥법」시행령 제69조에 따른 ′건설공사기본계획′ 포함 내용","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I2","display_id":"패키지시설사업-관리규정-제12조-제1항-제2호","item_number":"2","content":"시설규모 및 면적, 요구조건의 적정성 검토","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I3","display_id":"패키지시설사업-관리규정-제12조-제1항-제3호","item_number":"3","content":"공사예정지와 해당부대의 공사여건 분석","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I4","display_id":"패키지시설사업-관리규정-제12조-제1항-제4호","item_number":"4","content":"대관협의 필요사항에 대한 조치계획","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I5","display_id":"패키지시설사업-관리규정-제12조-제1항-제5호","item_number":"5","content":"사업추진방안 및 사업추진 일정(대관협의, 계약행정 일정 등 포함)","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I6","display_id":"패키지시설사업-관리규정-제12조-제1항-제6호","item_number":"6","content":"사업에 포함된 장비, 물자, 방호시설 등의 확보방안","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I7","display_id":"패키지시설사업-관리규정-제12조-제1항-제7호","item_number":"7","content":"사업추진 간 발생할 수 있는 예상 문제점 및 조치방안","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I8","display_id":"패키지시설사업-관리규정-제12조-제1항-제8호","item_number":"8","content":"유지관리 및 환경보전계획","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I9","display_id":"패키지시설사업-관리규정-제12조-제1항-제9호","item_number":"9","content":"총사업비","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I10","display_id":"패키지시설사업-관리규정-제12조-제1항-제10호","item_number":"10","content":"통합사업관리팀 구성(안)","subitems":[]},{"id":"DAPA_A_2100000283408_ART_12_P1_I11","display_id":"패키지시설사업-관리규정-제12조-제1항-제11호","item_number":"11","content":"관련기관의 의견 등","subitems":[]}]},{"id":"DAPA_A_2100000283408_ART_12_P2","display_id":"패키지시설사업-관리규정-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"시설사업기본계획은 별지 제3호서식을 참고하여 작성한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공사"]},{"id":"DAPA_A_2100000283408_ART_13","display_id":"패키지시설사업-관리규정-제13조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제5장 시설사업기본계획 수립 등","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"사업추진방안","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_13_P1","display_id":"패키지시설사업-관리규정-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"패키지시설사업의 사업추진방안은 시설사업기본계획 수립 단계에서 통합사업관리팀, 집행기관, 소요제기기관이 협의하여 결정한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_13_P2","display_id":"패키지시설사업-관리규정-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"「국가를 당사자로 하는 계약에 관한 법률 시행령」 제79조에 따른 대형공사는 국방부 「특별건설기술심의위원회 운영 및 시공 등 평가훈령」 및 국토해양부 고시 「대형공사 등의 입찰방법 심의기준」에 따라 집행방법 심의를 거쳐 입찰방법을 결정한 후 시행한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_79"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_14","display_id":"패키지시설사업-관리규정-제14조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제5장 시설사업기본계획 수립 등","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"연구용역","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_14_P1","display_id":"패키지시설사업-관리규정-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제11조 제3항의 시설사업기본계획 수립, 사업추진간 발생한 제한사항 검토 등 연구용역 예산은 통합사업관리팀이 확보하여야 한다. 다만, 연구용역이 필요함에도 예산이 반영되지 않아 용역을 착수할 수 없는 경우에는 방위사업정책국에 예산지원을 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_14_P2","display_id":"패키지시설사업-관리규정-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업정책국장은 사업 우선순위 등을 고려하여 확보된 예산범위 내에서 지원할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_14_P3","display_id":"패키지시설사업-관리규정-제14조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 중기계획 제출 시 해당기간에 대한 연구용역 소요를 포함하여 방위사업정책국에 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_14_P4","display_id":"패키지시설사업-관리규정-제14조-제4항","paragraph_number":"④","paragraph_index":4,"content":"소요제기기관은 시설사업기본계획 수립을 위한 연구용역 수행 단계에서 설계기본요구조건(초안)을 다음 각 호를 고려하여 통합사업관리팀에 제출하여야 한다.","items":[{"id":"DAPA_A_2100000283408_ART_14_P4_I1","display_id":"패키지시설사업-관리규정-제14조-제4항-제1호","item_number":"1","content":"주장비 적기 운용가능성","subitems":[]},{"id":"DAPA_A_2100000283408_ART_14_P4_I2","display_id":"패키지시설사업-관리규정-제14조-제4항-제2호","item_number":"2","content":"부대이전 관련사항","subitems":[]},{"id":"DAPA_A_2100000283408_ART_14_P4_I3","display_id":"패키지시설사업-관리규정-제14조-제4항-제3호","item_number":"3","content":"「국방ㆍ군사시설기준」 부합여부","subitems":[]},{"id":"DAPA_A_2100000283408_ART_14_P4_I4","display_id":"패키지시설사업-관리규정-제14조-제4항-제4호","item_number":"4","content":"그 밖에 관련 법령, 훈령 및 지침과의 부합 여부, 인ㆍ허가사항 저촉 여부","subitems":[]}]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000283408_ART_11"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_15","display_id":"패키지시설사업-관리규정-제15조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제5장 시설사업기본계획 수립 등","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"설계기본요구조건","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_15_P1","display_id":"패키지시설사업-관리규정-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"소요제기기관은 통합사업관리팀의 시설사업기본계획 수립 결과를 반영한 설계기본요구조건(안)을 작성하여 통합사업관리팀에 제출한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_15_P2","display_id":"패키지시설사업-관리규정-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 설계기본요구조건(안)이 시설사업기본계획의 업무 및 예산범위에 해당하는지 확인 후 집행기관에 통보한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_15_P3","display_id":"패키지시설사업-관리규정-제15조-제3항","paragraph_number":"③","paragraph_index":3,"content":"집행기관은 통합사업관리팀장과 협의하여 제14조 제4항의 각 호를 검토하고, 그 결과를 설계착수 일정에 따라 통합사업관리팀에 제출한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_15_P4","display_id":"패키지시설사업-관리규정-제15조-제4항","paragraph_number":"④","paragraph_index":4,"content":"통합사업관리팀장은 원칙적으로 연구개발사업의 경우에는 기본설계검토결과 확정 후부터 상세설계검토 종료일(최종 회의 결과 통보 시점) 이후 6개월까지의 기간 동안, 구매사업의 경우에는 구매계획 승인 후부터 대상장비 선정 이후 6개월까지의 기간 동안 설계기본요구조건(안)을 검토ㆍ확정하여 설계가 착수될 수 있도록 조치하여야 한다. 다만, 사업의 특성과 추진 여건을 고려하여 설계기본요구조건(안) 검토ㆍ확정시기를 조정할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_15_P5","display_id":"패키지시설사업-관리규정-제15조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"설계기본요구조건과 관련된 업무절차는 별표 2와 같고 별지 제4호서식을 참고하여 작성한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_15_P6","display_id":"패키지시설사업-관리규정-제15조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"「산업안전보건법」제67조, 같은 법 시행령 제55조에 따른 기본안전보건대장 작성과 관련한 사항은 「군 시설사업관리훈령」을 따른다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000283408_ART_14"],"related_regulations":[],"external_references":["산업안전보건법"],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_16","display_id":"패키지시설사업-관리규정-제16조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제6장 집행계획 작성","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"집행계획서 작성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_16_P1","display_id":"패키지시설사업-관리규정-제16조-제1항","paragraph_number":"①","paragraph_index":1,"content":"집행기관은 국방중기계획 및 예산편성, 시설사업기본계획 등에 따라 패키지시설사업 단계별(기본조사, 부지매입, 기본 및 실시설계, 시설공사) 집행계획서(안)를 작성하여 통합사업관리팀에 제출한다. 다만, 수 개의 단계가 유사한 시기에 착수 또는 종료되거나 단계 간 집행결과의 확인이 불필요한 경우 등에는 수 개의 단계를 통합하여 집행계획서(안)를 작성할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_16_P2","display_id":"패키지시설사업-관리규정-제16조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 집행계획서(안)를 검토 및 승인 후 집행기관에 통보한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_16_P3","display_id":"패키지시설사업-관리규정-제16조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 집행계획서 검토를 위해 필요시 방위사업정책국, 집행기관 및 소요제기기관과 협조하여 현장을 확인할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_16_P4","display_id":"패키지시설사업-관리규정-제16조-제4항","paragraph_number":"④","paragraph_index":4,"content":"집행계획 승인과 관련된 업무절차는 별표 3과 같다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_17","display_id":"패키지시설사업-관리규정-제17조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제6장 집행계획 작성","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"집행계획서 수정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_17_P1","display_id":"패키지시설사업-관리규정-제17조-제1항","paragraph_number":"①","paragraph_index":1,"content":"집행기관은 사업추진 중 승인된 집행계획서의 사업기간 변경, 예산증액 등이 필요한 경우 통합사업관리팀에 집행계획서 수정(안)을 제출한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_17_P2","display_id":"패키지시설사업-관리규정-제17조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 집행기관의 수정 요청사항에 대해 예산확보 및 집행가능성을 검토 및 승인 후 집행기관에 통보한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_17_P3","display_id":"패키지시설사업-관리규정-제17조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 집행계획서 수정에 따른 예산증감 및 예산의 이용ㆍ전용 소요가 발생할 경우 그에 따른 조치를 한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_18","display_id":"패키지시설사업-관리규정-제18조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제7장 설계 및 공사집행 관리","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"설계（단가） 적정성 검토","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_18_P1","display_id":"패키지시설사업-관리규정-제18조-제1항","paragraph_number":"①","paragraph_index":1,"content":"집행기관은 패키지시설사업 중 「국방사업 총사업비 관리지침」 제3조에 해당하는 시설사업에 대해서는 설계 용역 중 조달청장에게 설계의 적정성(30%, 60%, 90%설계)과 단가(90%설계)의 적정성 검토를 의뢰한다. 통합사업관리팀장은 예산편성 시 조달청에 적정성 검토 의뢰를 위해 발생하는 수수료를(시설부대비) 반영한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_18_P2","display_id":"패키지시설사업-관리규정-제18조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 조달청 설계(단가)의 적정성 검토결과에 따라 총사업비 조정이 필요한 경우 기획재정부와 협의한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["국방사업 총사업비 관리지침"],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_19","display_id":"패키지시설사업-관리규정-제19조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제7장 설계 및 공사집행 관리","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"설계변경","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_19_P1","display_id":"패키지시설사업-관리규정-제19조-제1항","paragraph_number":"①","paragraph_index":1,"content":"설계변경은 설계 시 예측하지 못했던 사항 및 현장상태의 변화 등으로 설계를 변경할 필요가 있다고 인정되는 다음 각 호에 해당하는 경우에 한한다.","items":[{"id":"DAPA_A_2100000283408_ART_19_P1_I1","display_id":"패키지시설사업-관리규정-제19조-제1항-제1호","item_number":"1","content":"설계서의 내용이 불분명하거나 누락ㆍ오류 또는 상호 모순되는 점이 있을 경우","subitems":[]},{"id":"DAPA_A_2100000283408_ART_19_P1_I2","display_id":"패키지시설사업-관리규정-제19조-제1항-제2호","item_number":"2","content":"시설물의 원 기능이 보장되지 않아 정상적인 사용이 불가능한 경우","subitems":[]},{"id":"DAPA_A_2100000283408_ART_19_P1_I3","display_id":"패키지시설사업-관리규정-제19조-제1항-제3호","item_number":"3","content":"새로운 기술ㆍ공법사용으로 공사비의 절감 및 시공기간의 단축 등의 효과가 현저할 경우","subitems":[]},{"id":"DAPA_A_2100000283408_ART_19_P1_I4","display_id":"패키지시설사업-관리규정-제19조-제1항-제4호","item_number":"4","content":"집행계획의 변경으로 설계변경이 필요한 경우","subitems":[]},{"id":"DAPA_A_2100000283408_ART_19_P1_I5","display_id":"패키지시설사업-관리규정-제19조-제1항-제5호","item_number":"5","content":"안전상 문제점 발생이 예상되거나 유지관리 간 과다한 예산소요가 예상되는 경우","subitems":[]}]},{"id":"DAPA_A_2100000283408_ART_19_P2","display_id":"패키지시설사업-관리규정-제19조-제2항","paragraph_number":"②","paragraph_index":2,"content":"집행기관은 설계변경이 발생할 경우 별표 4의 설계변경 절차에 따라 심의하고 승인한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_19_P3","display_id":"패키지시설사업-관리규정-제19조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 제21조에 따른 개별사업실무위원회에 참여하여 추가예산 확보여부 등 의견을 제시하여야 하며, 설계변경에 따른 집행계획서 수정은 제17조 절차를 따른다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000283408_ART_21","DAPA_A_2100000283408_ART_17"],"related_regulations":[],"external_references":[],"keywords":["설계변경"]},{"id":"DAPA_A_2100000283408_ART_20","display_id":"패키지시설사업-관리규정-제20조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제7장 설계 및 공사집행 관리","section":"","subsection":"","article_number":"20","article_label":"제20조","article_title":"집행진도 점검","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_20_P1","display_id":"패키지시설사업-관리규정-제20조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 다음 각 호의 사항을 집행기관 등으로부터 제출받아 주기적으로 사업추진현황을 점검하고 방위사업정책국에서 집행진도 점검을 위한 자료요청 시 제출하여야 한다.","items":[{"id":"DAPA_A_2100000283408_ART_20_P1_I1","display_id":"패키지시설사업-관리규정-제20조-제1항-제1호","item_number":"1","content":"설계, 공사 추진일정 및 사업집행 실적","subitems":[]},{"id":"DAPA_A_2100000283408_ART_20_P1_I2","display_id":"패키지시설사업-관리규정-제20조-제1항-제2호","item_number":"2","content":"설계 및 공사 변경사항(담당자 변경 포함)","subitems":[]},{"id":"DAPA_A_2100000283408_ART_20_P1_I3","display_id":"패키지시설사업-관리규정-제20조-제1항-제3호","item_number":"3","content":"공사준공 결과","subitems":[]},{"id":"DAPA_A_2100000283408_ART_20_P1_I4","display_id":"패키지시설사업-관리규정-제20조-제1항-제4호","item_number":"4","content":"부지매입 및 공사 관련한 민원사항 등","subitems":[]}]},{"id":"DAPA_A_2100000283408_ART_20_P2","display_id":"패키지시설사업-관리규정-제20조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업정책국장은 집행진도 및 사업집행실적을 분기별로 점검하고 관련기관(통합사업관리팀, 집행기관, 소요제기기관)과 협조하여 적기 준공 또는 예산관련 문제점 및 애로사항 등에 대한 해결방안을 수립하고 조치하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_20_P3","display_id":"패키지시설사업-관리규정-제20조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업정책국장은 전년도 패키지시설사업을 대상으로 예산집행 결과를 분석하고 집행이 부진한 사유에 대해서는 예방대책을 수립하고 조치하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_20_P4","display_id":"패키지시설사업-관리규정-제20조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업정책국장은 통합사업관리팀이 계획수립, 집행관리 시 활용할 수 있도록 매뉴얼 또는 체크리스트를 작성ㆍ제공할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공사"]},{"id":"DAPA_A_2100000283408_ART_21","display_id":"패키지시설사업-관리규정-제21조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제7장 설계 및 공사집행 관리","section":"","subsection":"","article_number":"21","article_label":"제21조","article_title":"개별사업실무협의회 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_21_P1","display_id":"패키지시설사업-관리규정-제21조-제1항","paragraph_number":"①","paragraph_index":1,"content":"집행기관은 패키지시설사업 진행 간에 효율적인 업무협력과 원활한 사업관리를 위해 방위사업청, 집행기관, 소요제기기관, 설계ㆍ시공회사 등이 참여하는 개별사업실무협의회를 운영한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_21_P2","display_id":"패키지시설사업-관리규정-제21조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 설계단계 착수회의, 30%, 60%, 90% 설계 완료 시(다만, 설계기간이 3개월 미만인 경우는 30%ㆍ60%, 6개월 미만인 경우는 60% 단계 생략 가능) 개별사업 실무협의회에 참여하여야 한다. 다만, 부득이한 사유가 있는 경우에는 사업담당자가 대리 수행할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_21_P3","display_id":"패키지시설사업-관리규정-제21조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 개별사업 실무협의회에서 다음 각 호의 사항에 대해 협의ㆍ조정을 요구할 수 있다.","items":[{"id":"DAPA_A_2100000283408_ART_21_P3_I1","display_id":"패키지시설사업-관리규정-제21조-제3항-제1호","item_number":"1","content":"총사업비 및 예산집행 관련 사항","subitems":[]},{"id":"DAPA_A_2100000283408_ART_21_P3_I2","display_id":"패키지시설사업-관리규정-제21조-제3항-제2호","item_number":"2","content":"설계변경 관련 사항","subitems":[]},{"id":"DAPA_A_2100000283408_ART_21_P3_I3","display_id":"패키지시설사업-관리규정-제21조-제3항-제3호","item_number":"3","content":"공정계획 및 사업추진 일정에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000283408_ART_21_P3_I4","display_id":"패키지시설사업-관리규정-제21조-제3항-제4호","item_number":"4","content":"기타 원활한 사업관리를 위하여 필요한 사항","subitems":[]}]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283408_ART_22","display_id":"패키지시설사업-관리규정-제22조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제7장 설계 및 공사집행 관리","section":"","subsection":"","article_number":"22","article_label":"제22조","article_title":"건설사업관리 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_22_P1","display_id":"패키지시설사업-관리규정-제22조-제1항","paragraph_number":"①","paragraph_index":1,"content":"집행기관은 「건설기술진흥법」제39조 및 같은 법 시행령 제55조, 제57조의 설계 및 시설공사를 대상으로 사업의 효율성, 신뢰성, 품질확보 등 향상을 위해 건설엔지니어링사업자로 하여금 건설사업관리를 실시하게 할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_22_P2","display_id":"패키지시설사업-관리규정-제22조-제2항","paragraph_number":"②","paragraph_index":2,"content":"집행기관은 건설사업관리용역에 해당되는 시설공사가 아니더라도 집행기관의 감독 능력 및 공사 특성에 따라 용역이 필요하다고 인정되는 경우 총사업비 범위 내에서 시행 할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_22_P3","display_id":"패키지시설사업-관리규정-제22조-제3항","paragraph_number":"③","paragraph_index":3,"content":"건설사업관리용역 계약은 공사계약 이전에 체결하고 준공 후 건설사업관리를 위해 계약종료를 공사기간 이후로 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_22_P4","display_id":"패키지시설사업-관리규정-제22조-제4항","paragraph_number":"④","paragraph_index":4,"content":"패키지시설사업 간 안전ㆍ품질 등 확보를 위해 건설사업관리가 원활히 시행, 지속되도록 통합사업관리팀 및 집행기관이 협력하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_22_P5","display_id":"패키지시설사업-관리규정-제22조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"기타 건설사업관리 집행에 관한 세부사항은 국토교통부 고시 「건설공사 사업관리방식 검토기준 및 업무수행지침」에 따른다.","items":[]},{"id":"DAPA_A_2100000283408_ART_22_P6","display_id":"패키지시설사업-관리규정-제22조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"정보통신공사사업의 감리업무에 대해서는 통합사업관리팀장 또는 집행기관은 「정보통신공사업법 시행령」 제8조부터 제10조까지의 규정에 따른다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["CONSTRUCTION_TECH_PROMOTION_ACT_ART_39","INFO_COMM_WORK_ENFORCEMENT_ART_8","INFO_COMM_WORK_ENFORCEMENT_ART_10"],"related_regulations":["CONSTRUCTION_TECH_PROMOTION_ACT","INFO_COMM_WORK_ENFORCEMENT"],"external_references":[],"keywords":["공사","용역"]},{"id":"DAPA_A_2100000283408_ART_23","display_id":"패키지시설사업-관리규정-제23조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제8장 공사결과 조치 등","section":"","subsection":"","article_number":"23","article_label":"제23조","article_title":"공사결과 조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_23_P1","display_id":"패키지시설사업-관리규정-제23조-제1항","paragraph_number":"①","paragraph_index":1,"content":"집행기관은 공사준공 후 1개월 이내에 준공검사 결과를 통합사업관리팀으로 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000283408_ART_23_P2","display_id":"패키지시설사업-관리규정-제23조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 준공 완료된 사업에 대하여 집행기관 및 소요제기기관과 협의하여 현장확인을 할 수 있다.","items":[]},{"id":"DAPA_A_2100000283408_ART_23_P3","display_id":"패키지시설사업-관리규정-제23조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 공사 집행결과를 토대로 예산 사용결과가 포함된 사업종결보고서를 작성 후 집행기관 및 방위사업정책국에 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-07-30","revision_date":"2026-07-30","source_file":"패키지시설사업 관리규정.json","source_path":"원문/법제처API/패키지시설사업 관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공사"]},{"id":"DAPA_A_2100000283408_ART_24","display_id":"패키지시설사업-관리규정-제24조","regulation_id":"DAPA_A_2100000283408","regulation_name":"패키지시설사업 관리규정","short_name":"패키지시설사업 관리규정","document_type":"훈령","part":"","chapter":"제8장 공사결과 조치 등","section":"","subsection":"","article_number":"24","article_label":"제24조","article_title":"예산결산","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283408_ART_24_P0","displa