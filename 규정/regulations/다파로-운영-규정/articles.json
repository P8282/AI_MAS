[{"id":"DAPA_A_2100000201398_ART_1","display_id":"다파로-운영-규정-제1조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_1_P0","display_id":"다파로-운영-규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위산업과 관련된 업체로부터 애로 및 건의사항 등을 청취하여 방위산업 관련 정책 및 제도를 개선하기 위해 실시하는\"다파로\"의 운영에 관하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_2","display_id":"다파로-운영-규정-제2조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용 범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_2_P0","display_id":"다파로-운영-규정-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업청과 그 소속기관, 국방과학연구소 및 국방기술품질원에 적용한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_3","display_id":"다파로-운영-규정-제3조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"업무분장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_3_P0","display_id":"다파로-운영-규정-제3조","paragraph_number":"","paragraph_index":null,"content":"다파로와 관련한 각 부서 및 소속기관의 업무분장은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000201398_ART_3_P0_I1","display_id":"다파로-운영-규정-제3조-제1호","item_number":"1","content":"방위산업진흥국 방산정책과가. 다파로 운영 총괄 및 제도 개선나. 다파로 신청 접수 관리다. 다파로 회의 결과 공개 및 종합관리 업무","subitems":[]},{"id":"DAPA_A_2100000201398_ART_3_P0_I2","display_id":"다파로-운영-규정-제3조-제2호","item_number":"2","content":"소관부서(다파로 신청서의 내용과 관련된 업무를 담당하는 국ㆍ부를 말한다)","subitems":[{"id":"DAPA_A_2100000201398_ART_3_P0_I2_S1","display_id":"다파로-운영-규정-제3조-제2호-가목","subitem_number":"가","content":"소관 업무와 관련한 다파로 회의 참석나. 다파로 신청서 및 회의 개최 여부 검토"}]},{"id":"DAPA_A_2100000201398_ART_3_P0_I3","display_id":"다파로-운영-규정-제3조-제3호","item_number":"3","content":"주관부서(소관부서로서 다파로 회의를 주관하는 국ㆍ부를 말한다)","subitems":[{"id":"DAPA_A_2100000201398_ART_3_P0_I3_S1","display_id":"다파로-운영-규정-제3조-제3호-가목","subitem_number":"가","content":"다파로 회의 개최 계획 및 결과 보고나. 다파로 회의 결과 업체 통보다. 다파로 회의 준비 관련 행정사항"}]}]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_4","display_id":"다파로-운영-규정-제4조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"업체신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_4_P1","display_id":"다파로-운영-규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"다파로 참여를 희망하는 업체 관계자는 별지 제1호 서식의 양식에 따라 신청서를 작성하여 제출해야 한다. 이 경우 신청서는 방위사업청 누리집을 통해 제출하거나 방산정책과장에게 전자우편 또는 우편으로 제출할 수 있다.","items":[]},{"id":"DAPA_A_2100000201398_ART_4_P2","display_id":"다파로-운영-규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위산업진흥국장은 업체신청이 있을 경우 신청 내용에 따른 소관부서를 정하여 해당 부서의 장에게 신청서를 송부하여야 한다.","items":[]},{"id":"DAPA_A_2100000201398_ART_4_P3","display_id":"다파로-운영-규정-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"소관부서가 둘 이상일 경우 소관부서간 협의하여 주관부서를 정하고, 주관부서의 장은 이를 방위산업진흥국장에게 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000201398_ART_4_P4","display_id":"다파로-운영-규정-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"주관부서의 장은 신청서 검토 결과를 반영한 회의 개최 여부 검토 결과를 청장에게 보고하고, 회의 개최가 결정된 경우 일정 및 참석자를 정하여 방위산업진흥국장에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_5","display_id":"다파로-운영-규정-제5조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"내부신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_5_P1","display_id":"다파로-운영-규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청 소속 부서장이 다음 각 호에 따라 업체 의견을 청취할 필요성이 있다고 판단한 경우 다파로를 신청할 수 있으며, 별지 제1호 서식의 신청서를 작성하여 방위산업진흥국장에게 통보하여야 한다. 이 경우 해당 부서장은 제3조 제3호에 따른 주관부서의 장으로 본다.","items":[{"id":"DAPA_A_2100000201398_ART_5_P1_I1","display_id":"다파로-운영-규정-제5조-제1항-제1호","item_number":"1","content":"방위산업 정책 수립에 관한 우수 사례를 보유한 업체","subitems":[]},{"id":"DAPA_A_2100000201398_ART_5_P1_I2","display_id":"다파로-운영-규정-제5조-제1항-제2호","item_number":"2","content":"방위사업청에서 추진하는 정책이나 사업의 보완이 필요한 애로사항을 보유한 업체","subitems":[]},{"id":"DAPA_A_2100000201398_ART_5_P1_I3","display_id":"다파로-운영-규정-제5조-제1항-제3호","item_number":"3","content":"그 밖에 주관부서의 장이 의견을 청취할 필요성이 있다고 판단한 업체","subitems":[]}]},{"id":"DAPA_A_2100000201398_ART_5_P2","display_id":"다파로-운영-규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"주관부서의 장은 다파로 회의와 관련된 다른 소관부서가 있을 경우, 해당 소관부서장에게 제1항의 신청서를 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000201398_ART_3"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_6","display_id":"다파로-운영-규정-제6조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"회의 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_6_P1","display_id":"다파로-운영-규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"회의는 주관부서의 국ㆍ부장이 주관하는 것을 원칙으로 하되, 신청서에 기재된 사항이 다수의 국ㆍ부와 관련된 경우는 차장 또는 본부장이 주관할 수 있다.","items":[]},{"id":"DAPA_A_2100000201398_ART_6_P2","display_id":"다파로-운영-규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"회의에는 신청 업체의 관계자와 소관부서의 과ㆍ팀장이 참석하되, 업체 관계자 또는 소관부서 장의 요청에 따라 다른 부서 또는 기관의 담당자를 참석하게 할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_7","display_id":"다파로-운영-규정-제7조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"회의 준비","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_7_P1","display_id":"다파로-운영-규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"주관부서의 장은 다파로 회의 개최계획을 작성하여 청장에게 보고하고, 보고 완료 후 소관부서의 장 및 방위산업진흥국장에게 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000201398_ART_7_P2","display_id":"다파로-운영-규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위산업진흥국장은 제1항의 통보를 받았을 경우 해당 내용을 다파로 신청 업체 관계자에게 통보하고 방위사업청 누리집에 게시하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_8","display_id":"다파로-운영-규정-제8조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"회의 의제","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_8_P0","display_id":"다파로-운영-규정-제8조","paragraph_number":"","paragraph_index":null,"content":"다파로에서 다루는 사항은 신청서에 기재된 사항을 원칙으로 하되, 회의에 참석한 업체의 관계자가 요청할 경우에는 다음 각 호에 해당하는 경우를 제외하고 신청서에 기재되지 않은 사항이라도 회의에서 다룰 수 있다.","items":[{"id":"DAPA_A_2100000201398_ART_8_P0_I1","display_id":"다파로-운영-규정-제8조-제1호","item_number":"1","content":"사업, 계약 등에 관하여「행정정보 공개 규정」(방위사업청 훈령)에 따른 비공개 대상정보를 입수하려고 시도하는 행위","subitems":[]},{"id":"DAPA_A_2100000201398_ART_8_P0_I2","display_id":"다파로-운영-규정-제8조-제2호","item_number":"2","content":"사업, 계약 등 처리방향의 변경 및 처리시기의 조정과 관련된 청탁을 하는 행위","subitems":[]},{"id":"DAPA_A_2100000201398_ART_8_P0_I3","display_id":"다파로-운영-규정-제8조-제3호","item_number":"3","content":"「부정청탁 및 금품등 수수의 금지에 관한 법률」에 의해 금지되는 음식물ㆍ주류의 접대 또는 선물ㆍ편의의 제공을 시도하는 행위","subitems":[]},{"id":"DAPA_A_2100000201398_ART_8_P0_I4","display_id":"다파로-운영-규정-제8조-제4호","item_number":"4","content":"그 밖에 공무원의 사업, 계약 등의 처리에 부당한 영향력을 행사할 우려가 있거나 공정성을 훼손할 우려가 있는 행위","subitems":[]}]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_9","display_id":"다파로-운영-규정-제9조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"회의 결과 정리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_9_P1","display_id":"다파로-운영-규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"주관부서의 장은 회의 결과를 정리하여 업체의 제기사항, 검토결과 및 후속조치 계획을 청장에게 보고하여야 한다.","items":[]},{"id":"DAPA_A_2100000201398_ART_9_P2","display_id":"다파로-운영-규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"주관부서의 장은 제1항의 보고 결과를 업체 참석자, 소관부서의 장 및 방위산업진흥국장에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_10","display_id":"다파로-운영-규정-제10조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"후속조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_10_P1","display_id":"다파로-운영-규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"주관부서의 장은 제9조의 보고 결과에 따라 공개 가능한 사항을 방위산업진흥국장에게 별도로 통보하고, 방위산업진흥국장은 통보 받은 사항을 방위사업청 누리집에 게시하여야 한다.","items":[]},{"id":"DAPA_A_2100000201398_ART_10_P2","display_id":"다파로-운영-규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위산업진흥국장은 주관부서의 장으로부터 통보받은 다파로 회의 결과를 종합ㆍ관리하고, 반기별 운영 결과를 청장에게 보고하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000201398_ART_9"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201398_ART_11","display_id":"다파로-운영-규정-제11조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_ART_11_P0","display_id":"다파로-운영-규정-제11조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 예규에 대하여 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2021년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000201398_SUPP_ART_1","display_id":"다파로-운영-규정-부칙-제1조","regulation_id":"DAPA_A_2100000201398","regulation_name":"다파로 운영 규정","short_name":"다파로 운영 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201398_SUPP_ART_1_P0","display_id":"다파로-운영-규정-부칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 발령한 날부터 시행한다.","items":[]}],"notes":[],"effective_date":"2021-05-27","revision_date":"2021-05-27","source_file":"다파로 운영 규정.json","source_path":"원문/법제처API/다파로 운영 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제719호, 2021. 5. 27.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]}]
