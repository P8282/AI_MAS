rsion_note":"","paragraphs":[{"id":"DAPA_A_2100000201147_ART_6_P1","display_id":"방위사업청-사전컨설팅-운영규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"사전컨설팅이 필요한 부서는 [별지 제1호 서식]에 따라 신청서를 작성하여 부서장(국ㆍ부ㆍ단장)의 승인을 받아 감사관에게 제출한다.","items":[]},{"id":"DAPA_A_2100000201147_ART_6_P2","display_id":"방위사업청-사전컨설팅-운영규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"감사관은 신청부서의 사전컨설팅 신청서를 접수하여 처리해야 한다. 다만, 신청부서의 사전컨설팅 신청 사안이 제4조 2항의 각 호에 해당되는 경우 감사관은 이를 반려할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-05-17","revision_date":"2021-05-17","source_file":"방위사업청 사전컨설팅 운영규정.json","source_path":"원문/법제처API/방위사업청 사전컨설팅 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000201147_ART_4"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201147_ART_7","display_id":"방위사업청-사전컨설팅-운영규정-제7조","regulation_id":"DAPA_A_2100000201147","regulation_name":"방위사업청 사전컨설팅 운영규정","short_name":"방위사업청 사전컨설팅 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"사전컨설팅 실시","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201147_ART_7_P1","display_id":"방위사업청-사전컨설팅-운영규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"사전컨설팅은 서면으로 실시함을 원칙으로 하되, 필요에 따라 현지확인 등을 실시할 수 있다.","items":[]},{"id":"DAPA_A_2100000201147_ART_7_P2","display_id":"방위사업청-사전컨설팅-운영규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"감사관은 필요한 경우 신청부서에 관련 자료를 추가로 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000201147_ART_7_P3","display_id":"방위사업청-사전컨설팅-운영규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"감사관은 해당 사안이 중대하거나 다수의 기관이 관련되어 있어 자체 판단이 어려운 경우 감사원에 사전컨설팅을 신청할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-05-17","revision_date":"2021-05-17","source_file":"방위사업청 사전컨설팅 운영규정.json","source_path":"원문/법제처API/방위사업청 사전컨설팅 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000201147_ART_8","display_id":"방위사업청-사전컨설팅-운영규정-제8조","regulation_id":"DAPA_A_2100000201147","regulation_name":"방위사업청 사전컨설팅 운영규정","short_name":"방위사업청 사전컨설팅 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"전문가 자문","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000201147_ART_8_P1","display_id":"방위사업청-사전컨설팅-운영규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"감사관은 사전컨설팅 결과가 다음의 각 호에 해당될 경우 자문위원회를 활용하여 전문가 자문을 구할 수 있다.","items":[{"id":"DAPA_A_2100000201147_ART_8_P1_I1","display_id":"방위사업청-사전컨설팅-운영규정-제8조-제1항-제1호","item_number":"1","content":"국민생활에 미치는 영향이 크거나 다수의 이해관계자와 관련된 사항인 경우","subitems":[]},{"id":"DAPA_A_2100000201147_ART_8_P1_I2","display_id":"방위사업청-사전컨설팅-운영규정-제8조-제1항-제2호","item_number":"2","content":"다수의 기관과 관계되어 있고 관계기관 간 법령 등의 해석 및 적용에 있어 이견이 있는 경우","subitems":[]},{"id":"DAPA_A_2100000201147_ART_8_P1_I3","display_id":"방위사업청-사전컨설팅-운영규정-제8조-제1항-제3호","item_number":"3","content":"그 밖에 중대한 규제 개선 등과 관련하여 자문위원회의 논의가 필요하다고 판단하는 경우","subitems":[]}]},{"id":"DAPA_A_2100000201147_ART_8_P2","display_id":"방위사업청-사전컨설팅-운영규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"자문위원회 구성은 자체감사에 관한 규정(청 훈령) 제4조의2(감사자문위원회 구성 등)를 따른다.","items":[]},{"id":"DAPA_A_2100000201147_ART_8_P3","display_id":"방위사업청-사전컨설팅-운영규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"전문가 자문 방법은 회의 이외에도 토의, 세미나, 서면, 방문, 전자메일 등 다양한 방법을 활용할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-05-17","revision_date":"2021-05-17","source_file":"방위사업청 사전컨설팅 운영규정.json","source_path":"원문/법제처API/방위사업청 사전컨설팅 운영규정.json",