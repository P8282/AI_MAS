[{"id":"DAPA_A_2100000285310_ART_1","display_id":"국제운송-적격심사-기준-제1조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_1_P0","display_id":"국제운송-적격심사-기준-제1조","paragraph_number":"","paragraph_index":null,"content":"이 기준은 「국가를 당사자로 하는 계약에 관한 법률 시행령」 제42조 제5항 단서에 따라 방위사업청에서 경쟁입찰을 통해 조달하는 국제운송계약의 낙찰자 결정에 적용할 계약이행능력의 심사기준을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_42"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["낙찰자"]},{"id":"DAPA_A_2100000285310_ART_2","display_id":"국제운송-적격심사-기준-제2조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"심사기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_2_P1","display_id":"국제운송-적격심사-기준-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심사의 적용기준은 다음 각 호에 의한다.","items":[{"id":"DAPA_A_2100000285310_ART_2_P1_I1","display_id":"국제운송-적격심사-기준-제2조-제1항-제1호","item_number":"1","content":"평가기준일평가기준일은 다른 법령 등에서 정한 것을 제외하고는 입찰참가 등록마감일 전일로 한다. 다만, 용역이행능력 결격여부 사항에 대하여는 적격심사 낙찰자 통보일 현재로 한다.","subitems":[]},{"id":"DAPA_A_2100000285310_ART_2_P1_I2","display_id":"국제운송-적격심사-기준-제2조-제1항-제2호","item_number":"2","content":"외화표시금액이행실적 등의 외화표시 금액은 원화로 환산하여 표시하며, 적용환율은 입찰참가 등록마감일 전일의 외국환거래법에 의한 기준환율 또는 재정환율(매매기준율)을 적용한다. 다만, 외화와 원화가 동시에 표시된 경우에는 원화를 적용한다.","subitems":[]},{"id":"DAPA_A_2100000285310_ART_2_P1_I3","display_id":"국제운송-적격심사-기준-제2조-제1항-제3호","item_number":"3","content":"계산결과 소수점 이하 숫자 처리비율, 평점(입찰가격 포함) 등을 계산한 결과 소수점 이하의 숫자가 있는 경우에는 소수점 다섯째 자리에서 반올림한다. 이때 비율은 백분율(%)단위로 전환하기 전 단계의 수치를 의미한다.","subitems":[]}]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["입찰참가자격"]},{"id":"DAPA_A_2100000285310_ART_3","display_id":"국제운송-적격심사-기준-제3조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"심사항목 및 배점한도","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_3_P1","display_id":"국제운송-적격심사-기준-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사의 심사항목 및 배점한도는 [별표1]에서 정한 바에 의한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_3_P2","display_id":"국제운송-적격심사-기준-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 계약의 특성ㆍ목적 및 내용 등을 종합 고려하여 심사분야별 배점한도(입찰가격은 제외)를 20% 범위 내에서 가ㆍ감 조정할 수 있으며, 항목별(신인도 제외) 세부사항을 추가하거나 제외할 수 있다. 이 경우 입찰공고 또는 입찰설명서에 조정내용을 명시하여야 한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_3_P3","display_id":"국제운송-적격심사-기준-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"신인도 평가는 적격심사대상자의 운송용역수행능력(이행실적, 업체신용도, 국외파트너신용도, 창고면적) 취득점수가 심사분야별 배점한도에 부족한 경우에만 배점한도 범위 내에서 가산점을 부여하며, 신인도 총평점이 음인 경우에는 적격심사대상자가 신인도 평가 이외에서 취득한 총점에서 감점한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["배점한도","신인도","적격심사","계약담당공무원"]},{"id":"DAPA_A_2100000285310_ART_4","display_id":"국제운송-적격심사-기준-제4조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"제출서류","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_4_P1","display_id":"국제운송-적격심사-기준-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 적격심사 대상자에게 입찰일 또는 공고일로부터 7일 이내에 다음 각 호의 서류를 제출하도록 하여야 한다.","items":[{"id":"DAPA_A_2100000285310_ART_4_P1_I1","display_id":"국제운송-적격심사-기준-제4조-제1항-제1호","item_number":"1","content":"적격심사신청서 (별지 제1호) 1부","subitems":[]},{"id":"DAPA_A_2100000285310_ART_4_P1_I2","display_id":"국제운송-적격심사-기준-제4조-제1항-제2호","item_number":"2","content":"적격심사자기평가 및 심사표 (별지 제2호) 1부","subitems":[]},{"id":"DAPA_A_2100000285310_ART_4_P1_I3","display_id":"국제운송-적격심사-기준-제4조-제1항-제3호","item_number":"3","content":"국제운송 이행실적증명서(별지 제3호) 1부","subitems":[]},{"id":"DAPA_A_2100000285310_ART_4_P1_I4","display_id":"국제운송-적격심사-기준-제4조-제1항-제4호","item_number":"4","content":"신용평가등급 확인서 1부","subitems":[]},{"id":"DAPA_A_2100000285310_ART_4_P1_I5","display_id":"국제운송-적격심사-기준-제4조-제1항-제5호","item_number":"5","content":"입찰참가등록 마감일 전일부터 과거 1년 이내에 지체상금을 부과받은 사실이 있는 자로서 위 지체상금에 대한 면제원이 해당 계약에서 제출된 경우(입찰참가등록 마감일 전일 이후부터 위 7일 이내에 제출된 경우도 포함), 지체상금 면제원 제출 현황(계약번호, 계약건명, 납품일자 및 지체상금면제원 제출일자) 및 위 지체상금 면제원이 결정된 경우 지체상금 면제원 결정 현황(결정일, 결정금액)","subitems":[]},{"id":"DAPA_A_2100000285310_ART_4_P1_I6","display_id":"국제운송-적격심사-기준-제4조-제1항-제6호","item_number":"6","content":"제5호의 지체상금 면제원이 취소 요청된 경우 취소 요청 서류","subitems":[]},{"id":"DAPA_A_2100000285310_ART_4_P1_I7","display_id":"국제운송-적격심사-기준-제4조-제1항-제7호","item_number":"7","content":"기타 제출서류 각 1부(별지 제4호 참조)","subitems":[]}]},{"id":"DAPA_A_2100000285310_ART_4_P2","display_id":"국제운송-적격심사-기준-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항에 의하여 제출된 적격심사서류상 첨부목록에 있는 서류가 첨부되어 있지 않거나 제출된 서류가 불명확하여 인지할 수 없는 경우에는 기한을 정하여 보완을 요구할 수 있다.","items":[]},{"id":"DAPA_A_2100000285310_ART_4_P3","display_id":"국제운송-적격심사-기준-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항에 의한 기한까지 보완 요구된 서류가 제출되지 아니한 경우에는 당초 제출된 서류만으로 심사하되, 당초 제출된 서류가 불명확하여 심사하기가 곤란한 경우에는 심사에서 제외한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_4_P4","display_id":"국제운송-적격심사-기준-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"해당평가항목의 제출실적이 없는 경우에는 해당 평가항목의 최저점을 부여한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_4_P5","display_id":"국제운송-적격심사-기준-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제1항과 제2항에 따라 제출 또는 확인할 서류로서 입찰참가 등록마감일 전일 이후에 발생 또는 신고하였거나 수정된 자료는 평가에서 제외한다. 다만 제1항에 의한 기한(제2항이 적용되는 경우에는 제2항에 의한 기한)까지 해당 계약에서 지체상금 면제원이 제출된 경우에는 위 면제원 서류를 평가에 포함하여 [별표 6]에서 정한 바에 따라 평가한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["지체상금","적격심사","신용평가","입찰참가자격","경영상태","계약담당공무원"]},{"id":"DAPA_A_2100000285310_ART_5","display_id":"국제운송-적격심사-기준-제5조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"평가방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_5_P1","display_id":"국제운송-적격심사-기준-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 예정가격 이하로서 최저가로 입찰한 자 순으로 심사한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_5_P2","display_id":"국제운송-적격심사-기준-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 상업운송의 경우 및 FMS운송의 경우 [별표1]의 각 항목별 배점한도 내에서 평가한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_5_P3","display_id":"국제운송-적격심사-기준-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 수행능력 평가를 위한 이행실적 평가기준을 입찰공고에 명시하여야 한다. 이때 이행실적은 이행 완료된 시점이 계약일자와 관계없이 최근 3년 이내에 이행한 금액 또는 규모로서 부가가치세를 제외한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_5_P4","display_id":"국제운송-적격심사-기준-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"합병의 경우 존속되거나 신설된 업체의 실적은 소멸된 자의 실적을 승계한 것으로 합산하여 평가하며, 분할의 경우에는 권리ㆍ의무를 승계 받은 업체의 실적으로 본다. 실적 평가 시 합병ㆍ분할과 관련한 업체의 실적증빙서류를 제출받아 평가하여야 한다.(단, 사업양수도 관련한 실적은 영업양도에 의하여 개인사업자의 영업권 및 채무관계 등 영업을 전부 승계한 경우에만 인정한다.)","items":[]},{"id":"DAPA_A_2100000285310_ART_5_P5","display_id":"국제운송-적격심사-기준-제5조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"이행실적의 평가는 상업운송계약은 관세청 또는 국가기관이, FMS 운송계약은 국방부, 각 군, 방위사업청 및 방위사업청 출연기관이 발행한 실적에 의한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_5_P6","display_id":"국제운송-적격심사-기준-제5조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"입찰자의 국외 파트너(상업운송의 경우는 국외 에이전트 또는 해외지사 또는 현지법인을, FMS운송의 경우는 해외 지사 또는 현지 법인을 의미한다. 이하 같다)에 대한 신용도 평가는 [별표4]에 정한 기준에 따라 평가하되 국외 파트너가 2인 이상인 경우에는 각 국외 파트너 신용도 평점의 평균에 의한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_5_P7","display_id":"국제운송-적격심사-기준-제5조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"신인도 평가 중 계약이행성실도의 지체상금 부과 심사항목은 해당 계약에서 지체상금 면제원이 제출된 경우 [별표 6]에서 정한 바에 따라 평가한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약담당공무원","신인도","배점한도","지체상금","예정가격"]},{"id":"DAPA_A_2100000285310_ART_6","display_id":"국제운송-적격심사-기준-제6조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"공동수급체 등에 대한 평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_6_P1","display_id":"국제운송-적격심사-기준-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"공동수급체로 참여하는 경우에는 구성원별 출자비율 또는 분담비율을 입찰 등록 시까지 확정ㆍ제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_6_P2","display_id":"국제운송-적격심사-기준-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심사대상자가 공동수급체인 경우에는 구성원별 평가결과에 각자의 출자비율 또는 분담비율을 반영하여 평가한다. 단, 이행실적 및 FMS 운송의 창고면적은 구성원별 분담액 기준으로 개별 평가한 후 각자의 분담비율을 반영하여 적용한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체"]},{"id":"DAPA_A_2100000285310_ART_7","display_id":"국제운송-적격심사-기준-제7조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"결격사유의 심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_7_P1","display_id":"국제운송-적격심사-기준-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"공동수급체의 대표자가 결격사유에 해당하는 경우에는 당해 공동수급체의 결격사유로 평가하며, 대표자 이외의 구성원중 결격사유에 해당되는 자가 있는 경우로서 잔여 구성원만으로 계약이행이 가능한 경우에는 적격심사를 할 수 있다. 이 경우 공동수급협정 내용을 변경하게 할 수 있다.","items":[]},{"id":"DAPA_A_2100000285310_ART_7_P2","display_id":"국제운송-적격심사-기준-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"저가입찰로 배점한도 최고점(신인도점수포함)을 적용하여도 90점이 미달될 때에는 적격심사를 생략하고 부적격 처리할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체","적격심사"]},{"id":"DAPA_A_2100000285310_ART_8","display_id":"국제운송-적격심사-기준-제8조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"재심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_8_P1","display_id":"국제운송-적격심사-기준-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사결과 부적격 통보를 받은 자가 통보일로부터 3일 이내에 심사결과에 재심사를 요청하였을 때에는 특별한 사유가 없는 한 재심사요청서 접수일로부터 3일 이내에 재심사를 하여야 한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_8_P2","display_id":"국제운송-적격심사-기준-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 재심사결과는 해당자에게 지체없이 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_8_P3","display_id":"국제운송-적격심사-기준-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항의 재심사요청서를 접수할 때에는 추가서류를 접수할 수 없다.","items":[]},{"id":"DAPA_A_2100000285310_ART_8_P4","display_id":"국제운송-적격심사-기준-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"재심사의 적격심사위원회 구성은 최초 적격심사위원회 위원과 중복되지 않는 5인 이상의 담당관으로 구성하며, 위원장은 팀장급으로 편성한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["적격심사"]},{"id":"DAPA_A_2100000285310_ART_9","display_id":"국제운송-적격심사-기준-제9조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"적격심사위원회 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_9_P1","display_id":"국제운송-적격심사-기준-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 공정하고 합리적인 심사를 위해 적격심사위원회를 구성하여 심사할 수 있다.","items":[]},{"id":"DAPA_A_2100000285310_ART_9_P2","display_id":"국제운송-적격심사-기준-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 경우 심사위원은 관계부서의 5인 이상 담당관으로 구성한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["적격심사","계약담당공무원"]},{"id":"DAPA_A_2100000285310_ART_10","display_id":"국제운송-적격심사-기준-제10조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"지방사무소 등의 확인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_10_P1","display_id":"국제운송-적격심사-기준-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 입찰자의 지방사무소나 국외파트너의 실태를 확인할 필요가 있는 용역에 대해서는 그 내용을 입찰공고 조건에 명시하여야 한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_10_P2","display_id":"국제운송-적격심사-기준-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 업체실태 확인대상은 입찰결과 예정가격 이내의 입찰자에 한하여 적용한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_10_P3","display_id":"국제운송-적격심사-기준-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"계약담당공무원은 입찰자의 지방사무소나 국외파트너의 실태확인을 위한 별도의 세부기준을 정할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약담당공무원","예정가격"]},{"id":"DAPA_A_2100000285310_ART_11","display_id":"국제운송-적격심사-기준-제11조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"낙찰자 결정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_11_P1","display_id":"국제운송-적격심사-기준-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"예정가격 이하로서 최저가로 입찰한 자 순으로 심사하며, 심사결과 종합평점이 90점 이상인 경우 낙찰자로 결정하고, 종합평점이 90점 미만일 경우에는 차 순위 입찰자 순으로 심사하여 낙찰자를 결정한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_11_P2","display_id":"국제운송-적격심사-기준-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"동일가격의 최저가 입찰자가 2인 이상일 경우, 적격심사결과 종합평점이 90점 이상인 자 중에서 최고점수인 자를 낙찰자로 결정하며, 평가점수가 동일한 경우에는 추첨으로 낙찰자를 결정한다","items":[]},{"id":"DAPA_A_2100000285310_ART_11_P3","display_id":"국제운송-적격심사-기준-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"적격심사에 소요되는 행정소요기간을 감안하여 필요하다고 인정되는 경우에는 예정가격 이내 입찰자를 대상으로 동시에 적격심사서류를 제출받을 수 있다.","items":[]},{"id":"DAPA_A_2100000285310_ART_11_P4","display_id":"국제운송-적격심사-기준-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"계약의 특성상 평가가 곤란한 항목이 있는 경우에는 입찰공고 시 그 내용을 명시하여 그 항목을 제외한 나머지 심사항목만으로 심사하고, 심사결과 종합평점이 나머지 심사항목 배점한도의 100분의 90 이상인 자를 낙찰자로 결정할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["낙찰자","예정가격","적격심사","최저가낙찰"]},{"id":"DAPA_A_2100000285310_ART_12","display_id":"국제운송-적격심사-기준-제12조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"평가결과 설명 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_12_P1","display_id":"국제운송-적격심사-기준-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"입찰에 참여한 업체는 본인의 적격심사결과에 대해 설명을 원하는 경우 심사결과를 통보받은 날로부터 3근무일 이내에 서면(형식 불문)으로 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000285310_ART_12_P2","display_id":"국제운송-적격심사-기준-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"북미지역협력담당관은 설명 요청서가 접수된 날로부터 5근무일 이내에 [별지 제5호]를 참고하여 설명을 실시한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_12_P3","display_id":"국제운송-적격심사-기준-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"적격심사결과에 이의가 있는 업체는 설명일로부터 3근무일 이내에 이의신청을 할 수 있으며, 북미지역협력담당관은 신청일로부터 7근무일 이내 처리하고 그 결과를 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000285310_ART_12_P4","display_id":"국제운송-적격심사-기준-제12조-제4항","paragraph_number":"④","paragraph_index":4,"content":"북미지역협력담당관은 제3항의 처리기한 내 처리가 불가능할 경우 그 사유와 새로운 처리기한을 정하여 이의 신청자에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["이의신청","적격심사"]},{"id":"DAPA_A_2100000285310_ART_13","display_id":"국제운송-적격심사-기준-제13조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"부정한 방법으로 심사서류를 제출한 자의 처리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_13_P1","display_id":"국제운송-적격심사-기준-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사대상자가 이 규정에 따라 제출한 서류 중 허위로 작성된 서류가 포함된 것으로 판명된 때와 정당한 사유 없이 적격심사 자료의 전부 또는 일부를 제출하지 아니한 때에는 다음 각 호와 같이 처리하여야 한다.","items":[{"id":"DAPA_A_2100000285310_ART_13_P1_I1","display_id":"국제운송-적격심사-기준-제13조-제1항-제1호","item_number":"1","content":"계약체결 이전인 경우에는 적격 낙찰자 결정대상에서 제외 또는 결정통보를 취소한다.","subitems":[]},{"id":"DAPA_A_2100000285310_ART_13_P1_I2","display_id":"국제운송-적격심사-기준-제13조-제1항-제2호","item_number":"2","content":"계약체결 이후인 경우에는 당해 계약을 해제 또는 해지할 수 있다.","subitems":[]}]},{"id":"DAPA_A_2100000285310_ART_13_P2","display_id":"국제운송-적격심사-기준-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전항에 해당하는 자에 대하여는 「국가를 당사자로 하는 계약에 관한 법률 시행령」 제76조에 의한 입찰참가자격 제한조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_76"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["입찰참가자격","입찰참가자격 제한","적격심사","낙찰자","계약서 작성"]},{"id":"DAPA_A_2100000285310_ART_14","display_id":"국제운송-적격심사-기준-제14조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"기타사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_14_P1","display_id":"국제운송-적격심사-기준-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 기준에서 별도로 정하지 아니한 사항에 대하여는 재정경제부 (계약예규) 적격심사기준을 적용할 수 있다.","items":[]},{"id":"DAPA_A_2100000285310_ART_14_P2","display_id":"국제운송-적격심사-기준-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약의 특성에 따라 별도로 필요한 사항은 관련 상위법령 및 본 기준의 규정 범위 내에서 입찰공고 또는 입찰설명서 등에 반영하여 시행할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000285310_ART_15","display_id":"국제운송-적격심사-기준-제15조","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_ART_15_P0","display_id":"국제운송-적격심사-기준-제15조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 예규에 대하여「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2026년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000285310_SUPP1_PRE","display_id":"국제운송-적격심사-기준-부칙1","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_SUPP1_PRE_P0","display_id":"국제운송-적격심사-기준-부칙1","paragraph_number":"","paragraph_index":null,"content":"1. 이 기준은 개정발령한 날부터 유효하며 다만, 별표1-1-1-비고, 별지제3호-주-①은 2006. 6. 28.일 이후의 적격심사대상인국제운송용역의 입찰공고분부터 적용한 것으로 본다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"국제운송 적격심사 기준.json","source_path":"원문/법제처API/국제운송 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제2006-43호,2006. 7. 13.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000285310_SUPP2_PRE","display_id":"국제운송-적격심사-기준-부칙2","regulation_id":"DAPA_A_2100000285310","regulation_name":"국제운송 적격심사 기준","short_name":"국제운송 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":2,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285310_SUPP2_PRE_P0","display_id":"국제운송-적격심사-기준-부칙2","paragraph_number":