[{"id":"DAPA_A_2100000196844_ART_1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제1조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_1_P0","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은『공무원 후생복지에 관한 규정』및『공무원보수 등의 업무지침』에서 위임된 사항 중 방위사업청 공무원 맞춤형 복지제도 운영에 관한 업무처리기준을 정함으로써 맞춤형 복지제도를 효율적으로 운영하여 직원의 복지증진을 도모함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_2_P0","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000196844_ART_2_P0_I1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조-제1호","item_number":"1","content":"\"맞춤형 복지제도”라 함은 방위사업청과 소속기관의 공무원(이하 \"소속공무원”이라 한다)에 대하여 예산의 범위 내에서 복지점수를 부여한 후 사전에 설계되어 제공되는 복지혜택 중에서 공무원이 본인의 선호와 필요에 따라 개별적으로 부여된 복지점수를 사용하여 자신에게 적합한 복지혜택을 선택하도록 하는 제도를 말한다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_2_P0_I2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조-제2호","item_number":"2","content":"\"기본항목”이라 함은 맞춤형 복지제도에 의한 복지혜택 중에서 정책적 필요에 의하여 전체 공무원이 의무적으로 선택하도록 설계·운영되는 복지항목을 말한다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_2_P0_I3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조-제3호","item_number":"3","content":"\"자율항목”이라 함은 맞춤형 복지제도에 의한 복지혜택 중에서 공무원이 자율적으로 선택하도록 설계·운영되는 복지항목을 말한다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_2_P0_I4","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조-제4호","item_number":"4","content":"\"복지점수”라 함은 맞춤형 복지제도를 설계·운영함에 있어 필요한 예산의 배정이나 복지혜택의 구매 및 정산에 사용되는 계산단위를 말한다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_2_P0_I5","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조-제5호","item_number":"5","content":"\"기본복지점수”라 함은 공무원 개개인에게 공통적으로 부여되는 복지점수를 말한다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_2_P0_I6","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제2조-제6호","item_number":"6","content":"\"변동복지점수”라 함은 근무연수, 부양가족의 수 등 일정한 기준에 따라 개인별로 차등 부여되는 복지점수를 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제3조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용범위 및 기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_3_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 지침은 현역군인을 제외한 소속공무원에게 적용한다. 다만, 휴직자, 시보근무중인 자 및 견습직원, 국외에 파견중인 자에 대하여는 이 지침에 의한 복지제도의 적용을 제한 또는 배제할 수 있으며, 적용기준은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000196844_ART_3_P1_I1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제3조-제1항-제1호","item_number":"1","content":"휴직자에 대한 적용기준은 별표 1과 같다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_3_P1_I2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제3조-제1항-제2호","item_number":"2","content":"국외에 파견중인 자에 대한 맞춤형 복지제도의 적용기준은 별표 2와 같다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_3_P1_I3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제3조-제1항-제3호","item_number":"3","content":"<삭제>","subitems":[]},{"id":"DAPA_A_2100000196844_ART_3_P1_I4","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제3조-제1항-제4호","item_number":"4","content":"시보근무자, 견습직원에 대하여는 당해 연도 예산을 고려하여 적용한다.","subitems":[]}]},{"id":"DAPA_A_2100000196844_ART_3_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"청원경찰·기간제 근로자 등 청에 근무 중인 자로서 ‘공무원이 아닌 자’에 대하여는 당해 연도 예산을 고려하여 공무원에 준하여 맞춤형 복지제도를 적용한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_4","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제4조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_4_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청 소속공무원의 복지증진을 위해 매년 맞춤형복지제도를 설계·운영한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_4_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청 소속공무원에 대한 복지점수의 배정·관리·정산 및 단체보험료 납입·반납·세입조치 등 맞춤형복지제도 운영은 운영지원과장이 한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_4_P3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"이 제도 운영기간은 매년 1월 1일부터 12월 31일까지로 하며 효율적인 결산을 위해 자율항목의 사용은 11월 30일까지로 한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_4_2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제4조의2","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4의2","article_label":"제4조의2","article_title":"준용규정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_4_2_P0","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제4조의2","paragraph_number":"","paragraph_index":null,"content":"공무원 맞춤형 복지제도에 관하여 이 지침에서 정하지 아니한 사항은 인사혁신처「공무원보수 등의 업무지침」을 준용한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_5","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제5조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제2장 맞춤형 복지제도의 설계","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"맞춤형 복지의 항목","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_5_P0","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제5조","paragraph_number":"","paragraph_index":null,"content":"맞춤형 복지의 항목은 기본항목과 자율항목으로 구성한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_6","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제6조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제2장 맞춤형 복지제도의 설계","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"기본항목","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_6_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기본항목은 필수기본항목과 선택기본항목으로 구분한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_6_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"필수기본항목은 공무원과 그 가족의 복지 및 생활안정을 보장하기 위하여 정부에서 그 필요성을 판단하여 전체공무원이 의무적으로 선택하도록 하는 항목으로 생명보험, 상해보험 등으로 구성하며, 그 보장범위와 세부조건은 제14조에 의한 방위사업청 후생복지운영협의회에서 정한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_6_P3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"선택기본항목은 본인 및 가족의료비 보장보험, 건강검진 등 방위사업청 조직운영의 목적이나 기타 정책적 필요에 따라 설정하는 항목으로서 소속공무원이 모두 의무적으로 선택하게 하거나 일정요건에 해당하는 경우 자동적으로 선택한 것으로 처리할 수 있다.","items":[]},{"id":"DAPA_A_2100000196844_ART_6_P4","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"기본항목은 적용기간 중 신분변동, 소속변동과 동시에 발생(전입, 복직, 임용) 또는 소멸(퇴직)하고, 인사발령 일자를 기준으로 한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000196844_ART_14"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_7","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제7조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제2장 맞춤형 복지제도의 설계","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"자율항목","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_7_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"자율항목은 공무원의 능력발전 및 삶의 질 향상에 기여할 수 있도록 본인의 선호와 필요에 따라 자율적으로 선택하여 사용할 수 있는 복지항목으로서 자기개발·건강관리·여가활용(레저·취미)·문화생활·가정친화 등을 위한 것으로서 복지점수 사용이 가능한 항목 예시는 별표 4와 같다.","items":[]},{"id":"DAPA_A_2100000196844_ART_7_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"다음 각 호에 대하여는 복지점수를 사용할 수 없다.","items":[{"id":"DAPA_A_2100000196844_ART_7_P2_I1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제7조-제2항-제1호","item_number":"1","content":"사행성이 있거나 불건전한 지출(보석, 복권, 경마장 마권, 유흥비 등)","subitems":[]},{"id":"DAPA_A_2100000196844_ART_7_P2_I2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제7조-제2항-제2호","item_number":"2","content":"현금과 유사한 유가증권 및 물품 구매(상품권, 주유권, 증권 등) 다만, 상품권 중 온누리상품권, 지역사랑상품권은 제외한다.","subitems":[]},{"id":"DAPA_A_2100000196844_ART_7_P2_I3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제7조-제2항-제3호","item_number":"3","content":"치료 목적이 아닌 미용관련 의료행위(성형, 치열교정 등)","subitems":[]}]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_8","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제8조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제3장 복지점수의 부여 및 관리","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"복지점수의 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_8_P0","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제8조","paragraph_number":"","paragraph_index":null,"content":"맞춤형 복지제도에 의한 복지점수는 기본복지점수와 변동복지점수로 구성한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_9","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제9조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제3장 복지점수의 부여 및 관리","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"복지점수의 부여 및 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_9_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"복지점수는 매년 통보되는『공무원보수 등의 업무지침』의 범위 안에서 배정하며, 복지점수의 기본 배정기준은 별표 5와 같다.","items":[]},{"id":"DAPA_A_2100000196844_ART_9_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기본복지점수는 소속공무원에게 일률적으로 부여하고, 변동복지점수는 근속복지점수와 가족복지점수 등으로 구분하여 부여한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_9_P3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"복지점수는 당해 연내에 사용하여야 하며, 사용 후 남은 복지점수는 다음 연도로 이월하거나 금전으로 환급하지 아니한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_9_P4","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"복지점수의 과오배정, 해외파견으로 인한 환수 불능 등 소급·환수사유가 발생한 경우에는 회계연도 마감 후라도 소급 배정·환수 할 수 있다. 다만, 소멸시효에 관한 사항은 국가재정법 및 민법 등 관계법령에 따른다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_10","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제10조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제3장 복지점수의 부여 및 관리","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"복지점수의 계산방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_10_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"개인별 복지점수를 부여시 소수점 이하는 절사한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_10_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"적용기간중 신규채용, 전보, 휴직, 복직, 퇴직(면직·해임·파면으로 인한 퇴직 포함)등으로 인하여 복지점수 사용권한이 발생·중단 또는 소멸할 경우에는 그 변동일을 기준으로 월할계산에 따라 복지점수를 계산한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_10_P3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항의 \"월할계산”이란 당해 연도의 복지점수를 12월로 나누어 계산하는 것으로 신규채용, 전보, 휴직, 복직, 퇴직(면직·해임·파면으로 인한 퇴직 포함), 국외파견 등의 경우 복지점수 부여사유가 있는 달이 속한 월을 실제 근무한 달로 계산하는 것을 말한다. 다만, 휴직, 퇴직, 해임, 파면일이 매월 1일인 경우에는 당해 월을 실제 근무한 달로 계산하지 아니하며, 동일한 월에 면직된 후 재임용된 경우에는 중복되지 않고 1월로 계산한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_11","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제11조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제3장 복지점수의 부여 및 관리","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"신분변동자에 대한 복지점수 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_11_P0","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제11조","paragraph_number":"","paragraph_index":null,"content":"신분의 변동이 있는 자의 복지점수는 별표 6과 같이 관리한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_12","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제12조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제3장 복지점수의 부여 및 관리","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"복지점수의 사용","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_12_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기본항목에 대한 소요비용은 매년 보험사와의 약정과 동시에 개인별 복지점수에서 공제한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_12_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"자율항목에 대한 복지점수 사용은 제휴카드 사용 등으로 처리하며 비용은 월별로 정산한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_12_P3","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기타 복지점수 사용의 세부 사항은 매년 통보되는 인사혁신처 예규「공무원보수 등의 업무지침」범위 내에서 운영지원과장이 소속공무원에게 안내하며, 불용예산이 발생하지 않도록 적극적으로 홍보한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_13","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제13조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제3장 복지점수의 부여 및 관리","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"운용수익의 처리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_13_P0","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제13조","paragraph_number":"","paragraph_index":null,"content":"카드의 발급과 이용자 카드 매출액으로부터 발생하는 복지기금 등 운영수익에 대하여는 복지재원의 건전화와 투명성 확보를 위하여 소속 공무원에게 전액 환급하는 것을 원칙으로 한다. 단, 필요시 소속 공무원의 종합된 의견을 바탕으로 소속 공무원의 후생복지 등의 용도로 사용은 제14조에 의한 방위사업청 후생복지운영협의회에서 결정한다.","items":[]}],"notes":[],"effective_date":"2021-01-01","revision_date":"2021-01-01","source_file":"방위사업청 공무원 맞춤형 복지제도 운영지침.json","source_path":"원문/법제처API/방위사업청 공무원 맞춤형 복지제도 운영지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000196844_ART_14"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000196844_ART_14","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제14조","regulation_id":"DAPA_A_2100000196844","regulation_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","short_name":"방위사업청 공무원 맞춤형 복지제도 운영지침","document_type":"예규","part":"","chapter":"제4장 후생복지운영협의회","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"후생복지운영협의회의 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000196844_ART_14_P1","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"맞춤형 복지제도의 효율적인 운영을 위하여「방위사업청 후생복지운영협의회」(이하 \"운영협의회”라 한다)를 설치·운영한다.","items":[]},{"id":"DAPA_A_2100000196844_ART_14_P2","display_id":"방위사업청-공무원-맞춤형-복지제도-운영지침-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"운영협의