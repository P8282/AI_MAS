[{"id":"DAPA_A_2100000257912_ART_1","display_id":"전문연구기관-위촉-및-해지-규정-제1조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_1_P0","display_id":"전문연구기관-위촉-및-해지-규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위사업법 시행령」 제46조 및 제63조에 따른 전문연구기관 위촉 및 해지, 검토에 관하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_46","DEFENSE_ACQ_ENFORCEMENT_ART_63"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_2","display_id":"전문연구기관-위촉-및-해지-규정-제2조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_2_P1","display_id":"전문연구기관-위촉-및-해지-규정-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"전문연구기관은 방위산업물자의 연구개발.시험.측정, 방위산업물자의 시험 등을 위한 기계.기구의 제작.검증, 방위산업체의 경영분석 또는 방위산업과 관련되는 소프트웨어의 개발을 위하여 방위사업청장의 위촉을 받은 기관을 말한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_2_P2","display_id":"전문연구기관-위촉-및-해지-규정-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"\"전문연구기관 정기평가\"(이하 \"정기평가\"라 한다)라 함은 「방위사업법 시행규칙」 제38조 제2항의 검토를 말한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_RULE_ART_38"],"related_regulations":["DEFENSE_ACQ_RULE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_3","display_id":"전문연구기관-위촉-및-해지-규정-제3조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"전문연구기관 위촉 신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_3_P1","display_id":"전문연구기관-위촉-및-해지-규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"「방위사업법 시행령」 제46조의 위촉을 받고자 하는 기관은 별표5의 전문연구기관 위촉신청서를 작성하여 기획조정관에게 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_3_P2","display_id":"전문연구기관-위촉-및-해지-규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기획조정관은 제1항의 규정에 의하여 전문연구기관 위촉 신청을 받은 경우에는 3월 이내에 전문연구기관 위촉여부를 결정하여 신청기관에게 통보한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_46"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_4","display_id":"전문연구기관-위촉-및-해지-규정-제4조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"전문연구기관 위촉 검토","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_4_P0","display_id":"전문연구기관-위촉-및-해지-규정-제4조","paragraph_number":"","paragraph_index":null,"content":"정책조정담당관은 전문연구기관 위촉 신청을 받은 경우, 신청기관에 대한 보안측정을 요청하고 제11조에 따른 평가위원을 선정하여 위촉여부 결정을 위한 서면평가 및 현장평가를 실시한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000257912_ART_11"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_5","display_id":"전문연구기관-위촉-및-해지-규정-제5조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"서면평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_5_P1","display_id":"전문연구기관-위촉-및-해지-규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"평가위원은 별표1의 평가항목 및 기준에 따라 평가결과를 작성한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_5_P2","display_id":"전문연구기관-위촉-및-해지-규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"정책조정담당관은 각 평가위원의 평가결과를 평균하여 서면평가결과를 산정하며 위촉을 위한 서면평가 기준점수는 총배점의 70% 이상으로 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["평가위원"]},{"id":"DAPA_A_2100000257912_ART_6","display_id":"전문연구기관-위촉-및-해지-규정-제6조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"현장평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_6_P1","display_id":"전문연구기관-위촉-및-해지-규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"평가위원은 전문연구기관 위촉 여부를 결정하기 위해 현장평가를 실시할 수 있다. 다만, 현장평가가 불필요하거나 불가하다고 판단되는 경우에는 현장평가를 생략할 수 있다.","items":[]},{"id":"DAPA_A_2100000257912_ART_6_P2","display_id":"전문연구기관-위촉-및-해지-규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"현장평가는 별표 2의 양식에 따라 \"합격\" 또는 \"불합격\"으로 평가한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_7","display_id":"전문연구기관-위촉-및-해지-규정-제7조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"보안측정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_7_P0","display_id":"전문연구기관-위촉-및-해지-규정-제7조","paragraph_number":"","paragraph_index":null,"content":"「방위사업법 시행령」 제44조제2항의 보안측정은 정책조정담당관이 운영지원과장에게 요청한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_44"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_8","display_id":"전문연구기관-위촉-및-해지-규정-제8조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"전문연구기관 위촉","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_8_P1","display_id":"전문연구기관-위촉-및-해지-규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기획조정관은 전문연구기관 위촉을 신청한 기관이 서면평가 및 현장평가, 보안측정의 기준을 충족하는 경우에 위촉을 승인하고 위촉서를 발급한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_8_P2","display_id":"전문연구기관-위촉-및-해지-규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"정책조정담당관은 서면평가결과가 위촉 기준점수 이상이지만 각 평가위원간의 점수 차이가 현저하여 검토가 필요하다고 판단되는 경우에는 평가위원 전원이 참여하는 회의를 소집할 수 있다.","items":[]},{"id":"DAPA_A_2100000257912_ART_8_P3","display_id":"전문연구기관-위촉-및-해지-규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"정책조정담당관은 전문연구기관 위촉서 발급대장을 작성ㆍ비치한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["평가위원"]},{"id":"DAPA_A_2100000257912_ART_9","display_id":"전문연구기관-위촉-및-해지-규정-제9조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"전문연구기관 위촉 해지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_9_P1","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기획조정관은 다음 각호에 해당하는 경우 전문연구기관 위촉을 해지할 수 있다.","items":[{"id":"DAPA_A_2100000257912_ART_9_P1_I1","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제1항-제1호","item_number":"1","content":"보안측정에 미달하게 된 때","subitems":[]},{"id":"DAPA_A_2100000257912_ART_9_P1_I2","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제1항-제2호","item_number":"2","content":"정당한 이유없이 방산물자의 연구개발 또는 시제생산 등의 위촉을 거부하거나 이행하지 아니할 때","subitems":[]},{"id":"DAPA_A_2100000257912_ART_9_P1_I3","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제1항-제3호","item_number":"3","content":"전문연구기관으로서 위촉의 목적을 달성하여 계속적인 위촉이 불필요하게 된 때","subitems":[]},{"id":"DAPA_A_2100000257912_ART_9_P1_I4","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제1항-제4호","item_number":"4","content":"전문연구기관으로 위촉될 당시보다 현저히 시설 또는 기술능력이 미달하여 방위사업청장이 보완요청을 하였으나 이를 이행하지 아니하였을 때","subitems":[]},{"id":"DAPA_A_2100000257912_ART_9_P1_I5","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제1항-제5호","item_number":"5","content":"위촉기관이 위촉해지를 원할 때","subitems":[]}]},{"id":"DAPA_A_2100000257912_ART_9_P2","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기획조정관이 전문연구기관의 위촉을 해지할 경우에는 위촉 절차를 준용하여 평가단의 검토 의견 수렴 후에 위촉해지 여부를 결정한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_9_P3","display_id":"전문연구기관-위촉-및-해지-규정-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기획조정관은 전문연구기관의 위촉을 해지하는 경우에 청문을 실시하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_10","display_id":"전문연구기관-위촉-및-해지-규정-제10조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"정기평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_10_P1","display_id":"전문연구기관-위촉-및-해지-규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기획조정관은 전문연구기관 위촉 유지 여부를 결정하기 위해 방위사업법 시행규칙 제38조제2항에 따라 3년 주기로 정기평가를 하여야 하며, 정기평가 대상기관에 평가계획을 정기평가 예정 연도 초에 통보할 수 있다.","items":[]},{"id":"DAPA_A_2100000257912_ART_10_P2","display_id":"전문연구기관-위촉-및-해지-규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"정기 서면평가는 별표3의 양식에 따른다.","items":[]},{"id":"DAPA_A_2100000257912_ART_10_P3","display_id":"전문연구기관-위촉-및-해지-규정-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"정기 현장평가는 별표4의 양식에 따른다.","items":[]},{"id":"DAPA_A_2100000257912_ART_10_P4","display_id":"전문연구기관-위촉-및-해지-규정-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"정책조정담당관은 정기평가 대상기관의 보안측정을 운영지원과장에게 의뢰한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_10_P5","display_id":"전문연구기관-위촉-및-해지-규정-제10조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"기획조정관은 서면평가결과가 총배점의 70% 이상이고 현장평가 결과 및 보안측정이 기준을 충족하는 경우에 전문연구기관 위촉을 유지한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_10_P6","display_id":"전문연구기관-위촉-및-해지-규정-제10조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"정기평가 결과 위촉을 해지하고자 하는 경우 방위사업법 시행령 제63조에 의거 청문 등의 절차를 거쳐야 한다. 다만, 정기평가 대상기관의 원에 의해 위촉해지를 요청하는 경우에는 청문을 실시하지 아니할 수 있다.","items":[]},{"id":"DAPA_A_2100000257912_ART_10_P7","display_id":"전문연구기관-위촉-및-해지-규정-제10조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"기획조정관은 정기평가 대상기관에 정기평가 결과를 통보한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_RULE_ART_38","DEFENSE_ACQ_ENFORCEMENT_ART_63"],"related_regulations":["DEFENSE_ACQ_RULE","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_ART_11","display_id":"전문연구기관-위촉-및-해지-규정-제11조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"평가위원의 선정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_11_P1","display_id":"전문연구기관-위촉-및-해지-규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"정책조정담당관은 7인 이하로 평가위원을 선정하여 위촉여부 결정 또는 정기평가를 수행한다. 단, 평가위원은 교수, 연구원 등의 외부 전문가를 1/2이상 포함한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_11_P2","display_id":"전문연구기관-위촉-및-해지-규정-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"정책조정담당관은 비밀취급인가가 필요한 경우에 한하여 외부 평가위원에 대한 신원조사를 운영지원과장에게 의뢰하고 신원조사 결과 \"적격\"인 경우 비밀취급인가증 발급을 요청해야 한다. 정기평가가 종료된 이후에는 외부평가위원으로부터 비밀취급인가증을 회수하여 운영지원과에 반납한다.","items":[]},{"id":"DAPA_A_2100000257912_ART_11_P3","display_id":"전문연구기관-위촉-및-해지-규정-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"각 평가위원은 별표 6의 평가위원 서약서를 작성하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["평가위원"]},{"id":"DAPA_A_2100000257912_ART_12","display_id":"전문연구기관-위촉-및-해지-규정-제12조","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_ART_12_P0","display_id":"전문연구기관-위촉-및-해지-규정-제12조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 훈령에 대하여 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2025년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000257912_SUPP_PRE","display_id":"전문연구기관-위촉-및-해지-규정-부칙","regulation_id":"DAPA_A_2100000257912","regulation_name":"전문연구기관 위촉 및 해지 규정","short_name":"전문연구기관 위촉 및 해지 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"0","article_label":"부칙","article_title":"","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000257912_SUPP_PRE_P0","display_id":"전문연구기관-위촉-및-해지-규정-부칙","paragraph_number":"","paragraph_index":null,"content":"이 규정은 발령한 날부터 시행한다.","items":[]}],"notes":[],"effective_date":"2025-04-16","revision_date":"2025-04-16","source_file":"전문연구기관 위촉 및 해지 규정.json","source_path":"원문/법제처API/전문연구기관 위촉 및 해지 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제911호, 2025. 4. 16.>","related_articles":[],"related_regulations":[],"external_references