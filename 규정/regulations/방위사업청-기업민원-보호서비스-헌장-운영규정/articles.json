[{"id":"DAPA_A_2100000182352_ART_1","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제1조","regulation_id":"DAPA_A_2100000182352","regulation_name":"방위사업청 기업민원 보호·서비스 헌장 운영규정","short_name":"방위사업청 기업민원 보호·서비스 헌장 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182352_ART_1_P0","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「행정서비스 헌장 규정(대통령훈령)」에 의하여 방위사업청의 기업민원 보호·서비스헌장을 운영하는데 필요한 사항을 규정하여 방위사업청 기업 고객들에게 수준 높은 민원행정서비스를 제공함으로써 기업이 활동하기 좋은 환경을 조성하여 정부와 기업이 소통하고 신뢰할 수 있는 민원행정을 실현함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2019-09-23","revision_date":"2019-09-23","source_file":"방위사업청 기업민원 보호·서비스 헌장 운영규정.json","source_path":"원문/법제처API/방위사업청 기업민원 보호·서비스 헌장 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000182352_ART_2","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제2조","regulation_id":"DAPA_A_2100000182352","regulation_name":"방위사업청 기업민원 보호·서비스 헌장 운영규정","short_name":"방위사업청 기업민원 보호·서비스 헌장 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182352_ART_2_P0","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000182352_ART_2_P0_I1","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제2조-제1호","item_number":"1","content":"‘기업민원 보호·서비스헌장’(이하\"헌장\"이라 한다)이라 함은 방위사업청에서 제공하는 기업민원 행정서비스(이하\"서비스\"라 한다)의 기준과 내용, 이를 제공받을 수 있는 절차와 방법, 잘못된 서비스에 대한 시정 및 보상조치 등을 구체적으로 정하여 공표하고, 이의 실현을 기업 고객에게 약속하는 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000182352_ART_2_P0_I2","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제2조-제2호","item_number":"2","content":"‘기업고객’이라 함은 방위사업청과 직접 또는 간접으로 관계가 있는 기업·기업인 등을 말한다.","subitems":[]},{"id":"DAPA_A_2100000182352_ART_2_P0_I3","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제2조-제3호","item_number":"3","content":"‘기업민원 보호’이라 함은 규제개선, 애로해소 등에 관한 의견을 제출한 기업·기업인에게 행정기관이 불이익을 주거나 차별을 하지 않은 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000182352_ART_2_P0_I4","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제2조-제4호","item_number":"4","content":"‘기업고객만족도’라 함은 헌장 이행 기준에 따라 방위사업청 공무원들이 기업고객에게 제공하는 서비스에 대한 고객들의 평가결과를 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2019-09-23","revision_date":"2019-09-23","source_file":"방위사업청 기업민원 보호·서비스 헌장 운영규정.json","source_path":"원문/법제처API/방위사업청 기업민원 보호·서비스 헌장 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000182352_ART_3","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제3조","regulation_id":"DAPA_A_2100000182352","regulation_name":"방위사업청 기업민원 보호·서비스 헌장 운영규정","short_name":"방위사업청 기업민원 보호·서비스 헌장 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182352_ART_3_P0","display_id":"방위사업청-기업민원-보호서비스-헌장-운영규정-제3조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업청과 그 소속기관에 적용함을 원칙으로 하되, 출연기관에서도 이를 준용할 수 있다.","items":[]}],"notes":[],"effective_date":"2019-09-23","revision_date":"2019-09-23","source_file":"방위사업청 기업민원 보호·서비스 헌장 운영규정.json","source_path":"원문/법제처API/방위사업청 기업민원 보호·서비스 헌장 운영규정.json","pdf_path":"","s