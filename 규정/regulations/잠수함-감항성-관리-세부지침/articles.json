[{"id":"DAPA_A_2100000253156_ART_1","display_id":"잠수함-감항성-관리-세부지침-제1조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_1_P0","display_id":"잠수함-감항성-관리-세부지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「방위사업관리규정」제85조제8항에 따라 잠수함의 항해 안전성 확보를 위해 필요한 잠수함 감항성 관리 업무의 절차 등을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MANAGEMENT_DIRECTIVE_ART_85"],"related_regulations":["DAPA_MANAGEMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_2","display_id":"잠수함-감항성-관리-세부지침-제2조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_2_P1","display_id":"잠수함-감항성-관리-세부지침-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 지침은 합참 소요결정 이후 선행연구 단계부터 방위력개선사업 종결시까지 적용한다. 이 때 종결이라 함은 「방위사업관리규정」 제55조(사업종결)를 따른다.","items":[]},{"id":"DAPA_A_2100000253156_ART_2_P2","display_id":"잠수함-감항성-관리-세부지침-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"이 지침은 방위사업청 및 그 소속기관과 이 규정에서 정하는 업무와 관련 있는 기관(업체)에 적용한다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MANAGEMENT_DIRECTIVE_ART_55"],"related_regulations":["DAPA_MANAGEMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_3","display_id":"잠수함-감항성-관리-세부지침-제3조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_3_P0","display_id":"잠수함-감항성-관리-세부지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용되는 용어의 정의는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000253156_ART_3_P0_I1","display_id":"잠수함-감항성-관리-세부지침-제3조-제1호","item_number":"1","content":"\"잠수함\"이란 국방전력발전업무훈령 제7조 및 [별표4] 무기체계 세부분류의 함정무기체계\"잠수함\"(소분류)에 해당하는 무기체계를 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I2","display_id":"잠수함-감항성-관리-세부지침-제3조-제2호","item_number":"2","content":"\"감항성(Seaworthiness)\"이란 잠수함이 자체의 안정성을 확보하기 위하여 갖추어야 하는 능력으로서 운용범위 내에서 안전하게 항해할 수 있는 성능을 말한다. 여기서 \"운용범위\"란 잠수함 감항성관리요구서에서 정한 함의 작전 환경조건(해상상태, 운항구역 등)을 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I3","display_id":"잠수함-감항성-관리-세부지침-제3조-제3호","item_number":"3","content":"\"감항성 관리(Seaworthiness Management)\"란 잠수함의 설계, 건조 및 운용유지단계 등 총수명주기 간에 감항성을 확보 및 유지할 수 있도록 관리함을 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I4","display_id":"잠수함-감항성-관리-세부지침-제3조-제4호","item_number":"4","content":"\"검증(Verification)\"이란 개발자 또는 제작자가 수행하며, 개발 또는 제작ㆍ생산 시에 체계 또는 체계 구성요소가 부여된 규정, 규격 또는 조건에 맞는지 평가하는 과정을 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I5","display_id":"잠수함-감항성-관리-세부지침-제3조-제5호","item_number":"5","content":"\"주요안전품목(CSI : Critical Safety Item)\"이란 어떤 품목의 특성상 고장, 오작동 또는 장착이 안 되었을 경우 잠수함 또는 탑재장비/설비의 심각한 손상이나 손실, 인명의 손상이나 손실 등을 일으켜 안전을 위태롭게 할 수 있는 잠수함의 침수 및 부상, 추진, 부력, 제어, 구조, 탈출, 대피, 화재, 계류, 예인, 통신, 항법, 대기제어 등과 관련된 품목을 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I6","display_id":"잠수함-감항성-관리-세부지침-제3조-제6호","item_number":"6","content":"\"확인(Validation)\"이란 개발자 또는 제작자가 아닌 제3자가 수행하며, 체계 또는 체계 구성요소가 기술적인 정확성과 적절성을 가지고 정해진 요구사항을 충족하는지를 결정하기 위해 검증을 통해 수집된 자료와 사실에 대해 검토하여 평가하는 과정을 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I7","display_id":"잠수함-감항성-관리-세부지침-제3조-제7호","item_number":"7","content":"\"적합성(Compliance)\"이란 잠수함의 설계 및 건조가 잠수함 사업별 감항성관리 기준을 충족함을 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I8","display_id":"잠수함-감항성-관리-세부지침-제3조-제8호","item_number":"8","content":"\"적합성 검증방법(MOC : Methods of Compliance)\"이란 사업별 감항성관리기준에 대한 적합 여부를 검증 또는 시범하기 위한 논리적 또는 체계적인 방법을 의미하며, 검증방법에는 검사, 분석, 시범, 정박시험 및 항해시험 등이 있다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I9","display_id":"잠수함-감항성-관리-세부지침-제3조-제9호","item_number":"9","content":"\"면제(Waiver)\"란 잠수함 사업별 감항성관리기준에 대한 확인과정에서 식별된 일부 미충족한 기준에 대하여 위험도 평가결과와 조치계획을 바탕으로 감항성에 미치는 영향을 판단하여 해당 기준을 영구 또는 임시적으로 미적용하는 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I10","display_id":"잠수함-감항성-관리-세부지침-제3조-제10호","item_number":"10","content":"\"감항성관리요구서\"란 감항성관리계획서 수립에 필수적인 함 운용개념을 기반으로 감항성 관리 관련 요구사항을 기술한 문서를 말한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_3_P0_I11","display_id":"잠수함-감항성-관리-세부지침-제3조-제11호","item_number":"11","content":"\"연구기관\"이라 함은 방위사업법 제3조 제10호의 전문연구기관, 기타 정부출연연구기관과 대학연구소 등 민간연구기관을 포함한 연구단체 및 개인을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000253156_ART_7","DEFENSE_ACQ_ACT_ART_3"],"related_regulations":["DEFENSE_ACQ_ACT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_4","display_id":"잠수함-감항성-관리-세부지침-제4조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"업무분장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_4_P0","display_id":"잠수함-감항성-관리-세부지침-제4조","paragraph_number":"","paragraph_index":null,"content":"잠수함 감항성 관리 업무 수행을 위한 각 기관의 업무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000253156_ART_4_P0_I1","display_id":"잠수함-감항성-관리-세부지침-제4조-제1호","item_number":"1","content":"방위사업청(한국형잠수함사업단)","subitems":[{"id":"DAPA_A_2100000253156_ART_4_P0_I1_S1","display_id":"잠수함-감항성-관리-세부지침-제4조-제1호-가목","subitem_number":"가","content":"잠수함 감항성 관리 관련 규정 및 지침 제ㆍ개정나. 「잠수함 감항성 관리 업무 매뉴얼」 작성ㆍ변경 및 관리(잠수함 표준 감항성 관리 기준 포함)다. 잠수함 감항성 관리 정책수립 및 제도발전라. 통합사업관리팀의 잠수함 감항성 관리 관련 업무 지원마. 감항성관리위원회 운영바. 감항성관리계획서(사업별 감항성관리기준 포함) 승인사. 항해 전 안전성 평가(필요시)아. 사업별 잠수함 감항성 적합성 최종 확인"}]},{"id":"DAPA_A_2100000253156_ART_4_P0_I2","display_id":"잠수함-감항성-관리-세부지침-제4조-제2호","item_number":"2","content":"통합사업관리팀가. 잠수함 사업추진 시 감항성 관리 관련 소요예산 반영나. 획득단계 잠수함 감항성 관리 업무 수행다. 잠수함 감항성관리요구서 검토라. 잠수함 감항성관리계획서(사업별 감항성관리기준 및 적합성 확인 방법 포함) 수립마. 승인된 잠수함 감항성관리계획서에 따른 업무관리바. 잠수함 사업 단계별 감항성 관리 관련회의 주관사. 잠수함 사업별 주요안전품목(CSI) 관리","subitems":[]},{"id":"DAPA_A_2100000253156_ART_4_P0_I3","display_id":"잠수함-감항성-관리-세부지침-제4조-제3호","item_number":"3","content":"국방기술품질원(이하 \"기품원\"이라 한다)","subitems":[{"id":"DAPA_A_2100000253156_ART_4_P0_I3_S1","display_id":"잠수함-감항성-관리-세부지침-제4조-제3호-가목","subitem_number":"가","content":"「잠수함 감항성 관리 업무 매뉴얼」검토나. 잠수함 표준 감항성 관리 기준 검토다. 잠수함 감항성관리요구서 검토라. 잠수함 감항성관리계획서(안)(사업별 감항성관리기준 포함) 등 감항성 관리 관련 문서 검토마. 감항성 적합성(설계 적합성, 제작ㆍ생산 합치성 포함) 검증 결과 확인바. 잠수함 사업별 주요안전품목(CSI) 확인사. 기술변경이 감항성에 미치는 영향성 검토아. 획득단계 잠수함 감항성 관리 지원"}]},{"id":"DAPA_A_2100000253156_ART_4_P0_I4","display_id":"잠수함-감항성-관리-세부지침-제4조-제4호","item_number":"4","content":"국방과학연구소(이하 \"국과연\"이라 한다,)","subitems":[{"id":"DAPA_A_2100000253156_ART_4_P0_I4_S1","display_id":"잠수함-감항성-관리-세부지침-제4조-제4호-가목","subitem_number":"가","content":"「잠수함 감항성 관리 업무 매뉴얼」검토나. 잠수함 감항성관리계획서(안) 등 감항성 관리 관련 문서 검토다. 감항성 검증 결과 검토"}]},{"id":"DAPA_A_2100000253156_ART_4_P0_I5","display_id":"잠수함-감항성-관리-세부지침-제4조-제5호","item_number":"5","content":"소요군가. 잠수함 감항성관리요구서 작성나. 잠수함 감항성관리계획서(안) 등 감항성 관리 관련 문서 검토다. 잠수함 사업별 주요안전품목(CSI) 검토라. 잠수함 감항성 적합성 검증 결과 검토마. 잠수함 감항성 관리 정책수립 및 제도발전 업무 지원","subitems":[]},{"id":"DAPA_A_2100000253156_ART_4_P0_I6","display_id":"잠수함-감항성-관리-세부지침-제4조-제6호","item_number":"6","content":"연구개발주관기관 및 후속함 건조업체(이하\"체계업체\"라 한다.)","subitems":[{"id":"DAPA_A_2100000253156_ART_4_P0_I6_S1","display_id":"잠수함-감항성-관리-세부지침-제4조-제6호-가목","subitem_number":"가","content":"잠수함 감항성관리계획서(안)(사업별 감항성관리기준 및 적합성 확인 방법 포함) 작성나. 잠수함 사업별 주요안전품목(CSI)(안)(목록 및 관리계획 포함) 작성다. 잠수함 감항성 확보라. 잠수함 사업별 주요안전 품목(CSI)(목록 및 관리계획 포함) 관리마. 잠수함 감항성 적합성 검증"}]}]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_5","display_id":"잠수함-감항성-관리-세부지침-제5조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제2장 감항성 관리 일반","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"감항성 관리 대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_5_P1","display_id":"잠수함-감항성-관리-세부지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"감항성 관리 대상사업은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000253156_ART_5_P1_I1","display_id":"잠수함-감항성-관리-세부지침-제5조-제1항-제1호","item_number":"1","content":"잠수함(1,000톤 이상)을 개발 및 건조하는 사업","subitems":[]},{"id":"DAPA_A_2100000253156_ART_5_P1_I2","display_id":"잠수함-감항성-관리-세부지침-제5조-제1항-제2호","item_number":"2","content":"잠수함(1,000톤 이상)을 성능개량 하는 사업","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_5_P2","display_id":"잠수함-감항성-관리-세부지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"필요시, 1,000톤 미만인 잠수함ㆍ잠수정의 감항성 관리 업무에도 이 지침을 적용할 수 있다. 다만 일시적으로 잠수 기능을 가지는 반잠수정과 무인으로 운용되는 잠수체 등은 제외한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_5_P3","display_id":"잠수함-감항성-관리-세부지침-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"전시ㆍ사변 또는 이에 준하는 국가비상사태의 발생 등으로 긴급한 전력화를 위하여 추진하는 사업의 경우 제7조에 따른 감항성 관리 단계의 전부 또는 일부를 적용하지 아니할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000253156_ART_7"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_6","display_id":"잠수함-감항성-관리-세부지침-제6조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제2장 감항성 관리 일반","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"감항성 관리 기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_6_P1","display_id":"잠수함-감항성-관리-세부지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청(한국형잠수함사업단장)은 잠수함의 감항성 관리를 위하여 「잠수함 표준 감항성 관리 기준」을 작성하고 「잠수함 감항성 관리 업무 매뉴얼」을 통해 관리하여야 한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_6_P2","display_id":"잠수함-감항성-관리-세부지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 체계업체로 하여금 「잠수함 감항성 관리 업무 매뉴얼」상의 「잠수함 표준 감항성 관리 기준」을 기초로 사업별 감항성관리기준을 작성하여 감항성관리계획서에 포함하여 제출하도록 해야한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_6_P3","display_id":"잠수함-감항성-관리-세부지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"승인된 사업별 감항성관리기준은 필요시, 사업 특성을 고려하여 감항성관리위원회의 승인을 받아 변경할 수 있으며, 사업 종결시까지 유지 관리되어야 한다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_7","display_id":"잠수함-감항성-관리-세부지침-제7조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제2장 감항성 관리 일반","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"감항성 관리 수행","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_7_P1","display_id":"잠수함-감항성-관리-세부지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"잠수함 설계 및 건조에 따른 감항성 관리 단계와 단계별 기본 업무는 다음 각호와 같다.","items":[{"id":"DAPA_A_2100000253156_ART_7_P1_I1","display_id":"잠수함-감항성-관리-세부지침-제7조-제1항-제1호","item_number":"1","content":"선행연구 : 잠수함 감항성관리요구서 검토","subitems":[]},{"id":"DAPA_A_2100000253156_ART_7_P1_I2","display_id":"잠수함-감항성-관리-세부지침-제7조-제1항-제2호","item_number":"2","content":"기본설계 : 감항성관리계획서 및 사업별 감항성관리기준을 수립하고, 기본설계 산출물(도면, 보고서 등)이 사업별 감항성관리기준을 충족하는지를 감항성 적합성 검증결과를 통해 확인","subitems":[]},{"id":"DAPA_A_2100000253156_ART_7_P1_I3","display_id":"잠수함-감항성-관리-세부지침-제7조-제1항-제3호","item_number":"3","content":"상세설계 : 잠수함 건조를 위한 상세설계 산출물(도면, 보고서 등)이 사업별 감항성관리기준을 충족하는지를 감항성 적합성 검증결과를 통해 확인","subitems":[]},{"id":"DAPA_A_2100000253156_ART_7_P1_I4","display_id":"잠수함-감항성-관리-세부지침-제7조-제1항-제4호","item_number":"4","content":"함 건조 : 승인된 설계(CDR)에 따라 탑재장비/설비의 설치 및 함 건조가 수행되고, 감항성관리기준을 충족하여 항해 안전에 적합한지를 감항성 적합성 검증결과를 통해 확인","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_7_P2","display_id":"잠수함-감항성-관리-세부지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 각 사업 단계별로 감항성관리계획서를 수립하고, 승인된 계획에 따라 감항성 관리를 주관하여야 한다. 단, 성능개량 사업의 경우, 성능개량 대상장비를 포함한 관련 탑재장비/설비(성능개량 대상장비/설비 간 주요 연동대상, 탈거, 장탈착 등)를 주요안전품목(CSI) 검토대상에 필수적으로 포함하고 제14조의 절차를 따른다.","items":[]},{"id":"DAPA_A_2100000253156_ART_7_P3","display_id":"잠수함-감항성-관리-세부지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"체계업체는 잠수함 감항성 확보의 수행 주체이며, 통합사업관리팀은 잠수함 감항성 관리 주체로 체계업체와 유기적으로 협조하여야 한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_7_P4","display_id":"잠수함-감항성-관리-세부지침-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"통합사업관리팀장은 잠수함 감항성 관리업무의 전문적인 관리를 위해 필요시 연구기관 등을 활용할 수 있다.","items":[]},{"id":"DAPA_A_2100000253156_ART_7_P5","display_id":"잠수함-감항성-관리-세부지침-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제4항에 따라 연구기관을 활용할 경우 통합사업관리팀장은 사업추진기본전략, 기본설계기본계획, 상세설계 및 선도함 건조기본계획, 후속함 건조 계획 수립 시 연구기관 선정방안 및 감항성관리용역 수행방안을 포함하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000253156_ART_14"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_8","display_id":"잠수함-감항성-관리-세부지침-제8조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제3장 감항성관리위원회 운영","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"감항성관리위원회","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_8_P1","display_id":"잠수함-감항성-관리-세부지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청(한국형잠수함사업단장)은 감항성 관리 및 관련 주요정책과 감항성 관리 확인에 관한 사항을 심의ㆍ조정하기 위하여 감항성관리위원회를 구성할 수 있다.","items":[]},{"id":"DAPA_A_2100000253156_ART_8_P2","display_id":"잠수함-감항성-관리-세부지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"감항성관리위원회는 다음 각 호의 사항을 심의ㆍ조정한다.","items":[{"id":"DAPA_A_2100000253156_ART_8_P2_I1","display_id":"잠수함-감항성-관리-세부지침-제8조-제2항-제1호","item_number":"1","content":"잠수함 감항성 관리와 관련된 주요정책의 수립 및 변경에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P2_I2","display_id":"잠수함-감항성-관리-세부지침-제8조-제2항-제2호","item_number":"2","content":"감항성관리계획서의 승인 및 변경에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P2_I3","display_id":"잠수함-감항성-관리-세부지침-제8조-제2항-제3호","item_number":"3","content":"「잠수함 감항성 관리 업무 매뉴얼」의 작성 및 변경에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P2_I4","display_id":"잠수함-감항성-관리-세부지침-제8조-제2항-제4호","item_number":"4","content":"잠수함 감항성 적합성 검증 결과의 최종 확인에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P2_I5","display_id":"잠수함-감항성-관리-세부지침-제8조-제2항-제5호","item_number":"5","content":"항해 전 안전성 평가(필요시)","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P2_I6","display_id":"잠수함-감항성-관리-세부지침-제8조-제2항-제6호","item_number":"6","content":"그 밖에 위원장이 감항성 관리와 관련하여 감항성관리위원회의 심의ㆍ조정이 필요하다고 인정하는 사항","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_8_P3","display_id":"잠수함-감항성-관리-세부지침-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"감항성관리위원회의 구성은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000253156_ART_8_P3_I1","display_id":"잠수함-감항성-관리-세부지침-제8조-제3항-제1호","item_number":"1","content":"감항성관리위원회는 위원장 1인을 포함한 5인 이상 12인 이내의 위원으로 구성한다.","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P3_I2","display_id":"잠수함-감항성-관리-세부지침-제8조-제3항-제2호","item_number":"2","content":"위원장은 한국형잠수함사업단장이 되며, 간사는 방위사업청 한국형잠수함총괄계약팀장이 된다.","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_8_P4","display_id":"잠수함-감항성-관리-세부지침-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"관리위원회 위원은 다음 각 호의 자로 구성하며, 관리위원회 심의안건의 특성 등을 고려, 감항성관리위원회 위원장이 정한다. 다만, 관리위원회 위원의 20 퍼센트 이상은 제4호의 민간위원으로 구성한다.","items":[{"id":"DAPA_A_2100000253156_ART_8_P4_I1","display_id":"잠수함-감항성-관리-세부지침-제8조-제4항-제1호","item_number":"1","content":"방위사업청 한국형잠수함사업단 각 팀장","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P4_I2","display_id":"잠수함-감항성-관리-세부지침-제8조-제4항-제2호","item_number":"2","content":"합참 해상전력과장, 전평단 잠수함감항인증과장 등 각군 관련 과장","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P4_I3","display_id":"잠수함-감항성-관리-세부지침-제8조-제4항-제3호","item_number":"3","content":"기품원ㆍ국과연 관련 팀장 등","subitems":[]},{"id":"DAPA_A_2100000253156_ART_8_P4_I4","display_id":"잠수함-감항성-관리-세부지침-제8조-제4항-제4호","item_number":"4","content":"그 밖에 잠수함 감항에 관한 학식과 경험이 풍부한 사람 중에서 위원장이 추천한 사람","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_8_P5","display_id":"잠수함-감항성-관리-세부지침-제8조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"간사는 해당 안건의 심의 전 출석한 위원으로부터 별지 제3호 서식의 제척ㆍ회피사유 부존재 등 확인서를 제출받아 원본은 보관하며 사본을 방위사업감독관실(감독총괄담당관)에게 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_9","display_id":"잠수함-감항성-관리-세부지침-제9조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제3장 감항성관리위원회 운영","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"감항성관리위원회 운영 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_9_P1","display_id":"잠수함-감항성-관리-세부지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 제8조제2항 각 호의 사항이 포함된 감항성관리위원회 상정 안건을 작성하여 감항성관리위원회 주관부서에 제출하고, 위원장에게 선행보고 후, 해당 안건을 각 위원에게 배부하며, 위원회에 참석하여 안건보고 및 위원의 질문에 답변한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_9_P2","display_id":"잠수함-감항성-관리-세부지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"간사는 회의개최 7일 이전까지 의사일정 및 심의안건을 각 위원에게 통지하여야 한다. 다만, 사전배부가 곤란하거나 부적절하다고 감항성관리위원회 위원장이 승인하는 경우와 긴급을 요하는 때에는 그러하지 아니한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_9_P3","display_id":"잠수함-감항성-관리-세부지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"감항성관리위원회는 위원장을 포함하여 재적위원 2/3이상 출석으로 개회하고, 출석위원 2/3이상 찬성으로 의결하되 표결은 기명으로 한다. 다만, 위원장은 심의안건의 내용이 경미하거나, 긴급한 사유로 회의를 소집할 시간적 여유가 없는 경우에는 서면으로 심의할 수 있다.","items":[]},{"id":"DAPA_A_2100000253156_ART_9_P4","display_id":"잠수함-감항성-관리-세부지침-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"감항성관리위원회 위원이 궐원ㆍ출장 또는 사고의 사유로 위원회에 출석하지 못하여 직무대리규정에 따라 그 직무를 대행하는 자가 감항성관리위원회에 참석하고자 할 때에는 감항성관리위원회 전까지 위원장의 승인을 받아 출석하여 발언 및 표결을 할 수 있다.","items":[]},{"id":"DAPA_A_2100000253156_ART_9_P5","display_id":"잠수함-감항성-관리-세부지침-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"감항성관리위원회 위원장과 위원은 별지 제2호서식의 의결서에 찬반여부와 의견을 자필로 기록한 후 서명하여야 하며 복수 안건일 경우 안건별로 의결서를 작성할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000253156_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_10","display_id":"잠수함-감항성-관리-세부지침-제10조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제3장 감항성관리위원회 운영","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"자문위원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_10_P1","display_id":"잠수함-감항성-관리-세부지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청(한국형잠수함사업단장)은 감항성 관리에 관한 업무 수행 시 기술적 자문을 위해 5명 이내의 자문위원을 구성할 수 있다.","items":[]},{"id":"DAPA_A_2100000253156_ART_10_P2","display_id":"잠수함-감항성-관리-세부지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청(한국형잠수함사업단장)은 다음 각 호에 해당하는 자 중에서 자문위원을 위촉할 수 있다.","items":[{"id":"DAPA_A_2100000253156_ART_10_P2_I1","display_id":"잠수함-감항성-관리-세부지침-제10조-제2항-제1호","item_number":"1","content":"학ㆍ연 기관의 잠수함 관련 기술적 전문지식을 구비한 자","subitems":[]},{"id":"DAPA_A_2100000253156_ART_10_P2_I2","display_id":"잠수함-감항성-관리-세부지침-제10조-제2항-제2호","item_number":"2","content":"함정 및 잠수함 개발 및 운용 관련 전문지식을 구비한 자","subitems":[]},{"id":"DAPA_A_2100000253156_ART_10_P2_I3","display_id":"잠수함-감항성-관리-세부지침-제10조-제2항-제3호","item_number":"3","content":"잠수함 감항 업무 관련 전문성을 구비한 자","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_10_P3","display_id":"잠수함-감항성-관리-세부지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"자문위원의 임기는 2년으로 하되 1회에 한하여 연임할 수 있다. 다만, 특정 사안에 대하여 한시적으로 위촉된 경우에는 그에 관한 자문이 종료된 때에 자동으로 해촉된다.","items":[]},{"id":"DAPA_A_2100000253156_ART_10_P4","display_id":"잠수함-감항성-관리-세부지침-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"자문위원은 감항성관리위원회에 출석하여 발언할 수 있으며, 참석이 불가능한 경우에는 감항성관리위원회에 서면으로 의견서를 제출할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_11","display_id":"잠수함-감항성-관리-세부지침-제11조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제4장 감항성 관리 절차","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"감항성 관리 준비","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_11_P1","display_id":"잠수함-감항성-관리-세부지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 선행연구 시 소요군에서 작성한 잠수함 감항성관리요구서를 검토하고 사업특성에 맞는 감항성 관리 방안을 수립하여야 한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_11_P2","display_id":"잠수함-감항성-관리-세부지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 사업추진기본전략, 사업관련 각종 계획서 및 제안요청서 작성 시 감항성 관리 방안을 포함하여야 한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_11_P3","display_id":"잠수함-감항성-관리-세부지침-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 제안요청서 작성 시 체계업체로 하여금 기본설계 제안서에 단계별 감항성 관리 개략계획을 포함한 감항성관리계획서(안)이 포함되도록 하여야 한다. 이 때 제안요청서에 감항성관리요구서 등을 포함할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["제안서"]},{"id":"DAPA_A_2100000253156_ART_12","display_id":"잠수함-감항성-관리-세부지침-제12조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제4장 감항성 관리 절차","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"감항성관리계획서 수립 및 승인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_12_P1","display_id":"잠수함-감항성-관리-세부지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 기본설계 계약 이후 30일 이내에 체계업체로 하여금 감항성관리계획서를 작성하여 제출하도록 하되, 다음 각 호의 사항이 포함되어야 한다.","items":[{"id":"DAPA_A_2100000253156_ART_12_P1_I1","display_id":"잠수함-감항성-관리-세부지침-제12조-제1항-제1호","item_number":"1","content":"사업개요","subitems":[]},{"id":"DAPA_A_2100000253156_ART_12_P1_I2","display_id":"잠수함-감항성-관리-세부지침-제12조-제1항-제2호","item_number":"2","content":"감항성 관리 대상/범위","subitems":[]},{"id":"DAPA_A_2100000253156_ART_12_P1_I3","display_id":"잠수함-감항성-관리-세부지침-제12조-제1항-제3호","item_number":"3","content":"단계별 감항성관리계획서 : 기본설계/상세설계/함건조 단계","subitems":[]},{"id":"DAPA_A_2100000253156_ART_12_P1_I4","display_id":"잠수함-감항성-관리-세부지침-제12조-제1항-제4호","item_number":"4","content":"감항성관리기준 및 적합성 검증 방법","subitems":[]},{"id":"DAPA_A_2100000253156_ART_12_P1_I5","display_id":"잠수함-감항성-관리-세부지침-제12조-제1항-제5호","item_number":"5","content":"주요안전품목(CSI) 목록(안) 및 관리계획","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_12_P2","display_id":"잠수함-감항성-관리-세부지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 체계업체로부터 접수한 감항성관리계획서에 대해서 소요군 및 관련기관의 검토의견을 반영하여 보완한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_12_P3","display_id":"잠수함-감항성-관리-세부지침-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청(한국형잠수함사업단장)은 감항성관리계획서 접수 후 감항성관리위원회의 심의를 통해 감항성관리계획서를 승인하고 그 결과를 해당기관 및 소요군에 통보한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_12_P4","display_id":"잠수함-감항성-관리-세부지침-제12조-제4항","paragraph_number":"④","paragraph_index":4,"content":"사업 수행 간 감항성 관리 범위, 기준, 주요안전품목(CSI) 변경 등의 중대한 변경 소요가 있을 경우는 감항성관리위원회의 심의를 통해 감항성관리계획서를 변경한다. 다만 적합성 검증방법, 수정계약에 따른 변경 등 일반적이거나 경미한 수정의 경우에는 한국형잠수함사업단장이 승인하여 변경할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_13","display_id":"잠수함-감항성-관리-세부지침-제13조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제4장 감항성 관리 절차","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"감항성 확인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_13_P1","display_id":"잠수함-감항성-관리-세부지침-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"체계업체는 기본설계검토(PDR), 상세설계검토(CDR), 개발/운용시험평가, 시운전 종료 전에 목적문건, 형상식별서, 탑재장비/설비의 설치, 함 건조 등의 결과가 사업별 감항성관리기준을 충족하여 감항성이 확보되었는지 검증을 수행하고, 감항성 적합성 검증결과를 통합사업관리팀장 및 기품원에게 제출해야한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_13_P2","display_id":"잠수함-감항성-관리-세부지침-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기품원은 소요군 등 관련기관의 검토의견을 수렴하여 잠수함 감항성 적합성(설계 적합성, 제작ㆍ생산 합치성 포함) 검증결과를 확인하고, 그 결과를 통합사업관리팀장에게 제출한다. 기품원은 감항성 적합성 검증결과 확인을 위해 기본/상세설계 검토결과, 개발/운용시험평가 결과, 시운전 결과, 품질보증 결과를 활용할 수 있다.","items":[]},{"id":"DAPA_A_2100000253156_ART_13_P3","display_id":"잠수함-감항성-관리-세부지침-제13조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청(한국형잠수함사업단장)은 감항성 적합성 여부를 감항성관리위원회의 심의를 거쳐 다음 각 호와 같이 구분하여 결정한다.","items":[{"id":"DAPA_A_2100000253156_ART_13_P3_I1","display_id":"잠수함-감항성-관리-세부지침-제13조-제3항-제1호","item_number":"1","content":"충족 : 다음 각 목의 어느 하나에 해당하는 경우가. 잠수함 사업별 감항성관리기준의 모든 항목을 충족하는 경우나.잠수함 사업별 감항성관리기준의 일부 항목을 충족하지 못하나 항해안전에 미치는 영향이 경미한 경우","subitems":[]},{"id":"DAPA_A_2100000253156_ART_13_P3_I2","display_id":"잠수함-감항성-관리-세부지침-제13조-제3항-제2호","item_number":"2","content":"미충족 : 잠수함 사업별 감항성관리기준을 충족하지 못하고 항해안전에 미치는 영향이 중대한 경우","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_13_P4","display_id":"잠수함-감항성-관리-세부지침-제13조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청(한국형잠수함사업단장)은 제3항제1호나목에 해당하는 경우 아래 각 호의 정의에 따라 해당 잠수함 사업별 감항성관리기준을 면제하여 적용한다.","items":[{"id":"DAPA_A_2100000253156_ART_13_P4_I1","display_id":"잠수함-감항성-관리-세부지침-제13조-제4항-제1호","item_number":"1","content":"영구면제 : 잠수함 사업별 감항성관리기준에서 해당 기준 영구 미적용","subitems":[]},{"id":"DAPA_A_2100000253156_ART_13_P4_I2","display_id":"잠수함-감항성-관리-세부지침-제13조-제4항-제2호","item_number":"2","content":"임시면제 : 잠수함 사업별 감항성관리기준에서 해당기준에 대한 면제 기간 및 조건 등을 명시하여 적용","subitems":[]}]},{"id":"DAPA_A_2100000253156_ART_13_P5","display_id":"잠수함-감항성-관리-세부지침-제13조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"통합사업관리팀장은 제3항제2호의 미충족 결정에 대하여 잠수함 사업별 감항성관리기준의 미충족 사항을 보완 후 방위사업청(한국형잠수함사업단장)으로 감항성관리위원회의 재심의를 요청하여야 한다. 다만 제7조제1항에 따른 사업단계 내에서 보완 또는 해결이 가능하다고 판단되는 경우 감항성관리위원회의 심의를 통하여 이를 함 건조 사업 종료 전까지 유예할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000253156_ART_7"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_14","display_id":"잠수함-감항성-관리-세부지침-제14조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제4장 감항성 관리 절차","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"주요안전품목（CSI） 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_14_P1","display_id":"잠수함-감항성-관리-세부지침-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"체계업체는 기본설계 계약 후 감항성관리계획서 수립 시 주요안전품목(CSI) 목록(안) 및 관리계획을 작성한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_14_P2","display_id":"잠수함-감항성-관리-세부지침-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"체계업체는 주요안전품목(CSI)을 설계도면 및 목적문건 검토, 탑재장비/설비 및 공정검사 등을 통해 철저히 관리하고, 그 결과를 잠수함 감항성 적합성 검증결과와 함께 통합사업관리팀장 및 기품원에게 제출해야한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_14_P3","display_id":"잠수함-감항성-관리-세부지침-제14조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기품원은 소요군 등 관련기관의 검토의견을 수렴하여 주요안전품목(CSI) 관리의 적절성을 확인 후 그 결과를 통합사업관리팀장에게 제출한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_14_P4","display_id":"잠수함-감항성-관리-세부지침-제14조-제4항","paragraph_number":"④","paragraph_index":4,"content":"후속함의 주요안전품목(CSI)은 선도함과 동일하게 선정하고 관리하며, 설계변경, 품질이력 등을 고려한 변경사항이 있을 경우, 체계업체는 변경사유를 포함하여 통합사업관리팀장 및 기품원에 주요안전품목(CSI) 수정(안)을 제출한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_14_P5","display_id":"잠수함-감항성-관리-세부지침-제14조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"기품원은 소요군 등 관련기관의 검토의견을 수렴하여 주요안전품목(CSI) 수정(안) 검토결과를 통합사업관리팀장에게 제출하고, 감항성관리위원회의 심의를 통해 주요안전품목(CSI)을 수정한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_14_P6","display_id":"잠수함-감항성-관리-세부지침-제14조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"필요시 주요안전품목(CSI)으로 지정된 탑재장비/설비 등 기자재의 감항성 적합성은 공인기관의 인증 결과로 대체할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_15","display_id":"잠수함-감항성-관리-세부지침-제15조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제4장 감항성 관리 절차","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"후속함 건조사업의 감항성 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_15_P0","display_id":"잠수함-감항성-관리-세부지침-제15조","paragraph_number":"","paragraph_index":null,"content":"후속함 사업 시는 제11조부터 제14조를 참조하여 별표 1 후속함 건조 부분의 절차를 수행한다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000253156_ART_11","DAPA_A_2100000253156_ART_14"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_16","display_id":"잠수함-감항성-관리-세부지침-제16조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제4장 감항성 관리 절차","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"항해 전 안전성 평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_16_P1","display_id":"잠수함-감항성-관리-세부지침-제16조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 잠수함 건조 후 최초잠항시험 전 또는 필요하다고 판단되는 경우 방위사업청(한국형잠수함사업단장)에게 안전성 평가를 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000253156_ART_16_P2","display_id":"잠수함-감항성-관리-세부지침-제16조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 경우 방위사업청(한국형잠수함사업단장)은 감항성관리위원회를 소집하여 안전성 및 제한사항을 평가하고 그 결과를 통합사업관리팀에 통보해야 한다.","items":[]},{"id":"DAPA_A_2100000253156_ART_16_P3","display_id":"잠수함-감항성-관리-세부지침-제16조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청(한국형잠수함사업단장)은 안전성 평가를 위해 관련 전문가 또는 자문위원의 검토가 필요한 경우는 자문을 요청하거나, 위원회에 출석하게 하여 의견을 청취할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_17","display_id":"잠수함-감항성-관리-세부지침-제17조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제5장 감항성 관리 업무의 협력","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"국제 기준 등의 확보를 위한 국제협력","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_17_P0","display_id":"잠수함-감항성-관리-세부지침-제17조","paragraph_number":"","paragraph_index":null,"content":"방위사업청(한국형잠수함사업단장)은 잠수함 감항성 관리를 위한 국제협력을 통해 국외 감항성 관리 제도 및 기술 자료의 수집, 감항성관리기준 확보 등에 필요한 예산을 편성하고 주관하여야 한다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_18","display_id":"잠수함-감항성-관리-세부지침-제18조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제5장 감항성 관리 업무의 협력","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"수출잠수함 지원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_18_P0","display_id":"잠수함-감항성-관리-세부지침-제18조","paragraph_number":"","paragraph_index":null,"content":"방위사업청(한국형잠수함사업단장)은 필요시 외국 정부 및 군의 요청에 따라 외국 정부에 수출하는 잠수함에 대한 감항성 관리 업무를 지원할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_19","display_id":"잠수함-감항성-관리-세부지침-제19조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제6장 기타","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"수당 및 여비지급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_19_P0","display_id":"잠수함-감항성-관리-세부지침-제19조","paragraph_number":"","paragraph_index":null,"content":"감항성관리위원회에 참석하거나 제10조제4항의 의견서를 제출한 위원 또는 자문위원에게는 예산의 범위 내에서 수당과 여비를 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000253156_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000253156_ART_20","display_id":"잠수함-감항성-관리-세부지침-제20조","regulation_id":"DAPA_A_2100000253156","regulation_name":"잠수함 감항성 관리 세부지침","short_name":"잠수함 감항성 관리 세부지침","document_type":"예규","part":"","chapter":"제6장 기타","section":"","subsection":"","article_number":"20","article_label":"제20조","article_title":"비밀유지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000253156_ART_20_P0","display_id":"잠수함-감항성-관리-세부지침-제20조","paragraph_number":"","paragraph_index":null,"content":"잠수함 감항성 관리 업무를 수행하는 방위사업청 직원이나 감항성 관리 위원 또는 자문위원은 직무상 알게 된 비밀 또는 관련업계에 손해를 끼칠 우려가 있는 내용을 누설하여서는 아니 된다.","items":[]}],"notes":[],"effective_date":"2025-01-09","revision_date":"2025-01-09","source_file":"잠수함 감항성 관리 세부지침.json","source_path":"원문/법제처API/잠수함 감항성 관리 세부지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},