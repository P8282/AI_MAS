[{"id":"DAPA_A_2100000239708_ART_1","display_id":"전시-국외현지구매-지침-제1조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_1_P0","display_id":"전시-국외현지구매-지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「국가를 당사자로 하는 계약에 관한 법률 시행령」(이하 「국가계약법 시행령」이라 한다) 제26조제1항제1호나목, 「방위사업법 시행령」제24조의3, 제61조 제3항(제5호) 국방부 충무집행계획, 방위사업청 자체 충무계획, 「군수품조달관리규정」 제175조(전시조달원칙)에 따라 전시 조달업무 중 전시 국외현지구매 계약을 수행하는데 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_26","DEFENSE_ACQ_ENFORCEMENT_ART_24_3","DEFENSE_ACQ_ENFORCEMENT_ART_61","DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE_ART_175"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT","DEFENSE_ACQ_ENFORCEMENT","DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_2","display_id":"전시-국외현지구매-지침-제2조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_2_P0","display_id":"전시-국외현지구매-지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 방위사업청에서 전시 국외현지구매와 관련된 업무를 수행하는 데 적용하며, 국외현지구매 형태가 아닌 전시 국제계약은 「군수품조달관리규정」 제179조를 따른다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE_ART_179"],"related_regulations":["DAPA_MUNITIONS_PROCUREMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_3","display_id":"전시-국외현지구매-지침-제3조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_3_P0","display_id":"전시-국외현지구매-지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000239708_ART_3_P0_I1","display_id":"전시-국외현지구매-지침-제3조-제1호","item_number":"1","content":"\"전시국외조달\"은 전시에 국외 현지로 인원을 직접 파견하여 계약을 추진하는 전시 국외현지구매와 국내에서 추진하는 국제계약을 말한다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_3_P0_I2","display_id":"전시-국외현지구매-지침-제3조-제2호","item_number":"2","content":"\"전시 국외현지구매반(이하 \"현지구매반\"이라 한다)\"은 국제계약지원단 및 전시에 청에서 국외로 직접 파견하는 인원으로 구성된 조직을 말한다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_3_P0_I3","display_id":"전시-국외현지구매-지침-제3조-제3호","item_number":"3","content":"\"전시 국외현지구매 품목\"은 전시 조달계획에 포함된 국외조달(상업구매)품목 중 조달판단결과 요구납기가 M+90일 이내로 확정된 품목을 말한다. 이때, 상업구매 품목 중 한도액 계약품목, 해외기술용역, 해외정비 등은 제외한다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_3_P0_I4","display_id":"전시-국외현지구매-지침-제3조-제4호","item_number":"4","content":"\"전시 국외현지구매 상황실\"은 국제협력관 및 청 내 증원인원으로 구성되어 전시 국외현지구매 업무를 총괄하는 조직을 말한다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_3_P0_I5","display_id":"전시-국외현지구매-지침-제3조-제5호","item_number":"5","content":"\"전시 운송수단\"은 전시 연합수송관리단(CTMC, Combined Transportation Management Command) 및 국토교통부가 동원하여 운용하는 항공기, 선박, 철도 및 미 국방운송체계(DTS, Defense Transportation System)에 따라 운용되는 미국 항공기, 선박 및 기타 운송수단을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_4","display_id":"전시-국외현지구매-지침-제4조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"기본방침","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_4_P0","display_id":"전시-국외현지구매-지침-제4조","paragraph_number":"","paragraph_index":null,"content":"전시 국외현지구매 관련 기본방침은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000239708_ART_4_P0_I1","display_id":"전시-국외현지구매-지침-제4조-제1호","item_number":"1","content":"전시 국외현지구매는 국제계약지원단 및 청에서 파견하는 현지구매반을 활용하여 추진한다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_4_P0_I2","display_id":"전시-국외현지구매-지침-제4조-제2호","item_number":"2","content":"전시 국외현지구매품목은 신속한 계약체결을 위해 「국가계약법 시행령」 제26조제1항제1호나목, 「방위사업법 시행령」 제61조제3항에 정한 바에 따라 수의계약에 의할 수 있으며, 공급 가능 물량 등을 고려하여 동종품의 공급이 가능한 다른 업체와 분할 수의계약을 할 수 있다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_4_P0_I3","display_id":"전시-국외현지구매-지침-제4조-제3호","item_number":"3","content":"계약일반조건은 분야별(일반장비, 수리부속 등) 국외조달 계약일반조건을 적용함을 원칙으로 한다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_4_P0_I4","display_id":"전시-국외현지구매-지침-제4조-제4호","item_number":"4","content":"전시 국외현지구매는 계약실적이 있는 품목 위주로 평시 계약실적가를 고려하여 추진하며, 별도의 목표가 산정은 생략한다.","subitems":[]}]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_26","DEFENSE_ACQ_ENFORCEMENT_ART_61"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":["일반조건","계약실적","수행실적","수의계약"]},{"id":"DAPA_A_2100000239708_ART_5","display_id":"전시-국외현지구매-지침-제5조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"임무 및 기능","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_5_P0","display_id":"전시-국외현지구매-지침-제5조","paragraph_number":"","paragraph_index":null,"content":"전시 국외현지구매 계약과 관련한 부서 및 각 관의 임무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000239708_ART_5_P0_I1","display_id":"전시-국외현지구매-지침-제5조-제1호","item_number":"1","content":"국제협력관가. 현지구매반 운영에 대한 조정ㆍ통제나. 전시 국외현지구매 상황실 운영 주관다. 전시 현지구매 관련 대외기관 협조","subitems":[]},{"id":"DAPA_A_2100000239708_ART_5_P0_I2","display_id":"전시-국외현지구매-지침-제5조-제2호","item_number":"2","content":"북미지역협력담당관가. 전시 국외현지구매 상황실 구성 및 상황반장 임무수행, 유관기관(부서) 협조나. 전시조달계획 국외조달분야 검토 및 종합다. 현지구매반 선발, 임명의뢰, 행동절차교육 및 직무관리계획 수립라. 전시 국외구매 협조부서(KOTRA 등) 대상 교육 주관마. 운송 및 보험부보 조치, 통관의뢰바. 운송하자 처리 및 운송업무 조정ㆍ통제","subitems":[]},{"id":"DAPA_A_2100000239708_ART_5_P0_I3","display_id":"전시-국외현지구매-지침-제5조-제3호","item_number":"3","content":"상업계약팀장(각 사업본부의 상업계약 업무를 담당하는 계약부서를 말한다. 이하 같다)","subitems":[{"id":"DAPA_A_2100000239708_ART_5_P0_I3_S1","display_id":"전시-국외현지구매-지침-제5조-제3호-가목","subitem_number":"가","content":"전시 국외현지구매 품목 관련정보 확인나. 해당 팀 증원인원 현지구매 계약절차 교육 및 직무능력 관리다. 전시 국외현지구매 상황실 부품/장비 계약반 임무수행 및 협조"}]},{"id":"DAPA_A_2100000239708_ART_5_P0_I4","display_id":"전시-국외현지구매-지침-제5조-제4호","item_number":"4","content":"현지구매반가. 전시 국외현지구매 계약나. KOTRA 등 유관기관 협조 및 현지에서 수행해야할 업무","subitems":[]},{"id":"DAPA_A_2100000239708_ART_5_P0_I5","display_id":"전시-국외현지구매-지침-제5조-제5호","item_number":"5","content":"전시 국외현지구매 상황실가. 전시 국외현지구매 계약업무 조정ㆍ통제 및 현황유지나. 상업/FMS 운송자산 배정요청 및 운송업무 협조다. 부품/장비 계약임무 지시 및 재고량 파악, 계약현황 각 군 통보라. 주미 국제계약지원단(이하 ‘주미단’이라 한다) 업무지시마. 추가 현지구매소요에 대한 관련정보 파악 및 현지구매반 임무 지시","subitems":[]},{"id":"DAPA_A_2100000239708_ART_5_P0_I6","display_id":"전시-국외현지구매-지침-제5조-제6호","item_number":"6","content":"대한무역투자진흥공사(KOTRA) 방산교역실가. 전시 국외현지구매 관련 해외무역관 업무협조, 조정나. 평시 해외무역관 인원 비취인가, 시설보안 확인 등 보안업무 및 직원교육 협조","subitems":[]},{"id":"DAPA_A_2100000239708_ART_5_P0_I7","display_id":"전시-국외현지구매-지침-제5조-제7호","item_number":"7","content":"국제계약지원단 및 주재무관가. 전시 국외현지 상업구매품목 지출심사나. 전시 국외현지 상업구매 물자대금 지급다. 상업/FMS 계약현황 관리라. 현지구매 협상, 운송업무 지원마. 해외시장 조사 및 조달원 발굴, 법무검토 지원 등바. 현지구매반 지원계획 수립 및 임무수행 지원","subitems":[]}]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_6","display_id":"전시-국외현지구매-지침-제6조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"현지구매반 운영절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_6_P1","display_id":"전시-국외현지구매-지침-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"현지구매반 인원을 매년 4월에 선발하여 인사명령 조치하며, 운영기간은 5월부터 익년도 4월까지로 한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_6_P2","display_id":"전시-국외현지구매-지침-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전시에 증원되는 현지구매반 인원은 청본부 및 소속기관 인원 중 국제계약 적임자를 우선 선발한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_6_P3","display_id":"전시-국외현지구매-지침-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"사전교육은 연 2회 실시하며, 시기는 선발 직후 1회, UFS 직전 1회 실시한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_6_P4","display_id":"전시-국외현지구매-지침-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"현지구매반 실제 훈련은 UFS와 연계하여 매년 실시한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_6_P5","display_id":"전시-국외현지구매-지침-제6조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"현지구매반 운영과 관련한 세부사항은「국외현지구매반 운영 매뉴얼」을 따른다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_7","display_id":"전시-국외현지구매-지침-제7조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"전시 국외현지구매 상황실 설치 및 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_7_P0","display_id":"전시-국외현지구매-지침-제7조","paragraph_number":"","paragraph_index":null,"content":"전시 국외 현지구매의 총괄 업무 및 실시간 대응을 위해 전시 국외현지구매 상황실을 설치 및 운영하며, 상황실 운영에 대한 세부사항은 「국외현지구매반 운영 매뉴얼」을 따른다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_8","display_id":"전시-국외현지구매-지침-제8조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제2장 조달판단 및 사전준비","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"전시 국외현지구매 조달판단 및 대상품목 선정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_8_P1","display_id":"전시-국외현지구매-지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"전시 국외현지구매품목의 조달판단 및 대상품목 선정과 관련하여 상업계약팀장이 수행해야 할 업무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000239708_ART_8_P1_I1","display_id":"전시-국외현지구매-지침-제8조-제1항-제1호","item_number":"1","content":"평시 계약실적 및 생산가능여부 등을 고려하여 조달판단 실시","subitems":[]},{"id":"DAPA_A_2100000239708_ART_8_P1_I2","display_id":"전시-국외현지구매-지침-제8조-제1항-제2호","item_number":"2","content":"요구납기 M+90일 이내 국외조달 확정품목에 대해 규격, 생산량, 납기, (대체)조달원, 생산중단(도태품목) 여부, 대금 지불방법, 운송방법등을 구체화 하여 전시 국외현지구매 조달판단서 작성","subitems":[]}]},{"id":"DAPA_A_2100000239708_ART_8_P2","display_id":"전시-국외현지구매-지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"상업계약팀장은 당해 연도 전시 조달계획에 대한 국외조달 (예비)판단시 다음 각 호 중 어느 하나에 해당하는 경우 전시 국외현지구매품목으로 우선 검토하여야 한다.","items":[{"id":"DAPA_A_2100000239708_ART_8_P2_I1","display_id":"전시-국외현지구매-지침-제8조-제2항-제1호","item_number":"1","content":"전쟁초기 긴급히 구매가 필요한 품목으로써 M+90일 이내 조달판단 한 품목","subitems":[]},{"id":"DAPA_A_2100000239708_ART_8_P2_I2","display_id":"전시-국외현지구매-지침-제8조-제2항-제2호","item_number":"2","content":"국외조달 물량이 전시 총 소요량의 10%를 초과하는 품목","subitems":[]},{"id":"DAPA_A_2100000239708_ART_8_P2_I3","display_id":"전시-국외현지구매-지침-제8조-제2항-제3호","item_number":"3","content":"기타 M+90일 이후 요구품목 중 현지구매가 유리하다고 판단되는 품목","subitems":[]}]},{"id":"DAPA_A_2100000239708_ART_8_P3","display_id":"전시-국외현지구매-지침-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항 및 제2항 이외에 미 국방성 비표준장비 및 도태장비 부속, 조달원 확인이 제한되는 품목, 비계획 긴급 조달요구 품목 등 현지구매가 당해 사업의 신속한 조달 및 효율성 면에서 유리하다고 판단되는 사업은 국외현지구매를 추진할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_9","display_id":"전시-국외현지구매-지침-제9조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제2장 조달판단 및 사전준비","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"전시 국외현지구매 사전준비","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_9_P1","display_id":"전시-국외현지구매-지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"북미지역협력담당관은 평시부터 현지구매반이 즉시 임무수행 가능하도록 다음 각 호와 같이 적합한 인원을 선발하고 청 및 관련기관 인원의 직무수행능력을 배양하여야 한다.","items":[{"id":"DAPA_A_2100000239708_ART_9_P1_I1","display_id":"전시-국외현지구매-지침-제9조-제1항-제1호","item_number":"1","content":"현지구매반 인원선정 및 관리계획 수립","subitems":[]},{"id":"DAPA_A_2100000239708_ART_9_P1_I2","display_id":"전시-국외현지구매-지침-제9조-제1항-제2호","item_number":"2","content":"현지구매반 직무능력 관리계획 수립 및 시행","subitems":[]},{"id":"DAPA_A_2100000239708_ART_9_P1_I3","display_id":"전시-국외현지구매-지침-제9조-제1항-제3호","item_number":"3","content":"행동화 숙달을 위한 실제 국외현지구매 파견훈련계획 수립 및 시행","subitems":[]},{"id":"DAPA_A_2100000239708_ART_9_P1_I4","display_id":"전시-국외현지구매-지침-제9조-제1항-제4호","item_number":"4","content":"국내ㆍ외 훈련에 필요한 평시 예산반영","subitems":[]},{"id":"DAPA_A_2100000239708_ART_9_P1_I5","display_id":"전시-국외현지구매-지침-제9조-제1항-제5호","item_number":"5","content":"KOTRA 해외무역관 등 전시구매관련 대외기관 인원에 대한 협조사항 교육","subitems":[]}]},{"id":"DAPA_A_2100000239708_ART_9_P2","display_id":"전시-국외현지구매-지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"북미지역협력담당관은 각 팀별 전시 국외현지구매 조달판단 결과를 종합하여 M+90일 이내 요구품목 중 적기조달이 제한될 것으로 판단되는 품목은 전시조달계획에 수정반영 하고 상호군수지원협약, 재구매, 임차 등 다른 방식으로 조달방안을 강구토록 국방부, 합참 및 각 군과 협조하여야 한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_9_P3","display_id":"전시-국외현지구매-지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"상업계약팀장은 조달판단과 동시에 해당팀 요구품목에 대해 상황발생시 즉시 현지구매가 가능하도록 다음 각 호의 사전준비를 하여야 한다.","items":[{"id":"DAPA_A_2100000239708_ART_9_P3_I1","display_id":"전시-국외현지구매-지침-제9조-제3항-제1호","item_number":"1","content":"제8조제1항 각 호의 정보를 포함한 전시 국외현지구매 조달판단서 구비 최신화","subitems":[]},{"id":"DAPA_A_2100000239708_ART_9_P3_I2","display_id":"전시-국외현지구매-지침-제9조-제3항-제2호","item_number":"2","content":"계약일반(특수)조건, 구매사양서, 구매계약서, 수의계약 사유서 등 현지 계약체결을 위한 행정서류 구비 및 저장매체화 관리","subitems":[]},{"id":"DAPA_A_2100000239708_ART_9_P3_I3","display_id":"전시-국외현지구매-지침-제9조-제3항-제3호","item_number":"3","content":"해당 팀으로 증원된 현지구매반 인원에 대한 계약절차 및 관련정보 교육","subitems":[]}]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000239708_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_10","display_id":"전시-국외현지구매-지침-제10조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제2장 조달판단 및 사전준비","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"전시 국외현지구매 집행계획 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_10_P0","display_id":"전시-국외현지구매-지침-제10조","paragraph_number":"","paragraph_index":null,"content":"현지구매반(장)은 상업계약팀장으로부터 현지구매 임무 접수 후 현지구매 집행계획을 수립하고 출국 전 해당 상업계약팀장에게 보고하여야 한다. 단, 집행계획보고 제한 시 전시 국외현지구매 조달판단서로 집행계획을 갈음할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_11","display_id":"전시-국외현지구매-지침-제11조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제2장 조달판단 및 사전준비","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"현지구매반 파견","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_11_P0","display_id":"전시-국외현지구매-지침-제11조","paragraph_number":"","paragraph_index":null,"content":"현지구매반의 파견과 행동절차에 대한 세부사항은 「국외현지구매반 운영 매뉴얼」을 적용한다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_12","display_id":"전시-국외현지구매-지침-제12조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제2장 조달판단 및 사전준비","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"계약행정기간 단축","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_12_P1","display_id":"전시-국외현지구매-지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약 행정기간 단축을 위해 KOTRA 해외무역관 인원과 협조하여 사전 확인이 필요한 계약조건서류, 현물 확인 등 사전에 필요한 조치를 할 수 있다.","items":[]},{"id":"DAPA_A_2100000239708_ART_12_P2","display_id":"전시-국외현지구매-지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"북미지역협력담당관은 제1항의 업무협조를 위해 평시부터 관련정보공유 및 업무수행절차등을 교육하여야 한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_12_P3","display_id":"전시-국외현지구매-지침-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"기타 본 지침에서 명시하지 않은 KOTRA 해외무역관과의 업무협조에 관한 세부사항은 기관별 충무계획을 따른다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_13","display_id":"전시-국외현지구매-지침-제13조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제3장 협상 및 계약체결","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"협상 및 계약 체결","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_13_P1","display_id":"전시-국외현지구매-지침-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"전시 국외현지구매 상황실은 사전 구비된 전시 국외현지구매 품목에 대한 실적가, 주재국 정부 납품가, 시장가 및 기타 가용한 가격정보 등을 주기적으로 최신화 하여 현지구매반의 협상을 지원하여야 한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_13_P2","display_id":"전시-국외현지구매-지침-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"주미단은 계약체결 결과를 현지구매 상황실 및 상업계약팀장에게 통보하여 통사체계상 입력되도록 하고, 통사체계 사용불가에 대비하여 별도의 전산체계를 유지하며 서류원본은 별도 보관토록 한다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약서 작성"]},{"id":"DAPA_A_2100000239708_ART_14","display_id":"전시-국외현지구매-지침-제14조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제3장 협상 및 계약체결","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"계약체결 시 적용조건","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_14_P1","display_id":"전시-국외현지구매-지침-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"전시 국외현지구매 품목의 운송은 적시성을 고려하여 항공운송을 원칙으로 한다. 이를 위해 북미지역협력담당관은 평시 국군수송사령부(전시 연합수송관리단, CTMC)와 전시통합수송지원계획이 최신화 되도록 협조하여야 한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_14_P2","display_id":"전시-국외현지구매-지침-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약일반조건은 분야별(일반장비, 수리부속 등) 계약일반조건을 적용하되 필요시 계약조건을 변경하여 계약을 체결할 수 있다.","items":[]},{"id":"DAPA_A_2100000239708_ART_14_P3","display_id":"전시-국외현지구매-지침-제14조-제3항","paragraph_number":"③","paragraph_index":3,"content":"현지구매반은 제2항에 따라 계약조건을 변경하여 적용하는 경우라도 품질보증에 문제가 발생하지 않도록 다음 관련서류를 계약업체로부터 제출받아야 한다.","items":[{"id":"DAPA_A_2100000239708_ART_14_P3_I1","display_id":"전시-국외현지구매-지침-제14조-제3항-제1호","item_number":"1","content":"제작자인 경우 제작자증명서 1부.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_14_P3_I2","display_id":"전시-국외현지구매-지침-제14조-제3항-제2호","item_number":"2","content":"공급자인 경우 공급자증명서 1부.","subitems":[]}]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약서 작성","일반조건","공급자"]},{"id":"DAPA_A_2100000239708_ART_15","display_id":"전시-국외현지구매-지침-제15조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제3장 협상 및 계약체결","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"준거법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_15_P1","display_id":"전시-국외현지구매-지침-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"전시 국외현지구매 계약에는 대한민국 법을 적용하되 해당 국가의 관련법규를 위반하여서는 아니 된다.","items":[]},{"id":"DAPA_A_2100000239708_ART_15_P2","display_id":"전시-국외현지구매-지침-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"해당 국가의 상거래 관련법규를 적용하는 경우에는 법무관 또는 주재국 대사관 자문 변호사 등의 자문을 받되, 적시성을 고려하여 이를 생략할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_16","display_id":"전시-국외현지구매-지침-제16조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제3장 협상 및 계약체결","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"계약체결시 고려사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_16_P1","display_id":"전시-국외현지구매-지침-제16조-제1항","paragraph_number":"①","paragraph_index":1,"content":"현지구매반은 협상이 완료되면 다음 각 호의 서류를 3부(원본포함) 작성하여야 하며, 계약이 체결된 이후 1부는 보관하고, 1부는 계약상대자에게 교부하며, 1부는 주미단에 송부한다.","items":[{"id":"DAPA_A_2100000239708_ART_16_P1_I1","display_id":"전시-국외현지구매-지침-제16조-제1항-제1호","item_number":"1","content":"계약서 표지(Contract Cover Sheet)","subitems":[]},{"id":"DAPA_A_2100000239708_ART_16_P1_I2","display_id":"전시-국외현지구매-지침-제16조-제1항-제2호","item_number":"2","content":"계약일반조건(General Terms And Conditions)","subitems":[]},{"id":"DAPA_A_2100000239708_ART_16_P1_I3","display_id":"전시-국외현지구매-지침-제16조-제1항-제3호","item_number":"3","content":"계약특수조건(Special Terms And Conditions)","subitems":[]},{"id":"DAPA_A_2100000239708_ART_16_P1_I4","display_id":"전시-국외현지구매-지침-제16조-제1항-제4호","item_number":"4","content":"계약품목 명세서(Commodity Description)","subitems":[]},{"id":"DAPA_A_2100000239708_ART_16_P1_I5","display_id":"전시-국외현지구매-지침-제16조-제1항-제5호","item_number":"5","content":"제작자 증명서(Manufacturer‘s Certificate) 또는 공급자 증명서(Supplier's Certificate)","subitems":[]}]},{"id":"DAPA_A_2100000239708_ART_16_P2","display_id":"전시-국외현지구매-지침-제16조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약관이 현지구매반에 계약 체결과 관련된 권한을 위임할 수 있는 범위는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000239708_ART_16_P2_I1","display_id":"전시-국외현지구매-지침-제16조-제2항-제1호","item_number":"1","content":"전시 국외현지구매 품목은 계약관의 승인절차를 생략하고 계약을 체결할 수 있다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_16_P2_I2","display_id":"전시-국외현지구매-지침-제16조-제2항-제2호","item_number":"2","content":"M+90일 이후의 품목에 대해서도 현지구매 지시가 있는 경우 제1호를 적용한다.","subitems":[]}]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약서 작성","일반조건","특수조건"]},{"id":"DAPA_A_2100000239708_ART_17","display_id":"전시-국외현지구매-지침-제17조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제3장 협상 및 계약체결","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"계약체결 및 발효","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_17_P0","display_id":"전시-국외현지구매-지침-제17조","paragraph_number":"","paragraph_index":null,"content":"전시 국외현지구매 사업의 계약체결은 지역별 현지구매반(장)이 계약서에 서명함으로써 계약이 확정 및 발효된다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약서 작성"]},{"id":"DAPA_A_2100000239708_ART_18","display_id":"전시-국외현지구매-지침-제18조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제4장 후속조치","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"계약번호 부여 및 후속조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_18_P1","display_id":"전시-국외현지구매-지침-제18조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약번호는 주미단으로 요청하여 부여받되, 다음 각 호의 계약번호 구성체계 기준을 준수하여야 한다.","items":[{"id":"DAPA_A_2100000239708_ART_18_P1_I1","display_id":"전시-국외현지구매-지침-제18조-제1항-제1호","item_number":"1","content":"계약번호는 통합사업관리정보체계에서 전산 관리하여야 하므로 주미단에서 계약번호를 부여시는 국가별로 계약순서에 따른 일련번호 3자리를 부여하되 일련번호 첫 자리는 전시 현지구매를 구분하기 위하여 W로 표기한다.","subitems":[]},{"id":"DAPA_A_2100000239708_ART_18_P1_I2","display_id":"전시-국외현지구매-지침-제18조-제1항-제2호","item_number":"2","content":"계약번호 구성체계<img id=\"139951767\"></img>","subitems":[]},{"id":"DAPA_A_2100000239708_ART_18_P1_I3","display_id":"전시-국외현지구매-지침-제18조-제1항-제3호","item_number":"3","content":"계약번호 형식 : KFX - 기관부호 - 연도, 군, 기능, 품목, 사업, 계약팀, 일련번호(W+2자리)1) 기관부호 : 현지구매반은 방위사업청 기관부호 DAPA(KD)사용2) 연도 : 해당 연도의 맨 끝자리3) 군 : 육군(1), 해군(2), 공군(3), 국직(4), 2개군 이상(5)4) 기능 : 항공(A), 화력(B), 함정(C), 통신(D), 공병(E),방공(F), 기동(G), 연료(J), 탄약(K), 운송(L), 화학(M), 병참(N), 의무(X)5) 품목 : 장비(A), 물자(C), 확정부품구매(D), 교육(F), 기름/연료(O), 기타(H)6) 사업 : 방위력개선사업(5), 전력운영사업(0)7) 계약부 : A-국제협력관, B-기반전력사업지원부, I-기동사업부,K-화력사업부, L-전투함사업부, M-특수함사업부, N-항공기사업부, O-헬기사업부, H-미래전력사업지원부, Q-지휘통제통신사업부, R-유도무기사업부, S-감시전자사업부, U-무인사업부, V-한국형전투기사업단, W-한국형잠수함사업단8) 전시부호 : W","subitems":[]}]},{"id":"DAPA_A_2100000239708_ART_18_P2","display_id":"전시-국외현지구매-지침-제18조-제2항","paragraph_number":"②","paragraph_index":2,"content":"현지구매반(장)은 계약이 확정된 후 즉시 계약서 사본 1부를 주미단으로 제출한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_18_P3","display_id":"전시-국외현지구매-지침-제18조-제3항","paragraph_number":"③","paragraph_index":3,"content":"북미지역협력담당관은 주미단이 확정 통보한 계약에 대해 통합사업관리체계로 입력이 가능하도록 정보화기획담당관실과 협조하여야 하며, 체계사용 불가에 대비하여 주미단 자체에서도 별도 전산화 및 수기관리 하도록 하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_19","display_id":"전시-국외현지구매-지침-제19조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제4장 후속조치","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"운송","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_19_P1","display_id":"전시-국외현지구매-지침-제19조-제1항","paragraph_number":"①","paragraph_index":1,"content":"현지구매반은 계약체결 후 운송대행업체가 주미단 운송담당에게 선적관련 정보를 제공토록 조치하고, 주미단은 접수한 운송정보 현황을 관리하되, 동원 운송자산 활용 필요시에는 DTIS 전시모드를 활용하여 운송자산 요청 및 국군수송사령부(전시 연합수송관리단, CTMC)로 현황을 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_19_P2","display_id":"전시-국외현지구매-지침-제19조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전시 국외현지구매 시 동원운송자산의 효율적인 운영을 위하여 대륙별 거점 공항과 항만을 지정할 수 있다. 또한, 전시 계약물자의 신속한 운송을 위해 지역별 운송경로를 사전에 설정할 수 있다.","items":[]},{"id":"DAPA_A_2100000239708_ART_19_P3","display_id":"전시-국외현지구매-지침-제19조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항의 구체적 이행을 위해 북미지역협력담당관은 국제 상업운송 계약 체결 시 전시 운송에 관해 운송업체와 사전 협의를 위한 계약조건을 반영하고, 계획 수립 시 그 결과를 반영할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약서 작성"]},{"id":"DAPA_A_2100000239708_ART_20","display_id":"전시-국외현지구매-지침-제20조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제4장 후속조치","section":"","subsection":"","article_number":"20","article_label":"제20조","article_title":"대금지불","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_20_P1","display_id":"전시-국외현지구매-지침-제20조-제1항","paragraph_number":"①","paragraph_index":1,"content":"대금지불은 송금방식을 원칙으로 하며, 북미지역협력담당관은 대금지급 보증 및 적기 외화자금집행을 위해 한국은행과 협조하여야 한다. 이때, 전쟁초기 물품 구매대금을 사전에 해외은행에 예치하고, 주미단에서 지출심사 및 송금의뢰 시 즉시 자금이 집행되도록 조치한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_20_P2","display_id":"전시-국외현지구매-지침-제20조-제2항","paragraph_number":"②","paragraph_index":2,"content":"북미지역협력담당관은 주미단의 전시 원활한 지출심사 업무 및 송금의뢰 업무를 위해 주미단 출납공무원을 지출관으로 임명 의뢰하고 현지구매반 인원이 이를 지원토록 조치해야 한다.","items":[]},{"id":"DAPA_A_2100000239708_ART_20_P3","display_id":"전시-국외현지구매-지침-제20조-제3항","paragraph_number":"③","paragraph_index":3,"content":"전시 외환대금은 달러로 계약 및 지급함을 원칙으로 한다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_21","display_id":"전시-국외현지구매-지침-제21조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제4장 후속조치","section":"","subsection":"","article_number":"21","article_label":"제21조","article_title":"국제상관례의 준용","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_21_P0","display_id":"전시-국외현지구매-지침-제21조","paragraph_number":"","paragraph_index":null,"content":"전시 국외현지구매 계약에 있어서 통화, 보증금 납부의 형태 및 시기, 대가지급 방법 및 검사 등 조달 절차 수행과 관련하여 불가피한 경우에는 본 지침의 성질에 반하지 아니하는 범위 안에서 국제상관례에 따를 수 있다.","items":[]}],"notes":[],"effective_date":"2024-04-24","revision_date":"2024-04-24","source_file":"전시 국외현지구매 지침.json","source_path":"원문/법제처API/전시 국외현지구매 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000239708_ART_22","display_id":"전시-국외현지구매-지침-제22조","regulation_id":"DAPA_A_2100000239708","regulation_name":"전시 국외현지구매 지침","short_name":"전시 국외현지구매 지침","document_type":"예규","part":"","chapter":"제4장 후속조치","section":"","subsection":"","article_number":"22","article_label":"제22조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000239708_ART_22_P0","display_id":"전시-국외현지구매-지침-제22조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 예규에 대하여「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 이 규정에 대하여 2024년 1월 1일을 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 취하여야 한다.","items":[]