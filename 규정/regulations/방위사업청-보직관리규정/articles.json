[{"id":"DAPA_A_2100000171276_ART_1","display_id":"방위사업청-보직관리규정-제1조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_1_P0","display_id":"방위사업청-보직관리규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업법 제7조 및 같은 법 시행령 제11조에 따른 주요직위 및 그 외 전문성이 필요하다고 인정되는 직위의 보직자격기준과 보직관리에 필요한 사항을 규정함으로써 방위사업 수행의 전문성 향상 및 각 직원의 업무능력 제고를 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_7"],"related_regulations":["DEFENSE_ACQ_ACT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_2","display_id":"방위사업청-보직관리규정-제2조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"용어의 정의","is_deleted":true,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_2_P0","display_id":"방위사업청-보직관리규정-제2조","paragraph_number":"","paragraph_index":null,"content":"<삭 제>","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_3","display_id":"방위사업청-보직관리규정-제3조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_3_P0","display_id":"방위사업청-보직관리규정-제3조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업청과 그 소속기관에 대하여 적용한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_4","display_id":"방위사업청-보직관리규정-제4조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제2장 보직자격","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"적용대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_4_P1","display_id":"방위사업청-보직관리규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업법 시행령 제11조에서 규정한 ‘주요직위’(국장·부장 및 통합사업관리팀장)에 대하여는 별표 1의 보직자격기준을 충족하는 인원을 보직하여야 한다.","items":[]},{"id":"DAPA_A_2100000171276_ART_4_P2","display_id":"방위사업청-보직관리규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"국제계약부서 및 원가관리부서의 팀장 또는 담당급 직위와 통합사업관리팀의 담당급 직위에 대한 정기 전보 시에는 각 부서에서 별표 2의 양식에 따라 필요한 보직자격기준을 제출하고 인사부서에서는 해당 기준을 충족하는 인원을 우선적으로 보직하여야 한다. 단, 전문직위에 해당하는 직위에 대하여는 방위사업청 「공무원인사운영규정」에 따른다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_11"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_5","display_id":"방위사업청-보직관리규정-제5조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제2장 보직자격","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"직무군","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_5_P1","display_id":"방위사업청-보직관리규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제4조 제1항의 보직자격의 설정을 위하여 직무군을 정책, 계약, 공통사업, 기동화력사업, 지휘정찰사업, 유도무기사업, 함정사업, 항공기사업으로 분류하여 운영하여야 한다.","items":[]},{"id":"DAPA_A_2100000171276_ART_5_P2","display_id":"방위사업청-보직관리규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 각 직무군에 속하는 부서는 별표 3의 직무군 분류표에 의한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000171276_ART_4"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_6","display_id":"방위사업청-보직관리규정-제6조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제2장 보직자격","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"보직자격기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_6_P1","display_id":"방위사업청-보직관리규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"별표 3의 직무군 분류표에 명시된 부서에 보직되는 국·부장 및 통합사업관리팀장은 별표 1의 보직자격기준의 근무경력, 교육훈련, 자격증·학위의 3가지 자격요건 중 하나 이상의 자격을 구비하여야 한다. 다만, 「군인사법」 제57조 제1항 및 「공무원징계령」 제1조의2의 규정에 의한 중징계 처분 또는 금고 이상의 형의 선고를 받고 5년이 경과되지 아니한 자는 국·부장 및 통합사업관리팀장 직위에 임명될 수 없다.","items":[]},{"id":"DAPA_A_2100000171276_ART_6_P2","display_id":"방위사업청-보직관리규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 해당 직위의 보직자격은 별표 3의 직무군 분류표에 따른 별표 1의 보직자격기준에 의한다.","items":[]},{"id":"DAPA_A_2100000171276_ART_6_P3","display_id":"방위사업청-보직관리규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제4조 제1항에도 불구하고 ‘주요직위’를 개방형 직위 및 공모 직위로 운영하는 경우는 인사혁신처의「개방형 직위 및 공모 직위 운영지침」을 우선 적용하고, 계약직 공무원을 채용하는 경우 등 인사운영상 불가피한 경우에는 청장의 승인을 거쳐 별도의 보직자격 기준을 인정할 수 있다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000171276_ART_4"],"related_regulations":[],"external_references":["군인사법","공무원징계령"],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_7","display_id":"방위사업청-보직관리규정-제7조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제3장 보직절차 및 관리","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"보직절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_7_P1","display_id":"방위사업청-보직관리규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"보직자격에 따른 개인별 보직절차는 공무원 및 군인인사규정에 따른다.","items":[]},{"id":"DAPA_A_2100000171276_ART_7_P2","display_id":"방위사업청-보직관리규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"조직인사담당관은 ‘주요직위’에 대한 보직조정 심의시 별표 4 서식의 보직자격 기준 충족현황을 작성·첨부하여야 한다. 단, 보직조정 심의를 거치지 않는 경우에는 보직안 청장 보고 시 첨부한다.","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_8","display_id":"방위사업청-보직관리규정-제8조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제3장 보직절차 및 관리","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"보직관리","is_deleted":true,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_8_P0","display_id":"방위사업청-보직관리규정-제8조","paragraph_number":"","paragraph_index":null,"content":"<삭 제>","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_ART_9","display_id":"방위사업청-보직관리규정-제9조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"제3장 보직절차 및 관리","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"보직 경력요건","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_ART_9_P1","display_id":"방위사업청-보직관리규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제6조 제1항에도 불구하고 팀장직위에 최초로 보직되는 자는 본청과 사업관리본부 및 계약관리본부에서 각 1년 이상의 근무경력을 요건으로 한다. 다만, 인사관리상의 불가피한 사유등으로 인하여 이 요건에 의한 대상자 부족으로 팀장 보직이 불가능할 경우에는 보직조정심의위원회의 심의를 거쳐 보직할 수 있다.","items":[]},{"id":"DAPA_A_2100000171276_ART_9_P2","display_id":"방위사업청-보직관리규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"사업단에서의 근무경력은 사업관리본부의 경력으로 간주한다.","items":[]},{"id":"DAPA_A_2100000171276_ART_9_P3","display_id":"방위사업청-보직관리규정-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항의 규정에도 불구하고 신규임용 또는 전입자에 대해서는 7년 이내에는 적용하지 아니할 수 있다.","items":[]},{"id":"DAPA_A_2100000171276_ART_9_P4","display_id":"방위사업청-보직관리규정-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항의 규정은 공무원임용령 제16조 제1항 제2호에 의한 자격증에 의해 특채된 공무원과 전산직 공무원이 각 해당분야인 그 자격증과 관련된 분야와 전산분야의 팀장으로 보임될 경우에는 적용하지 아니한다.","items":[]},{"id":"DAPA_A_2100000171276_ART_9_P5","display_id":"방위사업청-보직관리규정-제9조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"<삭 제>","items":[]}],"notes":[],"effective_date":"2018-11-28","revision_date":"2018-11-28","source_file":"(방위사업청) 보직관리규정.json","source_path":"원문/법제처API/(방위사업청) 보직관리규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000171276_ART_6"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000171276_SUPP1_ART_1","display_id":"방위사업청-보직관리규정-부칙1-제1조","regulation_id":"DAPA_A_2100000171276","regulation_name":"(방위사업청) 보직관리규정","short_name":"(방위사업청) 보직관리규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000171276_SUPP1_ART_1_P0","display_id":"방위사업청-보직관리규정-부칙1-제1조","paragraph_number":"","paragraph_index":null,"con