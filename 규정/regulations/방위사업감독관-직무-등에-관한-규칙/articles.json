[{"id":"DAPA_L_210539_ART_1","display_id":"방위사업감독관-직무-등에-관한-규칙-제1조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_1_P0","display_id":"방위사업감독관-직무-등에-관한-규칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규칙은 「방위사업법 시행령」 제12조의2제1항 및「방위사업청과 그 소속기관 직제」 제4조의5에 따라 설치ㆍ운영되는 자체감독기구의 장의 직무 등에 관하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_12_2","DAPA_L_288759_ART_4_5"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT","DAPA_L_288759"],"external_references":[],"keywords":[]},{"id":"DAPA_L_210539_ART_2","display_id":"방위사업감독관-직무-등에-관한-규칙-제2조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_2_P0","display_id":"방위사업감독관-직무-등에-관한-규칙-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규칙에서 사용하는 용어의 뜻은 다음과 같다.","items":[{"id":"DAPA_L_210539_ART_2_P0_I1","display_id":"방위사업감독관-직무-등에-관한-규칙-제2조-제1호","item_number":"1","content":"\"방위사업감독관\"이란 「방위사업법 시행령」(이하 \"영\"이라 한다) 제12조의2제1항에 따른 자체감독기구의 장을 말한다.","subitems":[]},{"id":"DAPA_L_210539_ART_2_P0_I2","display_id":"방위사업감독관-직무-등에-관한-규칙-제2조-제2호","item_number":"2","content":"\"감독\"이란 방위사업감독관이 비리를 상시 감시하고 이를 예방하기 위하여 수행하는 방위사업에 대한 법률적 검토, 사업검증ㆍ승인 및 정보수집 활동 등을 말한다.","subitems":[]},{"id":"DAPA_L_210539_ART_2_P0_I3","display_id":"방위사업감독관-직무-등에-관한-규칙-제2조-제3호","item_number":"3","content":"\"사업검증\"이란 방위사업의 추진기본전략 수립, 제안요청서 작성, 계약 체결 등 주요 단계에서 사업의 적정성 등을 확인하는 것을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_12_2"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_L_210539_ART_3","display_id":"방위사업감독관-직무-등에-관한-규칙-제3조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"업무의 조정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_3_P0","display_id":"방위사업감독관-직무-등에-관한-규칙-제3조","paragraph_number":"","paragraph_index":null,"content":"방위사업감독관과 방위사업청 감사관은 방위사업 감독업무의 효율화를 위하여 방위사업에 대한 감독ㆍ감사 업무가 중복되지 아니하도록 협의ㆍ조정한다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["감독"]},{"id":"DAPA_L_210539_ART_4","display_id":"방위사업감독관-직무-등에-관한-규칙-제4조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"업무의 독립성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_4_P0","display_id":"방위사업감독관-직무-등에-관한-규칙-제4조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 영 제12조의2제2항에 따른 방위사업감독관 업무 수행의 독립성을 최대한 보장하기 위하여 필요한 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_12_2"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_L_210539_ART_5","display_id":"방위사업감독관-직무-등에-관한-규칙-제5조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"전문성 강화","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_5_P0","display_id":"방위사업감독관-직무-등에-관한-규칙-제5조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 방위사업감독관에게 소속될 변호사, 회계사 및 기술사 등 전문인력 확보를 위하여 「공무원임용령」 제43조의3에 따른 전문직위 지정과 「국가공무원법」 제26조의5에 따른 임기제공무원 임용 등의 방법을 활용할 수 있다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["공무원임용령","국가공무원법"],"keywords":[]},{"id":"DAPA_L_210539_ART_6","display_id":"방위사업감독관-직무-등에-관한-규칙-제6조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"사업검증계획의 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_6_P1","display_id":"방위사업감독관-직무-등에-관한-규칙-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업감독관은 다음 해에 시행할 방위사업검증계획을 종합하여 사업검증 개시연도 30일 전까지 다음 각 호의 사항이 포함된 연간 사업검증계획을 수립하여야 한다.","items":[{"id":"DAPA_L_210539_ART_6_P1_I1","display_id":"방위사업감독관-직무-등에-관한-규칙-제6조-제1항-제1호","item_number":"1","content":"사업검증 대상","subitems":[]},{"id":"DAPA_L_210539_ART_6_P1_I2","display_id":"방위사업감독관-직무-등에-관한-규칙-제6조-제1항-제2호","item_number":"2","content":"사업검증의 범위","subitems":[]},{"id":"DAPA_L_210539_ART_6_P1_I3","display_id":"방위사업감독관-직무-등에-관한-규칙-제6조-제1항-제3호","item_number":"3","content":"그 밖에 사업검증에 필요한 사항","subitems":[]}]},{"id":"DAPA_L_210539_ART_6_P2","display_id":"방위사업감독관-직무-등에-관한-규칙-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업감독관은 제1항에 따른 연간 사업검증계획에 포함되지 아니하는 검증을 하는 경우에는 제1항 각 호의 사항이 포함된 사업검증계획을 별도로 수립하여야 한다.","items":[]},{"id":"DAPA_L_210539_ART_6_P3","display_id":"방위사업감독관-직무-등에-관한-규칙-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업감독관은 필요하면 방위사업청장의 승인을 받아 제1항 및 제2항에 따른 사업검증계획을 변경할 수 있다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_210539_ART_7","display_id":"방위사업감독관-직무-등에-관한-규칙-제7조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"사업검증과 승인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_7_P1","display_id":"방위사업감독관-직무-등에-관한-규칙-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제6조제1항 및 제2항에 따라 사업검증 대상으로 선정된 사업 소관 부서의 장은 계약 체결을 위한 최종 결재 전 방위사업감독관의 승인을 받아야 한다. 이 경우 방위사업감독관은 법률적 문제 등에 대한 검토 및 사업검증 결과를 판단하여 승인 여부를 결정한다.","items":[]},{"id":"DAPA_L_210539_ART_7_P2","display_id":"방위사업감독관-직무-등에-관한-규칙-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 사업검증 대상 사업의 계약 체결을 위한 최종 결재 전에 방위사업감독관이 승인하였는지 확인하여야 한다.","items":[]},{"id":"DAPA_L_210539_ART_7_P3","display_id":"방위사업감독관-직무-등에-관한-규칙-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"사업검증은 사업추진기본전략 수립, 제안요청서의 작성 및 계약 체결 등 주요 단계별로 하는 정기검증과 필요에 따라 하는 수시검증으로 나누어 실시한다.","items":[]},{"id":"DAPA_L_210539_ART_7_P4","display_id":"방위사업감독관-직무-등에-관한-규칙-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항부터 제3항까지에서 정한 사항 외에 사업검증과 승인에 관한 세부적인 사항은 방위사업청장이 정한다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_210539_ART_6"],"related_regulations":[],"external_references":[],"keywords":["계약서 작성"]},{"id":"DAPA_L_210539_ART_8","display_id":"방위사업감독관-직무-등에-관한-규칙-제8조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"개선대책 수립ㆍ시행 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_8_P1","display_id":"방위사업감독관-직무-등에-관한-규칙-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업감독관은 방위사업에 대한 검증과 비리예방 관련 업무를 수행하면서 문제점을 발견한 경우에는 이에 대한 개선대책을 수립하여 해당 부서의 장에게 통보하거나 개선대책 수립을 요구할 수 있다.","items":[]},{"id":"DAPA_L_210539_ART_8_P2","display_id":"방위사업감독관-직무-등에-관한-규칙-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 개선대책을 통보받거나 개선대책 수립을 요구받은 부서의 장은 이에 대한 의견과 개선대책 및 개선대책 시행을 위한 세부계획을 30일 안에 방위사업감독관에게 통보하여야 한다.","items":[]},{"id":"DAPA_L_210539_ART_8_P3","display_id":"방위사업감독관-직무-등에-관한-규칙-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업감독관은 제2항에 따른 개선대책 및 세부계획 등의 이행상황을 점검할 수 있다.","items":[]},{"id":"DAPA_L_210539_ART_8_P4","display_id":"방위사업감독관-직무-등에-관한-규칙-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항부터 제3항까지에서 정한 사항 외에 방위사업 관련 개선대책의 수립ㆍ시행에 관한 세부적인 사항은 방위사업청장이 정한다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_210539_ART_9","display_id":"방위사업감독관-직무-등에-관한-규칙-제9조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"감독활동의 평가 및 보고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_9_P0","display_id":"방위사업감독관-직무-등에-관한-규칙-제9조","paragraph_number":"","paragraph_index":null,"content":"방위사업감독관은 매년 감독활동을 자체 평가하고, 평가 결과를 방위사업청장에게 보고하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["감독"]},{"id":"DAPA_L_210539_ART_10","display_id":"방위사업감독관-직무-등에-관한-규칙-제10조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"방위사업에 대한 법률적 문제 등 검토","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_210539_ART_10_P1","display_id":"방위사업감독관-직무-등에-관한-규칙-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청 소관 부서의 장은 「방위사업법」 제8조와 영 제12조에 따른 계약 또는 협상 등을 할 때 미리 방위사업감독관에게 법률적 문제에 대한 검토를 받아야 한다.","items":[]},{"id":"DAPA_L_210539_ART_10_P2","display_id":"방위사업감독관-직무-등에-관한-규칙-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에서 정한 사항 외에 방위사업 관련 법률적 검토에 관한 세부적인 사항은 방위사업청장이 정한다.","items":[]}],"notes":[],"effective_date":"2019-09-17","revision_date":"2019-09-17","source_file":"방위사업감독관 직무 등에 관한 규칙.json","source_path":"원문/법제처API/방위사업감독관 직무 등에 관한 규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ACT_ART_8","DEFENSE_ACQ_ENFORCEMENT_ART_12"],"related_regulations":["DEFENSE_ACQ_ACT","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_L_210539_ART_11","display_id":"방위사업감독관-직무-등에-관한-규칙-제11조","regulation_id":"DAPA_L_210539","regulation_name":"방위사업감독관 직무 등에 관한 규칙","short_name":"방위사업감독관 직무 등에 관한 규칙","document_type":"부령","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"","is_deleted":true,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_da