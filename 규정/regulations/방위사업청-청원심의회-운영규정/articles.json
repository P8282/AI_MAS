[{"id":"DAPA_A_2100000274624_ART_1","display_id":"방위사업청-청원심의회-운영규정-제1조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_1_P0","display_id":"방위사업청-청원심의회-운영규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「청원법」 제8조 및 같은 법 시행령 제3조제9항에 따라 방위사업청에 두는 청원심의회의 구성 및 운영에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274624_ART_3"],"related_regulations":[],"external_references":["청원법"],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_2","display_id":"방위사업청-청원심의회-운영규정-제2조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_2_P1","display_id":"방위사업청-청원심의회-운영규정-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 규정은 방위사업청과 그 소속기관에 대하여 적용한다.","items":[]},{"id":"DAPA_A_2100000274624_ART_2_P2","display_id":"방위사업청-청원심의회-운영규정-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"청원심의회 운영 등에 관하여 다른 법령에 특별한 규정이 있는 경우를 제외하고는 이 규정이 정하는 바에 따른다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_3","display_id":"방위사업청-청원심의회-운영규정-제3조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"청원업무 주관부서ㆍ처리부서","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_3_P1","display_id":"방위사업청-청원심의회-운영규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"「청원법」(이하 \"법\"이라 한다), 같은 법 시행령(이하 \"시행령\"이라 한다) 및 같은 법 시행규칙(이하 \"시행규칙\"이라 한다)에 따라 청원사항에 관한 업무를 주관하는 부서(이하 \"주관부서\"라 한다)는 혁신행정법무담당관으로 한다.","items":[]},{"id":"DAPA_A_2100000274624_ART_3_P2","display_id":"방위사업청-청원심의회-운영규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"법 제12조에 따라 접수된 청원은 소관 업무와 관련하여 실제 처리하는 부서(이하 \"처리부서\"라 한다)에서 담당한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_4","display_id":"방위사업청-청원심의회-운영규정-제4조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"청원심의의 원칙","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_4_P0","display_id":"방위사업청-청원심의회-운영규정-제4조","paragraph_number":"","paragraph_index":null,"content":"법 제8조에 따라 방위사업청에 설치하는 청원심의회(이하 \"심의회\"라 한다)는 청원사항을 심의함에 있어 객관적으로 처리될 수 있도록 공정하게 심의하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274624_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_5","display_id":"방위사업청-청원심의회-운영규정-제5조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"청원심의회 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_5_P1","display_id":"방위사업청-청원심의회-운영규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심의회는 위원장 1명을 포함하여 7명으로 구성하되, 3명은 방위사업청 소속 공무원을 내부위원으로 하고, 4명은 외부위원으로 한다.","items":[]},{"id":"DAPA_A_2100000274624_ART_5_P2","display_id":"방위사업청-청원심의회-운영규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심의회 위원장(이하 \"위원장\"이라 한다)은 기획조정관으로, 내부위원은 혁신행정법무담당관, 청원 처리부서의 장으로 하고, 임기는 그 직위에 재직하는 기간으로 한다.","items":[]},{"id":"DAPA_A_2100000274624_ART_5_P3","display_id":"방위사업청-청원심의회-운영규정-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"외부위원은 방위사업청 소관 사무 분야의 학식과 경험이 풍부한 사람 중에서 방위사업청장이 위촉하되 임기는 2년으로 하며, 한 차례만 연임할 수 있다.","items":[]},{"id":"DAPA_A_2100000274624_ART_5_P4","display_id":"방위사업청-청원심의회-운영규정-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"심의회의 사무를 처리하기 위하여 간사 1명을 두되, 간사는 주관부서의 청원업무 담당 실무자로 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_6","display_id":"방위사업청-청원심의회-운영규정-제6조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"청원심의회 심의사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_6_P1","display_id":"방위사업청-청원심의회-운영규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심의회는 다음 각호의 1에 해당하는 사항을 심의한다.","items":[{"id":"DAPA_A_2100000274624_ART_6_P1_I1","display_id":"방위사업청-청원심의회-운영규정-제6조-제1항-제1호","item_number":"1","content":"법 제8조제1항제1호 및 법 제11조제2항에 따른 공개청원의 공 개여부에 관한 사항","subitems":[]},{"id":"DAPA_A_2100000274624_ART_6_P1_I2","display_id":"방위사업청-청원심의회-운영규정-제6조-제1항-제2호","item_number":"2","content":"법 제8조제1항제2호 및 법 제21조제1항 본문에 따른 청원의 조 사결과 등","subitems":[]},{"id":"DAPA_A_2100000274624_ART_6_P1_I3","display_id":"방위사업청-청원심의회-운영규정-제6조-제1항-제3호","item_number":"3","content":"법 제8조제1항제3호에 따른 그 밖에 청원에 관한 사항","subitems":[]}]},{"id":"DAPA_A_2100000274624_ART_6_P2","display_id":"방위사업청-청원심의회-운영규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에도 불구하고 법 제21조제1항 단서 및 영 제15조에 따른 청원심의회의 심의를 거칠 필요가 없는 사항에 해당하는 경우에는 심의회의 심의를 생략할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274624_ART_8"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_7","display_id":"방위사업청-청원심의회-운영규정-제7조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"청원심의회 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_7_P1","display_id":"방위사업청-청원심의회-운영규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심의회는 위원장이 필요하다고 인정하거나 해당 청원사항과 관련하여 처리부서의 장이 요청할 경우 소집할 수 있다.","items":[]},{"id":"DAPA_A_2100000274624_ART_7_P2","display_id":"방위사업청-청원심의회-운영규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심의회는 위원장을 포함하여 재적위원 과반수의 출석으로 개의하고, 출석위원 과반수의 찬성으로 의결한다. 다만, 위원이 부득이한 사유로 참석할 수 없는 경우에는 별지 제1호서식에 따른 청원심의회 검토의견서를 제출할 수 있고, 이 경우 청원심의회에 출석한 것으로 본다.","items":[]},{"id":"DAPA_A_2100000274624_ART_7_P3","display_id":"방위사업청-청원심의회-운영규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"심의회 회의는 출석하여 회의(화상회의를 포함한다)하는 것을 원칙으로 하되, 다음 각 호의 경우에는 서면회의로 대체할 수 있다.","items":[{"id":"DAPA_A_2100000274624_ART_7_P3_I1","display_id":"방위사업청-청원심의회-운영규정-제7조-제3항-제1호","item_number":"1","content":"안건의 내용이 경미한 경우","subitems":[]},{"id":"DAPA_A_2100000274624_ART_7_P3_I2","display_id":"방위사업청-청원심의회-운영규정-제7조-제3항-제2호","item_number":"2","content":"긴급한 사유로 위원이 출석하는 회의를 개최할 시간적 여유가 없는 경우","subitems":[]},{"id":"DAPA_A_2100000274624_ART_7_P3_I3","display_id":"방위사업청-청원심의회-운영규정-제7조-제3항-제3호","item_number":"3","content":"천재지변이나 그 밖의 부득이한 사유로 인하여 위원의 출석에 의한 의사정족수를 채우기 어려운 경우","subitems":[]},{"id":"DAPA_A_2100000274624_ART_7_P3_I4","display_id":"방위사업청-청원심의회-운영규정-제7조-제3항-제4호","item_number":"4","content":"감염병 확산 방지 등 재난 대응이 필요한 경우","subitems":[]}]},{"id":"DAPA_A_2100000274624_ART_7_P4","display_id":"방위사업청-청원심의회-운영규정-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"심의회 위원은 심의과정 및 위원 활동에서 알게 된 청원 관련 사항을 타인에게 누설해서는 안 되며, 임기 만료 이후에도 또한 같다.","items":[]},{"id":"DAPA_A_2100000274624_ART_7_P5","display_id":"방위사업청-청원심의회-운영규정-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"간사는 심의회의 심의의결서 및 회의록을 작성하여야 하며, 심의의결서는 별지 제2호서식에 따른다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_8","display_id":"방위사업청-청원심의회-운영규정-제8조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"심의회 개최 요구","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_8_P1","display_id":"방위사업청-청원심의회-운영규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청원을 처리하는 처리부서에서는 제6조제1항 각 호에 해당된다고 판단되는 경우는 심의회 개최를 요구할 수 있다.","items":[]},{"id":"DAPA_A_2100000274624_ART_8_P2","display_id":"방위사업청-청원심의회-운영규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심의회 개최를 요구할 때에는 별지 제3호서식에 의한 심의회 개최요구서 및 기타 필요한 자료를 첨부하여 주관부서에 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000274624_ART_8_P3","display_id":"방위사업청-청원심의회-운영규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"심의회 종료 후 주관부서는 별지 제2호서식을 첨부하여 처리부서에 통보하고, 처리부서는 심의회 심의 결과를 성실히 반영하여 청원을 처리하고 처리결과를 청원인에게 통지하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000274624_ART_6"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_9","display_id":"방위사업청-청원심의회-운영규정-제9조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"수당","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_9_P0","display_id":"방위사업청-청원심의회-운영규정-제9조","paragraph_number":"","paragraph_index":null,"content":"심의회를 개최한 때에는 공무원이 아닌 위원에 대해서는 예산의 범위에서 각종 수당ㆍ여비 등 기타 필요한 경비를 지급할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청원심의회 운영규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000274624_ART_10","display_id":"방위사업청-청원심의회-운영규정-제10조","regulation_id":"DAPA_A_2100000274624","regulation_name":"방위사업청 청원심의회 운영규정","short_name":"방위사업청 청원심의회 운영규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000274624_ART_10_P0","display_id":"방위사업청-청원심의회-운영규정-제10조","paragraph_number":"","paragraph_index":null,"content":"청장은 이 훈령에 대하여「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2026년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-02-10","revision_date":"2026-02-10","source_file":"방위사업청 청원심의회 운영규정.json","source_path":"원문/법제처API/방위사업청 청