00000284884","regulation_name":"방위사업청 정책자문위원회 규정","short_name":"방위사업청 정책자문위원회 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"해촉","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000284884_ART_7_P0","display_id":"방위사업청-정책자문위원회-규정-제7조","paragraph_number":"","paragraph_index":null,"content":"청장은 제4조에 따라 위촉된 위원이 다음 각 호의 어느 하나에 해당하는 경우에는 임기 만료 전이라도 해촉할 수 있다.","items":[{"id":"DAPA_A_2100000284884_ART_7_P0_I1","display_id":"방위사업청-정책자문위원회-규정-제7조-제1호","item_number":"1","content":"자문활동을 성실히 수행하지 않는 경우","subitems":[]},{"id":"DAPA_A_2100000284884_ART_7_P0_I2","display_id":"방위사업청-정책자문위원회-규정-제7조-제2호","item_number":"2","content":"제9조(비밀보호)부터 제11조(정치적 중립)까지의 의무를 위반 경우","subitems":[]},{"id":"DAPA_A_2100000284884_ART_7_P0_I3","display_id":"방위사업청-정책자문위원회-규정-제7조-제3호","item_number":"3","content":"위원이 질병, 6개월 이상의 연수 또는 여행, 기타 직무를 수행할 수 없는 사유가 있거나 스스로가 해촉을 원하는 경우","subitems":[]},{"id":"DAPA_A_2100000284884_ART_7_P0_I4","display_id":"방위사업청-정책자문위원회-규정-제7조-제4호","item_number":"4","content":"품위손상이나 그 밖의 사유로 위원으로 적합하지 아니하다고 인정되는 경우","subitems":[]}]}],"notes":[],"effective_date":"2026-09-08","revision_date":"2026-09-08","source_file":"방위사업청 정책자문위원회 규정.json","source_path":"원문/법제처API/방위사업청 정책자문위원회 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000284884_ART_4","DAPA_A_2100000284884_ART_9","DAPA_A_2100000284884_ART_11"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000284884_ART_8","display_id":"방위사업청-정책자문위원회-규정-제8조","regulation_id":"DAPA_A_2100000284884","regulation_name":"방위사업청 정책자문위원회 규정","short_name":"방위사업청 정책자문위원회 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"회의 등의 운영","is_deleted":false,"