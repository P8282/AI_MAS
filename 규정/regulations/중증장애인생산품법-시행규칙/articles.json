[{"id":"SEVERELY_DISABLED_PRODUCTS_RULE_ART_1","display_id":"중증장애인생산품법-시행규칙-제1조","regulation_id":"SEVERELY_DISABLED_PRODUCTS_RULE","regulation_name":"중증장애인생산품 우선구매 특별법 시행규칙","short_name":"중증장애인생산품법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"SEVERELY_DISABLED_PRODUCTS_RULE_ART_1_P0","display_id":"중증장애인생산품법-시행규칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규칙은 「중증장애인생산품 우선구매 특별법」 및 같은 법 시행령에서 위임된 사항과 그 시행에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2020-05-27","revision_date":"2020-05-27","source_file":"SEVERELY_DISABLED_PRODUCTS_RULE.json","source_path":"원문/법제처API/SEVERELY_DISABLED_PRODUCTS_RULE.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","api_text":"제1조(목적) 이 규칙은 「중증장애인생산품 우선구매 특별법」 및 같은 법 시행령에서 위임된 사항과 그 시행에 필요한 사항을 규정함을 목적으로 한다.","source":"api","source_url":"https://www.law.go.kr/lsInfoP.do?lsiSeq=218455","api_received":"2026-10-14","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"SEVERELY_DISABLED_PRODUCTS_RULE_ART_1_2","display_id":"중증장애인생산품법-시행규칙-제1조의2","regulation_id":"SEVERELY_DISABLED_PRODUCTS_RULE","regulation_name":"중증장애인생산품 우선구매 특별법 시행규칙","short_name":"중증장애인생산품법 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"1의2","article_label":"제1조의2","article_title":"중증장애인의 범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"SEVERELY_DISABLED_PRODUCTS_RULE_ART_1_2_P0","display_id":"중증장애인생산품법-시행규칙-제1조의2","paragraph_number":"","paragraph_index":null,"content":"「중증장애인생산품 우선구매 특별법」(이하 \"법\"이라 한다) 제2조제1항에서 \"보건복지부령으로 정하는