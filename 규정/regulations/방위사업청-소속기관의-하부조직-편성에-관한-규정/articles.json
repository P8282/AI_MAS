[{"id":"DAPA_A_2100000283954_ART_1","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제1조","regulation_id":"DAPA_A_2100000283954","regulation_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","short_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283954_ART_1_P0","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위사업청과 그 소속기관의 직제 시행규칙」(이하 \"직제 시행규칙\"이라 한다)상의 방위사업청 소속기관의 팀 단위 사무분장권 등을 명백히 하고, 직제 시행규칙 제15조, 제22조에 의해 위임된 기반전력사업본부 및 미래전력사업본부의 한시적 보조기관의 편성에 관한 사항을 규정함으로써 소속기관 운영의 효율화를 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-08-14","revision_date":"2026-08-13","source_file":"방위사업청 소속기관의 하부조직 편성에 관한 규정.json","source_path":"원문/법제처API/방위사업청 소속기관의 하부조직 편성에 관한 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["PPS_ORGANIZATION_RULE_ART_15"],"related_regulations":["PPS_ORGANIZATION_RULE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283954_ART_2","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제2조","regulation_id":"DAPA_A_2100000283954","regulation_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","short_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"팀 편성 및 정원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283954_ART_2_P1","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"직제 시행규칙 제15조, 제22조에 의하여 기반전력사업본부 및 미래전력사업본부의 각 부 및 한국형전투기사업단, 핵추진잠수함사업단(이하 \"사업단\"이라 한다)에 두는 한시적 보조기관의 편성은 별표와 같다.","items":[]},{"id":"DAPA_A_2100000283954_ART_2_P2","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"삭제","items":[]},{"id":"DAPA_A_2100000283954_ART_2_P3","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"삭제 <2011.6.7>","items":[]},{"id":"DAPA_A_2100000283954_ART_2_P4","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제2조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항 및 직제 시행규칙 제12조, 제13조, 제13조의2, 제13조의3, 제13조의5, 제13조의6, 제17조, 제18조, 제19조, 제20조, 제21조, 제26조, 제27조, 제27조의2 및 제27조의3에 따라 편성된 기반전력사업본부 및 미래전력사업본부의 각 팀별 정원은 직제 시행규칙 제24조에 따른 범위 안에서 기반전력사업본부장 및 미래전력사업본부장이 조직인사담당관과 협의하여 별도로 정한다. 이 경우 기반전력사업본부장 및 미래전력사업본부장은 각 부 및 사업단에 두는 팀의 정원조정에 관한 사항을 소속부장에게 위임할 수 있다.","items":[]},{"id":"DAPA_A_2100000283954_ART_2_P5","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제2조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"삭제","items":[]}],"notes":[],"effective_date":"2026-08-14","revision_date":"2026-08-13","source_file":"방위사업청 소속기관의 하부조직 편성에 관한 규정.json","source_path":"원문/법제처API/방위사업청 소속기관의 하부조직 편성에 관한 규정.json","pdf_path":"","source_page":"","amendments":["<2011.6.7>"],"last_amended":"2011-06-07","related_articles":["PPS_ORGANIZATION_RULE_ART_15","PPS_ORGANIZATION_RULE_ART_12","PPS_ORGANIZATION_RULE_ART_13","PPS_ORGANIZATION_RULE_ART_13_2","PPS_ORGANIZATION_RULE_ART_17","PPS_ORGANIZATION_RULE_ART_18"],"related_regulations":["PPS_ORGANIZATION_RULE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283954_ART_3","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제3조","regulation_id":"DAPA_A_2100000283954","regulation_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","short_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"팀별 기능 및 팀원 사무분장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000283954_ART_3_P1","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기반전력사업본부 및 미래전력사업본부의 팀별 기능은 직제 시행규칙 제12조, 제13조, 제13조의2, 제13조의3, 제13조의5, 제13조의6, 제17조, 제18조, 제19조, 제20조, 제21조, 제26조, 제27조, 제27조의2 및 제27조의3에 의한다.","items":[]},{"id":"DAPA_A_2100000283954_ART_3_P2","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제2조 제1항에 의하여 기반전력사업본부 및 미래전력사업본부의 각 부 및 사업단에 두는 한시적 보조기관의 팀별 기능은 직제 시행규칙 제13조 제3항을 준용한다.","items":[]},{"id":"DAPA_A_2100000283954_ART_3_P3","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"삭제","items":[]},{"id":"DAPA_A_2100000283954_ART_3_P4","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제3조-제4항","paragraph_number":"④","paragraph_index":4,"content":"삭제 <2011.6.7>","items":[]},{"id":"DAPA_A_2100000283954_ART_3_P5","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제3조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"소속기관의 각 팀원별 사무분장은 소속팀장이 정한다.","items":[]}],"notes":[],"effective_date":"2026-08-14","revision_date":"2026-08-13","source_file":"방위사업청 소속기관의 하부조직 편성에 관한 규정.json","source_path":"원문/법제처API/방위사업청 소속기관의 하부조직 편성에 관한 규정.json","pdf_path":"","source_page":"","amendments":["<2011.6.7>"],"last_amended":"2011-06-07","related_articles":["PPS_ORGANIZATION_RULE_ART_12","PPS_ORGANIZATION_RULE_ART_13","PPS_ORGANIZATION_RULE_ART_13_2","PPS_ORGANIZATION_RULE_ART_17","PPS_ORGANIZATION_RULE_ART_18","DAPA_A_2100000283954_ART_2"],"related_regulations":["PPS_ORGANIZATION_RULE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000283954_ART_4","display_id":"방위사업청-소속기관의-하부조직-편성에-관한-규정-제4조","regulation_id":"DAPA_A_2100000283954","regulation_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","short_name":"방위사업청 소속기관의 하부조직 편성에 관한 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_titl