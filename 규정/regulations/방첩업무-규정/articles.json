[{"id":"DAPA_A_2100000215282_ART_1","display_id":"방첩업무-규정-제1조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_1_P0","display_id":"방첩업무-규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 예규는 「국가정보원법」 제4조, 「방첩업무규정」,「군방첩업무훈령」의 적절한 운영을 기하기 위하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["국가정보원법"],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_2","display_id":"방첩업무-규정-제2조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_2_P0","display_id":"방첩업무-규정-제2조","paragraph_number":"","paragraph_index":null,"content":"이 예규에서 사용하는 용어의 뜻은 다음과 같다.","items":[{"id":"DAPA_A_2100000215282_ART_2_P0_I1","display_id":"방첩업무-규정-제2조-제1호","item_number":"1","content":"\"방첩\"이란 국가안보와 국익에 반하는 북한, 외국 및 외국인ㆍ외국단체ㆍ초국가행위자 또는 이와 연계된 내국인의 정보활동을 찾아내고 그 정보활동을 확인ㆍ견제ㆍ차단 하기 위하여 하는 정보의 수집ㆍ작성 및 배포 등을 포함한 모든 대응 활동을 말한다.","subitems":[]},{"id":"DAPA_A_2100000215282_ART_2_P0_I2","display_id":"방첩업무-규정-제2조-제2호","item_number":"2","content":"\"군방첩\"이란 군사상 기밀(군관련 국가기밀을 포함한다)을 탐지ㆍ수집하는 등 국가안보와 국익에 반하는 북한, 외국 및 외국인ㆍ외국단체ㆍ초국가행위자 또는 이와 연계된 군관련 내국인의 정보활동을 찾아내고 그 정보활동을 확인ㆍ견제ㆍ차단하기 위하여 하는 정보의 수집ㆍ작성 및 배포 등을 포함한 군에서 수행하는 모든 대응 활동을 말한다.","subitems":[]},{"id":"DAPA_A_2100000215282_ART_2_P0_I3","display_id":"방첩업무-규정-제2조-제3호","item_number":"3","content":"\"외국등의 정보활동\"이란 제1호 및 제2호에 열거된 대상의 정보 수집 활동과 그 밖의 활동으로서 대한민국의 국가안보와 국익에 영향을 미칠 수 있는 모든 활동을 말한다.","subitems":[]},{"id":"DAPA_A_2100000215282_ART_2_P0_I4","display_id":"방첩업무-규정-제2조-제4호","item_number":"4","content":"\"외국 정보기관\"이란 특정국가에서 다른 국가에 대한 정보 수집을 주된 목적으로 설치된 기관을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_3","display_id":"방첩업무-규정-제3조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_3_P0","display_id":"방첩업무-규정-제3조","paragraph_number":"","paragraph_index":null,"content":"이 이 예규는 방위사업청(청본부 및 소속기관을 포함한다)(이하 \"청\"이라 한다) 및 산하 모든 기관에 적용한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_4","display_id":"방첩업무-규정-제4조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"방첩업무 담당부서 및 담당관","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_4_P1","display_id":"방첩업무-규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청의 방첩담당관은 운영지원과장이 임명과 동시에 그 직을 수행하고, 직위를 떠난 경우에는 해임된 것으로 본다.","items":[]},{"id":"DAPA_A_2100000215282_ART_4_P2","display_id":"방첩업무-규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"분임방첩담당관은 청의「보안업무규정」(방위사업청훈령, 이하 \"청 보안업무규정\"이라 한다)상의 분임보안담당관이 겸임한다.","items":[{"id":"DAPA_A_2100000215282_ART_4_P2_I1","display_id":"방첩업무-규정-제4조-제2항-제1호","item_number":"1","content":"청본부 : 각 국장ㆍ관이 임명하는 과장 또는 담당관, 비서실장, 대변인, 비상기획보안팀장, 조직인사담당관이 임명하는 팀장","subitems":[]},{"id":"DAPA_A_2100000215282_ART_4_P2_I2","display_id":"방첩업무-규정-제4조-제2항-제2호","item_number":"2","content":"기반전력사업본부, 미래전력사업본부 : 각 부(단)장이 지명하는 과ㆍ팀장","subitems":[]}]},{"id":"DAPA_A_2100000215282_ART_4_P3","display_id":"방첩업무-규정-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방첩담당관의 임무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000215282_ART_4_P3_I1","display_id":"방첩업무-규정-제4조-제3항-제1호","item_number":"1","content":"「방첩업무규정」(대통령령, 이하 \"규정\"이라 한다) 제7조제2항, 「군방첩업무훈령」 (국방부훈령, 이하 \"군훈령\"이라 한다) 제7조에 따른 방첩관련 자체훈령 제정ㆍ시행에 관한 업무","subitems":[]},{"id":"DAPA_A_2100000215282_ART_4_P3_I2","display_id":"방첩업무-규정-제4조-제3항-제2호","item_number":"2","content":"분임방첩담당관의 임무에 대한 총괄역할을 하며, 방첩사고관련 사항 발생시 국가정보원 및 군사안보지원부대에 통보","subitems":[]}]},{"id":"DAPA_A_2100000215282_ART_4_P4","display_id":"방첩업무-규정-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"분임방첩담당관의 임무는 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000215282_ART_4_P4_I1","display_id":"방첩업무-규정-제4조-제4항-제1호","item_number":"1","content":"규정 제8조제1항, 군훈령 제9조에 따른 외국인 접촉 시 특이사항의 접수 및 방첩담당관 보고에 관한 업무","subitems":[]},{"id":"DAPA_A_2100000215282_ART_4_P4_I2","display_id":"방첩업무-규정-제4조-제4항-제2호","item_number":"2","content":"규정 제9조, 군훈령 제10조에 따른 외국정보기관 구성원 접촉 관리에 관한 업무","subitems":[]},{"id":"DAPA_A_2100000215282_ART_4_P4_I3","display_id":"방첩업무-규정-제4조-제4항-제3호","item_number":"3","content":"규정 제13조, 군훈령 제12조에 따른 방첩교육 시행에 관한 확인 업무","subitems":[]},{"id":"DAPA_A_2100000215282_ART_4_P4_I4","display_id":"방첩업무-규정-제4조-제4항-제4호","item_number":"4","content":"기타 방첩업무의 원활한 수행을 위해 필요한 업무","subitems":[]}]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000215282_ART_7","DAPA_A_2100000215282_ART_8","DAPA_A_2100000215282_ART_9","DAPA_A_2100000215282_ART_10","DAPA_A_2100000215282_ART_13","DAPA_A_2100000215282_ART_12"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_5","display_id":"방첩업무-규정-제5조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"개인의 임무와 책임","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_5_P1","display_id":"방첩업무-규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청직원은 외국을 방문하거나 외국인을 접촉할 때에는 외국등의 정보활동에 대응하기 위한 적절한 보호대책을 강구해야 하며 외국인 접촉절차를 반드시 준수하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_5_P2","display_id":"방첩업무-규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"이 예규의 적용을 받는 개인이 규정 제7조에 해당하는 사항을 발견하거나 관련 사항을 인지하였을 때에는 지체없이 분임방첩담당관에 신고하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000215282_ART_7"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_6","display_id":"방첩업무-규정-제6조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"외국인 접촉절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_6_P1","display_id":"방첩업무-규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 예규의 적용을 받는 개인이 다음 각 호의 외국인을 접촉 또는 외국인이 청에 출입하는 경우에는 별지 제1호서식에 의한 접촉 신청서를 작성하여 방첩담당관에 제출하여야 하며, 국제교류 행사 등 단체 접촉에 따라 신청자가 다수일 경우 대표자를 선정하여 접촉 신청서를 작성할 수 있다. 다만, 그 접촉 사실이 보고서 등 공식 문서로 존안하는 경우에는 그 문서로 접촉신청서를 갈음할 수 있다.","items":[{"id":"DAPA_A_2100000215282_ART_6_P1_I1","display_id":"방첩업무-규정-제6조-제1항-제1호","item_number":"1","content":"駐韓 외국대사관(국방무관부 포함) 직원","subitems":[]},{"id":"DAPA_A_2100000215282_ART_6_P1_I2","display_id":"방첩업무-규정-제6조-제1항-제2호","item_number":"2","content":"訪韓 외국공무원(외국군인 포함) 등 외국 정부기관(외국군 포함) 구성원","subitems":[]},{"id":"DAPA_A_2100000215282_ART_6_P1_I3","display_id":"방첩업무-규정-제6조-제1항-제3호","item_number":"3","content":"외국 언론사 직원","subitems":[]},{"id":"DAPA_A_2100000215282_ART_6_P1_I4","display_id":"방첩업무-규정-제6조-제1항-제4호","item_number":"4","content":"외국 연구기관 또는 사회단체 구성원","subitems":[]},{"id":"DAPA_A_2100000215282_ART_6_P1_I5","display_id":"방첩업무-규정-제6조-제1항-제5호","item_number":"5","content":"외국 방위산업체 임직원","subitems":[]},{"id":"DAPA_A_2100000215282_ART_6_P1_I6","display_id":"방첩업무-규정-제6조-제1항-제6호","item_number":"6","content":"국방ㆍ안보 관련 국제기구 구성원","subitems":[]},{"id":"DAPA_A_2100000215282_ART_6_P1_I7","display_id":"방첩업무-규정-제6조-제1항-제7호","item_number":"7","content":"기타 우리 군에 대한 정보활동이 의심되는 외국인","subitems":[]}]},{"id":"DAPA_A_2100000215282_ART_6_P2","display_id":"방첩업무-규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항 각 호의 외국인과 지속적으로 접촉해야 할 특별한 사유가 있는 경우에는 기간을 정하여 최초 1회만 신고할 수 있으며, 신고내용이 변동되었을 경우에는 이를 지체없이 신고한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_6_P3","display_id":"방첩업무-규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"사전에 외국인 접촉 사실을 보고하지 않은 상태에서 불가피하게 제1항 각 호의 외국인을 접촉한 경우에는 지체없이 별지 제2호서식에 의한 결과보고서를 방첩담당관에게 제출한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_6_P4","display_id":"방첩업무-규정-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"공ㆍ사적 국외여행 및 위탁교육(유학)ㆍ연수간 불가피하게 제1항 각 호의 외국인을 접촉한 경우에는 귀국 후 7일 이내 별지 제2호서식에 의한 결과보고서를 방첩담당관에게 제출한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_7","display_id":"방첩업무-규정-제7조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"외국인 접촉시 특이사항 등의 신고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_7_P1","display_id":"방첩업무-규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 예규의 적용을 받는 개인(기관에 소속된 위원회의 민간위원을 포함한다. 이하 이 조에서 같다)이 외국인(제8조에 따른 외국 정보기관이 정보활동에 이용하는 내국인을 포함한다. 이하 이 조에서 같다.)을 접촉하거나 통화ㆍ우편ㆍSNSㆍE-mail 등으로 통신한 경우 다음 각 호의 어느 하나에 해당된다고 의심할 만한 상당한 이유가 있을 경우에는 지체 없이 그 사실을 별지 제3호서식의 외국인 접촉시 특이사항 신고서를 작성하여 분임방첩담당관에게 신고하여야 하며 분임방첩담당관은 신고접수 후, 즉시 방첩담당관에게 보고하여야 한다.","items":[{"id":"DAPA_A_2100000215282_ART_7_P1_I1","display_id":"방첩업무-규정-제7조-제1항-제1호","item_number":"1","content":"접촉한 외국인이 국가기밀, 산업기술 또는 국가안보ㆍ국익 관련 중요 정책사항(이하 \"국가기밀등\"이라 한다)이나 그 밖의 국가안보 및 국익 관련 정보를 탐지ㆍ수집하려고 하는 경우","subitems":[]},{"id":"DAPA_A_2100000215282_ART_7_P1_I2","display_id":"방첩업무-규정-제7조-제1항-제2호","item_number":"2","content":"접촉한 외국인이 다음 각 목의 예시와 같이 자신이나 동료 등을 정보활동에 이용하려고 하는 경우가. 자신의 직무ㆍ사생활ㆍ친분인물 등에 대한 과도한 질문나. 같은 기관에 근무하는 공무원 등의 신상에 대한 지나친 관심다. 상대방이 밝힌 직업과 관련이 없는 민감한 분야에 대한 질문라. 지속적이거나 고가의 선물ㆍ식사 제공 또는 편의 제공마. 의도가 의심스럽거나 불법적인 활동에 대한 참여 권유","subitems":[]},{"id":"DAPA_A_2100000215282_ART_7_P1_I3","display_id":"방첩업무-규정-제7조-제1항-제3호","item_number":"3","content":"접촉한 외국인이 그 밖의 국가안보 또는 국익을 침해하는 활동을 하는 사람인경우","subitems":[]}]},{"id":"DAPA_A_2100000215282_ART_7_P2","display_id":"방첩업무-규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방첩담당관은 제1항의 신고내용을 확인하여 군방첩의 사항은 군사안보지원부대, 기타 방첩사항은 국가정보원에 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_7_P3","display_id":"방첩업무-규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"공ㆍ사적 국외여행 및 위탁교육(유학)ㆍ연수간 불가피하게 제1항의 사항을 신고하지 못한 경우 귀국 후 지체없이 즉시 별지 제3호서식 등에 의한 신고서를 작성하여 방첩담당관에게 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_7_P4","display_id":"방첩업무-규정-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"이 예규를 적용 받는 개인이 타인에 대한 제1항의 사실을 인지하였을 경우에는 분임방첩담당관에게 신고하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000215282_ART_8"],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000215282_ART_8","display_id":"방첩업무-규정-제8조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"외국 정보기관 구성원 접촉절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_8_P1","display_id":"방첩업무-규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 예규의 적용을 받는 개인이 법령에 따른 직무수행 외의 목적으로 외국 정보기관의 구성원을 접촉하려는 경우 별지 제4호서식에 의한 접촉신청서를 작성하여 소속 분임방첩담당관의 승인을 받은 문서를 방첩담당관에게 접촉 1일전까지 보고하고, 접촉 후 7일 이내에 별지 제5호서식에 의한 결과보고서를 작성하여 동일한 절차에 따라 보고하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_8_P2","display_id":"방첩업무-규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"공ㆍ사적 국외여행 및 위탁교육(유학)ㆍ연수간 불가피하게 제1항에 따른 외국 정보기관 구성원을 접촉한 경우에는 귀국 후 7일 이내 별지 제5호서식에 의한 결과보고서를 분임방첩담당관에게 제출하고, 분임방첩담당관은 즉시 방첩담당관에게 보고하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_8_P3","display_id":"방첩업무-규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"소속 직원으로부터 제1, 2항에 따른 보고를 받은 분임방첩담당관은 방첩담당관에게 지체없이 그 사실을 보고하며, 방첩담당관은 국가정보원 및 군사안보지원부대에 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_9","display_id":"방첩업무-규정-제9조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"외국 정보기관 방문 등 국제협력 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_9_P1","display_id":"방첩업무-규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"외국 정보기관과 합동 업무추진, 교육, 훈련 및 세미나 등을 추진하거나 외국 정보기관에게 기술ㆍ장비 등을 지원하려 할 때, 기관장이나 소속 직원이 외국정보기관을 방문하려고 할 때에는 별지 제7호서식에 의한 국제협력 계획을 작성하여 방첩담당관에게 보고하고, 방첩담당관은 최소 1개월 전까지 군방첩에 해당하는 사항은 군사안보지원부대, 그 밖의 사항은 국가정보원을 통해 방첩대책 등을 사전 협의하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_9_P2","display_id":"방첩업무-규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 명시된 정보협력 사항을 종료하였을 경우 별지 제8호서식에 의한 국제협력 결과를 작성하여 2주내에 방첩담당관에게 제출하고, 방첩담당관은 국가정보원 및 군사안보지원부대에 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_10","display_id":"방첩업무-규정-제10조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"해외 근무 시 방첩대책","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_10_P1","display_id":"방첩업무-규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"각 부서의 장은 해외 파견 근무자ㆍ공무국외출장자ㆍ장단기 연수자(이하 \"해외 근무 직원\"이라 한다)가 외국등의 정보활동에 효율적으로 대응하기 위하여 해외 근무 직원 출국 전에 다음 각 호의 방첩수칙을 포함하여 방첩교육을 실시한다.","items":[{"id":"DAPA_A_2100000215282_ART_10_P1_I1","display_id":"방첩업무-규정-제10조-제1항-제1호","item_number":"1","content":"출장용 노트북 등 전산통신기기 별도 구비ㆍ사용","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P1_I2","display_id":"방첩업무-규정-제10조-제1항-제2호","item_number":"2","content":"노트북 등 전산통신기기에 비밀번호 설정 등 보호조치","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P1_I3","display_id":"방첩업무-규정-제10조-제1항-제3호","item_number":"3","content":"공항 이용 시 민감 자료는 기내 휴대","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P1_I4","display_id":"방첩업무-규정-제10조-제1항-제4호","item_number":"4","content":"숙소에 중요 자료 방치 금지","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P1_I5","display_id":"방첩업무-규정-제10조-제1항-제5호","item_number":"5","content":"대중교통수단 등 공공장소에서 민감 내용 언급 자제","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P1_I6","display_id":"방첩업무-규정-제10조-제1항-제6호","item_number":"6","content":"숙소 비치 전화기ㆍFAX 등 사용 최소화","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P1_I7","display_id":"방첩업무-규정-제10조-제1항-제7호","item_number":"7","content":"호텔ㆍ공항ㆍ회의장 등 공공장소內 Wi-Fi(와이파이) 활용 자제","subitems":[]}]},{"id":"DAPA_A_2100000215282_ART_10_P2","display_id":"방첩업무-규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"해외 근무 직원은 현지 체류기간 동안 외국 정보기관 구성원(이하 \"외국 정보요원\"이라 한다)을 접촉하거나 외국인 접촉 시 다음 각 호의 특이사항이 발견될 경우 방첩담당관을 통해 지체없이 그 사실을 신고하여야 하며, 국내로 복귀 시 현지 체류기간 동안의 방첩상 위해요인에 대해 방첩담당관에게 보고하여야 한다.","items":[{"id":"DAPA_A_2100000215282_ART_10_P2_I1","display_id":"방첩업무-규정-제10조-제2항-제1호","item_number":"1","content":"접촉한 외국인이 외국 정보기관 구성원으로 추정되거나 외국 정보기관에 포섭된 것으로 의심되는 경우","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P2_I2","display_id":"방첩업무-규정-제10조-제2항-제2호","item_number":"2","content":"접촉한 외국인이 대한민국의 대외비ㆍ민감자료 또는 국가기밀 등 자료를 소지하고 있는 것을 목격하거나 인지한 경우","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P2_I3","display_id":"방첩업무-규정-제10조-제2항-제3호","item_number":"3","content":"접촉한 외국인이 대한민국의 산업기밀(방위산업기밀 포함)을 유출하거나 유출을 기도한 사실을 인지한 경우","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P2_I4","display_id":"방첩업무-규정-제10조-제2항-제4호","item_number":"4","content":"접촉한 외국인이 해당 기관의 공식 접촉창구 이외에 휴대전화 번호ㆍe-메일 주소 등 개별 연락처 제공을 요청하는 경우","subitems":[]},{"id":"DAPA_A_2100000215282_ART_10_P2_I5","display_id":"방첩업무-규정-제10조-제2항-제5호","item_number":"5","content":"외국 공관원ㆍ정보요원이 사적으로 접촉을 제의하거나 금품ㆍ향응, 특히 USB 등 정보통신기기를 선물로 제공하는 경우","subitems":[]}]},{"id":"DAPA_A_2100000215282_ART_10_P3","display_id":"방첩업무-규정-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방첩담당관은 해외 근무 직원로부터 제2항의 신고를 받거나 특이사항을 발견한 경우 7일 이내에 그 내용을 국가정보원 및 군사안보지원부대에 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_11","display_id":"방첩업무-규정-제11조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"외국인 접촉의 부당한 제한 금지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_11_P0","display_id":"방첩업무-규정-제11조","paragraph_number":"","paragraph_index":null,"content":"각 부서의 장은 이 예규의 목적이 외국등의 정보활동으로부터 대한민국의 국가안보와 국익을 보호하기 위한 것임을 고려하여 소속 직원의 외국인과의 접촉을 부당하게 제한하여서는 아니 된다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_12","display_id":"방첩업무-규정-제12조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"방첩교육","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_12_P1","display_id":"방첩업무-규정-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방첩담당관은 해당 기관의 업무수행과 관련하여 소속 직원들이 외국등의 정보활동에 효율적으로 대응하기 위하여 반기 1회 이상 방첩교육계획을 수립하여 시행하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_12_P2","display_id":"방첩업무-규정-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"각 부서의 장은 제10조제1항의 해외 근무 직원 및 사적 국외여행 예정인원에게 제10조에 따라 출국 전 별도의 교육을 실시하고, 결과는 해당 월의 사이버ㆍ보안진단의 날 행사 결과 보고시 첨부한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_12_P3","display_id":"방첩업무-규정-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방첩담당관은 필요한 경우 소속 직원에 대한 방첩교육을 전문기관(국가정보원, 군사안보지원부대)에 위탁하여 실시할 수 있다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000215282_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_13","display_id":"방첩업무-규정-제13조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"기타 통보 사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_13_P0","display_id":"방첩업무-규정-제13조","paragraph_number":"","paragraph_index":null,"content":"각 부서의 장은 다음 각 호에 명시된 사항을 방첩담당관에게 통보하여야 한다.","items":[{"id":"DAPA_A_2100000215282_ART_13_P0_I1","display_id":"방첩업무-규정-제13조-제1호","item_number":"1","content":"외국 軍부대ㆍ기관 방문 및 외국인 부대 초청 등 외국인과의 공식 교류사업(행사) 개최시 교류사업(행사) 종료 후 10일 이내 별지 제6호서식의 교류계획 및 결과를 작성하여 통보(다만, 교류계획 및 결과가 공식 문서로 존안하는 경우에는 그 문서로 갈음할 수 있다)","subitems":[]},{"id":"DAPA_A_2100000215282_ART_13_P0_I2","display_id":"방첩업무-규정-제13조-제2호","item_number":"2","content":"청 내에 1개월 이상 고정 출입 및 근무하고 있는 외국인에 대한 신원사항을 별지 제9호서식의 외국인 신원사항을 작성하여 고정 출입증발급일로부터 10일 이내에 통보한다.","subitems":[]},{"id":"DAPA_A_2100000215282_ART_13_P0_I3","display_id":"방첩업무-규정-제13조-제3호","item_number":"3","content":"해당년도 국제 교류행사(국외출장 및 국내초청 등) 일정, 공무 국외출장 및 해외 파병ㆍ파견ㆍ유학(국외 위탁교육)ㆍ연수 예정 인원 현황을 매년 1월 15일까지 통보하며, 방첩담당관은 1,2호에 대한 사항을 5일 이내, 3호에 대한 사항은 매년 1월 31일까지 군사안보지원부대에 통보한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_14","display_id":"방첩업무-규정-제14조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"방첩업무 전산시스템 운용","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_14_P0","display_id":"방첩업무-규정-제14조","paragraph_number":"","paragraph_index":null,"content":"방첩업무 효율성 제고를 위해 이 예규에 따른 각종 신고 및 통보사항 처리에 있어 방첩업무 전산시스템을 우선적으로 이용한다. 다만, 불가피한 사정으로 전산시스템 이용이 제한될 경우 공문서로 처리 할 수 있다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_15","display_id":"방첩업무-규정-제15조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"서류의 보존","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_15_P0","display_id":"방첩업무-규정-제15조","paragraph_number":"","paragraph_index":null,"content":"각 부서는 외국인 및 외국 정보기관 구성원 접촉 신청서ㆍ결과보고서, 외국인 접촉시 특이사항 신고서, 외국인 교류 계획ㆍ결과, 외국인 신원사항, 방첩교육 결과 등의 관련 서류는 1년간 보존한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_16","display_id":"방첩업무-규정-제16조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"조사 및 점검","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_16_P1","display_id":"방첩업무-규정-제16조-제1항","paragraph_number":"①","paragraph_index":1,"content":"각 부서의 장은 소속직원이 제7, 8조 위반 또는 군사상 기밀 국외 누설 정황을 인지하였을 경우 방첩담당관에게 보고하여야 하며, 방첩담당관은 해당내용의 조사를 군사안보지원부대에 의뢰하여야 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_16_P2","display_id":"방첩업무-규정-제16조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방첩담당관은 필요시 지원 군사안보지원부대와 협의하여방첩업무 수행실태 점검 및 지도방문을 실시할 수 있다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_17","display_id":"방첩업무-규정-제17조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"계도장 발부","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_17_P1","display_id":"방첩업무-규정-제17조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청 직원의 업무수행 과정에서 방첩규정 및 지시 불이행 등 제반 정황이 인정되는 경우 별지 제10호서식의 계도장을 발부하며, 이때 별표 1(방첩 관련 상ㆍ벌점 부여 지침에 의한 벌점을 부여하며 청 보안업무규정상의 보안벌점제도와 동일하게 처리한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_17_P2","display_id":"방첩업무-규정-제17조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계도장은 방첩담당관이 청장 명의로 발부하며, 현황을 유지 및 관리한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_17_P3","display_id":"방첩업무-규정-제17조-제3항","paragraph_number":"③","paragraph_index":3,"content":"누적된 방첩벌점은 발부일자로부터 2년간 유효하며 다음 각 호와 같이 가중 처벌한다.","items":[{"id":"DAPA_A_2100000215282_ART_17_P3_I1","display_id":"방첩업무-규정-제17조-제3항-제1호","item_number":"1","content":"계도장 3회 또는 벌점 20점 이상 시 경고(서면) 조치","subitems":[]},{"id":"DAPA_A_2100000215282_ART_17_P3_I2","display_id":"방첩업무-규정-제17조-제3항-제2호","item_number":"2","content":"서면 경고 2회 또는 벌점 40점 이상시 징계 건의","subitems":[]}]},{"id":"DAPA_A_2100000215282_ART_17_P4","display_id":"방첩업무-규정-제17조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방첩담당관은 현황을 종합하여 개인성과지표(BSC) 보안분야에 관련 사항을 포함한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_18","display_id":"방첩업무-규정-제18조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"포상 및 방첩 상ㆍ벌점","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_18_P1","display_id":"방첩업무-규정-제18조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방첩담당관은 소속직원 중 다음과 같은 방첩유공ㆍ과오가 있는 자에 대하여 별표 1(방첩 관련 상ㆍ벌점 부여 지침)에 따른 방첩 상ㆍ벌점을 부여 한다.","items":[]},{"id":"DAPA_A_2100000215282_ART_18_P2","display_id":"방첩업무-규정-제18조-제2항","paragraph_number":"②","paragraph_index":2,"content":"누적된 상ㆍ벌점은 2년간 유효하며, 방첩 상ㆍ벌점은 상쇄가 가능하다. 다만, 청 보안업무규정 제150조(보안계도장 발부) 제3항에 따라 이미 조치된 가중 처벌은 이후 부여된 보안(방첩)상점으로 취소되지 않는다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_ART_19","display_id":"방첩업무-규정-제19조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"재검토 기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_ART_19_P0","display_id":"방첩업무-규정-제19조","paragraph_number":"","paragraph_index":null,"content":"「훈령 ㆍ 예규 등의 발령 및 관리에 관한 규정」에 따라 이 예규 발령 후의 법령이나 현실여건의 변화 등을 검토하여 2023년 1월 1일을 기준으로 매3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 폐지 또는 개정한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000215282_SUPP1_ART_1","display_id":"방첩업무-규정-부칙1-제1조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_SUPP1_ART_1_P0","display_id":"방첩업무-규정-부칙1-제1조","paragraph_number":"","paragraph_index":null,"content":"이 시행지침은 발령한 날부터 시행한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제154호,2013. 8. 29.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_SUPP1_ART_2","display_id":"방첩업무-규정-부칙1-제2조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"재검토기한","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_SUPP1_ART_2_P0","display_id":"방첩업무-규정-부칙1-제2조","paragraph_number":"","paragraph_index":null,"content":"「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」(대통령훈령 제248호)에 따라 이 시행지침 발령 후의 법령이나 현실여건의 변화 등을 검토하여 폐지, 개정 등의 조치를 하여야 하는 기한은 2016년 8월 29일까지로 한다.","items":[]}],"notes":[],"effective_date":"2022-10-18","revision_date":"2022-10-18","source_file":"방첩업무 규정.json","source_path":"원문/법제처API/방첩업무 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제154호,2013. 8. 29.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000215282_SUPP2_ART_1","display_id":"방첩업무-규정-부칙2-제1조","regulation_id":"DAPA_A_2100000215282","regulation_name":"방첩업무 규정","short_name":"방첩업무 규정","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":2,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000215282_SUPP2_ART_1_P0","di