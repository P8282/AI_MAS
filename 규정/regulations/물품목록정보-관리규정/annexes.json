      ├────────────┼───────────┨\n┃                            │단위                    │                      ┃\n┃                            ├────────────┼───────────┨\n┃                            │모델명                  │                      ┃\n┃                            ├────────────┼───────────┨\n┃                            │상품브랜드명            │                      ┃\n┠───────────┬──┼────────────┼───────────┨\n┃부품여부              │    │본품모델명              │부품인 경우           ┃\n┠───────────┼──┼────────────┼───────────┨\n┃상품원산지국가명      │    │제조업체 카탈로그 유무  │외국산인 경우         ┃\n┠───────────┼──┼────────────┼───────────┨\n┃전통문화상품여부      │    │문화상품 직접생산확인서 │전통문화상품인 경우   ┃\n┠───────────┼──┼────────────┼───────────┨\n┃제조업체명            │    │제조업체사업자번호      │                      ┃\n┠───────────┼──┴────────────┴───────────┨\n┃제조업체 소재지명     │                                                      ┃\n┠───────────┼───────────────────────────┨\n┃품목명                │                                                      ┃\n┠───────────┼───────────────────────────┨\n┃제품설명              │                                                      ┃\n┠───────────┼───────────────────────────┨\n┃복합상품여부          │                                                      ┃\n┠───────────┼──┬────────────┬───────────┨\n┃주문자상표부착상품여부│    │상표권이 명시된 제조    │                      ┃\n┃                      │    │계약서 유무             │                      ┃\n┠───────────┼──┼────────────┼───────────┨\n┃기관주문제작품 여부   │    │주문제작요청기관명      │                      ┃\n┠───────────┼──┴────────────┴───────────┨\n┃범위형규격여부        │                                                      ┃\n┠───────────┼───────────────────────────┨\n┃공개여부              │                                                      ┃\n┠───────────┼──┬────────────┬───────────┨\n┃내용연수              │    │계약상품여부            │                      ┃\n┠───────────┼──┴────────────┴───────────┨\n┃자동발급유형          │                                                      ┃\n┠───────────┼───────────────────────────┨\n┃입력근거              │(요청번호, 구분, 근거내용, 요청기관, 연락처, 요청자명)┃\n┠───────────┼──┬────────────┬───────────┨\n┃등록자                │    │등록일시                │                      ┃\n┠───────────┼──┼────────────┼───────────┨\n┃변경자                │    │변경일시                │                      ┃\n┗━━━━━━━━━━━┷━━┷━━━━━━━━━━━━┷━━━━━━━━━━━┛\n\n\n  개별속성\n┏━━━━━━━━━━━┯━┯━━━━━━━━━━━━━┯━━━━━━━━━━━┓\n┃속성1                 │  │속성2                     │                      ┃\n┠───────────┼─┼─────────────┼───────────┨\n┃속성3                 │  │속성4                     │                      ┃\n┠───────────┼─┼─────────────┼───────────┨\n┃속성5                 │  │속성6                     │                      ┃\n┠───────────┼─┼─────────────┼───────────┨\n┃속성7                 │  │속성8                     │                      ┃\n┠───────────┼─┼─────────────┼───────────┨\n┃용도                  │  │옵션/기타                 │                      ┃\n┗━━━━━━━━━━━┷━┶━━━━━━━━━━━━━┷━━━━━━━━━━━┛\n\n\n  참조자료\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃HSK번호, 산업분류번호, KS표준번호, 바코드번호, 국가재고번호, 식약처분류번호, 고효율기자재인증번호┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛","content_blocks":[],"content_format":"text","related_articles":[],"related_regulations":[],"effective_date":"2026-01-01","revision_date":"2025-12-23","source_file":"goods-list-sites-preview.json","source_path":"규정검색rev/물품목록정보_20261015/unpacked/sites-source/goods-list-sites-preview.json","pdf_path":"","source_page":"","keywords":[],"source":"api","source_url":"https://www.law.go.kr/admRulInfoP.do?admRulSeq=2100000270306"}]
