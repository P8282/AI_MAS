[{"id":"DAPA_A_2100000214045_ART_1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제1조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_1_P0","display_id":"군용총포도검화약류-운반허가에-관한-고시-제1조","paragraph_number":"","paragraph_index":null,"content":"이 고시는 「방위사업법 시행규칙」제42조의2에 따라 군용총포ㆍ도검ㆍ화약류의 운반허가 기간, 방법 및 절차 등에 관하여 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_RULE_ART_42_2"],"related_regulations":["DEFENSE_ACQ_RULE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214045_ART_2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"운반허가 신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_2_P1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"군용총포ㆍ도검ㆍ화약류(이하 \"군용총포등\"이라 한다.)를 운반하려는 자는 운반예정일 15근무일 전까지 다음 각 호의 서류를 첨부하여 방산수출입지원시스템(D4B)으로 신청하여야 한다. 다만, 방산수출입지원시스템(D4B)이 정상적으로 운영되지 않는 경우 공문 등 다른 방법으로 신청할 수 있다.","items":[{"id":"DAPA_A_2100000214045_ART_2_P1_I1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제1항-제1호","item_number":"1","content":"「방위사업법 시행규칙」별지 제14호의9 서식 군용총포ㆍ도검ㆍ화약류 운반 허가 신청서","subitems":[]},{"id":"DAPA_A_2100000214045_ART_2_P1_I2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제1항-제2호","item_number":"2","content":"별지 제1호 서식 군용총포ㆍ도검ㆍ화약류 안전 운반/관리 계획서","subitems":[]},{"id":"DAPA_A_2100000214045_ART_2_P1_I3","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제1항-제3호","item_number":"3","content":"군용총포등의 운반목적을 증명하는 서류","subitems":[]}]},{"id":"DAPA_A_2100000214045_ART_2_P2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 운반허가를 신청하지 못한 자가 다음 각 호의 사유로 긴급하게 운반이 필요한 경우 운반예정일 5근무일 전까지 운반허가를 신청해야 한다.","items":[{"id":"DAPA_A_2100000214045_ART_2_P2_I1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제2항-제1호","item_number":"1","content":"계약변경, 소요군ㆍ사업부서 요구, 개발ㆍ시험소요 발생 등","subitems":[]},{"id":"DAPA_A_2100000214045_ART_2_P2_I2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제2항-제2호","item_number":"2","content":"국가재난, 천재지변 등 불가항력적인 사항이 발생한 경우","subitems":[]}]},{"id":"DAPA_A_2100000214045_ART_2_P3","display_id":"군용총포도검화약류-운반허가에-관한-고시-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"「군수품관리법」에 의해 관리되는 군용총포등(이하 \"군수품(군용총포등)\"이라 한다.)을 운반하려는 자는 제1항 및 제2항에 따라 운반허가를 신청하되, 해당 군수품(군용총포등)을 소유한 부대의 장(물품관리관)이 작성한 별지 제4호 서식의 군수품(군용총포등) 운반 의뢰서를 첨부하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["불가항력"]},{"id":"DAPA_A_2100000214045_ART_3","display_id":"군용총포도검화약류-운반허가에-관한-고시-제3조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"운반 허가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_3_P1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 제2조제1항에 따라 허가 신청을 받은 후 10근무일 이내에 운반허가 여부를 결정ㆍ통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000214045_ART_3_P2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"「군용총포ㆍ도검ㆍ화약류 허가ㆍ감독 지침」제9조제1항 및 제3항에 해당하는 경우 운반허가 없이 운반할 수 있다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000214045_ART_2"],"related_regulations":[],"external_references":["군용총포ㆍ도검ㆍ화약류 허가ㆍ감독 지침"],"keywords":[]},{"id":"DAPA_A_2100000214045_ART_4","display_id":"군용총포도검화약류-운반허가에-관한-고시-제4조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"운반 신고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_4_P0","display_id":"군용총포도검화약류-운반허가에-관한-고시-제4조","paragraph_number":"","paragraph_index":null,"content":"제3조에 따라 허가를 받은 자는 별지 제2호 서식의 군용총포ㆍ도검ㆍ화약류 운반 신고서를 작성하여 국방기술품질원장(이하 \"기품원장\"이라 한다.) 또는 국방기술진흥연구소장(이하 \"국기연소장\"이라 한다.)에게 운반예정일 2근무일 전까지 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000214045_ART_3"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214045_ART_5","display_id":"군용총포도검화약류-운반허가에-관한-고시-제5조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"운반신고필증 발급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_5_P1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"기품원장 및 국기연소장은 방위사업청의 운반허가서와 신고서와의 일치여부(품명, 수량, 운반구간, 운반기간) 등을 확인하고 별지 제3호 서식의 군용총포ㆍ도검ㆍ화약류 운반신고필증을 발급한다.","items":[]},{"id":"DAPA_A_2100000214045_ART_5_P2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"기품원장 및 국기연소장은 운반일시 및 운반경로의 적절성 등을 검토하여 안전에 부적합하다고 판단되는 경우 운반신고필증을 발급하지 아니할 수 있다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214045_ART_6","display_id":"군용총포도검화약류-운반허가에-관한-고시-제6조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"운반호송관 임명","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_6_P1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"운반호송관 임명 등에 관한 사항은「방위산업보안업무훈령」(국방부 훈령) 제129조 규정을 따르며, 운반호송관은 운전자와 별도로 임명한다.","items":[]},{"id":"DAPA_A_2100000214045_ART_6_P2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"운반차량 대수별 호송관 인원 편성기준은 아래와 같다.<img id=\"119039747\"></img>","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214045_ART_7","display_id":"군용총포도검화약류-운반허가에-관한-고시-제7조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"운반 보안","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_7_P0","display_id":"군용총포도검화약류-운반허가에-관한-고시-제7조","paragraph_number":"","paragraph_index":null,"content":"군용총포등을 운반할 경우 수송업체의 이용, 운반 및 보안책임, 운반 보안준칙 등은「방위산업보안업무훈령」제130조부터 제132조까지의 규정을 준용한다. 단, 일과시간이 경과되어 운반할 경우 군용총포등을 군부대 및 인수업체에 인도 시까지 인수ㆍ인근부대 또는 인수업체에서 경계 및 보안지원을 제공한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":["방위산업보안업무훈령"],"keywords":[]},{"id":"DAPA_A_2100000214045_ART_8","display_id":"군용총포도검화약류-운반허가에-관한-고시-제8조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"운반책임자 임명","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_8_P1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"군용총포등을 운반하고자 하는 업체 대표는 운전자와 별도로 신원조사를 받은 자를 운반책임자로 임명하여야 한다. 단, 군용화약류 운반책임자는 군용화약류 제조보안책임자 또는 관리보안책임자로 선임된 자 중에서 임명하여야 한다.","items":[]},{"id":"DAPA_A_2100000214045_ART_8_P2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"운반책임자는 다음 각 호를 포함한 업무를 수행한다.","items":[{"id":"DAPA_A_2100000214045_ART_8_P2_I1","display_id":"군용총포도검화약류-운반허가에-관한-고시-제8조-제2항-제1호","item_number":"1","content":"운반책임자는 군용총포 등 운반차량이 출발하기 전 차량 및 적재상황 등을 점검ㆍ확인하여야 한다.","subitems":[]},{"id":"DAPA_A_2100000214045_ART_8_P2_I2","display_id":"군용총포도검화약류-운반허가에-관한-고시-제8조-제2항-제2호","item_number":"2","content":"운반책임자는 운전기술이 능숙한 사람으로 하여금 차량을 운전하게 하여야 한다.","subitems":[]}]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214045_ART_9","display_id":"군용총포도검화약류-운반허가에-관한-고시-제9조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_ART_9_P0","display_id":"군용총포도검화약류-운반허가에-관한-고시-제9조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2022년 1월 1일 기준으로 매3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 폐지 또는 개정한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214045_SUPP1_ART_1","display_id":"군용총포도검화약류-운반허가에-관한-고시-부칙1-제1조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000214045_SUPP1_ART_1_P0","display_id":"군용총포도검화약류-운반허가에-관한-고시-부칙1-제1조","paragraph_number":"","paragraph_index":null,"content":"이 고시는 발령한 날로부터 시행한다.","items":[]}],"notes":[],"effective_date":"2022-08-22","revision_date":"2022-08-22","source_file":"군용총포·도검·화약류 운반허가에 관한 고시.json","source_path":"원문/법제처API/군용총포·도검·화약류 운반허가에 관한 고시.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제2021-12호, 2021. 12. 10.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000214045_SUPP1_ART_2","display_id":"군용총포도검화약류-운반허가에-관한-고시-부칙1-제2조","regulation_id":"DAPA_A_2100000214045","regulation_name":"군용총포·도검·화약류 운반허가에 관한 고시","short_name":"군용총포·도검·화약류 운반허가에 관한 고시","document_type":"고시","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"경과규정","is_deleted":false,"is_supplementary