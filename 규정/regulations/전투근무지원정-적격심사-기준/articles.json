[{"id":"DAPA_A_2100000285306_ART_1","display_id":"전투근무지원정-적격심사-기준-제1조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_1_P0","display_id":"전투근무지원정-적격심사-기준-제1조","paragraph_number":"","paragraph_index":null,"content":"이 기준은 「국가를 당사자로 하는 계약에 관한 법률 시행령」 제42조제5항 단서에 의거 방위사업청에서 집행하는 전투근무지원정 건조(제조)입찰의 낙찰자 결정에 적용할 적격심사기준을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_42"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["낙찰자"]},{"id":"DAPA_A_2100000285306_ART_2","display_id":"전투근무지원정-적격심사-기준-제2조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_2_P0","display_id":"전투근무지원정-적격심사-기준-제2조","paragraph_number":"","paragraph_index":null,"content":"전투근무지원정 적격심사기준(이하\"기준\"이라 한다)에서 전투근무지원정은 「국방전력발전업무훈령」의 함정무기체계 분류상에 기재된 함정의 종류 중 전투근무지원정을 의미한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000285306_ART_3","display_id":"전투근무지원정-적격심사-기준-제3조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"적용기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_3_P1","display_id":"전투근무지원정-적격심사-기준-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"심사기준일은 입찰참가 등록마감일 전일로 한다. 다만, 당해 계약 수행능력의 결격여부 사항에 대하여는 적격심사낙찰자 통보일 현재로 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_3_P2","display_id":"전투근무지원정-적격심사-기준-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심사서류의 외화표시금액은 입찰참가 등록마감일 전일의 「외국환거래법」에 의한 기준환율 또는 재정환율(매매기준율)을 적용하여 원화로 환산한다. 다만, 외화와 원화가 동시 표시된 경우에는 원화를 적용한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_3_P3","display_id":"전투근무지원정-적격심사-기준-제3조-제3항","paragraph_number":"③","paragraph_index":3,"content":"비율, 평점(입찰가격 포함) 등을 계산한 결과 소수점 이하의 숫자가 있는 경우에는 별도로 정한 경우를 제외하고는 소수점 다섯째 자리에서 반올림한 결과를 그 비율ㆍ평점으로 본다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["배점한도","입찰참가자격"]},{"id":"DAPA_A_2100000285306_ART_4","display_id":"전투근무지원정-적격심사-기준-제4조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"심사항목 및 배점한도","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_4_P1","display_id":"전투근무지원정-적격심사-기준-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사의 심사분야별 배점한도 및 심사항목은 <별표 1>에서 정한 바에 의한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_4_P2","display_id":"전투근무지원정-적격심사-기준-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"발주관서의 장 또는 계약담당공무원은 계약의 특성ㆍ목적 및 내용 등을 종합 고려하여 심사분야별 배점한도(입찰가격은 제외)를 20% 범위 내에서 가ㆍ감 조정할 수 있으며, 심사항목별(신인도 제외) 세부사항을 추가하거나 제외할 수 있다. 이때에는 입찰공고 또는 입찰 설명서에 조정내용을 명시하여 입찰참가자가 열람 또는 교부 등을 통해 그 내용을 알 수 있도록 조치하여야 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_4_P3","display_id":"전투근무지원정-적격심사-기준-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"신인도 평가는 적격심사대상자의 당해함정건조이행능력의 취득점수가 심사분야별 배점한도에 부족한 경우에만 배점한도 범위 내에서 가산점을 부여하며, 신인도 총평점이 음인 경우에는 적격심사대상자가 신인도 평가 이외에서 취득한 총점에서 감점한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["배점한도","신인도","적격심사","계약담당공무원"]},{"id":"DAPA_A_2100000285306_ART_5","display_id":"전투근무지원정-적격심사-기준-제5조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"평가방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_5_P1","display_id":"전투근무지원정-적격심사-기준-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 예정가격 이하로서 최저가로 입찰한 자 순으로 심사한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_5_P2","display_id":"전투근무지원정-적격심사-기준-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"이행실적 평가 시 합병의 경우 존속되거나 신설된 업체의 실적은 소멸된 자의 실적을 승계한 것으로 합산하여 평가하며, 분할 및 사업양수도의 경우에는 권한ㆍ의무ㆍ시설, 기술자 등을 포함하여 해당업종을 승계 받는 업체에 대해서만 이행실적을 평가한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_5_P3","display_id":"전투근무지원정-적격심사-기준-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"피 평가업체는 제1항의 평가를 위해서는 합병ㆍ분할 및 사업양수도와 관련한 실적증빙서류를 제출하여야 한다. 다만, 방산업체간 사업양수도시 시설 및 기술자 등 기존 함정건조에 필요한 요건이 승계되어 이를 갖춘 경우에는 예외로 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_5_P4","display_id":"전투근무지원정-적격심사-기준-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"기술인력의 기술수준 평가시 해당 기술인력은 입찰공고에서 제시한 분야별 소요인원으로 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_5_P5","display_id":"전투근무지원정-적격심사-기준-제5조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"신인도의 각 심사항목별 평점은 당해 배점한도를 초과할 수 없으며, 신인도 종합평점은 각 항목의 가점합계와 감점합계를 상계한 점수로 하되, 총 배점한도를 초과할 수 없다.","items":[]},{"id":"DAPA_A_2100000285306_ART_5_P6","display_id":"전투근무지원정-적격심사-기준-제5조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"신인도 평가 중 계약이행성실도의 최근 5년내 함정사업 납품지연 심사항목은 해당 계약에서 지체상금 면제원이 제출된 경우 별표 1에서 정한 바에 따라 평가한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["신인도","배점한도","예정가격","계약담당공무원"]},{"id":"DAPA_A_2100000285306_ART_6","display_id":"전투근무지원정-적격심사-기준-제6조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"공동수급체 등에 대한 평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_6_P1","display_id":"전투근무지원정-적격심사-기준-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"공동수급체로 참여하는 경우에는 구성원별 출자비율 또는 분담비율을 입찰 등록 시까지 확정ㆍ제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_6_P2","display_id":"전투근무지원정-적격심사-기준-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"심사대상자가 공동수급체인 경우에는 구성원별 평가결과에 각자의 출자비율 또는 분담비율을 반영하여 평가한다. 단, 이행실적은 구성원별 분담액 기준으로 개별 평가한 후 각자의 분담비율을 반영하여 적용한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동계약","공동수급체"]},{"id":"DAPA_A_2100000285306_ART_7","display_id":"전투근무지원정-적격심사-기준-제7조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"결격사유의 심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_7_P0","display_id":"전투근무지원정-적격심사-기준-제7조","paragraph_number":"","paragraph_index":null,"content":"심사대상자가 부도ㆍ파산 상태인 경우에는 결격사유로 평가하며, 부도ㆍ파산의 우려가 있어 계약이행이 어렵다고 판단되는 경우에는 적격심사위원회에서 결격여부를 결정한다. 이때 심사대상자에게 자료의 제출을 요구하거나 관계자 또는 전문가의 의견을 청취 또는 자문을 받을 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000285306_ART_8","display_id":"전투근무지원정-적격심사-기준-제8조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"제출서류","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_8_P1","display_id":"전투근무지원정-적격심사-기준-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사 대상자로 통보받은 입찰자는 통보서를 접수한 날로부터 7일 이내에 다음 각 호의 서류를 첨부한 적격심사 신청서(별지 제1호 서식)를 제출하여야 한다.","items":[{"id":"DAPA_A_2100000285306_ART_8_P1_I1","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제1호","item_number":"1","content":"적격심사 자기평가 및 심사표(별지 제2호 서식)","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I2","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제2호","item_number":"2","content":"함정 및 상선건조 실적증명서","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I3","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제3호","item_number":"3","content":"당해함정 기본설계 실적증명서(필요시)","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I4","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제4호","item_number":"4","content":"기술능력 평가 시 설계기술 인력, 현장기술 인력 및 기능 인력의 인적사항, 경력증명서, 기술등급 평가 시 기술평가등급확인서(공공기관제출용)","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I5","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제5호","item_number":"5","content":"경영상태 평가를 위한 신용평가등급 관련 평가자료(공공기관제출용)","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I6","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제6호","item_number":"6","content":"공인회계사의 감사보고서를 첨부한 최근 결산연도 재무제표 또는 세무대리인의 확인을 받아 세무서에 제출한 최근 결산연도의 재무제표","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I7","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제7호","item_number":"7","content":"체계통합역량관리계획, 공정관리계획, 자재관리계획 및 품질관리계획서","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I8","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제8호","item_number":"8","content":"입찰참가등록 마감일 전일부터 과거 5년 이내에 함정사업 계약에서 지체상금을 부과받은 사실이 있는 자로서 위 지체상금에 대한 면제원이 해당 계약에서 제출된 경우(입찰참가등록 마감일 전일 이후부터 위 7일 이내에 제출된 경우도 포함), 지체상금 면제원 제출 현황(계약번호, 계약건명, 납품일자 및 지체상금면제원 제출일자) 및 위 지체상금 면제원이 결정된 경우 지체상금 면제원 결정 현황(결정일, 결정금액)","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I9","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제9호","item_number":"9","content":"제8호의 지체상금 면제원이 취소 요청된 경우 취소 요청 서류","subitems":[]},{"id":"DAPA_A_2100000285306_ART_8_P1_I10","display_id":"전투근무지원정-적격심사-기준-제8조-제1항-제10호","item_number":"10","content":"기타 입찰공고에 제출토록 명시된 서류","subitems":[]}]},{"id":"DAPA_A_2100000285306_ART_8_P2","display_id":"전투근무지원정-적격심사-기준-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 제출된 서류상 첨부목록에 기재되어 있는 서류가 빠졌거나 제출된 서류가 불명확하여 인지할 수 없는 경우에 발주관서의 장 또는 계약담당공무원은 기한을 정하여 보완을 요구하여야 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_8_P3","display_id":"전투근무지원정-적격심사-기준-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항에 의해 정해진 기한까지 제출서류를 보완하지 아니한 때에는 기 제출한 서류만으로 심사하되, 기 제출된 서류가 불명확하여 심사하기가 곤란한 경우에는 해당 심사항목에서 제외한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_8_P4","display_id":"전투근무지원정-적격심사-기준-제8조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제1항 및 제2항에 따라 제출한 서류와 평가에 필요한 재무제표 등 각종 증빙서류는 입찰공고일 이후에 발생 또는 신고하였거나 수정된 자료의 제출은 인정하지 않는다. 다만 제1항에 의한 기한(제2항이 적용되는 경우에는 제2항에 의한 기한)까지 지체상금 면제원이 제출된 경우에는 위 면제원 서류를 평가에 포함하여 별표 1에서 정한 바에 따라 평가한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["지체상금","경영상태","적격심사","신용평가","기술능력평가","입찰참가자격"]},{"id":"DAPA_A_2100000285306_ART_9","display_id":"전투근무지원정-적격심사-기준-제9조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"적격심사생략","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_9_P0","display_id":"전투근무지원정-적격심사-기준-제9조","paragraph_number":"","paragraph_index":null,"content":"저가입찰로 당해함정건조이행능력 및 신인도의 배점한도 최고점을 적용하여도 88점이 미달될 때에는 적격심사를 생략하고 부적격 처리할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["적격심사"]},{"id":"DAPA_A_2100000285306_ART_10","display_id":"전투근무지원정-적격심사-기준-제10조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"낙찰자 결정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_10_P1","display_id":"전투근무지원정-적격심사-기준-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"예정가격 이하로써 최저가로 입찰한 자 순으로 심사하여 종합평점이 88점 이상인 자를 낙찰자로 결정하여야 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_10_P2","display_id":"전투근무지원정-적격심사-기준-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"동일가격으로 입찰한 최저가 입찰자가 2인 이상일 때에는 심사결과 종합평점이 88점 이상인자로서 가장 높은 점수를 얻은 자를 낙찰자로 결정하여야 한다. 다만, 이외의 경우에는 추첨에 의해 낙찰자를 결정한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_10_P3","display_id":"전투근무지원정-적격심사-기준-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"최저가 입찰자에 대한 심사결과 종합평점이 88점 미만인 경우에는 차순위 최저가 입찰자 순으로 심사하여 낙찰자를 결정한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_10_P4","display_id":"전투근무지원정-적격심사-기준-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"적격심사에 소요되는 행정소요기간을 감안하여 필요하다고 인정되는 경우에는 예정가격 이내 입찰자를 대상으로 동시에 적격심사서류를 제출받을 수 있다.","items":[]},{"id":"DAPA_A_2100000285306_ART_10_P5","display_id":"전투근무지원정-적격심사-기준-제10조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"예정가격을 작성할 수 없는 경우에는 입찰가격을 제외한 나머지 심사항목을 심사하며, 심사결과 종합평점이 당해 심사항목 배점한도의 100분의 88이상인 자를 낙찰자로 결정하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["낙찰자","예정가격","최저가낙찰","적격심사"]},{"id":"DAPA_A_2100000285306_ART_11","display_id":"전투근무지원정-적격심사-기준-제11조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"재심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_11_P1","display_id":"전투근무지원정-적격심사-기준-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제10조에 따라 최저가 입찰자 임에도 부적격통보를 받은 자가 통보일로부터 3일 이내에 심사결과에 불복하여 재심사를 요청하였을 때에는 특별한 사유가 없는 한 재심사요청서 접수일로부터 3일 이내에 재심사를 하여야 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_11_P2","display_id":"전투근무지원정-적격심사-기준-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 의한 재심사결과는 해당자에게 지체 없이 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_11_P3","display_id":"전투근무지원정-적격심사-기준-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항의 재심사요청서를 접수할 때에는 적격심사에 필요한 추가서류는 접수할 수 없다.","items":[]},{"id":"DAPA_A_2100000285306_ART_11_P4","display_id":"전투근무지원정-적격심사-기준-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"재심사의 적격심사위원회 구성은 최초 적격심사위원회 위원과 중복되지 않는 5인 이상의 담당관으로 구성하며, 위원장은 팀장급으로 편성한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000285306_ART_10"],"related_regulations":[],"external_references":[],"keywords":["적격심사"]},{"id":"DAPA_A_2100000285306_ART_12","display_id":"전투근무지원정-적격심사-기준-제12조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"적격심사위원회 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_12_P1","display_id":"전투근무지원정-적격심사-기준-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"발주관서의 장 또는 계약담당공무원은 가능한 공정하고 합리적인 심사를 위해 각 입찰대상별로 적격심사위원회를 구성하여 심사할 수 있다.","items":[]},{"id":"DAPA_A_2100000285306_ART_12_P2","display_id":"전투근무지원정-적격심사-기준-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"이 경우 심사위원은 관계부서의 5인 이상으로 구성한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["적격심사","계약담당공무원"]},{"id":"DAPA_A_2100000285306_ART_13","display_id":"전투근무지원정-적격심사-기준-제13조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"평가결과 설명 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_13_P1","display_id":"전투근무지원정-적격심사-기준-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"입찰에 참여한 업체는 본인의 적격심사결과에 대해 설명을 원하는 경우 심사결과를 통보받은 날로부터 3근무일 이내에 서면(형식 불문)으로 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000285306_ART_13_P2","display_id":"전투근무지원정-적격심사-기준-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"해당 계약팀장은 설명 요청서가 접수된 날로부터 5근무일 이내에 [별지 제3호]를 참고하여 설명을 실시한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_13_P3","display_id":"전투근무지원정-적격심사-기준-제13조-제3항","paragraph_number":"③","paragraph_index":3,"content":"적격심사결과에 이의가 있는 업체는 설명일로부터 3근무일 이내에 이의신청을 할 수 있으며, 해당 계약팀장은 신청일로부터 7근무일 이내 처리하고 그 결과를 통보하여야 한다.","items":[]},{"id":"DAPA_A_2100000285306_ART_13_P4","display_id":"전투근무지원정-적격심사-기준-제13조-제4항","paragraph_number":"④","paragraph_index":4,"content":"해당 계약팀장은 제3항의 처리기한 내 처리가 불가능할 경우 그 사유와 새로운 처리기한을 정하여 이의 신청자에게 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["이의신청","적격심사"]},{"id":"DAPA_A_2100000285306_ART_14","display_id":"전투근무지원정-적격심사-기준-제14조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"부정한 방법으로 심사서류를 제출한 자의 처리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_14_P1","display_id":"전투근무지원정-적격심사-기준-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"적격심사대상자가 이 규정에 따라 제출한 서류 중 부정 또는 허위로 작성된 서류가 포함된 것으로 판명된 때에는 다음 각 호와 같이 처리하여야 한다.","items":[{"id":"DAPA_A_2100000285306_ART_14_P1_I1","display_id":"전투근무지원정-적격심사-기준-제14조-제1항-제1호","item_number":"1","content":"계약체결 이전인 경우에는 적격낙찰자 결정대상에서 제외 또는 결정통보를 취소한다.","subitems":[]},{"id":"DAPA_A_2100000285306_ART_14_P1_I2","display_id":"전투근무지원정-적격심사-기준-제14조-제1항-제2호","item_number":"2","content":"계약체결 이후인 경우에는 당해 계약을 해제 또는 해지할 수 있다.","subitems":[]}]},{"id":"DAPA_A_2100000285306_ART_14_P2","display_id":"전투근무지원정-적격심사-기준-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항에 해당하는 자에 대하여는 재정경제부 (계약예규) 적격심사기준 제10조에 의거 조치하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["QUALIFICATION_REVIEW_RULE_ART_10"],"related_regulations":["QUALIFICATION_REVIEW_RULE"],"external_references":[],"keywords":["적격심사","계약서 작성","계약담당공무원"]},{"id":"DAPA_A_2100000285306_ART_15","display_id":"전투근무지원정-적격심사-기준-제15조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"기타사항","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_15_P0","display_id":"전투근무지원정-적격심사-기준-제15조","paragraph_number":"","paragraph_index":null,"content":"이 기준에 정하지 아니한 사항에 대하여는 재정경제부 (계약예규) 적격심사기준에 의하고, 계약목적물에 따라 이 기준을 적용하기 곤란하다고 인정되는 사항에 대하여는 입찰공고 또는 입찰설명서 등에 반영하여 시행할 수 있다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000285306_ART_16","display_id":"전투근무지원정-적격심사-기준-제16조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_ART_16_P0","display_id":"전투근무지원정-적격심사-기준-제16조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 예규에 대하여「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 2026년 1월 1일 기준으로 매 3년이 되는 시점(매 3년째의 12월 31일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약예규"]},{"id":"DAPA_A_2100000285306_SUPP1_ART_1","display_id":"전투근무지원정-적격심사-기준-부칙1-제1조","regulation_id":"DAPA_A_2100000285306","regulation_name":"전투근무지원정 적격심사 기준","short_name":"전투근무지원정 적격심사 기준","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000285306_SUPP1_ART_1_P0","display_id":"전투근무지원정-적격심사-기준-부칙1-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 2014년 2월 3일 입찰공고 분부터 적용하며, 이 지침 적용시점 이전까지는 방위사업청 예규 제138호 「수상함 및 전투근무지원정 적격심사기준」을 적용한다.","items":[]}],"notes":[],"effective_date":"2026-09-21","revision_date":"2026-09-21","source_file":"전투근무지원정 적격심사 기준.json","source_path":"원문/법제처API/전투근무지원정 적격심사 기준.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"",