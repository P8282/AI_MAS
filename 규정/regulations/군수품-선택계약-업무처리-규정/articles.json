[{"id":"DAPA_A_2100000182498_ART_1","display_id":"군수품-선택계약-업무처리-규정-제1조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_1_P0","display_id":"군수품-선택계약-업무처리-규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「방위사업법 시행령」제61조의2에서 위임한 군수품 선택계약 업무처리에 관한 기준 및 절차 등에 필요한 사항을 정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DEFENSE_ACQ_ENFORCEMENT_ART_61_2"],"related_regulations":["DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000182498_ART_2","display_id":"군수품-선택계약-업무처리-규정-제2조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_2_P0","display_id":"군수품-선택계약-업무처리-규정-제2조","paragraph_number":"","paragraph_index":null,"content":"이 규정에서 사용하는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000182498_ART_2_P0_I1","display_id":"군수품-선택계약-업무처리-규정-제2조-제1호","item_number":"1","content":"\"수요기관\"이란 방위사업청에 군수품 조달소요를 제기하는 육군, 해군, 공군, 국방부 및 그 직할부대·직할기관을 말한다.","subitems":[]},{"id":"DAPA_A_2100000182498_ART_2_P0_I2","display_id":"군수품-선택계약-업무처리-규정-제2조-제2호","item_number":"2","content":"\"군수품 선택계약\"이란 전력지원체계를 조달함에 있어 수요기관이 선호하는 물품을 직접 선택할 수 있도록 필요한 경우 품질·성능 등이 같거나 비슷한 물품을 공급하는 2인 이상의 다수자를 계약상대자로 하여 체결하는 단가계약을 말한다.","subitems":[]},{"id":"DAPA_A_2100000182498_ART_2_P0_I3","display_id":"군수품-선택계약-업무처리-규정-제2조-제3호","item_number":"3","content":"\"계약담당공무원\"이란 계약관으로부터 계약사무의 일부를 위임 받은 자를 말한다.","subitems":[]},{"id":"DAPA_A_2100000182498_ART_2_P0_I4","display_id":"군수품-선택계약-업무처리-규정-제2조-제4호","item_number":"4","content":"\"계약상대자\"란 제7조에서 정한 기준에 따라 심사하여 군수품 선택계약 낙찰자로 결정된 다수의 계약업체를 말한다.","subitems":[]},{"id":"DAPA_A_2100000182498_ART_2_P0_I5","display_id":"군수품-선택계약-업무처리-규정-제2조-제5호","item_number":"5","content":"\"계약이행실적평가 및 등급화\"란 방위사업청장이 군수품 선택계약을 이행한 계약상대자를 대상으로 계약물품별로 납기, 품질, 수요기관 만족도 등의 계약이행실적을 평가하여 등급화하는 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000182498_ART_2_P0_I6","display_id":"군수품-선택계약-업무처리-규정-제2조-제6호","item_number":"6","content":"\"예정가격\"이란 입찰 또는 계약체결 전에 낙찰자 및 계약금액의 결정기준으로 삼기 위하여 미리 작성·비치하여 두는 가액을 말한다.","subitems":[]},{"id":"DAPA_A_2100000182498_ART_2_P0_I7","display_id":"군수품-선택계약-업무처리-규정-제2조-제7호","item_number":"7","content":"\"업체 생산능력 확인\"이란 물품의 품질유지 혹은 안정적 조달확보가 요구되는 품목에 대하여 사전에 업체 생산능력 확인기준서를 작성하여 국방기술품질원에 생산능력 확인을 요청한 후 그 결과를 낙찰자 결정을 위한 적격심사, 제한경쟁에 적용하는 것을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000182498_ART_7"],"related_regulations":[],"external_references":[],"keywords":["낙찰자","수요기관","물품","예정가격","계약상대자","계약의 이행"]},{"id":"DAPA_A_2100000182498_ART_3","display_id":"군수품-선택계약-업무처리-규정-제3조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제2장 대상수요물자 및 참가자격 등","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"대상수요물자","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_3_P0","display_id":"군수품-선택계약-업무처리-규정-제3조","paragraph_number":"","paragraph_index":null,"content":"군수품 선택계약은 규격(모델)이 확정되어 있거나 수요기관의 구매요구서가 제시되는 물품 중 다음 각 호에 해당하는 물품을 그 대상으로 한다.","items":[{"id":"DAPA_A_2100000182498_ART_3_P0_I1","display_id":"군수품-선택계약-업무처리-규정-제3조-제1호","item_number":"1","content":"경쟁입찰이 가능한 물품","subitems":[]},{"id":"DAPA_A_2100000182498_ART_3_P0_I2","display_id":"군수품-선택계약-업무처리-규정-제3조-제2호","item_number":"2","content":"단가계약이 가능한 물품","subitems":[]},{"id":"DAPA_A_2100000182498_ART_3_P0_I3","display_id":"군수품-선택계약-업무처리-규정-제3조-제3호","item_number":"3","content":"선호도에 따라 수요기관에서 선택이 가능한 물품","subitems":[]},{"id":"DAPA_A_2100000182498_ART_3_P0_I4","display_id":"군수품-선택계약-업무처리-규정-제3조-제4호","item_number":"4","content":"기타 계약관리본부장이 필요하다고 판단하는 물품 등","subitems":[]}]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["물품","수요기관"]},{"id":"DAPA_A_2100000182498_ART_4","display_id":"군수품-선택계약-업무처리-규정-제4조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제2장 대상수요물자 및 참가자격 등","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"참가자격","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_4_P1","display_id":"군수품-선택계약-업무처리-규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 국가종합전자조달시스템(나라장터)에 업체 등록을 하고, 국방전자조달시스템(www.d2b.go.kr)에 사용자 등록 및 추가정보 등록을 한 자를 군수품 선택계약에 참가하도록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_4_P2","display_id":"군수품-선택계약-업무처리-규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"「중소기업제품 구매촉진 및 판로지원에 관한 법률」에 따라 중소기업자간 경쟁제품으로 지정 공고한 품목은 군수품 선택계약의 참가자격을 중소기업자로 제한하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["입찰참가자격","전자입찰","중소기업자간 경쟁제품","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_5","display_id":"군수품-선택계약-업무처리-규정-제5조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제2장 대상수요물자 및 참가자격 등","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"입찰공고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_5_P0","display_id":"군수품-선택계약-업무처리-규정-제5조","paragraph_number":"","paragraph_index":null,"content":"군수품 선택계약에 의하여 조달할 물품은 「군수품조달관리규정」 별지 제10호 서식(표준 입찰공고문)에서 정한 내용 외에 아래 내용을 입찰공고문에 포함하여야 한다.","items":[{"id":"DAPA_A_2100000182498_ART_5_P0_I1","display_id":"군수품-선택계약-업무처리-규정-제5조-제1호","item_number":"1","content":"계약방법 : 군수품 선택계약","subitems":[]},{"id":"DAPA_A_2100000182498_ART_5_P0_I2","display_id":"군수품-선택계약-업무처리-규정-제5조-제2호","item_number":"2","content":"군수품 선택계약 계약업체 수 : ( )개 업체","subitems":[]},{"id":"DAPA_A_2100000182498_ART_5_P0_I3","display_id":"군수품-선택계약-업무처리-규정-제5조-제3호","item_number":"3","content":"계약상대자 결정방법 :「물품 적격심사 기준」또는「중소기업자간 경쟁제품 중 물품의 구매에 관한 계약이행능력심사 세부기준」등 적용기준 단, 종합평점 95점 이상인 ( )개 업체 선정","subitems":[]},{"id":"DAPA_A_2100000182498_ART_5_P0_I4","display_id":"군수품-선택계약-업무처리-규정-제5조-제4호","item_number":"4","content":"납품업체 및 납품수량 : 계약된 업체 중에서 수요기관이 결정","subitems":[]}]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["입찰공고","중소기업자간 경쟁제품","적격심사","물품"]},{"id":"DAPA_A_2100000182498_ART_6","display_id":"군수품-선택계약-업무처리-규정-제6조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제2장 대상수요물자 및 참가자격 등","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"생산능력의 확인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_6_P1","display_id":"군수품-선택계약-업무처리-규정-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 업체의 생산능력을 확인할 필요가 있는 물품에 대해서는 그 내용을 입찰공고 조건에 명시하여야 한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_6_P2","display_id":"군수품-선택계약-업무처리-규정-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따른 생산능력 확인을 위한 기준은 방위사업청장이 별도로 정한「업체 생산 및 정비능력 확인지침」을 적용하며, 확인결과 생산능력이 부족한 것으로 판단된 경우에는 부적격 처리한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_6_P3","display_id":"군수품-선택계약-업무처리-규정-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"중소벤처기업부장관이 중소기업자간 경쟁제품으로 지정 공고한 품목은 중소벤처기업부 고시「중소기업자간 경쟁제품 직접생산 확인기준」에 따라 별도의 업체 생산능력 확인을 생략할 수 있다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["중소기업자간 경쟁제품","직접생산","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_7","display_id":"군수품-선택계약-업무처리-규정-제7조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"계약상대자의 결정","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_7_P1","display_id":"군수품-선택계약-업무처리-규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 방위사업청장이 별도로 정한「물품 적격심사 기준」또는「중소기업자간 경쟁제품 중 물품의 구매에 관한 계약이행능력심사 세부기준」등을 적용하여 계약상대자를 결정한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_7_P2","display_id":"군수품-선택계약-업무처리-규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 기준에 의한 낙찰자 결정방법에 따라 예정가격 이하로서 최저가 입찰자순으로 심사를 진행하여 심사결과 종합평점이 95점 이상인 다수의 업체를 계약상대자로 결정하되, 구체적인 계약상대자 수는 입찰공고시 정하여 공고한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_7_P3","display_id":"군수품-선택계약-업무처리-규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"심사결과 입찰공고시 정하여 공고한 업체 수에 미달한 경우에는 계약상대자가 2개 이상인 경우는 유효한 입찰로 계약이 성립한다고 본다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약상대자","중소기업자간 경쟁제품","적격심사","예정가격","낙찰자","입찰공고"]},{"id":"DAPA_A_2100000182498_ART_8","display_id":"군수품-선택계약-업무처리-규정-제8조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"계약보증금","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_8_P0","display_id":"군수품-선택계약-업무처리-규정-제8조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 군수품 선택계약의 계약목적물을 여러 차례로 분할하여 계약을 이행하게 하는 때에는「국가를 당사자로 하는 계약에 관한 법률 시행령」제50조제2항에 따라 매회별 이행예정량 중 최대량에 계약단가를 곱한 금액의 100분의 10이상을 계약보증금으로 납부하게 하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_50"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["계약보증금","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_9","display_id":"군수품-선택계약-업무처리-규정-제9조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"계약체결","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_9_P1","display_id":"군수품-선택계약-업무처리-규정-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 계약상대자가 결정되면「국가를 당사자로 하는 계약에 관한 법률 시행규칙」제49조에서 정한 기준에 따라 계약을 체결한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_9_P2","display_id":"군수품-선택계약-업무처리-규정-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항에 따라 체결된 계약결과를 수요기관에 통보하고, 수요기관으로 하여금 납품대상업체 및 납지별 납품수량을 결정할 수 있도록 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_RULE_ART_49"],"related_regulations":["STATE_CONTRACT_RULE"],"external_references":[],"keywords":["계약서 작성","계약담당공무원","수요기관"]},{"id":"DAPA_A_2100000182498_ART_10","display_id":"군수품-선택계약-업무처리-규정-제10조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"물품납품통지서 발급","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_10_P1","display_id":"군수품-선택계약-업무처리-규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 최초 물품납품통지서 발행시 계약상대자로 결정된 각 업체와 총 계약금액의 100분의 10이상의 최소 납품 물량에 대한 계약을 보장한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_10_P2","display_id":"군수품-선택계약-업무처리-규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"수요기관은 제1항의 최소 납품 보장 물량을 제외한 나머지 물량에 대해 납품대상업체 및 납지별 납품수량을 결정하여 계약담당공무원에게 통보하고, 이에 따라 계약담당공무원은 해당업체에 물품납품통지서를 발행한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_10_P3","display_id":"군수품-선택계약-업무처리-규정-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"수요기관 중 각 군의 경우에는 각 군 군수사령부에서 방위사업청 계약담당공무원이 물품납품통지서를 발행할 수 있도록 납지별 납품대상업체 및 납품수량을 종합한 물품납품통지요구서를 계약담당공무원에게 통보하여야 한다. 단, 급식품목은 각 군 군수사령부와 협의를 거쳐 필요시 수납부대에서 직접 납품대상업체로 납품지시를 할 수 있다.","items":[]},{"id":"DAPA_A_2100000182498_ART_10_P4","display_id":"군수품-선택계약-업무처리-규정-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"물품납품통지서 발행은 수요기관 요구에 따라 월, 분기, 반기 단위로 발행하거나, 본조, 국고채무 예산으로 구분하여 발행할 수 있다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["물품","계약담당공무원","수요기관"]},{"id":"DAPA_A_2100000182498_ART_11","display_id":"군수품-선택계약-업무처리-규정-제11조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"계약기간","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_11_P1","display_id":"군수품-선택계약-업무처리-규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"물품납품통지서의 최종납기는 계약서에 기재된 계약종료일을 초과하여 발행할 수 없다.","items":[]},{"id":"DAPA_A_2100000182498_ART_11_P2","display_id":"군수품-선택계약-업무처리-규정-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약담당공무원은 제1항에도 불구하고 차기계약 체결이 지연되어 수요기관의 적기 보급에 차질이 발생하는 경우에는 계약서에서 정한 회계연도 내에서 계약관(또는 분임계약관)의 승인을 받아 납기를 차기계약 체결 시 까지 기간을 고려하여 연장할 수 있다.","items":[]},{"id":"DAPA_A_2100000182498_ART_11_P3","display_id":"군수품-선택계약-업무처리-규정-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항에 따른 물품납품통지서 발급일은 계약서에 기재된 계약종료일 이전에 발행하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약기간","계약서 작성","물품","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_12","display_id":"군수품-선택계약-업무처리-규정-제12조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"차기계약 배제","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_12_P0","display_id":"군수품-선택계약-업무처리-규정-제12조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 다음 각 호의 어느 하나에 해당하는 계약상대자와는 차기공고일로부터 1년간 차기계약 계약상대자 결정시 배제할 수 있다.","items":[{"id":"DAPA_A_2100000182498_ART_12_P0_I1","display_id":"군수품-선택계약-업무처리-규정-제12조-제1호","item_number":"1","content":"계약물품 기준으로 입찰참가등록 마감일 전일부터 기산하여 최근 2년간 군수품 선택계약을 연속적으로 체결하였으나 제10조제1항의 최소 납품 보장 물량외에 수요기관의 선택을 받지 못한 계약상대자","subitems":[]},{"id":"DAPA_A_2100000182498_ART_12_P0_I2","display_id":"군수품-선택계약-업무처리-규정-제12조-제2호","item_number":"2","content":"계약물품 기준으로 최근 2년간 제16조에 따른 계약이행실적평가에서 2회 이상 연속 총점기준으로‘미흡’등급을 받은 계약상대자","subitems":[]}]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000182498_ART_10","DAPA_A_2100000182498_ART_16"],"related_regulations":[],"external_references":[],"keywords":["계약상대자","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_13","display_id":"군수품-선택계약-업무처리-규정-제13조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"허위서류 제출 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_13_P0","display_id":"군수품-선택계약-업무처리-규정-제13조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 계약상대자가 계약 과정에서 입찰 또는 계약에 관한 서류를 위조·변조하거나 또는 기타 부정한 방법으로 허위서류를 제출한 경우 계약을 해제·해지하고「국가를 당사자로 하는 계약에 관한 법률 시행령」제76조제1항제1호가목에 따라 부정당업자로 제재하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_76"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["부정당업자","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_14","display_id":"군수품-선택계약-업무처리-규정-제14조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"계약 미체결자에 대한 조치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_14_P0","display_id":"군수품-선택계약-업무처리-규정-제14조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 계약상대자로 결정된 자가 정당한 이유 없이 계약을 체결하지 않을 경우에는「국가를 당사자로 하는 계약에 관한 법률」제27조 제1항제8호나목에 따라 부정당업자로 제재하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ACT_ART_27"],"related_regulations":["STATE_CONTRACT_ACT"],"external_references":[],"keywords":["부정당업자","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_15","display_id":"군수품-선택계약-업무처리-규정-제15조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제3장 계약의 절차","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"부당이득의 환수","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_15_P1","display_id":"군수품-선택계약-업무처리-규정-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 계약상대자가 계약과정에서 계약관련 허위서류 제출, 위조·변조 또는 기타 부정한 행위로 부당이득이 발생한 경우, 계약상대자로부터 부당이득금과 부당이득금에 상당하는 가산금을 환수하여야 한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_15_P2","display_id":"군수품-선택계약-업무처리-규정-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 환수조치에 대하여 계약상대자는 이의를 신청할 수 있으며, 이 경우 계약상대자는 신뢰할 만한 증빙서류를 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약상대자","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_16","display_id":"군수품-선택계약-업무처리-규정-제16조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제4장 계약이행실적평가 및 등급화 운영","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"계약이행실적평가 및 등급화 대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_16_P0","display_id":"군수품-선택계약-업무처리-규정-제16조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 군수품 선택계약 납품실적이 있는 계약상대자를 대상으로 평가 전월기준 최근 1년내 계약기간 동안의 계약이행실적을 평가하고 등급화한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약의 이행","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_17","display_id":"군수품-선택계약-업무처리-규정-제17조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제4장 계약이행실적평가 및 등급화 운영","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"계약이행실적평가 및 등급화 평가시기","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_17_P0","display_id":"군수품-선택계약-업무처리-규정-제17조","paragraph_number":"","paragraph_index":null,"content":"평가시기는 연 1회, 1월에 평가함을 원칙으로 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약의 이행"]},{"id":"DAPA_A_2100000182498_ART_18","display_id":"군수품-선택계약-업무처리-규정-제18조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제4장 계약이행실적평가 및 등급화 운영","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"계약이행실적평가 및 등급화 산출방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_18_P1","display_id":"군수품-선택계약-업무처리-규정-제18조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약이행실적평가는 4개의 평가항목에 대하여 8개의 평가지표로 구성되며, 기본점수 10점을 포함한 총점 100점 만점으로 평가지표별 등급 점수는 별표 제1항과 같다.","items":[]},{"id":"DAPA_A_2100000182498_ART_18_P2","display_id":"군수품-선택계약-업무처리-규정-제18조-제2항","paragraph_number":"②","paragraph_index":2,"content":"평가등급은 최우수, 우수, 보통, 미흡의 4단계로 구성하고, 평가등급 간 점수구간은 별표 제2항과 같으며 신호등 표시체계로 표출시 최우수는 파란색, 우수는 초록색, 보통은 황색, 미흡은 빨간색을 부여한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약의 이행"]},{"id":"DAPA_A_2100000182498_ART_19","display_id":"군수품-선택계약-업무처리-규정-제19조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제4장 계약이행실적평가 및 등급화 운영","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"평가정보의 취득","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_19_P0","display_id":"군수품-선택계약-업무처리-규정-제19조","paragraph_number":"","paragraph_index":null,"content":"계약담당공무원은 계약상대자의 계약이행실적을 평가하기 위한 평가항목 및 평가지표의 데이터는 통합사업관리정보체계시스템의 데이터베이스에 저장된 계약 관련자료를 활용한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_20","display_id":"군수품-선택계약-업무처리-규정-제20조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제4장 계약이행실적평가 및 등급화 운영","section":"","subsection":"","article_number":"20","article_label":"제20조","article_title":"수요기관의 수요기관 만족도 평가 의무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_20_P0","display_id":"군수품-선택계약-업무처리-규정-제20조","paragraph_number":"","paragraph_index":null,"content":"수요기관은 계약이행실적이 있는 계약상대자를 대상으로 별표 제1항의 품질 만족도, 가격 만족도, 종합 만족도의 3개 평가지표에 대해 각 군 군수사령부에서 정한 기준에 의해 수납부대에서 공정하고 정확한 평가를 하고 그 결과를 국방전자조달시스템에 접속하여 입력해야 한다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["수요기관","전자입찰"]},{"id":"DAPA_A_2100000182498_ART_21","display_id":"군수품-선택계약-업무처리-규정-제21조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제4장 계약이행실적평가 및 등급화 운영","section":"","subsection":"","article_number":"21","article_label":"제21조","article_title":"평가결과 공개 및 열람","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498_ART_21_P1","display_id":"군수품-선택계약-업무처리-규정-제21조-제1항","paragraph_number":"①","paragraph_index":1,"content":"계약담당공무원은 계약이행실적평가 결과를 수요기관이 열람할 수 있도록 국방전자조달시스템에 게시하여야 한다.","items":[]},{"id":"DAPA_A_2100000182498_ART_21_P2","display_id":"군수품-선택계약-업무처리-규정-제21조-제2항","paragraph_number":"②","paragraph_index":2,"content":"계약상대자는 국방전자조달시스템에 로그인하여 당해 업체의 평가항목별 점수 및 평가등급을 열람할 수 있다.","items":[]}],"notes":[],"effective_date":"2019-09-18","revision_date":"2019-09-18","source_file":"군수품 선택계약 업무처리 규정.json","source_path":"원문/법제처API/군수품 선택계약 업무처리 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["전자입찰","계약담당공무원"]},{"id":"DAPA_A_2100000182498_ART_22","display_id":"군수품-선택계약-업무처리-규정-제22조","regulation_id":"DAPA_A_2100000182498","regulation_name":"군수품 선택계약 업무처리 규정","short_name":"군수품 선택계약 업무처리 규정","document_type":"훈령","part":"","chapter":"제4장 계약이행실적평가 및 등급화 운영","section":"","subsection":"","article_number":"22","article_label":"제22조","article_title":"평가 관련정보 비밀 준수 의무","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000182498