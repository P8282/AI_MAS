ords":["전자입찰","입찰보증금","낙찰자"]},{"id":"DAPA_A_2100000199739_ART_8","display_id":"역경매-업무처리지침-제8조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"역경매 집행","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_8_P1","display_id":"역경매-업무처리지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장은 입찰서를 공고서에 지정된 기간내에 본 시스템을 통하여 전자적으로만 제출받아야 한다. 다만, 공고서에 정하는 바에 따라 경매종료일시가 연장된 경우에는 연장된 종료일시까지 제출받을 수 있다.","items":[]},{"id":"DAPA_A_2100000199739_ART_8_P2","display_id":"역경매-업무처리지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"상업계약팀장은 역경매입찰자로부터 최초 입찰서를 제출한 이후에도 입찰서 제출횟수와 관계없이 투찰가능금액 이하의 가격으로 입찰서를 제출받을 수 있다. 다만, 공고서에서 입찰서 제출 횟수를 제한한 경우에는 이를 초과하여 제출받을 수 없다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000199739_ART_9","display_id":"역경매-업무처리지침-제9조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"역경매입찰 참가의 취소","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_9_P1","display_id":"역경매-업무처리지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장은 입찰서의 투찰금액 등 중요부분의 기재오류를 이유로 역경매입찰자가 모든 입찰의 취소 의사를 표시하면 역경매입찰자가 제출한 모든 입찰을 무효처리 할 수 있다. 이 경우 취소의사를 표시한 역경매입찰자는 당해 역경매입찰에 참가할 수 없으나 재공고 입찰에 부치는 경우에는 그러하지 아니하다.","items":[]},{"id":"DAPA_A_2100000199739_ART_9_P2","display_id":"역경매-업무처리지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 역경매입찰 참가의 취소에 대한 의사표시 경매종료일시 30분전까지 본 시스템에서 직접 제출받아야 한다. 다만, 본 시스템을 통해 직접 제출이 곤란한 경우에는 경매종료일시 30분 전까지 역경매입찰 취소신청서(별지 서식)를 작성하여 우편 또는 모사전송(FAX)의 방법으로 제출(모사전송시 추후 원본 제출)받을 수 있다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["입찰참가자격","재공고입찰"]},{"id":"DAPA_A_2100000199739_ART_10","display_id":"역경매-업무처리지침-제10조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"개찰","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_10_P1","display_id":"역경매-업무처리지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장은 역경매입찰 공고에 명시된 장소에서 지정된 일시에 개찰을 집행하며, 역경매입찰자 또는 그 대리인은 개찰에 참관할 수 있다. 이 경우 상업계약팀장은 개찰에 참관하고자 하는 자에게 신분증, 위임장 및 입찰참가등록증의 제시를 요구할 수 있다.","items":[]},{"id":"DAPA_A_2100000199739_ART_10_P2","display_id":"역경매-업무처리지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"역경매입찰의 개찰은 계약담당공무원이 개찰용 컴퓨터를 통해 지정전자서명인증사업자에게서 발급한 인증서로 시스템에 접속하여 집행한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["개찰","전자서명","계약담당공무원"]},{"id":"DAPA_A_2100000199739_ART_11","display_id":"역경매-업무처리지침-제11조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"낙찰자 결정방법","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_11_P0","display_id":"역경매-업무처리지침-제11조","paragraph_number":"","paragraph_index":null,"content":"상업계약팀장은 경매종료일시까지 입찰서를 제출하게 하여 최저가격의 입찰서 제출자를 낙찰자로 결정한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["낙찰자"]},{"id":"DAPA_A_2100000199739_ART_12","display_id":"역경매-업무처리지침-제12조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"재공고 입찰","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_12_P1","display_id":"역경매-업무처리지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장은 2인 이상의 유효한 입찰자가 없거나 낙찰자가 없을 경우 재공고 일시를 다시 정하여 재공고 입찰에 부칠 수 있다.","items":[]},{"id":"DAPA_A_2100000199739_ART_12_P2","display_id":"역경매-업무처리지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"재공고 입찰의 시작가격은 제6조에 따른 최초의 시작가격과 같아야 한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000199739_ART_6"],"related_regulations":[],"external_references":[],"keywords":["재공고입찰","재입찰"]},{"id":"DAPA_A_2100000199739_ART_13","display_id":"역경매-업무처리지침-제13조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"역경매입찰의 연기공고","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_13_P1","display_id":"역경매-업무처리지침-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장이 역경매입찰을 연기하고자 할 경우 본 시스템의 게시판에 게재하여야 한다. 필요에 따라 전자공동수급협정서 등의 제출기한, 경매종료일시, 개찰일시 등의 일부 또는 전부를 연기할 수 있다.","items":[]},{"id":"DAPA_A_2100000199739_ART_13_P2","display_id":"역경매-업무처리지침-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 역경매입찰을 연기할 경우 이미 유효하게 제출된 입찰서 및 전자공동수급협정서 등은 연기된 역경매입찰에 유효하게 접수된 것으로 보며 다시 제출받을 수 없다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["공동수급체","공동계약"]},{"id":"DAPA_A_2100000199739_ART_14","display_id":"역경매-업무처리지침-제14조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"역경매입찰의 취소","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_14_P1","display_id":"역경매-업무처리지침-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장은 낙찰자 선정통보 이전에 방위사업청의 예산사정, 사업계획의 변경 등 불가피한 사유가 있을 때에는 당해 역경매입찰을 취소할 수 있다.","items":[]},{"id":"DAPA_A_2100000199739_ART_14_P2","display_id":"역경매-업무처리지침-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"상업계약팀장은 입찰서제출자가 정상적으로 입찰서를 제출하였으나 본 시스템 또는 개인용 컴퓨터의 오류 등으로 인하여 공정한 역경매입찰의 집행이 곤란하다고 판단될 경우 해당 역경매입찰 전체를 취소할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000199739_ART_15","display_id":"역경매-업무처리지침-제15조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"낙찰자 선정 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_15_P0","display_id":"역경매-업무처리지침-제15조","paragraph_number":"","paragraph_index":null,"content":"낙찰자선정 및 계약체결 등은 「국외 상업구매 업무지침」에 따른다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["낙찰자"]},{"id":"DAPA_A_2100000199739_ART_16","display_id":"역경매-업무처리지침-제16조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"정보안내","is_deleted":false,"is_supplementar