[{"id":"DAPA_A_2100000199739_ART_1","display_id":"역경매-업무처리지침-제1조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_1_P0","display_id":"역경매-업무처리지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 역경매 업무처리지침은 방위사업청이 물품의 제조ㆍ구매를 위하여 「국가를 당사자로 하는 계약에 관한 법률 시행령」 제10조제3항 및 제39조제1항, 「특정조달을 위한 국가를 당사자로 하는 계약에 관한 법률 시행령 특례규정」에 따라 국방전자조달시스템을 이용하여 실시하는 역경매 입찰의 처리기준 및 절차와 관련된 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ENFORCEMENT_ART_10","STATE_CONTRACT_ENFORCEMENT_ART_39"],"related_regulations":["STATE_CONTRACT_ENFORCEMENT"],"external_references":[],"keywords":["전자입찰"]},{"id":"DAPA_A_2100000199739_ART_2","display_id":"역경매-업무처리지침-제2조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_2_P0","display_id":"역경매-업무처리지침-제2조","paragraph_number":"","paragraph_index":null,"content":"역경매입찰에 관한 업무처리는 따로 정한 것을 제외하고는 이 지침에 따른다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000199739_ART_3","display_id":"역경매-업무처리지침-제3조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"용어의 정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_3_P1","display_id":"역경매-업무처리지침-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 지침에 사용되는 용어의 정의는 다음과 같다.","items":[{"id":"DAPA_A_2100000199739_ART_3_P1_I1","display_id":"역경매-업무처리지침-제3조-제1항-제1호","item_number":"1","content":"\"역경매입찰\"이라 함은 「국가를 당사자로 하는 계약에 관한 법률」 제10조 제3항의 규정에 따른 역경매로 국방전자조달시스템(이하 \"본 시스템\"이라 한다.)을 이용하여 행하여지는 입찰을 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I2","display_id":"역경매-업무처리지침-제3조-제1항-제2호","item_number":"2","content":"\"조달업체\"라 함은 본 시스템을 통해 전자거래를 하기 위하여 「역경매입찰 특별유의서」 제5조의 규정에 따라 등록된 업체로서 입찰 및 계약 등에 참여하는 업체를 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I3","display_id":"역경매-업무처리지침-제3조-제1항-제3호","item_number":"3","content":"\"역경매\"란 본 시스템을 통해 1인이 복수의 입찰서를 제출할 수 있도록 하여 경매종료일시까지 제출한 입찰서 중 최저가격의 입찰서 제출자를 낙찰자로 결정할 수 있는 방식을 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I4","display_id":"역경매-업무처리지침-제3조-제1항-제4호","item_number":"4","content":"\"역경매입찰자\"라 함은 본 시스템을 이용하여 역경매입찰에 참가하는 국내 ㆍ 외 조달업체의 대표자 또는 위임 받아 업무를 처리하는 자를 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I5","display_id":"역경매-업무처리지침-제3조-제1항-제5호","item_number":"5","content":"\"경매종료일시\"란 입찰공고에서 정한 역경매 입찰서 제출마감일시를 말한다. 다만, 경매종료일시 직전에 새로운 입찰자가 있는 경우에는 연장된 종료일시를 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I6","display_id":"역경매-업무처리지침-제3조-제1항-제6호","item_number":"6","content":"\"현재최저가격(마감전)\"이란 입찰서 제출기간내에 제출된 입찰서 중 최저가격을 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I7","display_id":"역경매-업무처리지침-제3조-제1항-제7호","item_number":"7","content":"\"투찰가능금액\"이란 새로운 견적이 가능한 최대투찰금액을 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I8","display_id":"역경매-업무처리지침-제3조-제1항-제8호","item_number":"8","content":"\"인하비율\"이란 현재최저가격(마감전)에서 인하하여 투찰할 수 있는 비율을 말한다.","subitems":[]},{"id":"DAPA_A_2100000199739_ART_3_P1_I9","display_id":"역경매-업무처리지침-제3조-제1항-제9호","item_number":"9","content":"\"시작가격\"이란 계약담당자가 공개하는 최대입찰가격을 말한다.","subitems":[]}]},{"id":"DAPA_A_2100000199739_ART_3_P2","display_id":"역경매-업무처리지침-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"이 지침에서 따로 정의하는 용어를 제외하고는 「국가를 당사자로 하는 계약에 관한 법률」,「동법 시행령」,「동법 시행규칙」(이하 \"국가계약법령\"이라 한다), 「특정조달을 위한 국가를 당사자로 하는 계약에 관한 법률 시행령 특례규정」, 「계약예규」,「방위사업관리규정」,「군수품조달관리규정」,「국외 상업구매 업무지침」,「국방전자조달시스템 이용에 관한 약관」 등 관련규정에서 정한 바에 따른다.","items":[]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["STATE_CONTRACT_ACT_ART_10","DAPA_A_2100000199738_ART_5"],"related_regulations":["STATE_CONTRACT_ACT","DAPA_A_2100000199738"],"external_references":[],"keywords":["전자입찰","최저가낙찰"]},{"id":"DAPA_A_2100000199739_ART_4","display_id":"역경매-업무처리지침-제4조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"역경매입찰 대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_4_P1","display_id":"역경매-업무처리지침-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장(각 사업본부의 상업계약업무를 담당하는 계약팀장을 말한다. 이하 같다)은 조달계획서를 접수하면 해당 품목의 특성ㆍ목적 및 내용 등을 검토하여 역경매입찰이 가능할 경우 역경매입찰에 부칠 수 있다.","items":[]},{"id":"DAPA_A_2100000199739_ART_4_P2","display_id":"역경매-업무처리지침-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"다음 각 호의 기준을 모두 충족하는 품목은 역경매입찰 대상으로 선정할 수 있다.","items":[{"id":"DAPA_A_2100000199739_ART_4_P2_I1","display_id":"역경매-업무처리지침-제4조-제2항-제1호","item_number":"1","content":"구매빈도가 높고 규격이 명확한 단순ㆍ소모성 수리부속류","subitems":[]},{"id":"DAPA_A_2100000199739_ART_4_P2_I2","display_id":"역경매-업무처리지침-제4조-제2항-제2호","item_number":"2","content":"공급자가 많아 경쟁이 활성화되어 있는 품목(5개 이상 경쟁업체)","subitems":[]},{"id":"DAPA_A_2100000199739_ART_4_P2_I3","display_id":"역경매-업무처리지침-제4조-제2항-제3호","item_number":"3","content":"품목 단가가 2,000만원 이하인 소액품목","subitems":[]}]}],"notes":[],"effective_date":"2021-04-01","revision_date":"2021-04-01","source_file":"역경매 업무처리지침.json","source_path":"원문/법제처API/역경매 업무처리지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000199739_ART_5","display_id":"역경매-업무처리지침-제5조","regulation_id":"DAPA_A_2100000199739","regulation_name":"역경매 업무처리지침","short_name":"역경매 업무처리지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"조달판단","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000199739_ART_5_P1","display_id":"역경매-업무처리지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"상업계약팀장은 역경매로 조달판단한 경우 역경매입찰에 필요한 사항을 기재한 조달판단서를 작성하여 해당 계약관의 승인을 얻은 후 이에 따라 구매를 추진한다.","items":[]},{"id":"DAPA_A_2100000199739_ART_5_P2","display_id":"역경매-업무처리지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"상업계약팀장은 조달판단시 구매요청번호(Purchase Request Number : P.R. No.)를 별도로 부여하며, 부여방법은 「국외 상업구매 업무지침」에 따른다.","items":[]},{"id":"DAPA_A_2100000199739_ART_5_P3","display_id":"역경매-업무처리지침-제5조-제3항","paragraph_number":"③","parag