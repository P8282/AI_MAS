[{"id":"DAPA_A_2100000233820_ART_1","display_id":"무기체계-디지털-트윈-활용-지침-제1조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_1_P0","display_id":"무기체계-디지털-트윈-활용-지침-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은「방위사업관리규정」에 따라 방위력개선사업을 수행함에 있어서 무기체계 획득단계별 절차에서 디지털 트윈의 시범적 적용을 위한 기준 및 절차를 정함으로써 무기체계의 획득 및 운용 과정에서의 신뢰성 및 효율성을 제고함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_2","display_id":"무기체계-디지털-트윈-활용-지침-제2조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용 범위","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_2_P0","display_id":"무기체계-디지털-트윈-활용-지침-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 다음 각 호의 기관에 적용한다.","items":[{"id":"DAPA_A_2100000233820_ART_2_P0_I1","display_id":"무기체계-디지털-트윈-활용-지침-제2조-제1호","item_number":"1","content":"방위사업청과 그 소속기관","subitems":[]},{"id":"DAPA_A_2100000233820_ART_2_P0_I2","display_id":"무기체계-디지털-트윈-활용-지침-제2조-제2호","item_number":"2","content":"국방과학연구소(이하 \"국과연\"이라 한다)와 그 부설기관(국방신속획득기술연구원, 이하 \"신속원\"이라 한다)","subitems":[]},{"id":"DAPA_A_2100000233820_ART_2_P0_I3","display_id":"무기체계-디지털-트윈-활용-지침-제2조-제3호","item_number":"3","content":"국방기술품질원(이하 \"기품원\"이라 한다)과 그 부설기관(국방기술진흥연구소, 이하 \" 국기연\"이라고 한다)","subitems":[]},{"id":"DAPA_A_2100000233820_ART_2_P0_I4","display_id":"무기체계-디지털-트윈-활용-지침-제2조-제4호","item_number":"4","content":"연구개발주관기관(국과연 또는 연구개발업체를 말한다)","subitems":[]},{"id":"DAPA_A_2100000233820_ART_2_P0_I5","display_id":"무기체계-디지털-트윈-활용-지침-제2조-제5호","item_number":"5","content":"그 밖에 이 지침에서 정하는 업무와 관련이 있는 기관(부서)","subitems":[]}]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_3","display_id":"무기체계-디지털-트윈-활용-지침-제3조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_3_P0","display_id":"무기체계-디지털-트윈-활용-지침-제3조","paragraph_number":"","paragraph_index":null,"content":"이 지침에서 사용하는 용어의 뜻은 다음과 같다.","items":[{"id":"DAPA_A_2100000233820_ART_3_P0_I1","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제1호","item_number":"1","content":"\"디지털 트윈\"이란 실제 무기체계(핵심부품ㆍ구성품 등을 포함한다)와 동일한 수준의 디지털 객체를 구현하여 상호 실시간으로 융합하고 이를 기반으로 무기체계를 최적화하는 기술을 말한다.","subitems":[]},{"id":"DAPA_A_2100000233820_ART_3_P0_I2","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제2호","item_number":"2","content":"\"디지털 트윈 적용 수준(DTL: Digital Twin Level)\"은 디지털 트윈을 차별적으로 적용하기 위하여 연구개발비와 기술적 난이도(체계 복잡도ㆍ위험도)을 고려하여 정한 정략적 수준을 말한다.","subitems":[]},{"id":"DAPA_A_2100000233820_ART_3_P0_I3","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제3호","item_number":"3","content":"\"디지털 트윈 기술 단계\"라 함은 민간의 디지털 트윈 기술 5단계 개념(모사-관제-모의-연합-자율)을 국방 분야에 적합하게 재정립(설계-관제-체계가상화-연계-결심)한 것을 말한다.","subitems":[]},{"id":"DAPA_A_2100000233820_ART_3_P0_I4","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제4호","item_number":"4","content":"\"디지털 트윈 자원\"이라 함은 디지털 트윈 기술 데이터, 정보자원 저장소 등 디지털 트윈 기반 및 기술을 망라한 일체의 디지털 트윈 관련 유ㆍ무형의 지식 및 정보자원을 말한다.","subitems":[]},{"id":"DAPA_A_2100000233820_ART_3_P0_I5","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제5호","item_number":"5","content":"\"디지털 트윈 기술 Tool\"이라 함은 디지털 트윈에 대한 시험평가 시에 활용되는 관련 소프트웨어를 말한다.","subitems":[]},{"id":"DAPA_A_2100000233820_ART_3_P0_I6","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제6호","item_number":"6","content":"\"디지털 트윈 활용계획(DAP: Digital twin Application Plan)\"은 체계개발 결과물의 예측 및 검증을 통하여 무기체계의 안전성을 높이고 설계를 최적화하고자 디지털 트윈 추진전략, 활용ㆍ접근방법, 자원관리 등에 대해 기술한 문서를 말한다. 이 경우 디지털 트윈 추진전략을 작성할 때에는 무기체계의 개념발전, 비용절감, 개발기간 단축, 사업효율성 향상 등을 고려하여야 한다.","subitems":[]},{"id":"DAPA_A_2100000233820_ART_3_P0_I7","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제7호","item_number":"7","content":"\"적정성 평가\"이라 함은 모델 수행이 개발자의 개념적 묘사와 명세를 정확하게 반영하여 나타내고 있는지를 결정하는 과정인 검증, 모델 수행결과가 본래 의도한 용도와 관련해서 어느 정도 정확하게 체계 혹은 실세계를 나타내고 있는지를 결정하는 확인을 말하며, 이는 디지털 트윈 기술의 신뢰성 확보를 위해 요구된다.","subitems":[]},{"id":"DAPA_A_2100000233820_ART_3_P0_I8","display_id":"무기체계-디지털-트윈-활용-지침-제3조-제8호","item_number":"8","content":"\"가상실험\"이라 함은 제7조 및 \"별표 1\"에서 정하는 DTL Ⅱ에 해당하는 대상사업에 대하여 센서 네트워크 구축을 통한 데이터 수집 및 실시간 시뮬레이션으로 무기체계 최적화를 위한 실험을 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000233820_ART_7"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_4","display_id":"무기체계-디지털-트윈-활용-지침-제4조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제1장 총 칙","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"업무분장","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_4_P0","display_id":"무기체계-디지털-트윈-활용-지침-제4조","paragraph_number":"","paragraph_index":null,"content":"무기체계 획득단계별 디지털 트윈 적용에 관한 업무분장은 다음 각 호와 같다","items":[{"id":"DAPA_A_2100000233820_ART_4_P0_I1","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제1호","item_number":"1","content":"국방기술보호국(기술정책과)","subitems":[{"id":"DAPA_A_2100000233820_ART_4_P0_I1_S1","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제1호-가목","subitem_number":"가","content":"방위력개선사업분야의 디지털 트윈에 대한 주요 정책ㆍ기획의 총괄 및 제도발전 - 디지털 트윈 기술 단계별 획득업무 적용 로드맵 작성나. 디지털 트윈과 관련한 중ㆍ장기 계획 및 예산편성에 관한 검토ㆍ조정 및 통제다. 디지털 트윈 기술 Tool에 적용되는 각종 데이터(대기환경, 토양 재질 등)의 제공 및 관리"}]},{"id":"DAPA_A_2100000233820_ART_4_P0_I2","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제2호","item_number":"2","content":"방위사업정책국(표준기획과)","subitems":[{"id":"DAPA_A_2100000233820_ART_4_P0_I2_S1","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제2호-가목","subitem_number":"가","content":"디지털 트윈과 관련한 3D CAD 등의 특수기술자료를 국방표준종합정보시스템(KDSIS)에 탑재하기 위한 고도화 업무나. 디지털 트윈과 관련한 표준화 정책의 발전"}]},{"id":"DAPA_A_2100000233820_ART_4_P0_I3","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제3호","item_number":"3","content":"방위사업정책국(방위사업분석과)","subitems":[{"id":"DAPA_A_2100000233820_ART_4_P0_I3_S1","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제3호-가목","subitem_number":"가","content":"디지털 트윈에 대한 적정성 평가 업무의 조정ㆍ통제나. 디지털 트윈 체계의 통합 등에 대한 검토, 조정 및 통제다. 획득단계별 디지털 트윈 활용계획 검토라. 제10조에 따른 디지털 트윈 지원단 구성 및 운영"}]},{"id":"DAPA_A_2100000233820_ART_4_P0_I4","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제4호","item_number":"4","content":"사업본부(통합사업관리팀)","subitems":[{"id":"DAPA_A_2100000233820_ART_4_P0_I4_S1","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제4호-가목","subitem_number":"가","content":"디지털 트윈 활용계획의 수립, 검토 및 승인나. 디지털 트윈 적용수준의 결정다. 디지털 트윈 적용을 위한 요구사항의 작성(제안요청서에 포함) 및 확정라. 디지털 트윈 가상실험의 적정성 평가 결과 검토마. 디지털 트윈과 관련한 기능적 형상(필요시) 및 3D 모델 형상 확인바. 동조 제9호가목부터 사목까지의 사항에 대한 검토 및 관련기관 의견 수렴 등사. 업체주관 무기체계 연구개발 사업의 디지털 트윈에 대한 적정성 평가 의뢰"}]},{"id":"DAPA_A_2100000233820_ART_4_P0_I5","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제5호","item_number":"5","content":"국과연가. 국과연주관 무기체계 연구개발 사업의 디지털 트윈 활용계획(안) 작성나. 국과연주관 무기체계 연구개발 사업의 H/W 설계기술서 및 요구사항 명세서 작성다. 국과연주관 무기체계 연구개발 사업의 시험평가기본계획서 및 개발시험평가계획서 작성 및 지원라. 국과연주관 무기체계 연구개발 사업의 디지털 트윈 구성(안) 및 가상실험 계획(안) 작성마. 국과연주관 무기체계 연구개발 사업의 디지털 트윈 가상실험 계획(안) 및 활용 결과 보고서 작성바. 국과연주관 무기체계 연구개발 사업의 디지털 트윈 자원 관련 표준화 및 형상관리사. 국과연주관 무기체계 연구개발 사업의 디지털 트윈에 대한 적정성 평가 수행","subitems":[]},{"id":"DAPA_A_2100000233820_ART_4_P0_I6","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제6호","item_number":"6","content":"신속원가. 무기체계 연구개발 사업의 디지털 트윈 활용 결과 분석 지원나. 무기체계 연구개발 사업의 디지털 트윈에 대한 적정성 평가 지원","subitems":[]},{"id":"DAPA_A_2100000233820_ART_4_P0_I7","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제7호","item_number":"7","content":"기품원가. 통합사업관리팀장으로부터 이관 받은 디지털 트윈 활용결과 및 산출물에 대한 관리나. 무기체계별 디지털 트윈 기술지원 및 향후 발전 전략 수립","subitems":[]},{"id":"DAPA_A_2100000233820_ART_4_P0_I8","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제8호","item_number":"8","content":"국기연가. 선행연구 간 무기체계 연구개발 사업의 디지털 트윈 적용수준 및 대상(안) 검토나. 디지털 트윈 분야 핵심기술기획서 작성 및 수준 조사다. 국방기술연구개발사업 분야의 디지털 트윈에 대한 정책ㆍ기획 지원","subitems":[]},{"id":"DAPA_A_2100000233820_ART_4_P0_I9","display_id":"무기체계-디지털-트윈-활용-지침-제4조-제9호","item_number":"9","content":"연구개발업체가. 업체주관 무기체계 연구개발 사업의 디지털 트윈 활용계획(안) 작성나. 업체주관 무기체계 연구개발 사업의 H/W 설계기술서 및 요구사항 명세서 작성다. 업체주관 무기체계 연구개발 사업의 시험평가기본계획서 및 개발시험평가계획서 작성 및 지원라. 업체주관 무기체계 연구개발 사업의 디지털 트윈 구성(안) 및 가상실험 계획(안) 작성마. 업체주관 무기체계 연구개발 사업의 디지털 트윈 가상실험 계획(안) 및 활용 결과 보고서 작성바. 업체주관 무기체계 연구개발 사업의 디지털 트윈 자원 관련 표준화 및 형상관리사. 업체주관 무기체계 연구개발 사업의 디지털 트윈에 대한 적정성 평가 요청","subitems":[]}]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000233820_ART_10"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_5","display_id":"무기체계-디지털-트윈-활용-지침-제5조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제2장 디지털 트윈 적용 기본 지침","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"디지털 트윈 적용 목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_5_P1","display_id":"무기체계-디지털-트윈-활용-지침-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 무기체계 연구개발 시 디지털 트윈을 적용함으로써 설계를 최적화하고 연구개발의 완성도 극대화할 수 있으며, 이를 통해 안전성 및 편의성 향상 등을 위함이다.","items":[]},{"id":"DAPA_A_2100000233820_ART_5_P2","display_id":"무기체계-디지털-트윈-활용-지침-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"연구개발업체는 디지털 트윈을 활용하여 무기체계 양산단계에서 작업 기술 및 절차 등과 같은 Know-How의 전수를 용이하게 할 수 있으며, 이를 통해 공정불량의 감소 및 생산의 효율성을 증가시킬 수 있다.","items":[]},{"id":"DAPA_A_2100000233820_ART_5_P3","display_id":"무기체계-디지털-트윈-활용-지침-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"소요군은 디지털 트윈을 활용하여 운영유지단계에서 상시 정비를 통한 고장의 예측ㆍ예방을 원활히 수행할 수 있으며, 이를 통해 운영비를 낮추고 상태기반정비(CBM+)와 연계하여 운영ㆍ가동률을 높일 수 있다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_6","display_id":"무기체계-디지털-트윈-활용-지침-제6조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제2장 디지털 트윈 적용 기본 지침","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"디지털 트윈 적용 기본원칙","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_6_P0","display_id":"무기체계-디지털-트윈-활용-지침-제6조","paragraph_number":"","paragraph_index":null,"content":"디지털 트윈은 무기체계 연구개발사업의 단계 중 체계개발단계에서 적용할 수 있으며, 이에 대한 기본원칙은 다음 각 호와 같다.","items":[{"id":"DAPA_A_2100000233820_ART_6_P0_I1","display_id":"무기체계-디지털-트윈-활용-지침-제6조-제1호","item_number":"1","content":"기술진보 대응기술 발전의 가속화에 따른 무기체계 연구개발사업의 신뢰성 및 경쟁력 확보 등을 위해 신기술 적용","subitems":[]},{"id":"DAPA_A_2100000233820_ART_6_P0_I2","display_id":"무기체계-디지털-트윈-활용-지침-제6조-제2호","item_number":"2","content":"성능 최적화무기체계 연구개발사업 간 작전요구성능, 기술적ㆍ부수적 성능 등을 충족시킬 수 있도록 디지털 트윈 기반의 업무 수행","subitems":[]},{"id":"DAPA_A_2100000233820_ART_6_P0_I3","display_id":"무기체계-디지털-트윈-활용-지침-제6조-제3호","item_number":"3","content":"비용ㆍ인력 절감, 개발기간 단축 및 사업 효율성 향상디지털 트윈 기반의 무기체계 연구개발사업을 통해 시제품 제작 감소 및 반복적인 시험평가 항목 등을 일부 대체함으로써 비용ㆍ인력절감, 개발기간 단축 및 사업효율성 향상 추진","subitems":[]},{"id":"DAPA_A_2100000233820_ART_6_P0_I4","display_id":"무기체계-디지털-트윈-활용-지침-제6조-제4호","item_number":"4","content":"기술자료 작성 및 유지관리무기체계 획득을 위한 디지털 트윈 관련 기술자료는 요구사항, 설계, 시험평가 등에 관한 자료를 포함하여 작성하고 이를 국방표준종합정보시스템(KDSIS)에 특수기술자료로 저장 및 관리","subitems":[]},{"id":"DAPA_A_2100000233820_ART_6_P0_I5","display_id":"무기체계-디지털-트윈-활용-지침-제6조-제5호","item_number":"5","content":"디지털 트윈에 대한 적정성 평가무기체계 성능에 결정적인 영향을 미치거나, 일부 시험평가 항목에 대체되는 체계 및 핵심ㆍ구성품에 적용한 디지털 트윈 기술에 대한 적정성 평가 수행","subitems":[]},{"id":"DAPA_A_2100000233820_ART_6_P0_I6","display_id":"무기체계-디지털-트윈-활용-지침-제6조-제6호","item_number":"6","content":"디지털 트윈 산출물의 확대 운용무기체계 연구개발 단계부터 적용 후 전 수명주기 동안 디지털 트윈 기술을 확대 적용하여 효율적인 운영유지 및 성능개량, 작전분야까지 활용 추진","subitems":[]}]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_7","display_id":"무기체계-디지털-트윈-활용-지침-제7조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제2장 디지털 트윈 적용 기본 지침","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"디지털 트윈 적용 수준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_7_P1","display_id":"무기체계-디지털-트윈-활용-지침-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"디지털 트윈 적용수준은 연구개발비와 기술적 난이도를 고려하여 DTL 0, DTL I, DTL II로 구분한다. 이 경우 기술적 난이도는 체계 복잡도와 체계 위험도를 고려하여 상, 중, 하 중에서 결정한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_7_P2","display_id":"무기체계-디지털-트윈-활용-지침-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 체계개발을 추진하는 경우에는 \"별표 1\"의 기준에 따라 해당 무기체계 연구개발사업의 디지털 트윈 적용수준을 결정하여야 한다. 다만, \"별표 1\"의 기준에도 불구하고 예산, 사업기간 등을 고려하여 디지털 트윈 적용 수준을 조정할 필요가 있는 경우에는 이를 상향하거나 하향할 수 있다.","items":[]},{"id":"DAPA_A_2100000233820_ART_7_P3","display_id":"무기체계-디지털-트윈-활용-지침-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 전항의 단서에 따라 디지털 트윈 적용 수준을 하향하는 때에는 사업추진기본전략(안)에 그 사유를 명시하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_7_P4","display_id":"무기체계-디지털-트윈-활용-지침-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"디지털 트윈 적용수준에 관한 세부사항 및 기준 등은 \"별표 1\"에 따른다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_8","display_id":"무기체계-디지털-트윈-활용-지침-제8조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제2장 디지털 트윈 적용 기본 지침","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"디지털 트윈 적용 대상","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_8_P1","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 디지털 트윈 적용 대상을 체계 단위로 선정하여 적용하여야 한다. 이 경우 통합사업관리팀장은 다음 각 호를 고려하여야 한다.","items":[{"id":"DAPA_A_2100000233820_ART_8_P1_I1","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제1항-제1호","item_number":"1","content":"사용자의 안전성 및 편의성이 요구되는 체계","subitems":[]},{"id":"DAPA_A_2100000233820_ART_8_P1_I2","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제1항-제2호","item_number":"2","content":"체계의 파손 및 결함이 인명피해와 직결되는 체계","subitems":[]},{"id":"DAPA_A_2100000233820_ART_8_P1_I3","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제1항-제3호","item_number":"3","content":"외부 환경요인에 의해 영향을 크게 받는 체계 등","subitems":[]}]},{"id":"DAPA_A_2100000233820_ART_8_P2","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 전항에도 불구하고 「방위사업관리규정」 제79조에 따른 핵심부품ㆍ구성품을 디지털 트윈 적용 대상으로 선정하여 적용할 수 있다. 이 경우 통합사업관리팀장은 연구개발주관 기관 등 관련 기관과의 협의를 통해 다음 각 호를 고려하여 대상 품목을 선정하여야 한다.","items":[{"id":"DAPA_A_2100000233820_ART_8_P2_I1","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제2항-제1호","item_number":"1","content":"시험평가 시 내구도에 영향을 미치는 품목","subitems":[]},{"id":"DAPA_A_2100000233820_ART_8_P2_I2","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제2항-제2호","item_number":"2","content":"1회 시험으로 파손이 우려되는 품목","subitems":[]},{"id":"DAPA_A_2100000233820_ART_8_P2_I3","display_id":"무기체계-디지털-트윈-활용-지침-제8조-제2항-제3호","item_number":"3","content":"고장 발생 시 체계안전에 영향을 미치는 품목 등","subitems":[]}]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MANAGEMENT_DIRECTIVE_ART_79"],"related_regulations":["DAPA_MANAGEMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_9","display_id":"무기체계-디지털-트윈-활용-지침-제9조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제2장 디지털 트윈 적용 기본 지침","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"디지털 트윈 기술 단계","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_9_P1","display_id":"무기체계-디지털-트윈-활용-지침-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"디지털 트윈 기술은 민간과 다른 국방분야의 특성을 고려하여 \"별표 2\"와 같이 5단계(설계, 관제, 체계 가상화, 연계, 결심)로 재정립하며, 디지털 트윈 적용 수준(DTL)에 따라 각 단계를 차별적으로 적용한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_9_P2","display_id":"무기체계-디지털-트윈-활용-지침-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"디지털 트윈 기술 단계 중 설계, 관제, 체계 가상화 단계는 단일객체 대상으로 무기체계 연구개발 사업에 적용한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_9_P3","display_id":"무기체계-디지털-트윈-활용-지침-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"디지털 트윈 기술 단계 중 연계, 결심 단계는 복수객체 대상으로 다수의 무기체계 데이터 등을 연계하여 의사결정을 지원하는 작전분야에 적용한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_9_P4","display_id":"무기체계-디지털-트윈-활용-지침-제9조-제4항","paragraph_number":"④","paragraph_index":4,"content":"디지털 트윈 기술 단계에 관한 세부 사항은 \"별표 2\"에 따른다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_10","display_id":"무기체계-디지털-트윈-활용-지침-제10조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제2장 디지털 트윈 적용 기본 지침","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"디지털 트윈 지원단 구성 및 운영","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_10_P1","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업정책국장(방위사업분석과)은 소요군, 국과연, 기품원 등을 포함한 내부 전문가(10명 내) 및 관련 기관으로부터 추천을 받은 외부 전문가(2~3명)로 구성된 디지털 트윈 지원단(비상설)을 운영할 수 있다. 다만, 제7조에 따른 디지털 트윈 적용수준이 DTL II인 경우, 방위사업정책국장(방위사업분석과)은 디지털 트윈 지원단은 운영하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_10_P2","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전항 단서에도 불구하고 시범사업기간 동안에는 디지털 트윈 지원단은 디지털 트윈 적용수준과 관계없이 시범사업을 주관(디지털 트윈과 관련한 각종 산출물 및 근거 자료 검토 등 포함)하고, 시범사업이 종료된 후에는 이 조에 따른 업무 등을 수행한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_10_P3","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 제7조제4항에 따라 연구개발사업에 대한 디지털 트윈 지원단의 운영이 결정된 경우에는 디지털 트윈 관련 산출물 및 근거 자료 제공 등 디지털 트윈 지원단의 요청에 대하여 협조하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_10_P4","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"디지털 트윈 지원단은 다음 각 호의 사항을 수행한다.","items":[{"id":"DAPA_A_2100000233820_ART_10_P4_I1","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제4항-제1호","item_number":"1","content":"디지털 트윈 적용수준(DTL Ⅱ)에 대한 각종 산출물 및 근거 자료 검토","subitems":[]},{"id":"DAPA_A_2100000233820_ART_10_P4_I2","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제4항-제2호","item_number":"2","content":"디지털 트윈 적용수준 DTL Ⅱ일 경우 제4조제9호가목부터 사목까지의 사항에 대한 기술지원 및 검토","subitems":[]},{"id":"DAPA_A_2100000233820_ART_10_P4_I3","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제4항-제3호","item_number":"3","content":"디지털 트윈 가상실험에 대한 적정성 평가 수행","subitems":[]}]},{"id":"DAPA_A_2100000233820_ART_10_P5","display_id":"무기체계-디지털-트윈-활용-지침-제10조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"방위사업정책국장(방위사업분석과)는 필요한 경우에는 기품원(국기연)의 협조 및 지원을 받아 전항 본문 및 각 호의 사항을 수행할 수 있다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000233820_ART_7","DAPA_A_2100000233820_ART_4"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_11","display_id":"무기체계-디지털-트윈-활용-지침-제11조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"선행연구 및 사업추진기본전략 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_11_P1","display_id":"무기체계-디지털-트윈-활용-지침-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업정책국장(선행연구과)은 「방위사업관리규정」 제36조에 따른 선행연구 수행 시, 디지털 트윈과 관련하여 통합사업관리팀장이 요청하는 경우, 이를 선행연구계획서에 포함하여 작성하고, 선행연구 수행기관에 통보할 수 있다.","items":[]},{"id":"DAPA_A_2100000233820_ART_11_P2","display_id":"무기체계-디지털-트윈-활용-지침-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"선행연구 수행기관은 선행연구 조사ㆍ분석 수행 중 연구개발사업이 사업추진방법으로 유리하다고 판단되는 경우 디지털 트윈 적용수준(안) 및 적용 대상(안)에 대해 검토한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_11_P3","display_id":"무기체계-디지털-트윈-활용-지침-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 선행연구 조사ㆍ분석 수행 중 도출된 디지털 트윈 적용수준(안) 및 적용 대상(안)에 대해 검토하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_11_P4","display_id":"무기체계-디지털-트윈-활용-지침-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"통합사업관리팀장은 사업추진기본전략을 수립하는 경우에는 디지털 트윈 적용수준 및 적용 대상을 확정하여 반영하여야 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MANAGEMENT_DIRECTIVE_ART_36"],"related_regulations":["DAPA_MANAGEMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_12","display_id":"무기체계-디지털-트윈-활용-지침-제12조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"제안요청 및 제안서 평가","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_12_P1","display_id":"무기체계-디지털-트윈-활용-지침-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 업체주관 연구개발사업의 경우에는 디지털 트윈 적용을 위한 요구사항과 디지털 트윈 활용계획의 작성 및 평가에 관한 사항을 제안요청서에 포함하여야 한다. 이 경우 디지털 트윈 활용계획(안)에 관한 양식은 \"별지 1\"에 따른다.","items":[]},{"id":"DAPA_A_2100000233820_ART_12_P2","display_id":"무기체계-디지털-트윈-활용-지침-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제안서에는 제안요청서에서 요구하는 디지털 트윈 활용계획(안)이 포함되어야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_12_P3","display_id":"무기체계-디지털-트윈-활용-지침-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 업체로부터 접수된 제안서 내 디지털 트윈 활용계획(안)에 대하여 검토(관련 기관에 대한 의견 조회를 포함한다)를 수행하여야 한다. 다만, DTL II인 경우에는 디지털 트윈 지원단의 지원을 받아 본문에 따른 검토를 수행할 수 있다.","items":[]},{"id":"DAPA_A_2100000233820_ART_12_P4","display_id":"무기체계-디지털-트윈-활용-지침-제12조-제4항","paragraph_number":"④","paragraph_index":4,"content":"통합사업관리팀장은 업체로부터 접수된 제안서와 함께 전항에 따른 검토 결과를 제안서평가팀에 제출하며, 디지털 트윈 활용계획(안)을 제안서 평가 요소에 반영하여 평가한다. 이 경우 통합사업관리팀장은 타당성 및 가용성, 효과성 등을 고려하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_12_P5","display_id":"무기체계-디지털-트윈-활용-지침-제12조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"국과연주관 연구개발사업은 시제 업체 선정 시 제1항부터 제4항까지의 절차를 준용한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["제안서","협상에 의한 계약"]},{"id":"DAPA_A_2100000233820_ART_13","display_id":"무기체계-디지털-트윈-활용-지침-제13조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"체계개발기본계획 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_13_P1","display_id":"무기체계-디지털-트윈-활용-지침-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 제11조제4항에 따라 확정된 디지털 트윈 적용수준 및 적용 대상을 체계개발기본계획에 반영한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_13_P2","display_id":"무기체계-디지털-트윈-활용-지침-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전항에도 불구하고 함정사업의 경우에는 상세설계 및 함건조 기본계획에 디지털 트윈 적용수준 및 적용 대상을 반영한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000233820_ART_11"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_14","display_id":"무기체계-디지털-트윈-활용-지침-제14조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"체계개발실행계획 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_14_P1","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"통합사업관리팀장은 연구개발업체로 하여금 체계개발기본계획에 반영된 디지털 트윈 적용수준 및 적용 대상과 연구개발업체가 제안서와 함께 제출한 디지털 트윈 활용계획(안)을 포함하여 체계개발실행계획서를 작성하도록 하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_14_P2","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전항에 따른 디지털 트윈 활용계획(안)에는 다음 각 호의 사항이 반영되어야 한다.","items":[{"id":"DAPA_A_2100000233820_ART_14_P2_I1","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제2항-제1호","item_number":"1","content":"디지털 트윈 활용 목적 및 범위","subitems":[]},{"id":"DAPA_A_2100000233820_ART_14_P2_I2","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제2항-제2호","item_number":"2","content":"디지털 트윈 추진전략","subitems":[]},{"id":"DAPA_A_2100000233820_ART_14_P2_I3","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제2항-제3호","item_number":"3","content":"디지털 트윈 활용방안","subitems":[]},{"id":"DAPA_A_2100000233820_ART_14_P2_I4","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제2항-제4호","item_number":"4","content":"디지털 트윈 자원관리","subitems":[]},{"id":"DAPA_A_2100000233820_ART_14_P2_I5","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제2항-제5호","item_number":"5","content":"디지털 트윈 적용을 위한 기술적 요구사항 등","subitems":[]}]},{"id":"DAPA_A_2100000233820_ART_14_P3","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제1항 및 제2항에도 불구하고 함정사업의 경우에는 상세설계 및 함건조 기본계획(실행계획)에 디지털 트윈 적용수준 및 적용 대상과 제2항 각 호 사항이 반영되어야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_14_P4","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제4항","paragraph_number":"④","paragraph_index":4,"content":"국과연주관 연구개발사업의 경우에는 제1항 및 제2항을 준용하여 국과연이 체계개발실행계획서를 작성한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_14_P5","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"통합사업관리팀장은 체계개발실행계획서에 포함된 디지털 트윈 활용계획(안)과 제2항 각 호의 사항 등에 대하여 관련 기관 및 디지털 트윈 지원단 등에 검토를 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000233820_ART_14_P6","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"디지털 트윈 활용계획은 「방위사업관리규정」 제77조에 따라 체계개발실행계획서가 확정되는 때에 확정된다.","items":[]},{"id":"DAPA_A_2100000233820_ART_14_P7","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"통합사업관리팀장은 연구개발을 수행하는 동안 디지털 트윈 활용계획을 최신화하여 관리하여야 하며, 디지털 트윈 활용계획에 따라 연구개발을 수행하는 동안 계획된 디지털 트윈 자원을 확보하고 활용여부를 확인ㆍ감독하여야 한다","items":[]},{"id":"DAPA_A_2100000233820_ART_14_P8","display_id":"무기체계-디지털-트윈-활용-지침-제14조-제8항","paragraph_number":"⑧","paragraph_index":8,"content":"연구개발주관기관은 연구개발을 착수한 이후에 디지털 트윈 활용계획을 변경하고자 하는 경우에는 통합사업관리팀장의 승인을 받아 이를 연구개발에 적용할 수 있다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MANAGEMENT_DIRECTIVE_ART_77"],"related_regulations":["DAPA_MANAGEMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_15","display_id":"무기체계-디지털-트윈-활용-지침-제15조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"예비시험평가기본계획서 작성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_15_P1","display_id":"무기체계-디지털-트윈-활용-지침-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"연구개발주관기관은 체계개발실행계획서 등을 참고하여 디지털 트윈을 활용한 시험평가계획을 포함한 예비시험평가기본계획서를 통합사업관리팀장에게 제출한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_15_P2","display_id":"무기체계-디지털-트윈-활용-지침-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 예비시험평가기본계획서에 디지털 트윈을 활용한 시험평가계획이 포함되어 있는지와 해당 계획을 검토한 후, 이를 체계개발실행계획서와 함께 합동참모본부(이하 \"합참\"이라 한다)에 제출한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_16","display_id":"무기체계-디지털-트윈-활용-지침-제16조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"16","article_label":"제16조","article_title":"개발시험평가계획서 수립","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_16_P1","display_id":"무기체계-디지털-트윈-활용-지침-제16조-제1항","paragraph_number":"①","paragraph_index":1,"content":"연구개발주관기관은 가혹한 시험환경, 반복적인 평가 등으로 인해 시험평가가 제한 또는 제약되는 항목 등을 대상으로 디지털 트윈을 활용한 개발시험평가를 실시할 수 있다.","items":[]},{"id":"DAPA_A_2100000233820_ART_16_P2","display_id":"무기체계-디지털-트윈-활용-지침-제16조-제2항","paragraph_number":"②","paragraph_index":2,"content":"연구개발주관기관은 체계개발실행계획서 및 시험평가기본계획서에 근거하여 개발시험평가계획(안)을 작성하고 이를 통합사업관리팀에게 제출한다. 이 경우 연구개발주관기관은 디지털 트윈을 활용한 개발시험평가가 가능하다고 판단되는 경우에는 이를 개발시험평가계획(안)에 반영하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_16_P3","display_id":"무기체계-디지털-트윈-활용-지침-제16조-제3항","paragraph_number":"③","paragraph_index":3,"content":"연구개발주관기관은 디지털 트윈을 활용한 개발시험평가를 수행하게 된 경우에는 DTL II인 경우에 한하여 제17조에 따른 가상실험에 대하여 자체적으로 적정성 평가를 실시하고 이에 대한 결과를 개발시험평가계획(안)에 포함하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_16_P4","display_id":"무기체계-디지털-트윈-활용-지침-제16조-제4항","paragraph_number":"④","paragraph_index":4,"content":"통합사업관리팀장은 전항에 따른 개발시험평가계획(안)을 검토하여 개발시험평가 착수 2개월 전까지 합참에 제출한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000233820_ART_17"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_17","display_id":"무기체계-디지털-트윈-활용-지침-제17조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"17","article_label":"제17조","article_title":"가상실험","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_17_P1","display_id":"무기체계-디지털-트윈-활용-지침-제17조-제1항","paragraph_number":"①","paragraph_index":1,"content":"제11조에 따라 확정된 디지털 트윈 적용수준(DTL)이 II인 경우에는 가상실험을 수행함을 원칙으로 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_17_P2","display_id":"무기체계-디지털-트윈-활용-지침-제17조-제2항","paragraph_number":"②","paragraph_index":2,"content":"연구개발주관기관은 가상실험을 수행하는 대상사업(DTL II)에 한하여 가상실험계획(안)을 수립하고 이를 상세설계검토(CDR) 전까지 통합사업관리팀장에게 제출하여야 한다. 이 경우 통합사업관리팀장은 관련 기관 및 디지털 트윈 지원단 등에 가상실험계획(안)에 대한 검토를 요청할 수 있다.","items":[]},{"id":"DAPA_A_2100000233820_ART_17_P3","display_id":"무기체계-디지털-트윈-활용-지침-제17조-제3항","paragraph_number":"③","paragraph_index":3,"content":"통합사업관리팀장은 상세설계검토(CDR) 후 1개월 이내에 가상실험계획을 확정하여 연구개발주관기관 및 관련 기관에 통보한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_17_P4","display_id":"무기체계-디지털-트윈-활용-지침-제17조-제4항","paragraph_number":"④","paragraph_index":4,"content":"연구개발주관기관은 확정된 가상실험계획에 따라 가상실험을 수행한 후 시험 및 결과를 반영한 가상실험결과보고서를 통합사업관리팀장에게 제출하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_17_P5","display_id":"무기체계-디지털-트윈-활용-지침-제17조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"통합사업관리팀장은 가상실험에 대한 신뢰성 제고를 위하여 디지털 트윈 지원단에 적정성 평가 수행을 요청하며, 디지털 트윈 지원단은 이에 대한 적정성 평가 후 결과를 통합사업관리팀장에게 제출한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000233820_ART_11"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_18","display_id":"무기체계-디지털-트윈-활용-지침-제18조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제3장 연구개발단계별 디지털 트윈 적용","section":"","subsection":"","article_number":"18","article_label":"제18조","article_title":"형상확인","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_18_P0","display_id":"무기체계-디지털-트윈-활용-지침-제18조","paragraph_number":"","paragraph_index":null,"content":"연구개발주관기관은 필요한 경우에는 디지털 트윈 적용 대상에 대하여 「방위사업관리규정」 제79조에 따른 기능적ㆍ물리적 형상 확인을 수행할 수 있다. 이 경우 연구개발주관기관은 확인 결과를 통합사업관리팀장에게 제출하여야 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_MANAGEMENT_DIRECTIVE_ART_79"],"related_regulations":["DAPA_MANAGEMENT_DIRECTIVE"],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_19","display_id":"무기체계-디지털-트윈-활용-지침-제19조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제4장 디지털 트윈 자원, 산출물 관리 및 발전","section":"","subsection":"","article_number":"19","article_label":"제19조","article_title":"디지털 트윈 활용결과 분석","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_19_P1","display_id":"무기체계-디지털-트윈-활용-지침-제19조-제1항","paragraph_number":"①","paragraph_index":1,"content":"연구개발주관기관은 무기체계 연구개발사업에 디지털 트윈을 활용하게 된 경우에는 체계개발결과보고서에 디지털 트윈 활용 결과를 포함하여야 한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_19_P2","display_id":"무기체계-디지털-트윈-활용-지침-제19조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 연구개발주관기관으로부터 디지털 트윈 활용 결과를 제출받은 경우에는 국과연, 기품원 또는 신속원 등에 이에 대한 기술검토를 요청하며, 연구개발주관기관은 해당 검토 결과를 체계개발결과보고서에 반영하여야 한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_ART_20","display_id":"무기체계-디지털-트윈-활용-지침-제20조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"제4장 디지털 트윈 자원, 산출물 관리 및 발전","section":"","subsection":"","article_number":"20","article_label":"제20조","article_title":"기술자료의 작성 및 관리","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_ART_20_P1","display_id":"무기체계-디지털-트윈-활용-지침-제20조-제1항","paragraph_number":"①","paragraph_index":1,"content":"연구개발주관기관은 무기체계 연구개발사업에 디지털 트윈 자원을 활용하게 된 경우에는 개발을 완료한 후 디지털 트윈 활용계획에 명시된 기술자료(디지털 트윈 활용결과 등) 산출물을 통합사업관리팀장에게 제출한다.","items":[]},{"id":"DAPA_A_2100000233820_ART_20_P2","display_id":"무기체계-디지털-트윈-활용-지침-제20조-제2항","paragraph_number":"②","paragraph_index":2,"content":"통합사업관리팀장은 국방표준종합정보시스템(KDSIS)에 저장하지 아니한 기술자료 및 산출물을 기품원(국기연)으로 이관하여야 하며, 기품원(국기연)은 필요한 경우 이를 소요군으로 재이관할 수 있다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_SUPP_ART_1","display_id":"무기체계-디지털-트윈-활용-지침-부칙-제1조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일 및 시행범위","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_SUPP_ART_1_P0","display_id":"무기체계-디지털-트윈-활용-지침-부칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 발령한 날부터 시행하는 것을 원칙으로 하되, 이 지침의 전면 시행에 앞서 시범사업에 우선 적용하여 관련 법령 정비 등 보완사항 등을 확인 및 조치한 후 필요성이 인정되는 경우에 무기체계 연구개발 사업에 적용한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제893호, 2023. 12. 28.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000233820_SUPP_ART_2","display_id":"무기체계-디지털-트윈-활용-지침-부칙-제2조","regulation_id":"DAPA_A_2100000233820","regulation_name":"무기체계 디지털 트윈 활용 지침","short_name":"무기체계 디지털 트윈 활용 지침","document_type":"예규","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용례","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000233820_SUPP_ART_2_P0","display_id":"무기체계-디지털-트윈-활용-지침-부칙-제2조","paragraph_number":"","paragraph_index":null,"content":"이 지침은 시행일 이후 선정된 시범사업에 적용한다.","items":[]}],"notes":[],"effective_date":"2023-12-28","revision_date":"2023-12-28","source_file":"무기체계 디지털 트윈 활용 지침.json","source_path":"원문/법제처API/무기체계 디지털 트윈 활용 지침.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제893호, 2023. 12. 28.>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]}]
