[{"id":"DAPA_A_2100000206387_ART_1","display_id":"방위사업청-청원경찰-징계-규정-제1조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_1_P0","display_id":"방위사업청-청원경찰-징계-규정-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 방위사업청에서 근무하는 청원경찰의 징계에 관하여 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_2","display_id":"방위사업청-청원경찰-징계-규정-제2조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"징계권자","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_2_P0","display_id":"방위사업청-청원경찰-징계-규정-제2조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 방위사업청 소속청원경찰(이하 \"청원경찰\"이라 한다)에 대한 징계권을 갖는다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_3","display_id":"방위사업청-청원경찰-징계-규정-제3조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"징계위원회의 설치 및 구성","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_3_P1","display_id":"방위사업청-청원경찰-징계-규정-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청원경찰의 징계에 관한 사항을 심의ㆍ의결하기 위하여 방위사업청에 청원경찰징계위원회(이하 \"징계위원회\"라 한다)를 설치ㆍ운영한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_3_P2","display_id":"방위사업청-청원경찰-징계-규정-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"징계위원회의 구성은 위원장1인과 3인이상 6인이하의 위원으로 구성하되, 위원장은 운영지원과장으로 하고 위원은 방위사업청장이 임명하고, 간사는 비상기획보안팀 청원경찰 담당자가 된다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_4","display_id":"방위사업청-청원경찰-징계-규정-제4조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"징계위원회의 회의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_4_P1","display_id":"방위사업청-청원경찰-징계-규정-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"위원장이 징계위원회를 소집하며 회무를 통리하고 표결권을 가진다.","items":[]},{"id":"DAPA_A_2100000206387_ART_4_P2","display_id":"방위사업청-청원경찰-징계-규정-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"위원장이 부득이한 사유로 직무를 수행할 수 없는 때에는 방위사업청장이 직무대행자를 임명한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_4_P3","display_id":"방위사업청-청원경찰-징계-규정-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"간사는 위원장의 명을 받아 징계에 관한 기록 및 기타 서류를 작성ㆍ처리한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_5","display_id":"방위사업청-청원경찰-징계-규정-제5조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"징계의결의 요구","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_5_P1","display_id":"방위사업청-청원경찰-징계-규정-제5조-제1항","paragraph_number":"①","paragraph_index":1,"content":"징계요구자는 방위사업청차장이 된다.","items":[]},{"id":"DAPA_A_2100000206387_ART_5_P2","display_id":"방위사업청-청원경찰-징계-규정-제5조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업차장은 방위사업청 청원경찰 근무규칙 제21조(징계)에 해당하는 사유가 있다고 인정한 때, 지체없이 징계위원회에 회부 의결을 요구하여야 한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_5_P3","display_id":"방위사업청-청원경찰-징계-규정-제5조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항에 의한 징계요구시에는 별지 제1호서식의 청원경찰징계의결요구서 2부를 작성하여 징계위원회에 징계의결을 요청하여야 한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_5_P4","display_id":"방위사업청-청원경찰-징계-규정-제5조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항의 청원경찰징계의결요구서 중 징계요구권자의 의견란에는 징계양정과 기타 징계심의에 필요한 참고사항 등을 기재하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_6","display_id":"방위사업청-청원경찰-징계-규정-제6조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"징계의 의결기간","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_6_P0","display_id":"방위사업청-청원경찰-징계-규정-제6조","paragraph_number":"","paragraph_index":null,"content":"징계위원회는 제5조의 규정에 의하여 징계의결요구서를 접수한 날로부터 10일 이내에 징계 사항을 심의 의결하여야 한다. 다만, 부득이한 사유가 있을 때에는 당해 징계위원회의 의결로 10일이내의 범위안에서 그 기간을 연장할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_A_2100000206387_ART_5"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_7","display_id":"방위사업청-청원경찰-징계-규정-제7조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"징계심의대상자의 출석 및 서면심사","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_7_P1","display_id":"방위사업청-청원경찰-징계-규정-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"징계위원회(간사)에서는 징계안건을 심의할 일자를 정하고 징계심의대상자에게 별지 제2호서식의 출석요구서에 의하여 징계위원회에 출석할 것을 통지하여야 한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_7_P2","display_id":"방위사업청-청원경찰-징계-규정-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"징계심의대상자가 징계위원회에서 진술을 위한 출석을 원하지 아니할 때에는 진술포기서를 제출케 하여 이를 기록에 첨부하고 서면심사에 의하여 징계 의결 할 수 있다.","items":[]},{"id":"DAPA_A_2100000206387_ART_7_P3","display_id":"방위사업청-청원경찰-징계-규정-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"징계심의 대상자가 2회 이상 출석통지를 한데도 불구하고 정당한 이유없이 출석하지 아니할 때에는 그 사실을 기록에 명기하고(출석통지서 부본첨부) 서면심사에 의하여 징계 의결 할 수 있다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_8","display_id":"방위사업청-청원경찰-징계-규정-제8조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"심문과 진술권","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_8_P1","display_id":"방위사업청-청원경찰-징계-규정-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"징계위원회는 출석한 징계심의대상자에게 징계사유에 해당하는 사실에 관한 심문을 할 수 있고 징계심의상 필요하다고 인정될 때에는 관계인의 출석을 요구하여 필요한 사항을 질문할 수 있다.","items":[]},{"id":"DAPA_A_2100000206387_ART_8_P2","display_id":"방위사업청-청원경찰-징계-규정-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"징계위원회는 징계심의 대상자에게 충분히 진술할 수 있는 기회를 부여하여야 하며, 징계심의대상자는 서면 또는 구두로 자기에게 유리한 사실을 진술하거나 증거를 제출할 수 있다.","items":[]},{"id":"DAPA_A_2100000206387_ART_8_P3","display_id":"방위사업청-청원경찰-징계-규정-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"징계심의대상자는 증인의 심문을 신청할 수 있다. 이 경우 징계위원회는 의결로서 채택여부를 결정하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_9","display_id":"방위사업청-청원경찰-징계-규정-제9조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"징계양정 기준","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_9_P0","display_id":"방위사업청-청원경찰-징계-규정-제9조","paragraph_number":"","paragraph_index":null,"content":"징계위원회에서 징계안건을 심의할 때에는 입증자료의 적ㆍ부 및 징계심의대상자의 소행 평소 근무성적, 공적, 비위동기, 개전의 정 유무등의 정상참작과 징계요구권자의 의견을 종합적으로 검토하여 공무원 징계령 및 공무원 징계령 시행규칙 등에 따라 의결하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_10","display_id":"방위사업청-청원경찰-징계-규정-제10조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"징계위원회의 의결","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_10_P1","display_id":"방위사업청-청원경찰-징계-규정-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"징계위원회의 간사는 징계심의에 앞서 각 위원에게 징계사유 및 동기, 징계요구권자의 의견 등을 충분히 설명하여야 한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_10_P2","display_id":"방위사업청-청원경찰-징계-규정-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"징계위원회의 의결은 위원장을 포함한 위원 과반수의 출석과 출석위원 과반수의 찬성으로 의결하되 의견이 분립되어 출석위원 과반수에 달하지 못할 때에는 출석위원 과반수에 달하기까지 징계심의대상자에게 가장 불리한 의견에 순차 유리한 의견을 가하여 가장 유리한 의견을 합의된 의견으로 본다.","items":[]},{"id":"DAPA_A_2100000206387_ART_10_P3","display_id":"방위사업청-청원경찰-징계-규정-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"징계심의결과에 따른 각 위원의 징계양정 결정방법은 심문과 진술이 끝나고 징계심의 대상자를 퇴장시킨 후 별지 제3호서식의 징계의결투표지에 자기 의견을 해당란에 서명 표기하여야 한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_10_P4","display_id":"방위사업청-청원경찰-징계-규정-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항에서 정한 절차에 따라 징계의견이 결정되면 간사는 별지 제4호서식의 징계의결대장에 등재하고 별지 제5호서식의 징계의결서를 작성하여 징계투표장(위원장과 간사가 간인)을 첨부한 징계의결서 원본과 사본(간사가 작성하였음을 기재) 1통을 작성하여 방위사업청장에게 보고하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_11","display_id":"방위사업청-청원경찰-징계-규정-제11조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"집행","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_11_P1","display_id":"방위사업청-청원경찰-징계-규정-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 징계위원회로부터 징계의결서를 접수하였을 때에는 5일이내에 징계처분을 행한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_11_P2","display_id":"방위사업청-청원경찰-징계-규정-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항의 징계처분을 집행함에 있어서는 별지 제6호서식의 징계처분사유설명서에 징계의결서 사본을 첨부하여 징계의결된 자에게 교부함으로써 이를 행한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_12","display_id":"방위사업청-청원경찰-징계-규정-제12조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"재심청구","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_12_P1","display_id":"방위사업청-청원경찰-징계-규정-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"징계처분을 받은 자가 징계처분이 부당하거나 불리한 처분이라고 인정될 때에는 그 사유 및 자기주장을 뒷받침할 수 있는 입증자료를 첨부하여 비상기획보안팀장을 경유 재심을 청구할 수 있다.","items":[]},{"id":"DAPA_A_2100000206387_ART_12_P2","display_id":"방위사업청-청원경찰-징계-규정-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"비상기획보안팀장은 재심청구를 접수하면 즉시 청장에게 보고하여 징계위원회에 회부하여 재심의하게 하여야 한다. 이때 재심의 위원은 청장이 따로 임명한다.","items":[]},{"id":"DAPA_A_2100000206387_ART_12_P3","display_id":"방위사업청-청원경찰-징계-규정-제12조-제3항","paragraph_number":"③","paragraph_index":3,"content":"재심의 절차 및 의결방법은 일심 때와 같다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":["이의신청"]},{"id":"DAPA_A_2100000206387_ART_13","display_id":"방위사업청-청원경찰-징계-규정-제13조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"서류등의 비치","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_13_P1","display_id":"방위사업청-청원경찰-징계-규정-제13조-제1항","paragraph_number":"①","paragraph_index":1,"content":"청원경찰의 징계에 관한 서류철 및 부책의 종목 다음 각호와 같고 보관 및 처리는 비상기획보안팀장이 행한다.","items":[{"id":"DAPA_A_2100000206387_ART_13_P1_I1","display_id":"방위사업청-청원경찰-징계-규정-제13조-제1항-제1호","item_number":"1","content":"징계의결 요구서류철","subitems":[]},{"id":"DAPA_A_2100000206387_ART_13_P1_I2","display_id":"방위사업청-청원경찰-징계-규정-제13조-제1항-제2호","item_number":"2","content":"징계의결서 및 징계발령서류철","subitems":[]},{"id":"DAPA_A_2100000206387_ART_13_P1_I3","display_id":"방위사업청-청원경찰-징계-규정-제13조-제1항-제3호","item_number":"3","content":"징계의결대장","subitems":[]},{"id":"DAPA_A_2100000206387_ART_13_P1_I4","display_id":"방위사업청-청원경찰-징계-규정-제13조-제1항-제4호","item_number":"4","content":"청경 신상카드 사본1부","subitems":[]}]},{"id":"DAPA_A_2100000206387_ART_13_P2","display_id":"방위사업청-청원경찰-징계-규정-제13조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항 2호 서류철에는 운영지원과로부터 징계위원회에 회부된 징계의결요구서 및 징계의결서 징계발령안을 동일건으로 하여 합철한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_14","display_id":"방위사업청-청원경찰-징계-규정-제14조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"회의의 비공개와 비밀누설금지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_14_P0","display_id":"방위사업청-청원경찰-징계-규정-제14조","paragraph_number":"","paragraph_index":null,"content":"징계위원회의 회의는 공개하지 아니하며, 회의에 참가한 자는 직무상 알게 된 비밀을 누설하여서는 아니 된다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_ART_15","display_id":"방위사업청-청원경찰-징계-규정-제15조","regulation_id":"DAPA_A_2100000206387","regulation_name":"(방위사업청) 청원경찰 징계 규정","short_name":"(방위사업청) 청원경찰 징계 규정","document_type":"훈령","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"재검토기한","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_A_2100000206387_ART_15_P0","display_id":"방위사업청-청원경찰-징계-규정-제15조","paragraph_number":"","paragraph_index":null,"content":"이 규정은 「훈령ㆍ예규등의 발령 및 관리에 관한 규정」에 따라 2021년 12월 1일 기준으로 매 3년이 되는 시점(매 3년째의 11월 30일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.","items":[]}],"notes":[],"effective_date":"2021-11-23","revision_date":"2021-11-23","source_file":"(방위사업청) 청원경찰 징계 규정.json","source_path":"원문/법제처API/(방위사업청) 청원경찰 징계 규정.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_A_2100000206387_SUPP1_PRE","d