[{"id":"DAPA_L_258705_ART_1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제1조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_1_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-제1조","paragraph_number":"","paragraph_index":null,"content":"이 법은 군용항공기가 안전하게 비행할 수 있는지를 인증하는 데 필요한 사항을 정하여 군용항공기의 안전성을 확보하고, 군용항공기 수출을 지원하여 항공산업 발전에 기여함을 목적으로 한다. <개정 2012.12.18>","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18>"],"last_amended":"2012-12-18","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"정의","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_2_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조","paragraph_number":"","paragraph_index":null,"content":"이 법에서 사용하는 용어의 뜻은 다음과 같다. <개정 2012.12.18, 2014.12.30, 2019.4.23>","items":[{"id":"DAPA_L_258705_ART_2_P0_I1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제1호","item_number":"1","content":"\"군용항공기\"란 국군이 사용하거나 군사용으로 국외에 수출하기 위한 다음 각 목의 항공기 및 기기를 말한다.","subitems":[{"id":"DAPA_L_258705_ART_2_P0_I1_S1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제1호-가목","subitem_number":"가","content":"[['가. 다음의 어느 하나에 해당하는 항공기', ' 1) 비행기', ' 2) 회전익항공기', ' 3) 비행선', ' 4) 활공기(滑空機)']]"},{"id":"DAPA_L_258705_ART_2_P0_I1_S2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제1호-나목","subitem_number":"나","content":"무인항공기 등 항공에 사용할 수 있는 기기로서 대통령령으로 정하는 기기"}]},{"id":"DAPA_L_258705_ART_2_P0_I2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제2호","item_number":"2","content":"\"감항성(堪航性)\"이란 군용항공기가 운용범위 내에서 비행안전에 적합하다는 것을 말한다.","subitems":[]},{"id":"DAPA_L_258705_ART_2_P0_I3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제3호","item_number":"3","content":"\"감항인증(堪航認證)\"이란 군용항공기가 감항성을 가지고, 그 성능과 기능을 발휘할 수 있음에 대한 정부의 인증을 말한다.","subitems":[]},{"id":"DAPA_L_258705_ART_2_P0_I4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제4호","item_number":"4","content":"\"군용항공기 사업\"이란 다음 각 목의 어느 하나에 해당하는 사업을 말한다.","subitems":[{"id":"DAPA_L_258705_ART_2_P0_I4_S1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제4호-가목","subitem_number":"가","content":"군용항공기를 연구ㆍ개발하는 사업"},{"id":"DAPA_L_258705_ART_2_P0_I4_S2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제4호-나목","subitem_number":"나","content":"군용항공기를 구매하는 사업"},{"id":"DAPA_L_258705_ART_2_P0_I4_S3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제4호-다목","subitem_number":"다","content":"군용항공기를 개조ㆍ개량하는 사업"},{"id":"DAPA_L_258705_ART_2_P0_I4_S4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제4호-라목","subitem_number":"라","content":"군용항공기의 부품ㆍ구성품 및 무기ㆍ장비 등을 제작ㆍ개조 또는 개량하여 군용항공기에 장착하는 사업"},{"id":"DAPA_L_258705_ART_2_P0_I4_S5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제4호-마목","subitem_number":"마","content":"삭제 <2012.12.18>"}]},{"id":"DAPA_L_258705_ART_2_P0_I5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조-제5호","item_number":"5","content":"\"사업관리기관\"이란 개별 군용항공기 사업의 모든 과정을 관리하는 방위사업청 소속 기관, 육군ㆍ해군ㆍ공군(이하 \"각 군\"이라 한다), 정부출연기관 또는 군용항공기 관련 업체 등과 이들로부터 군용항공기 사업에 관한 권한을 위임ㆍ위탁받은 자를 말한다.","subitems":[]}]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18, 2014.12.30, 2019.4.23>","<2012.12.18>"],"last_amended":"2019-04-23","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_2_2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조의2","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"2의2","article_label":"제2조의2","article_title":"경찰용ㆍ세관용 항공기의 감항인증","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_2_2_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-제2조의2","paragraph_number":"","paragraph_index":null,"content":"이 법의 감항인증에 관한 규정은 대통령령으로 정하는 경찰용 및 세관용 항공기(이하 \"경찰용ㆍ세관용 항공기\"라 한다)에 준용한다. 이 경우 \"군용항공기\"는 \"경찰용ㆍ세관용 항공기\"로 본다.","items":[]}],"notes":["[본조신설 2012.12.18]"],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["[본조신설 2012.12.18]"],"last_amended":"2012-12-18","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제3조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"표준감항인증기준의 고시","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_3_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제3조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 군용항공기 사업 계획의 수립 및 사업추진 단계별로 군용항공기의 비행안전성을 확보하기 위하여 사업관리기관의 장이 군용항공기 사업을 추진하는 경우에 일반적으로 지켜야 할 기술기준 등(이하 \"표준감항인증기준\"이라 한다)을 정하여 고시하여야 한다. <개정 2012.12.18>","items":[]},{"id":"DAPA_L_258705_ART_3_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제3조-제2항","paragraph_number":"②","paragraph_index":2,"content":"표준감항인증기준의 작성 및 변경 절차 등에 필요한 사항은 국방부령으로 정한다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18>"],"last_amended":"2012-12-18","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"감항인증의 절차 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_4_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"사업관리기관의 장은 군용항공기에 관하여 국방부령으로 정하는 바에 따라 방위사업청장에게 감항인증을 신청하여야 한다. <개정 2012.12.18>","items":[]},{"id":"DAPA_L_258705_ART_4_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 감항인증 신청을 받은 방위사업청장은 기종별 감항인증기준 작성지침을 포함한 감항인증 계획 작성지침을 사업관리기관의 장에게 통보하여야 한다. <개정 2012.12.18>","items":[]},{"id":"DAPA_L_258705_ART_4_P3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제3항","paragraph_number":"③","paragraph_index":3,"content":"사업관리기관의 장은 제2항의 감항인증 계획 작성지침에 따라 기종별 감항인증 계획안을 수립하고 이를 방위사업청장에게 제출하여야 한다. 이 경우 사업관리기관의 장은 방위사업청장에게 기종별 감항인증 계획의 수립에 필요한 지원 또는 협조를 요청할 수 있다. <개정 2012.12.18>","items":[]},{"id":"DAPA_L_258705_ART_4_P4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 제3항에 따라 사업관리기관의 장이 수립한 기종별 감항인증 계획안을 제7조에 따른 감항인증심의위원회의 심의를 거쳐 확정하고, 그 결과를 해당 사업관리기관의 장, 군용항공기 사업과 관련된 각 군 참모총장 및 그 밖에 감항인증과 관련된 기관의 장에게 통보하여야 한다. <개정 2012.12.18>","items":[]},{"id":"DAPA_L_258705_ART_4_P5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"방위사업청장은 제4항에 따라 확정된 기종별 감항인증 계획에 따라 군용항공기 사업이 기종별 감항인증기준에 적합한지에 대하여 다음 각 호의 순서에 따른 단계별 감항성 심사를 하여야 한다. 다만, 제2조제4호나목의 구매사업 등 대통령령으로 정하는 사업의 경우에는 감항성 심사의 전부 또는 일부를 생략할 수 있다. <개정 2012.12.18, 2014.12.30>","items":[{"id":"DAPA_L_258705_ART_4_P5_I1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제5항-제1호","item_number":"1","content":"형식인증: 군용항공기 설계가 기종별 감항인증기준을 충족하여 비행안전에 적합하다는 인증","subitems":[]},{"id":"DAPA_L_258705_ART_4_P5_I2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제5항-제2호","item_number":"2","content":"생산확인: 군용항공기가 설계에 맞게 생산될 수 있는 기술, 설비, 인력 및 품질보증체계 등을 갖추고 있는지에 대한 확인","subitems":[]}]},{"id":"DAPA_L_258705_ART_4_P6","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"방위사업청장은 제5항에 따른 감항성 심사를 한 후 제7조에 따른 감항인증심의위원회의 심의를 거쳐 단계별 감항인증 여부를 결정하고, 최종 감항인증 결과를 사업관리기관의 장, 각 군 참모총장 및 그 밖에 감항인증과 관련된 기관의 장에게 통보하여야 한다.","items":[]},{"id":"DAPA_L_258705_ART_4_P7","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조-제7항","paragraph_number":"⑦","paragraph_index":7,"content":"방위사업청장은 감항인증서 발급이 필요하다고 판단되는 경우 기종별 감항인증서를 발급하여야 한다. 감항인증서 발급 등에 필요한 사항은 국방부령으로 정한다. <개정 2012.12.18>","items":[]}],"notes":["[제5조에서 이동, 종전 제4조는 제5조로 이동 <2012.12.18>]"],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18>","<개정 2012.12.18, 2014.12.30>","[제5조에서 이동, 종전 제4조는 제5조로 이동 <2012.12.18>]"],"last_amended":"2014-12-30","related_articles":["DAPA_L_258705_ART_7","DAPA_L_258705_ART_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_4_2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조의2","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"4의2","article_label":"제4조의2","article_title":"연구 등 목적의 감항인증","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_4_2_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"제4조에도 불구하고 연구ㆍ시험ㆍ수출ㆍ홍보 등을 위하여 한시적으로 운용하는 군용항공기에 관하여 감항인증을 받고자 하는 사업관리기관의 장은 국방부령으로 정하는 바에 따라 방위사업청장에게 감항인증을 신청할 수 있다.","items":[]},{"id":"DAPA_L_258705_ART_4_2_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제4조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 제1항에 따른 신청을 검토하여 군용항공기가 비행에 안전하다고 판단되는 경우 비행 제한사항 및 비행안전을 위한 조건 등 국방부령으로 정하는 사항을 포함한 감항인증서를 신청기관의 장에게 발급하여야 한다. 이 경우 군용항공기의 감항성에 중대한 영향을 미치게 될 경우에는 제7조에 따른 감항인증심의위원회의 심의ㆍ의결을 거쳐야 한다.","items":[]}],"notes":["[본조신설 2019.4.23]"],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["[본조신설 2019.4.23]"],"last_amended":"2019-04-23","related_articles":["DAPA_L_258705_ART_4","DAPA_L_258705_ART_7"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"표준감항인증기준 등의 적용 제외","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_5_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 다음 각 호의 어느 하나에 해당하는 경우 표준감항인증기준이나 제4조에 따른 감항인증 절차의 전부 또는 일부를 적용하지 아니할 수 있다. 이 경우 방위사업청장은 감항인증에 필요한 기준과 절차를 별도로 정할 수 있다. <개정 2012.12.18>","items":[{"id":"DAPA_L_258705_ART_5_P0_I1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조-제1호","item_number":"1","content":"수출용 군용항공기에 대하여 해당 군용항공기의 수입국에서 감항인증을 요청하지 아니하거나 표준감항인증기준과 다른 기준을 적용하도록 요청하는 경우","subitems":[]},{"id":"DAPA_L_258705_ART_5_P0_I2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조-제2호","item_number":"2","content":"국외에서 수입하는 군용항공기로서 그 군용항공기를 제작한 국가에서 감항인증 또는 이에 준하는 증명을 받은 경우","subitems":[]},{"id":"DAPA_L_258705_ART_5_P0_I3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조-제3호","item_number":"3","content":"제작국가에서 감항인증 또는 이에 준하는 증명을 받은 군용항공기 부품ㆍ구성품 등을 수입하여 국군이 운용하는 같은 계열의 군용항공기에 장착하는 경우","subitems":[]},{"id":"DAPA_L_258705_ART_5_P0_I3_2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조-제3호의2","item_number":"3의2","content":"2009년 7월 31일 이전부터 운용 중인 군용항공기를 제2조제4호다목 또는 라목에 따라 개조ㆍ개량하거나 부품ㆍ구성품 및 무기ㆍ장비 등을 장착함에 있어서 개조ㆍ개량 또는 장착되는 부분 외의 경우","subitems":[]},{"id":"DAPA_L_258705_ART_5_P0_I4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조-제4호","item_number":"4","content":"그 밖에 이 법에 따른 표준감항인증기준이나 제4조에 따른 감항인증 절차를 적용하는 것이 부적당한 군용항공기 사업으로서 대통령령으로 정하는 군용항공기 사업의 경우","subitems":[]}]}],"notes":["[제목개정 2012.12.18][제4조에서 이동, 종전 제5조는 제4조로 이동 <2012.12.18>]"],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18>","[제목개정 2012.12.18][제4조에서 이동, 종전 제5조는 제4조로 이동 <2012.12.18>]"],"last_amended":"2012-12-18","related_articles":["DAPA_L_258705_ART_4","DAPA_L_258705_ART_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_5_2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조의2","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"5의2","article_label":"제5조의2","article_title":"감항성 유지 및 기술 지원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_5_2_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조의2-제1항","paragraph_number":"①","paragraph_index":1,"content":"각 군 참모총장 등 군용항공기를 운용하는 기관의 장은 군용항공기가 기종별 감항인증기준(제4조제4항에 따라 확정되는 감항인증기준을 말한다)에 적합하도록 감항성을 유지하여야 한다.","items":[]},{"id":"DAPA_L_258705_ART_5_2_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제5조의2-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 군용항공기를 운용하는 기관의 장에게 감항성 유지에 필요한 기술 지원을 할 수 있다.","items":[]}],"notes":["[본조신설 2019.4.23]"],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["[본조신설 2019.4.23]"],"last_amended":"2019-04-23","related_articles":["DAPA_L_258705_ART_4"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_6","display_id":"군용항공기-비행안전성-인증에-관한-법률-제6조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"수수료","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_6_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-제6조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 군용항공기에 대한 감항인증 또는 감항인증서의 발급을 신청하는 자에게 국방부령으로 정하는 바에 따라 수수료를 부과할 수 있다. <개정 2012.12.18>","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18>"],"last_amended":"2012-12-18","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_7","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"감항인증심의위원회의 설치 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_7_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"감항인증 및 관련 주요정책과 감항인증 심사에 관한 사항을 심의ㆍ조정하기 위하여 방위사업청장 소속으로 감항인증심의위원회(이하 \"인증위원회\"라 한다)를 둔다.","items":[]},{"id":"DAPA_L_258705_ART_7_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"인증위원회는 다음 각 호의 사항을 심의ㆍ조정한다. <개정 2012.12.18>","items":[{"id":"DAPA_L_258705_ART_7_P2_I1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항-제1호","item_number":"1","content":"감항인증과 관련된 주요 정책의 수립 및 변경에 관한 사항","subitems":[]},{"id":"DAPA_L_258705_ART_7_P2_I2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항-제2호","item_number":"2","content":"표준감항인증기준의 작성 및 변경 고시에 관한 사항","subitems":[]},{"id":"DAPA_L_258705_ART_7_P2_I3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항-제3호","item_number":"3","content":"기종별 감항인증 계획의 확정에 관한 사항","subitems":[]},{"id":"DAPA_L_258705_ART_7_P2_I4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항-제4호","item_number":"4","content":"감항성 심사 결과의 확인에 관한 사항","subitems":[]},{"id":"DAPA_L_258705_ART_7_P2_I5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항-제5호","item_number":"5","content":"감항인증과 관련된 기관 간의 업무조정에 관한 사항","subitems":[]},{"id":"DAPA_L_258705_ART_7_P2_I6","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항-제6호","item_number":"6","content":"삭제<2012.12.18>","subitems":[]},{"id":"DAPA_L_258705_ART_7_P2_I7","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제2항-제7호","item_number":"7","content":"그 밖에 방위사업청장이 감항인증과 관련하여 인증위원회의 심의ㆍ조정이 필요하다고 인정하는 사항","subitems":[]}]},{"id":"DAPA_L_258705_ART_7_P3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제3항","paragraph_number":"③","paragraph_index":3,"content":"인증위원회는 위원장 1명을 포함한 13명 이내의 위원으로 구성하되, 위원장은 방위사업청 차장이 되고 위원은 관계 중앙행정기관의 공무원, 각 군 및 감항인증에 대한 학식과 경험이 풍부한 자 중에서 방위사업청장이 임명하거나 위촉한다. <개정 2019.4.23>","items":[]},{"id":"DAPA_L_258705_ART_7_P4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제4항","paragraph_number":"④","paragraph_index":4,"content":"인증위원회의 업무를 지원하기 위하여 인증위원회에 감항인증 기술실무위원회(이하 \"실무위원회\"라 한다)를 둘 수 있다.","items":[]},{"id":"DAPA_L_258705_ART_7_P5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제7조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제1항부터 제4항까지에서 규정한 사항 외에 인증위원회 및 실무위원회의 구성 및 운영에 필요한 사항은 대통령령으로 정한다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18>","<2012.12.18>","<개정 2019.4.23>"],"last_amended":"2019-04-23","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_8","display_id":"군용항공기-비행안전성-인증에-관한-법률-제8조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"감항인증 자문위원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_8_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 감항인증에 관한 업무에 대하여 자문하기 위하여 방위사업청장 소속으로 5명 이내의 자문위원을 둘 수 있다.","items":[]},{"id":"DAPA_L_258705_ART_8_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따른 자문위원의 위촉에 필요한 사항은 방위사업청장이 정한다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_9","display_id":"군용항공기-비행안전성-인증에-관한-법률-제9조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"9","article_label":"제9조","article_title":"감항인증 기술 자료의 지원ㆍ유지","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_9_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제9조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 군용항공기의 비행안전성을 지속적으로 확보하기 위하여 감항인증과 관련된 기술 자료를 관리ㆍ유지하여야 한다.","items":[]},{"id":"DAPA_L_258705_ART_9_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제9조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 각 군 참모총장, 사업관리기관 또는 군용항공기의 구매자가 요청할 경우 제1항에 따라 관리ㆍ유지되는 기술 자료를 지원할 수 있다.","items":[]},{"id":"DAPA_L_258705_ART_9_P3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제9조-제3항","paragraph_number":"③","paragraph_index":3,"content":"각 군 참모총장 및 그 밖에 감항인증과 관련된 기관의 장은 감항인증을 받은 군용항공기의 비행안전성에 영향을 미칠 수 있는 군용항공기 또는 그 부품ㆍ구성품, 장비 등의 개조ㆍ개량, 형상 및 구조변경 등을 하는 경우에는 방위사업청장에게 그 내용과 관련 기술 자료를 통보하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_10","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"10","article_label":"제10조","article_title":"군용항공기 감항인증 전문기관의 지정 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_10_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 감항인증 업무의 전문성과 신뢰성을 확보하기 위하여 대통령령으로 정하는 기준에 따라 군용항공기 감항인증 전문기관(이하 \"전문기관\"이라 한다)을 지정ㆍ고시할 수 있다.","items":[]},{"id":"DAPA_L_258705_ART_10_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제2항","paragraph_number":"②","paragraph_index":2,"content":"전문기관은 다음 각 호의 업무를 수행한다.","items":[{"id":"DAPA_L_258705_ART_10_P2_I1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제2항-제1호","item_number":"1","content":"감항인증 전문인력과 능력의 확보 및 유지관리","subitems":[]},{"id":"DAPA_L_258705_ART_10_P2_I2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제2항-제2호","item_number":"2","content":"제11조에 따른 주관기관의 감항인증에 필요한 업무 지원ㆍ협조","subitems":[]},{"id":"DAPA_L_258705_ART_10_P2_I3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제2항-제3호","item_number":"3","content":"그 밖에 방위사업청장이 감항인증 업무와 관련하여 필요하다고 인정하는 사항","subitems":[]}]},{"id":"DAPA_L_258705_ART_10_P3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 전문기관에 종사하는 자가 감항인증 업무의 원활한 수행을 위하여 대통령령으로 정하는 자격과 능력을 구비하고 있는지 정기적으로 확인하여야 한다.","items":[]},{"id":"DAPA_L_258705_ART_10_P4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 전문기관이 다음 각 호의 어느 하나에 해당하면 대통령령으로 정하는 바에 따라 전문기관의 지정을 취소하거나 전문기관으로서의 업무를 1년의 범위에서 정지할 수 있다. 다만, 제1호에 해당하는 경우에는 전문기관의 지정을 취소하여야 한다.","items":[{"id":"DAPA_L_258705_ART_10_P4_I1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제4항-제1호","item_number":"1","content":"거짓이나 그 밖의 부정한 방법으로 전문기관의 지정을 받은 경우","subitems":[]},{"id":"DAPA_L_258705_ART_10_P4_I2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제4항-제2호","item_number":"2","content":"제1항에 따른 전문기관 지정 기준을 충족하지 못하게 된 경우","subitems":[]}]},{"id":"DAPA_L_258705_ART_10_P5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제10조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"방위사업청장은 제4항에 따라 전문기관의 지정을 취소하려는 경우에는 청문을 실시하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_258705_ART_11"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_11","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"11","article_label":"제11조","article_title":"감항인증 주관기관의 지정 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_11_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 감항인증 업무의 객관성ㆍ효율성ㆍ전문성을 보장하기 위하여 제4조제1항 또는 제4조의2제1항에 따라 감항인증을 신청 받은 군용항공기의 종류 및 특성을 고려하여 군용항공기 사업별로 전문기관 중 1개 기관을 감항인증 주관기관(이하 \"주관기관\"이라 한다)으로 지정할 수 있다. <개정 2019.4.23>","items":[]},{"id":"DAPA_L_258705_ART_11_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제2항","paragraph_number":"②","paragraph_index":2,"content":"주관기관은 방위사업청장의 조정ㆍ통제를 받아 다음 각 호의 업무를 수행한다. <개정 2012.12.18>","items":[{"id":"DAPA_L_258705_ART_11_P2_I1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제2항-제1호","item_number":"1","content":"감항인증 업무 주관","subitems":[]},{"id":"DAPA_L_258705_ART_11_P2_I2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제2항-제2호","item_number":"2","content":"감항인증의 정책수립 및 집행에 대한 업무 지원","subitems":[]},{"id":"DAPA_L_258705_ART_11_P2_I3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제2항-제3호","item_number":"3","content":"감항인증 관련 자료의 조사ㆍ분석","subitems":[]},{"id":"DAPA_L_258705_ART_11_P2_I4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제2항-제4호","item_number":"4","content":"감항인증과 관련된 항공기술의 연구개발 및 지원","subitems":[]},{"id":"DAPA_L_258705_ART_11_P2_I5","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제2항-제5호","item_number":"5","content":"그 밖에 방위사업청장이 감항인증 업무와 관련하여 필요하다고 인정하는 사항","subitems":[]}]},{"id":"DAPA_L_258705_ART_11_P3","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제3항","paragraph_number":"③","paragraph_index":3,"content":"방위사업청장은 주관기관의 장으로 하여금 감항인증에 필요한 시험비행 조종사와 시험비행 기술사를 확보하도록 하여야 한다.","items":[]},{"id":"DAPA_L_258705_ART_11_P4","display_id":"군용항공기-비행안전성-인증에-관한-법률-제11조-제4항","paragraph_number":"④","paragraph_index":4,"content":"방위사업청장은 주관기관이 감항인증 관련 업무를 독립적으로 수행할 수 있도록 단계별 지원계획을 수립ㆍ시행하여야 한다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2019.4.23>","<개정 2012.12.18>"],"last_amended":"2019-04-23","related_articles":["DAPA_L_258705_ART_4","DAPA_L_258705_ART_4_2"],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_12","display_id":"군용항공기-비행안전성-인증에-관한-법률-제12조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"12","article_label":"제12조","article_title":"예산의 지원","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_12_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제12조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 주관기관 및 전문기관의 감항인증 관련 업무수행 및 운영에 필요한 경비를 예산의 범위에서 출연하거나 지원할 수 있다. <개정 2024.1.16>","items":[]},{"id":"DAPA_L_258705_ART_12_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제12조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 각 군 및 감항인증과 관련된 기관이 감항인증을 위하여 필요한 시험ㆍ평가ㆍ분석ㆍ검증 장비, 시설 및 전문인력 등을 갖출 수 있도록 예산의 범위에서 출연하거나 지원할 수 있다. <개정 2024.1.16>","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2024.1.16>"],"last_amended":"2024-01-16","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_13","display_id":"군용항공기-비행안전성-인증에-관한-법률-제13조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"13","article_label":"제13조","article_title":"업무 지원 요청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_13_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-제13조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 감항인증에 필요한 인력ㆍ장비ㆍ시설 등의 지원을 각 군 참모총장 및 감항인증과 관련된 기관의 장에게 요청할 수 있고, 이를 요청받은 자는 특별한 사정이 없는 한 인력ㆍ장비ㆍ시설 등을 지원할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_ART_14","display_id":"군용항공기-비행안전성-인증에-관한-법률-제14조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"14","article_label":"제14조","article_title":"「항공안전법」에 따른 형식증명 등과의 관계","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_14_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제14조-제1항","paragraph_number":"①","paragraph_index":1,"content":"「항공안전법」 제20조에 따라 형식증명을 받았거나 같은 법 제21조에 따라 형식증명승인을 받은 항공기를 군용항공기로 사용하는 경우 제4조제5항제1호에 따른 형식인증을 받은 것으로 본다. <개정 2012.12.18, 2016.3.29, 2019.4.23>","items":[]},{"id":"DAPA_L_258705_ART_14_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제14조-제2항","paragraph_number":"②","paragraph_index":2,"content":"「항공안전법」 제108조에 따라 안전성인증을 받은 경량항공기 또는 같은 법 제124조에 따라 안전성인증을 받은 초경량비행장치를 군용항공기로 사용하는 경우 제4조에 따른 감항인증을 받은 것으로 본다. <신설 2019.4.23>","items":[]}],"notes":["[제목개정 2016.3.29, 2019.4.23]"],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2012.12.18, 2016.3.29, 2019.4.23>","<신설 2019.4.23>","[제목개정 2016.3.29, 2019.4.23]"],"last_amended":"2019-04-23","related_articles":["DAPA_L_258705_ART_4"],"related_regulations":[],"external_references":["항공안전법"],"keywords":[]},{"id":"DAPA_L_258705_ART_15","display_id":"군용항공기-비행안전성-인증에-관한-법률-제15조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"15","article_label":"제15조","article_title":"권한의 위탁 및 재위탁","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_ART_15_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-제15조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 법에 따른 방위사업청장의 권한의 일부를 대통령령으로 정하는 바에 따라 각 군 및 전문기관에 위탁할 수 있다. <개정 2019.4.23>","items":[]},{"id":"DAPA_L_258705_ART_15_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-제15조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따라 방위사업청장의 권한을 위탁받은 각 군 및 전문기관은 그 권한의 일부를 방위사업청장의 승인을 받아 대통령령으로 정하는 요건을 갖춘 감항인증과 관련된 기관이나 연구기관의 장, 군용항공기 및 그 부품ㆍ구성품을 제작ㆍ개조ㆍ개량 또는 구매하는 자에게 재위탁할 수 있다. <개정 2019.4.23>","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":["<개정 2019.4.23>"],"last_amended":"2019-04-23","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_SUPP1_ART_1","display_id":"군용항공기-비행안전성-인증에-관한-법률-부칙1-제1조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_SUPP1_ART_1_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-부칙1-제1조","paragraph_number":"","paragraph_index":null,"content":"이 법은 2009년 8월 1일부터 시행한다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제9560호,2009.4.1>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_SUPP1_ART_2","display_id":"군용항공기-비행안전성-인증에-관한-법률-부칙1-제2조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"적용례","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_SUPP1_ART_2_P1","display_id":"군용항공기-비행안전성-인증에-관한-법률-부칙1-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"이 법에 따른 감항인증은 이 법 시행 후 착수하는 군용항공기 사업부터 적용한다.","items":[]},{"id":"DAPA_L_258705_SUPP1_ART_2_P2","display_id":"군용항공기-비행안전성-인증에-관한-법률-부칙1-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 제1항에도 불구하고 이 법 시행 전에 착수한 군용항공기 사업 중 감항인증이 사업추진에 미치는 영향, 수출 가능성 등을 고려하여 인증위원회의 심의를 거쳐 이 법을 적용하여 감항인증을 할 수 있다. 이 경우 표준감항인증기준 및 사업별ㆍ기종별 감항인증기준의 적용 범위 등에 관하여는 인증위원회의 심의를 거쳐 방위사업청장이 따로 정할 수 있다.","items":[]}],"notes":[],"effective_date":"2024-07-17","revision_date":"2024-01-16","source_file":"군용항공기 비행안전성 인증에 관한 법률.json","source_path":"원문/법제처API/군용항공기 비행안전성 인증에 관한 법률.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","supplement_header":"부칙 <제9560호,2009.4.1>","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_258705_SUPP1_ART_3","display_id":"군용항공기-비행안전성-인증에-관한-법률-부칙1-제3조","regulation_id":"DAPA_L_258705","regulation_name":"군용항공기 비행안전성 인증에 관한 법률","short_name":"군용항공기 비행안전성 인증에 관한 법률","document_type":"법률","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"감항인증 업무에 관한 준비행위","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_258705_SUPP1_ART_3_P0","display_id":"군용항공기-비행안전성-인증에-관한-법률-부칙1-제3조","paragraph_number":"","paragraph_index":null,"content":"방위사업청장은 이 법 시행 전에 전문기관 및 주관기관의 지정, 감항인증 전문인력의 양성, 그 밖에 감항인증 업무추진에 필요한 준비행위를 하거나 관련된 기관으로 하여금 준비행위를 