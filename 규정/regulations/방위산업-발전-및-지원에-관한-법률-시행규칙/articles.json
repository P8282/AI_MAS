ated_regulations":["DAPA_L_287981"],"external_references":[],"keywords":[]},{"id":"DAPA_L_286153_ART_8","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"8","article_label":"제8조","article_title":"방위산업발전협의회 실무협의회","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_8_P1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제1항","paragraph_number":"①","paragraph_index":1,"content":"영 제22조제5항에 따른 실무협의회(이하 \"실무협의회\"라 한다)는 다음 각 호의 사항을 협의한다.","items":[{"id":"DAPA_L_286153_ART_8_P1_I1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제1항-제1호","item_number":"1","content":"영 제22조제1항에 따른 방위산업발전협의회(이하 \"협의회\"라 한다) 안건에 대해 사전 검토가 필요한 사항","subitems":[]},{"id":"DAPA_L_286153_ART_8_P1_I2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제1항-제2호","item_number":"2","content":"협의회 지원을 위하여 필요한 사항","subitems":[]}]},{"id":"DAPA_L_286153_ART_8_P2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항","paragraph_number":"②","paragraph_index":2,"content":"실무협의회 위원장은 방위사업청장이 되고, 실무협의회 위원은 다음 각 호의 사람이 된다. <개정 2024.7.30, 2025.10.31, 2026.1.2>","items":[{"id":"DAPA_L_286153_ART_8_P2_I1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항-제1호","item_number":"1","content":"재정경제부, 과학기술정보통신부, 외교부, 국방부, 산업통상부, 중소벤처기업부, 기획예산처, 우주항공청 및 방위사업청의 고위공무원단에 속하는 일반직공무원으로서 직무등급이 나등급인 직위에 보직된 공무원 중 소속 기관의 장이 지명하는 사람","subitems":[]},{"id":"DAPA_L_286153_ART_8_P2_I2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항-제2호","item_number":"2","content":"국무조정실 등 실무협의회 위원장이 실무협의회 안건과 관련하여 실무협의회에 참여하는 것이 필요하다고 인정하는 중앙행정기관의 고위공무원단에 속하는 일반직공무원으로서 직무등급이 나등급인 직위에 보직된 공무원 중 소속 기관의 장이 지명하는 사람","subitems":[]},{"id":"DAPA_L_286153_ART_8_P2_I3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항-제3호","item_number":"3","content":"각군 참모총장 및 해병대사령관이 소속 군의 장성급(將星級) 장교 중에서 각각 지명하는 사람","subitems":[]},{"id":"DAPA_L_286153_ART_8_P2_I4","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항-제4호","item_number":"4","content":"「대한무역투자진흥공사법」 제10조제2항에 따른 방산물자교역지원센터의 장","subitems":[]},{"id":"DAPA_L_286153_ART_8_P2_I5","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항-제5호","item_number":"5","content":"다음 각 목의 어느 하나에 해당하는 사람으로서 방위사업청장이 위촉하는 사람","subitems":[{"id":"DAPA_L_286153_ART_8_P2_I5_S1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항-제5호-가목","subitem_number":"가","content":"「한국수출입은행법」에 따른 한국수출입은행에서 방위산업과 관련된 금융 업무를 수행하는 임직원으로서 은행장이 추천하는 사람"},{"id":"DAPA_L_286153_ART_8_P2_I5_S2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제2항-제5호-나목","subitem_number":"나","content":"법 제19조에 따라 설립된 협회 또는 단체의 임원으로서 국방부장관이 정하는 기준에 따라 해당 협회 또는 단체의 장이 추천하는 사람"}]}]},{"id":"DAPA_L_286153_ART_8_P3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제8조-제3항","paragraph_number":"③","paragraph_index":3,"content":"실무협의회 사무를 처리하기 위하여 간사 1명을 두며, 간사는 방위사업청의 방위산업 발전 정책 업무를 담당하는 과장급 공무원이 된다.","items":[]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":["<개정 2024.7.30, 2025.10.31, 2026.1.2>"],"last_amended":"2026-01-02","related_articles":["DAPA_L_289447_ART_22","DAPA_L_287981_ART_19"],"related_regulations":["DAPA_L_289447","DAPA_L_287981"],"external_references":["대한무역투자진흥공사법"],"keywords":[]},{"id":"DAPA_L_286153_SUPP1_ART_1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-부칙1-제1조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"시행일","is_deleted":false,"is_supplementary":true,"supplement_no":1,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_28