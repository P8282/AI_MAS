[{"id":"DAPA_L_286153_ART_1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제1조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"1","article_label":"제1조","article_title":"목적","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_1_P0","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제1조","paragraph_number":"","paragraph_index":null,"content":"이 규칙은 「방위산업 발전 및 지원에 관한 법률」 및 같은 법 시행령에서 위임된 사항과 그 시행에 필요한 사항을 규정함을 목적으로 한다.","items":[]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":[],"related_regulations":[],"external_references":[],"keywords":[]},{"id":"DAPA_L_286153_ART_2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"2","article_label":"제2조","article_title":"사업조정제도 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_2_P1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제1항","paragraph_number":"①","paragraph_index":1,"content":"방위사업청장은 「방위산업 발전 및 지원에 관한 법률」(이하 \"법\"이라 한다) 제11조제1항 각 호 외의 부분 후단에 따라 사업조정 당사자 간 합의를 권고하는 경우 「방위산업 발전 및 지원에 관한 법률 시행령」(이하 \"영\"이라 한다) 제13조제1항에 따라 별지 제1호서식의 사업조정 합의서를 제시해야 한다.","items":[]},{"id":"DAPA_L_286153_ART_2_P2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 법 제11조제1항 각 호 외의 부분 후단에 따라 사업조정 당사자 간 합의를 권고한 경우에는 그 주요 내용을 인터넷 홈페이지 등에 공고해야 한다.","items":[]},{"id":"DAPA_L_286153_ART_2_P3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제3항","paragraph_number":"③","paragraph_index":3,"content":"법 제11조제1항제2호에 따라 사업조정을 신청하려는 「중소기업기본법」 제2조에 따른 중소기업(이하 \"중소기업자\"라 한다)은 영 제13조제2항에 따라 별지 제2호서식의 사업조정 신청서에 다음 각 호의 서류를 첨부하여 방위사업청장에게 제출해야 한다.","items":[{"id":"DAPA_L_286153_ART_2_P3_I1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제3항-제1호","item_number":"1","content":"사업조정 신청 사유서","subitems":[]},{"id":"DAPA_L_286153_ART_2_P3_I2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제3항-제2호","item_number":"2","content":"신청인이 방위사업과 관련된 업체로서 중소기업자임을 확인할 수 있는 서류","subitems":[]},{"id":"DAPA_L_286153_ART_2_P3_I3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제3항-제3호","item_number":"3","content":"「대ㆍ중소기업 상생협력 촉진에 관한 법률」 제2조제2호에 따른 대기업이 신청인을 인수ㆍ합병하려 한다는 사실을 확인할 수 있는 서류","subitems":[]},{"id":"DAPA_L_286153_ART_2_P3_I4","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제3항-제4호","item_number":"4","content":"대리인이 신청하는 경우 그 위임장","subitems":[]},{"id":"DAPA_L_286153_ART_2_P3_I5","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제3항-제5호","item_number":"5","content":"그 밖에 사업조정에 필요한 서류나 자료","subitems":[]}]},{"id":"DAPA_L_286153_ART_2_P4","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제2조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항에 따라 사업조정을 신청한 자가 그 신청을 취하하려는 경우에는 별지 제3호서식의 사업조정 신청 취하서를 방위사업청장에게 제출해야 한다. 이 경우 대리인이 신청하는 경우에는 그 위임장을 함께 제출해야 한다.","items":[]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_11","DAPA_L_289447_ART_13","SME_BASIC_ACT_ART_2","LARGE_SME_COOPERATION_ACT_ART_2"],"related_regulations":["DAPA_L_287981","DAPA_L_289447","SME_BASIC_ACT","LARGE_SME_COOPERATION_ACT"],"external_references":[],"keywords":["대리"]},{"id":"DAPA_L_286153_ART_3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제3조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"3","article_label":"제3조","article_title":"보조금 지급 신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_3_P0","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제3조","paragraph_number":"","paragraph_index":null,"content":"법 제13조제1항 및 영 제17조제2항에 따라 보조금을 받으려는 방위산업체등(이하 \"방산업체등\"이라 한다) 또는 전문연구기관은 별지 제4호서식의 보조금 지급 신청서에 다음 각 호의 서류를 첨부하여 방위사업청장에게 제출해야 한다.","items":[{"id":"DAPA_L_286153_ART_3_P0_I1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제3조-제1호","item_number":"1","content":"사업계획서","subitems":[]},{"id":"DAPA_L_286153_ART_3_P0_I2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제3조-제2호","item_number":"2","content":"업체ㆍ기관 명의의 금융회사 거래통장 사본","subitems":[]},{"id":"DAPA_L_286153_ART_3_P0_I3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제3조-제3호","item_number":"3","content":"법인인감증명서(신청인이 법인인 경우만 해당한다)","subitems":[]}]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_13","DAPA_L_289447_ART_17"],"related_regulations":["DAPA_L_287981","DAPA_L_289447"],"external_references":[],"keywords":["법인"]},{"id":"DAPA_L_286153_ART_4","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제4조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"4","article_label":"제4조","article_title":"보조금에 의한 재산의 양도ㆍ교환 또는 대부 승인 신청","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_4_P1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제4조-제1항","paragraph_number":"①","paragraph_index":1,"content":"법 제13조제2항 및 영 제18조제1항에 따라 보조금으로 취득하거나 효용이 증가된 재산의 양도ㆍ교환 또는 대부에 대한 승인을 받으려는 방산업체등 또는 전문연구기관은 별지 제5호서식에 따른 승인 신청서에 다음 각 호의 서류를 첨부하여 방위사업청장에게 제출해야 한다.","items":[{"id":"DAPA_L_286153_ART_4_P1_I1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제4조-제1항-제1호","item_number":"1","content":"별지 제6호서식에 따른 승인 신청 사유서","subitems":[]},{"id":"DAPA_L_286153_ART_4_P1_I2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제4조-제1항-제2호","item_number":"2","content":"양도ㆍ교환 또는 대부 계약서 사본","subitems":[]},{"id":"DAPA_L_286153_ART_4_P1_I3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제4조-제1항-제3호","item_number":"3","content":"보조금에 의한 재산의 양도ㆍ교환 또는 대부에 관한 법인의 의사결정을 증명하는 서류(신청인이 법인인 경우만 해당한다)","subitems":[]}]},{"id":"DAPA_L_286153_ART_4_P2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제4조-제2항","paragraph_number":"②","paragraph_index":2,"content":"방위사업청장은 제1항에 따른 신청서를 받으면 「전자정부법」 제36조제1항에 따른 행정정보의 공동이용을 통하여 법인 등기사항증명서를 확인해야 한다.","items":[]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_287981_ART_13","DAPA_L_289447_ART_18","EGOVERNMENT_ACT_ART_36"],"related_regulations":["DAPA_L_287981","DAPA_L_289447","EGOVERNMENT_ACT"],"external_references":[],"keywords":["법인"]},{"id":"DAPA_L_286153_ART_5","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제5조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"5","article_label":"제5조","article_title":"방위산업 전문인력 양성기관 지정 신청의 서식","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_5_P0","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제5조","paragraph_number":"","paragraph_index":null,"content":"영 제19조제4항 각 호 외의 부분 전단에 따른 방위산업 전문인력 양성기관 지정 신청서는 별지 제7호서식과 같다.","items":[]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":[],"last_amended":"","related_articles":["DAPA_L_289447_ART_19"],"related_regulations":["DAPA_L_289447"],"external_references":[],"keywords":[]},{"id":"DAPA_L_286153_ART_5_2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제5조의2","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"5의2","article_label":"제5조의2","article_title":"대응구매의 절차","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_5_2_P0","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제5조의2","paragraph_number":"","paragraph_index":null,"content":"영 제20조제1항 각 호 외의 부분에 따른 대응구매는 「방위사업법 시행령」 제25조의3에 따른 국외 구매절차를 적용한다. 다만, 영 제20조제1항제2호에 따라 수의계약의 방법으로 대응구매를 하는 경우에는 입찰공고, 구매대상 무기체계의 기종결정 등 방위사업청장이 정하는 구매절차를 생략할 수 있다.","items":[]}],"notes":["[본조신설 2026.5.19]"],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":["[본조신설 2026.5.19]"],"last_amended":"2026-05-19","related_articles":["DAPA_L_289447_ART_20","DEFENSE_ACQ_ENFORCEMENT_ART_25_3"],"related_regulations":["DAPA_L_289447","DEFENSE_ACQ_ENFORCEMENT"],"external_references":[],"keywords":[]},{"id":"DAPA_L_286153_ART_6","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"6","article_label":"제6조","article_title":"수출에 따른 후속군수지원 절차 등","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_6_P1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제1항","paragraph_number":"①","paragraph_index":1,"content":"법 제15조제3항제1호에 따라 방위산업물자등의 수출에 따른 후속군수지원 업무지원을 받으려는 자는 영 제20조제5항에 따라 수출 후속군수지원 종합관리계획서를 방위사업청장에게 제출할 때에 별지 제8호서식의 후속군수지원 요청서를 함께 제출해야 한다. <개정 2026.5.19>","items":[]},{"id":"DAPA_L_286153_ART_6_P2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제2항","paragraph_number":"②","paragraph_index":2,"content":"제1항에 따른 지원을 요청받은 방위사업청장은 관계 행정기관의 장 및 각 군의 참모총장(이하 이 조에서 \"관계기관의장\"이라 한다)에게 다음 각 호의 사항에 대한 검토를 요청할 수 있다.","items":[{"id":"DAPA_L_286153_ART_6_P2_I1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제2항-제1호","item_number":"1","content":"후속군수지원 가능 여부","subitems":[]},{"id":"DAPA_L_286153_ART_6_P2_I2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제2항-제2호","item_number":"2","content":"후속군수지원의 범위와 기간","subitems":[]},{"id":"DAPA_L_286153_ART_6_P2_I3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제2항-제3호","item_number":"3","content":"후속군수지원요소의 유상ㆍ무상 대여나 양도 가능 여부 및 대여나 양도의 조건","subitems":[]},{"id":"DAPA_L_286153_ART_6_P2_I4","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제2항-제4호","item_number":"4","content":"그 밖에 후속군수지원을 위하여 필요한 사항","subitems":[]}]},{"id":"DAPA_L_286153_ART_6_P3","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제3항","paragraph_number":"③","paragraph_index":3,"content":"제2항에 따라 검토 요청을 받은 관계기관의장은 검토 결과를 30일 이내에 방위사업청장에게 통보해야 한다.","items":[]},{"id":"DAPA_L_286153_ART_6_P4","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제4항","paragraph_number":"④","paragraph_index":4,"content":"제3항에 따라 검토 결과를 통보받은 방위사업청장은 관계기관의장과 협의하여 후속군수지원이 가능한 기관과 지원업무의 범위 등을 정하고, 그 내용을 관계기관의장 및 제1항의 요청자에게 각각 통보해야 한다.","items":[]},{"id":"DAPA_L_286153_ART_6_P5","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제5항","paragraph_number":"⑤","paragraph_index":5,"content":"제4항에 따라 통보받은 요청자는 후속군수지원이 가능한 기관의 장과 계약을 체결하여 필요한 후속군수지원을 받을 수 있다.","items":[]},{"id":"DAPA_L_286153_ART_6_P6","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제6조-제6항","paragraph_number":"⑥","paragraph_index":6,"content":"제1항부터 제5항까지에서 규정한 사항 외에 후속군수지원의 세부절차 등에 관하여 필요한 사항은 방위사업청장이 정한다.","items":[]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","pdf_path":"","source_page":"","amendments":["<개정 2026.5.19>"],"last_amended":"2026-05-19","related_articles":["DAPA_L_287981_ART_15","DAPA_L_289447_ART_20"],"related_regulations":["DAPA_L_287981","DAPA_L_289447"],"external_references":[],"keywords":[]},{"id":"DAPA_L_286153_ART_7","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제7조","regulation_id":"DAPA_L_286153","regulation_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","short_name":"방위산업 발전 및 지원에 관한 법률 시행규칙","document_type":"시행규칙","part":"","chapter":"","section":"","subsection":"","article_number":"7","article_label":"제7조","article_title":"수출산업협력 지원 신청의 서식","is_deleted":false,"is_supplementary":false,"supplement_no":null,"is_scheduled":false,"scheduled_effective_date":"","variant_of":null,"version_note":"","paragraphs":[{"id":"DAPA_L_286153_ART_7_P1","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제7조-제1항","paragraph_number":"①","paragraph_index":1,"content":"영 제21조제5항에 따른 신청서는 별지 제9호서식과 같다.","items":[]},{"id":"DAPA_L_286153_ART_7_P2","display_id":"방위산업-발전-및-지원에-관한-법률-시행규칙-제7조-제2항","paragraph_number":"②","paragraph_index":2,"content":"영 제21조제7항 각 호 외의 부분 전단에 따른 신청서는 별지 제10호서식과 같다.","items":[]}],"notes":[],"effective_date":"2026-05-19","revision_date":"2026-05-19","source_file":"방위산업 발전 및 지원에 관한 법률 시행규칙.json","source_path":"원문/법제처API/방위산업 발전 및 지원에 관한 법률 시행규칙.json","p